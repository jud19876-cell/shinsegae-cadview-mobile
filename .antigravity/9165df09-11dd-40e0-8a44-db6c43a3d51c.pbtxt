            }
            lines {
              text: "            if ("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              (sx1 < 0 && sx2 < 0) ||"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
