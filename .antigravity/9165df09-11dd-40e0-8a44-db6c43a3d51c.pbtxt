    use_fast_apply: true
    replacement_infos {
      original_chunk {
        target_content: "    screenToWorld,\n    worldToScreen,\n  ]);\n\n  // Window resize handler\n  useEffect(() => {\n    const handleResize = () => {\n      const container = containerRef.current;\n      const canvas = canvasRef.current;\n      if (!container || !canvas) return;\n      const rect = container.getBoundingClientRect();\n      canvas.width = Math.max(280, Math.floor(rect.width));\n      canvas.height = Math.max(200, Math.floor(rect.height));\n    };\n\n    handleResize();\n    window.addEventListener(\'resize\', handleResize);\n    window.addEventListener(\'orientationchange\', () =>\n      setTimeout(handleResize, 150)\n    );\n    return () => {\n      window.removeEventListener(\'resize\', handleResize);\n    };\n  }, []);"
        replacement_content: "    screenToWorld,\n    worldToScreen,\n    canvasDimensions,\n  ]);\n\n  // Window & Container resize observer with orientation auto-adjustment\n  useEffect(() => {\n    const container = containerRef.current;\n    if (!container) return;\n\n    let prevW = 0;\n    let prevH = 0;\n\n    const handleResize = () => {\n      const canvas = canvasRef.current;\n      if (!container || !canvas) return;\n      const rect = container.getBoundingClientRect();\n      const newW = Math.max(100, Math.floor(rect.width));\n      const newH = Math.max(100, Math.floor(rect.height));\n\n      if (\n        newW !== prevW ||\n        newH !== prevH ||\n        canvas.width !== newW ||\n        canvas.height !== newH\n      ) {\n        prevW = newW;\n        prevH = newH;\n        canvas.width = newW;\n        canvas.height = newH;\n        setCanvasDimensions({ width: newW, height: newH });\n\n        // Auto adjust camera when switching between landscape and portrait!\n        if (entities.length > 0) {\n          const isPortrait = newW < newH;\n          if (\n            prevIsPortraitRef.current !== null &&\n            prevIsPortraitRef.current !== isPortrait\n          ) {\n            const extW = Math.max(10, extents.maxX - extents.minX);\n            const extH = Math.max(10, extents.maxY - extents.minY);\n            const newCamX = (extents.minX + extents.maxX) / 2;\n            const newCamY = (extents.minY + extents.maxY) / 2;\n            const fittedZoom = Math.min((newW * 0.88) / extW, (newH * 0.88) / extH);\n            onUpdateCamera(newCamX, newCamY, fittedZoom);\n          }\n          prevIsPortraitRef.current = isPortrait;\n        }\n      }\n    };\n\n    handleResize();\n\n    const ro = new ResizeObserver(() => {\n      handleResize();\n    });\n    ro.observe(container);\n\n    window.addEventListener(\'resize\', handleResize);\n    window.addEventListener(\'orientationchange\', () => {\n      setTimeout(handleResize, 100);\n      setTimeout(handleResize, 350);\n    });\n    if (window.visualViewport) {\n      window.visualViewport.addEventListener(\'resize\', handleResize);\n    }\n\n    return () => {\n      ro.disconnect();\n      window.removeEventListener(\'resize\', handleResize);\n      if (window.visualViewport) {\n        window.visualViewport.removeEventListener(\'resize\', handleResize);\n      }\n    };\n  }, [entities.length, extents, onUpdateCamera]);"
        start_line: 752
        end_line: 777
      }
      num_matches: 1
    }
    description: "Update CADCanvas resize observer and camera auto-fit on orientation change"
