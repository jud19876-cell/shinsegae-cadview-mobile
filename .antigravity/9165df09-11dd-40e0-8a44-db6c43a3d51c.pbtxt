      arguments_json: "{\"CodeContent\":\"/**\\n * @license\\n * SPDX-License-Identifier: Apache-2.0\\n */\\n\\nimport React from \'react\';\\nimport { Hand, MousePointer, Ruler, Scaling, Magnet, Map as MapIcon } from \'lucide-react\';\\nimport { ToolMode } from \'../types/cad\';\\n\\ninterface BottomDockProps {\\n  mode: ToolMode;\\n  showGrid: boolean;\\n  showMinimap: boolean;\\n  onSetMode: (mode: ToolMode) => void;\\n  onToggleGrid: () => void;\\n  onToggleMinimap: () => void;\\n}\\n\\nexport const BottomDock: React.FC<BottomDockProps> = ({\\n  mode,\\n  showGrid,\\n  showMinimap,\\n  onSetMode,\\n  onToggleGrid,\\n  onToggleMinimap,\\n}) => {\\n  return (\\n    <footer className=\\\"h-16 bg-white dark:bg-[#0f172a] border-t border-slate-300 dark:border-slate-800 px-2 flex items-center justify-around gap-1 shrink-0 z-30 pb-safe shadow-lg\\\">\\n      {/* 1. Pan Tool */}\\n      <button\\n        onClick={() => onSetMode(\'pan\')}\\n        className={`flex-1 flex flex-col items-center justify-center gap-1 py-1.5 px-1 rounded-xl text-xs font-semibold transition active:scale-95 ${\\n          mode === \'pan\'\\n            ? \'bg-[#1E3A8A] text-white shadow-md\'\\n            : \'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800\'\\n        }`}\\n        title=\\\"\355\204\260\354\271\230\353\241\234 \353\217\204\353\251\264 \355\231\224\353\251\264 \354\236\220\354\234\240 \354\235\264\353\217\231\\\"\\n      >\\n        <Hand className=\\\"w-4 h-4\\\" />\\n        <span className=\\\"text-[11px]\\\">\355\231\224\353\251\264\354\235\264\353\217\231</span>\\n      </button>\\n\\n      {/* 2. Select Tool */}\\n      <button\\n        onClick={() => onSetMode(\'select\')}\\n        className={`flex-1 flex flex-col items-center justify-center gap-1 py-1.5 px-1 rounded-xl text-xs font-semibold transition active:scale-95 ${\\n          mode === \'select\'\\n            ? \'bg-[#1E3A8A] text-white shadow-md\'\\n            : \'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800\'\\n        }`}\\n        title=\\\"\354\204\240, \355\230\270, \354\233\220, \355\205\215\354\212\244\355\212\270 \352\260\235\354\262\264 \355\204\260\354\271\230 \353\260\217 \354\206\215\354\204\261 \355\231\225\354\235\270\\\"\\n      >\\n        <MousePointer className=\\\"w-4 h-4\\\" />\\n        <span className=\\\"text-[11px]\\\">\352\260\235\354\262\264\354\204\240\355\203\235</span>\\n      </button>\\n\\n      {/* 3. Measure Tool */}\\n      <button\\n        onClick={() => onSetMode(\'measure\')}\\n        className={`flex-1 flex flex-col items-center justify-center gap-1 py-1.5 px-1 rounded-xl text-xs font-semibold transition active:scale-95 ${\\n          mode === \'measure\'\\n            ? \'bg-[#C8102E] text-white shadow-md\'\\n            : \'text-rose-600 dark:text-rose-400 hover:bg-slate-100 dark:hover:bg-slate-800\'\\n        }`}\\n        title=\\\"\353\221\220 \354\247\200\354\240\220\354\235\204 \355\204\260\354\271\230\355\225\230\354\227\254 \354\213\244\354\240\234 \352\270\270\354\235\264 \353\260\217 \354\271\230\354\210\230 \354\270\241\354\240\225\\\"\\n      >\\n        <Ruler className=\\\"w-4 h-4\\\" />\\n        <span className=\\\"text-[11px]\\\">\352\261\260\353\246\254\354\270\241\354\240\225</span>\\n      </button>\\n\\n      {/* 4. Calibrate Tool */}\\n      <button\\n        onClick={() => onSetMode(\'calibrate\')}\\n        className={`flex-1 flex flex-col items-center justify-center gap-1 py-1.5 px-1 rounded-xl text-xs font-semibold transition active:scale-95 ${\\n          mode === \'calibrate\'\\n            ? \'bg-amber-600 text-white shadow-md\'\\n            : \'text-amber-600 dark:text-amber-400 hover:bg-slate-100 dark:hover:bg-slate-800\'\\n        }`}\\n        title=\\\"\352\270\260\354\244\200 \354\271\230\354\210\230 2\354\240\220\354\235\204 \355\204\260\354\271\230\355\225\230\354\227\254 \353\217\204\353\251\264 \354\213\244\354\240\234 1:1 \354\266\225\354\262\231 \352\265\220\354\240\225\\\"\\n      >\\n        <Scaling className=\\\"w-4 h-4\\\" />\\n        <span className=\\\"text-[11px]\\\">2\354\240\220\354\266\225\354\262\231</span>\\n      </button>\\n\\n      {/* 5. Snap & Grid Toggle */}\\n      <button\\n        onClick={onToggleGrid}\\n        className={`flex-1 flex flex-col items-center justify-center gap-1 py-1.5 px-1 rounded-xl text-xs font-semibold transition active:scale-95 ${\\n          showGrid\\n            ? \'text-emerald-600 dark:text-emerald-400 font-bold bg-emerald-50 dark:bg-emerald-950/30\'\\n            : \'text-slate-400 dark:text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800\'\\n        }`}\\n        title=\\\"\352\267\270\353\246\254\353\223\234 \355\221\234\354\213\234 \353\260\217 \353\201\235\354\240\220\302\267\354\244\221\354\213\254\354\240\220 \354\236\220\354\204\235 \354\212\244\353\203\205(OSNAP) On/Off\\\"\\n      >\\n        <Magnet className=\\\"w-4 h-4\\\" />\\n        <span className=\\\"text-[11px]\\\">\354\212\244\353\203\205\302\267\352\262\251\354\236\220</span>\\n      </button>\\n\\n      {/* 6. Minimap Toggle */}\\n      <button\\n        onClick={onToggleMinimap}\\n        className={`flex-1 flex flex-col items-center justify-center gap-1 py-1.5 px-1 rounded-xl text-xs font-semibold transition active:scale-95 ${\\n          showMinimap\\n            ? \'bg-[#1E3A8A] text-white shadow-md\'\\n            : \'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800\'\\n        }`}\\n        title=\\\"\353\217\204\353\251\264 \354\240\204\354\262\264 \353\257\270\353\213\210\353\247\265 \355\221\234\354\213\234/\354\210\250\352\271\200\\\"\\n      >\\n        <MapIcon className=\\\"w-4 h-4\\\" />\\n        <span className=\\\"text-[11px]\\\">\353\257\270\353\213\210\353\247\265</span>\\n      </button>\\n    </footer>\\n  );\\n};\\n\", \"Description\":\"Create BottomDock component\", \"Overwrite\":true, \"TargetFile\":\"/src/components/BottomDock.tsx\", \"toolAction\":\"Writing BottomDock.tsx\", \"toolSummary\":\"Create BottomDock component\"}"
