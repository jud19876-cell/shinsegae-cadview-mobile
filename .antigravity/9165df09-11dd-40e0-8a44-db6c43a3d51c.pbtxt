    content: "              }\n\n              ent.position = wPos;\n              ent.blockName = bname;\n              ent.scaleX = sx;\n              ent.scaleY = sy;\n              ent.rotation = isFinite(rot) ? rot : 0;\n            } else if (t === \'DIMENSION\' || t.startsWith(\'DIMENSION_\') || t === \'ARC_DIMENSION\' || t === \'LARGE_RADIAL_DIMENSION\') {\n              const bname = cleanCadText(raw.block || raw.blockName || raw.name || raw.anonymousBlockName || \'\');\n              if (bname) {\n                ent.type = \'INSERT\';\n                ent.blockName = bname;\n                const insPt = raw.insertionPoint || raw.clonePoint || { x: 0, y: 0 };\n                const wIns = (isValidCoord(insPt.x) && isValidCoord(insPt.y)) ? ocs.pt(insPt.x, insPt.y, insPt.z || 0) : { x: 0, y: 0 };\n                ent.position = wIns;\n                ent.scaleX = ocs.flipX < 0 ? -1 : 1;\n                ent.scaleY = 1;\n                ent.rotation = 0;\n              } else return null;\n            } else if (t === \'ACAD_TABLE\' || t === \'TABLE\') {\n              const bname = cleanCadText(raw.block || raw.blockName || raw.name || (\'*T\' + (tableBlockSeq++)));\n              const pos = raw.insertionPoint || raw.startPoint || raw.position || { x: 0, y: 0 };\n              ent.type = \'INSERT\';\n              ent.blockName = bname;\n              ent.position = (isValidCoord(pos.x) && isValidCoord(pos.y)) ? { x: pos.x, y: pos.y } : { x: 0, y: 0 };\n              ent.scaleX = 1; ent.scaleY = 1; ent.rotation = 0;\n            } else if (t === \'SPLINE\') {\n              const pts = (raw.fitPoints && raw.fitPoints.length >= 2) ? raw.fitPoints : (raw.controlPoints || raw.vertices || []);\n              if (!Array.isArray(pts) || pts.length < 2) return null;\n              ent.type = \'LWPOLYLINE\';\n              ent.closed = false;\n              ent.vertices = pts.map(p => ({ x: Number(p.x), y: Number(p.y) })).filter(p => isValidCoord(p.x) && isValidCoord(p.y));\n              if (ent.vertices.length < 2) return null;\n            } else if (t === \'SOLID\' || t === \'3DFACE\' || t === \'TRACE\') {\n              let pts = raw.points || raw.vertices || [raw.firstCorner || raw.corner1, raw.secondCorner || raw.corner2, raw.thirdCorner || raw.corner3, raw.fourthCorner || raw.corner4].filter(Boolean);\n              if (!Array.isArray(pts) || pts.length < 3) return null;\n              // SOLID/TRACE in AutoCAD uses 1-2-4-3 vertex ordering\n              if ((t === \'SOLID\' || t === \'TRACE\') && pts.length === 4) {\n                pts = [pts[0], pts[1], pts[3], pts[2]];\n              }\n              const isWcsFace = (t === \'3DFACE\');\n              ent.type = \'LWPOLYLINE\';\n              ent.closed = true;\n              ent.vertices = pts.map(p => {\n                const px = Number(p.x), py = Number(p.y);\n                if (!isValidCoord(px) || !isValidCoord(py)) return null;\n                return isWcsFace ? { x: px, y: py } : ocs.pt(px, py, p.z || elev);\n              }).filter(Boolean);\n              if (ent.vertices.length < 3) return null;\n            } else return null;\n            return ent;\n          } catch (e) { return null; }\n        }\n\n        const rawBlocks = (db && db.tables && db.tables.BLOCK_RECORD && db.tables.BLOCK_RECORD.entries) || (db && db.blocks) || [];\n        let modelSpaceFallback = [];\n        let paperSpaceFallback = [];\n\n        function processBlockRecord(b, fallbackName) {\n          if (!b) return;\n          const bname = cleanCadText(b.name || fallbackName || \'\');\n          if (!bname) return;\n          const upper = bname.toUpperCase();\n          const bEnts = (Array.isArray(b.entities) ? b.entities : []).map(r => mapRawEntity(r, true)).filter(Boolean);\n          if (upper.startsWith(\'*MODEL_SPACE\')) {\n            if (bEnts.length > modelSpaceFallback.length) modelSpaceFallback = bEnts;\n            return;\n          }\n          if (upper.startsWith(\'*PAPER_SPACE\')) {\n            if (bEnts.length > paperSpaceFallback.length) paperSpaceFallback = bEnts;\n            return;\n          }\n          const bpSrc = b.basePoint || b.origin || b.insertionPoint || (b.block && (b.block.basePoint || b.block.origin)) || { x: 0, y: 0 };\n          blocks[bname] = {\n            name: bname,\n            basePoint: {"
