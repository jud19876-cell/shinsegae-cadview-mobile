    replacement_infos {
      original_chunk {
        target_content: "  function isArtifactStreakSegment(\n    p1: Point2D,\n    p2: Point2D\n  ): boolean {\n    const dx = Math.abs(p2.x - p1.x);\n    const dy = Math.abs(p2.y - p1.y);\n    const len = Math.hypot(dx, dy);\n    if (!isFinite(len) || len === 0) return true;\n    if (len > maxDiag * 1.5) return true;\n\n    // 1. Accidental ray or tangent connecting to origin (0, 0)\n    const p1NearZero = Math.hypot(p1.x, p1.y) < 2.0;\n    const p2NearZero = Math.hypot(p2.x, p2.y) < 2.0;\n    if ((p1NearZero || p2NearZero) && len > 250) {\n      return true;\n    }\n\n    // 2. Diagonal streak cutting across viewports between disparate machines/views\n    const isDiagonal = dx > 80 && dy > 80;\n    if (isDiagonal && len > 500) {\n      return true;\n    }\n\n    // 3. Very long anomalous line that is not strictly axis-aligned border\n    const isAxisAligned = dx < 1e-2 || dy < 1e-2;\n    if (!isAxisAligned && len > 1200) {\n      return true;\n    }\n\n    return false;\n  }\n\n  const finalEntities: CadEntity[] = [];\n  for (let i = 0; i < expanded.length; i++) {\n    const e = expanded[i];\n    const lyrUpper = String(e.layer || \'\').toUpperCase();\n    if (\n      lyrUpper === \'DEFPOINTS\' ||\n      lyrUpper.includes(\'DEFPOINT\') ||\n      lyrUpper === \'NPLT\' ||\n      lyrUpper.includes(\'NO_PLOT\') ||\n      lyrUpper.includes(\'NON_PLOT\')\n    ) {\n      continue;\n    }\n\n    if (e.type === \'LINE\' && e.start && e.end) {\n      if (isArtifactStreakSegment(e.start, e.end)) continue;\n      finalEntities.push(e);\n    } else if (e.type === \'LWPOLYLINE\' && e.vertices && e.vertices.length >= 2) {\n      // Calculate median segment length in this polyline to detect anomalous jumps\n      const segLengths: number[] = [];\n      for (let s = 1; s < Math.min(e.vertices.length, 30); s++) {\n        segLengths.push(\n          Math.hypot(\n            e.vertices[s].x - e.vertices[s - 1].x,\n            e.vertices[s].y - e.vertices[s - 1].y\n          )\n        );\n      }\n      segLengths.sort((a, b) => a - b);\n      const medianStep =\n        segLengths[Math.floor(segLengths.length / 2)] || 10;\n\n      // Check false polyline closure (connecting disparate ends of drawing across machines)\n      if (e.closed && e.vertices.length >= 2) {\n        const v0 = e.vertices[0];\n        const vn = e.vertices[e.vertices.length - 1];\n        const closeDist = Math.hypot(vn.x - v0.x, vn.y - v0.y);\n        const closeDx = Math.abs(vn.x - v0.x);\n        const closeDy = Math.abs(vn.y - v0.y);\n        if (\n          closeDist > 0.1 &&\n          ((closeDx > 300 && closeDy > 300) ||\n            closeDist > Math.max(medianStep * 4, 300) ||\n            closeDist > Math.min(spanW, spanH) * 0.1)\n        ) {\n          e.closed = false;\n        }\n      }\n\n      // Filter internal jump streaks in polylines\n      let currentSubVerts = [e.vertices[0]];\n      for (let k = 1; k < e.vertices.length; k++) {\n        const prev = e.vertices[k - 1];\n        const cur = e.vertices[k];\n        const segDx = Math.abs(cur.x - prev.x);\n        const segDy = Math.abs(cur.y - prev.y);\n        const segLen = Math.hypot(segDx, segDy);\n        const isJump =\n          isArtifactStreakSegment(prev, cur) ||\n          (segDx > 350 && segDy > 350 && segLen > Math.max(medianStep * 5, 800));"
        replacement_content: "  function isArtifactStreakSegment(\n    p1: Point2D,\n    p2: Point2D\n  ): boolean {\n    const dx = Math.abs(p2.x - p1.x);\n    const dy = Math.abs(p2.y - p1.y);\n    const len = Math.hypot(dx, dy);\n    if (!isFinite(len) || len === 0) return true;\n    if (len > maxDiag * 1.25) return true;\n\n    // 1. Accidental ray or tangent connecting to origin (0, 0)\n    const p1NearZero = Math.hypot(p1.x, p1.y) < 2.0;\n    const p2NearZero = Math.hypot(p2.x, p2.y) < 2.0;\n    const drawingFarFromZero =\n      Math.min(Math.abs(minX), Math.abs(maxX)) > 100 ||\n      Math.min(Math.abs(minY), Math.abs(maxY)) > 100;\n    if ((p1NearZero || p2NearZero) && len > 250 && drawingFarFromZero) {\n      return true;\n    }\n\n    return false;\n  }\n\n  const finalEntities: CadEntity[] = [];\n  for (let i = 0; i < expanded.length; i++) {\n    const e = expanded[i];\n    const lyrUpper = String(e.layer || \'\').toUpperCase();\n    if (\n      lyrUpper === \'DEFPOINTS\' ||\n      lyrUpper.includes(\'DEFPOINT\') ||\n      lyrUpper === \'NPLT\' ||\n      lyrUpper.includes(\'NO_PLOT\') ||\n      lyrUpper.includes(\'NON_PLOT\')\n    ) {\n      continue;\n    }\n\n    if (e.type === \'LINE\' && e.start && e.end) {\n      if (isArtifactStreakSegment(e.start, e.end)) continue;\n      finalEntities.push(e);\n    } else if (e.type === \'LWPOLYLINE\' && e.vertices && e.vertices.length >= 2) {\n      // Calculate median segment length in this polyline to detect anomalous jumps\n      const segLengths: number[] = [];\n      for (let s = 1; s < Math.min(e.vertices.length, 30); s++) {\n        segLengths.push(\n          Math.hypot(\n            e.vertices[s].x - e.vertices[s - 1].x,\n            e.vertices[s].y - e.vertices[s - 1].y\n          )\n        );\n      }\n      segLengths.sort((a, b) => a - b);\n      const medianStep =\n        segLengths[Math.floor(segLengths.length / 2)] || 10;\n\n      // Check false polyline closure (connecting disparate ends of drawing across machines)\n      if (e.closed && e.vertices.length >= 2) {\n        const v0 = e.vertices[0];\n        const vn = e.vertices[e.vertices.length - 1];\n        const closeDist = Math.hypot(vn.x - v0.x, vn.y - v0.y);\n        if (\n          closeDist > Math.max(medianStep * 15, 800) ||\n          (closeDist > 250 && (Math.hypot(v0.x, v0.y) < 2.0 || Math.hypot(vn.x, vn.y) < 2.0))\n        ) {\n          e.closed = false;\n        }\n      }\n\n      // Filter internal jump streaks in polylines\n      let currentSubVerts = [e.vertices[0]];\n      for (let k = 1; k < e.vertices.length; k++) {\n        const prev = e.vertices[k - 1];\n        const cur = e.vertices[k];\n        const segDx = Math.abs(cur.x - prev.x);\n        const segDy = Math.abs(cur.y - prev.y);\n        const segLen = Math.hypot(segDx, segDy);\n        const isJump =\n          isArtifactStreakSegment(prev, cur) ||\n          (segLen > Math.max(medianStep * 30, 2000) &&\n            (Math.hypot(cur.x, cur.y) < 2.0 || Math.hypot(prev.x, prev.y) < 2.0));"
