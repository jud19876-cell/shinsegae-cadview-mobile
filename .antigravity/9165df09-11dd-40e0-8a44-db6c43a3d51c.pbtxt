    content: "  > = {};\n  const textList: TextEntity[] = [];\n  const rasterList: RasterPreviewEntity[] = [];\n\n  for (let i = 0; i < finalEntities.length; i++) {\n    const e = finalEntities[i];\n    if (e.type === \'TEXT\') {\n      textList.push(e);\n      continue;\n    }\n    if (e.type === \'RASTER_PREVIEW\') {\n      rasterList.push(e);\n      continue;\n    }\n\n    const layerName = e.layer || \'0\';\n    let entityColor = \'\';\n    if (e.aci !== null && e.aci !== undefined && e.aci !== 256 && e.aci !== 0) {\n      entityColor = resolveCadColorValue(e.aci, theme);\n    } else if (layers[layerName]) {\n      entityColor = resolveCadColorValue(layers[layerName].aci, theme);\n    } else {\n      entityColor = theme === \'white\' ? \'#0f172a\' : \'#f8fafc\';\n    }\n\n    const lt = String(e.linetype || \'CONTINUOUS\').toUpperCase();\n    const dashType: \'S\' | \'D\' | \'C\' = lt.includes(\'CENTER\')\n      ? \'C\'\n      : lt.includes(\'DASH\') || lt.includes(\'HIDDEN\')\n        ? \'D\'\n        : \'S\';\n    const key = `${layerName}|${entityColor}|${dashType}`;\n\n    let batch = batchMap[key];\n    if (!batch) {\n      batch = {\n        layer: layerName,\n        color: entityColor,\n        dashType,\n        lines: [],\n        polylines: [],\n        circles: [],\n        arcs: [],\n        ellipses: [],\n      };\n      batchMap[key] = batch;\n    }\n\n    if (e.type === \'LINE\' && e.start && e.end) {\n      batch.lines.push(e.start.x, e.start.y, e.end.x, e.end.y);\n    } else if (e.type === \'LWPOLYLINE\' && e.vertices) {\n      batch.polylines.push(e);\n    } else if (e.type === \'CIRCLE\' && e.center) {\n      batch.circles.push(e);\n    } else if (e.type === \'ARC\' && e.center) {\n      batch.arcs.push(e);\n    } else if (e.type === \'ELLIPSE\' && e.center) {\n      batch.ellipses.push(e);\n    }\n  }\n\n  const renderBatches: RenderBatch[] = Object.values(batchMap).map((b) => ({\n    layer: b.layer,\n    color: b.color,\n    dashType: b.dashType,\n    lineCoords: new Float32Array(b.lines),"
