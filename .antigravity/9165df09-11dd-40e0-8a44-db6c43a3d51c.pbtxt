    content: "        } else {\n          ctx.setLineDash([]);\n        }\n\n        ctx.beginPath();\n        const coords = batch.lineCoords;\n        if (noRot) {\n          for (let i = 0; i < coords.length; i += 4) {\n            const sx1 = halfW + (coords[i] - camX) * zoom;\n            const sy1 = halfH - (coords[i + 1] - camY) * zoom;\n            const sx2 = halfW + (coords[i + 2] - camX) * zoom;\n            const sy2 = halfH - (coords[i + 3] - camY) * zoom;\n            if (\n              (sx1 < 0 && sx2 < 0) ||\n              (sx1 > cw && sx2 > cw) ||\n              (sy1 < 0 && sy2 < 0) ||\n              (sy1 > ch && sy2 > ch)\n            )\n              continue;\n            ctx.moveTo(sx1, sy1);\n            ctx.lineTo(sx2, sy2);\n          }\n        } else {\n          for (let i = 0; i < coords.length; i += 4) {\n            const dx1 = coords[i] - camX;\n            const dy1 = coords[i + 1] - camY;\n            const sx1 = halfW + (dx1 * cosA - dy1 * sinA) * zoom;\n            const sy1 = halfH - (dx1 * sinA + dy1 * cosA) * zoom;\n            const dx2 = coords[i + 2] - camX;\n            const dy2 = coords[i + 3] - camY;\n            const sx2 = halfW + (dx2 * cosA - dy2 * sinA) * zoom;\n            const sy2 = halfH - (dx2 * sinA + dy2 * cosA) * zoom;\n            ctx.moveTo(sx1, sy1);\n            ctx.lineTo(sx2, sy2);\n          }\n        }\n\n        // Polylines\n        const polys = batch.polylines;\n        for (let pIdx = 0; pIdx < polys.length; pIdx++) {\n          const verts = polys[pIdx].vertices;\n          if (verts.length < 2) continue;\n          const v0 = verts[0];\n          const s0 = worldToScreen(v0.x, v0.y);\n          ctx.moveTo(s0.x, s0.y);\n          for (let k = 1; k < verts.length; k++) {\n            const sk = worldToScreen(verts[k].x, verts[k].y);\n            ctx.lineTo(sk.x, sk.y);\n          }\n          if (polys[pIdx].closed) ctx.closePath();\n        }\n\n        // Circles\n        const circles = batch.circles;\n        for (let cIdx = 0; cIdx < circles.length; cIdx++) {\n          const c = circles[cIdx];\n          const r = c.radius * zoom;\n          if (r < 0.6) continue;\n          const sc = worldToScreen(c.center.x, c.center.y);\n          if (sc.x + r < 0 || sc.x - r > cw || sc.y + r < 0 || sc.y - r > ch)\n            continue;\n          ctx.moveTo(sc.x + r, sc.y);\n          ctx.arc(sc.x, sc.y, r, 0, Math.PI * 2);\n        }\n\n        // Arcs\n        const arcs = batch.arcs;\n        for (let aIdx = 0; aIdx < arcs.length; aIdx++) {\n          const a = arcs[aIdx];\n          const r = a.radius * zoom;\n          if (r < 0.6) continue;\n          const sc = worldToScreen(a.center.x, a.center.y);\n          if (sc.x + r < 0 || sc.x - r > cw || sc.y + r < 0 || sc.y - r > ch)\n            continue;\n          const sRad = (-(a.startAngle + rotation) * Math.PI) / 180;\n          const eRad = (-(a.endAngle + rotation) * Math.PI) / 180;\n          ctx.moveTo(sc.x + Math.cos(sRad) * r, sc.y + Math.sin(sRad) * r);\n          ctx.arc(sc.x, sc.y, r, sRad, eRad, true);\n        }\n\n        // Ellipses"
