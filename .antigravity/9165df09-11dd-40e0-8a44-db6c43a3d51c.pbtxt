            }
            lines {
              text: "              (sx1 > cw && sx2 > cw) ||"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              (sy1 < 0 && sy2 < 0) ||"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              (sy1 > ch && sy2 > ch)"
