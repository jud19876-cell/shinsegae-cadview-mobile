    content: "\nexport const CADCanvas = forwardRef<CADCanvasHandle, CADCanvasProps>(({\n  theme,\n  mode,\n  showGrid,\n  enableOsnap,\n  textScale,\n  unitScaleFactor,\n  rotation,\n  camX,\n  camY,\n  zoom,\n  extents,\n  entities,\n  renderBatches,\n  textEntities,\n  rasterEntities,\n  layers,\n  selectedEntity,\n  measurements,\n  measurePoints,\n  isLoading,\n  loadingMessage,\n  recentDrawings = [],\n  onSelectRecentDrawing,\n  onOpenSelectModal,\n  onUpdateCamera,\n  onRotate90,\n  onSelectEntity,\n  onAddMeasurement,\n  onStartCalibration,\n  onClearMeasurements,\n  onCancelMode,\n  onOpenFileClick,\n  onLoadArchSample,\n  onLoadMechSample,\n  onUpdateMouseWorld,\n}, ref) => {\n  const containerRef = useRef<HTMLDivElement>(null);\n  const canvasRef = useRef<HTMLCanvasElement>(null);\n  const loupeWrapperRef = useRef<HTMLDivElement>(null);\n  const loupeCanvasRef = useRef<HTMLCanvasElement>(null);\n\n  const isDraggingRef = useRef(false);\n  const dragStartScreenRef = useRef({ x: 0, y: 0 });\n  const dragStartCamRef = useRef({ x: 0, y: 0 });\n  const pinchDistStartRef = useRef(0);\n  const tapStartPosRef = useRef({ x: 0, y: 0 });\n  const snapPointRef = useRef<SnapPoint | null>(null);\n\n  // Coordinate transforms\n  const worldToScreen = useCallback(\n    (wx: number, wy: number) => {\n      const c = canvasRef.current;\n      if (!c) return { x: 0, y: 0 };\n      const cw = c.width;\n      const ch = c.height;\n      const dx = wx - camX;\n      const dy = wy - camY;\n      const rad = (rotation * Math.PI) / 180;\n      const cosA = Math.cos(rad);"
