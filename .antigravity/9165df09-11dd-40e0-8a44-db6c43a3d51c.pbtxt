  view_file {
    absolute_path_uri: "file:///src/lib/modelExpander.ts"
    end_line: 199
    content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport {\n  ArcEntity,\n  CadBlock,\n  CadEntity,\n  CircleEntity,\n  DrawingModel,\n  EllipseEntity,\n  Extents2D,\n  LayerInfo,\n  LineEntity,\n  Point2D,\n  PolylineEntity,\n  RasterPreviewEntity,\n  RenderBatch,\n  TextEntity,\n} from \'../types/cad\';\nimport { resolveCadColorValue } from \'./cadColors\';\nimport { sanitizeCadEntity } from \'./cadSanitizer\';\n\nfunction multiplyAffine(\n  m1: [number, number, number, number, number, number],\n  m2: [number, number, number, number, number, number]\n): [number, number, number, number, number, number] {\n  return [\n    m1[0] * m2[0] + m1[2] * m2[1],\n    m1[1] * m2[0] + m1[3] * m2[1],\n    m1[0] * m2[2] + m1[2] * m2[3],\n    m1[1] * m2[2] + m1[3] * m2[3],\n    m1[0] * m2[4] + m1[2] * m2[5] + m1[4],\n    m1[1] * m2[4] + m1[3] * m2[5] + m1[5],\n  ];\n}\n\nfunction applyAffine(\n  m: [number, number, number, number, number, number],\n  pt: Point2D\n): Point2D {\n  return {\n    x: m[0] * pt.x + m[2] * pt.y + m[4],\n    y: m[1] * pt.x + m[3] * pt.y + m[5],\n  };\n}\n\nfunction transformAngleDeg(\n  m: [number, number, number, number, number, number],\n  deg: number\n): number {\n  const r = ((deg || 0) * Math.PI) / 180;\n  const vx = Math.cos(r);\n  const vy = Math.sin(r);\n  const wx = m[0] * vx + m[2] * vy;\n  const wy = m[1] * vx + m[3] * vy;\n  return (Math.atan2(wy, wx) * 180) / Math.PI;\n}\n\nexport function expandAndOptimizeDrawing(\n  model: DrawingModel,\n  theme: \'white\' | \'dark\' | \'blueprint\'\n): {\n  entities: CadEntity[];\n  layers: Record<string, LayerInfo>;\n  extents: Extents2D;\n  renderBatches: RenderBatch[];\n  textEntities: TextEntity[];\n  rasterEntities: RasterPreviewEntity[];\n} {\n  const blocks = model.blocks || {};\n  const blockLookupUpper: Record<string, CadBlock> = {};\n  Object.keys(blocks).forEach((k) => {\n    blockLookupUpper[k.toUpperCase()] = blocks[k];\n  });\n\n  function findBlock(name: string): CadBlock | null {\n    if (!name) return null;\n    return blocks[name] || blockLookupUpper[name.toUpperCase()] || null;\n  }\n\n  const layers: Record<string, LayerInfo> = {};\n  if (model.layers) {\n    Object.keys(model.layers).forEach((k) => {\n      const l = model.layers[k];\n      if (!l) return;\n      const aciVal = l.aci !== undefined ? l.aci : 7;\n      layers[k] = {\n        name: k,\n        aci: aciVal,\n        color: resolveCadColorValue(aciVal, theme),\n        visible: l.visible !== false,\n        count: 0,\n      };\n    });\n  }\n\n  const expanded: CadEntity[] = [];\n  const MAX_ENTITIES = 600000;\n\n  function expandList(\n    list: CadEntity[],\n    mat: [number, number, number, number, number, number],\n    parentLayer: string | null,\n    parentAci: number | null | undefined,\n    depth: number,\n    visited: Set<string>\n  ) {\n    if (!Array.isArray(list) || depth > 8 || expanded.length >= MAX_ENTITIES)\n      return;\n    const isIdentity =\n      mat[0] === 1 &&\n      mat[1] === 0 &&\n      mat[2] === 0 &&\n      mat[3] === 1 &&\n      mat[4] === 0 &&\n      mat[5] === 0;\n    const scaleFactor = Math.hypot(mat[0], mat[1]) || 1;\n    const det = mat[0] * mat[3] - mat[1] * mat[2];\n\n    for (let i = 0; i < list.length; i++) {\n      if (expanded.length >= MAX_ENTITIES) break;\n      const e = list[i];\n      if (!e) continue;\n\n      const effLayer =\n        e.layer === \'0\' && parentLayer ? parentLayer : e.layer || \'0\';\n      const effAci =\n        (e.aci === 0 || e.aci === null || e.aci === undefined) &&\n        parentAci !== null &&\n        parentAci !== undefined &&\n        parentAci !== 0 &&\n        parentAci !== 256\n          ? parentAci\n          : e.aci;\n\n      if (e.type === \'INSERT\' && e.blockName) {\n        const blk = findBlock(e.blockName);\n        if (\n          blk &&\n          blk.entities &&\n          blk.entities.length > 0 &&\n          !visited.has(blk.name)\n        ) {\n          const isDim = blk.name.toUpperCase().startsWith(\'*D\');\n          const bp = isDim ? { x: 0, y: 0 } : (blk.basePoint || { x: 0, y: 0 });\n          const ins = isDim ? { x: 0, y: 0 } : (e.position || { x: 0, y: 0 });\n          const sx = isDim ? 1 : (e.scaleX !== undefined && e.scaleX !== 0 ? e.scaleX : 1);\n          const sy = isDim ? 1 : (e.scaleY !== undefined && e.scaleY !== 0 ? e.scaleY : 1);\n          const rad = isDim ? 0 : (((e.rotation || 0) * Math.PI) / 180);\n          const cosA = Math.cos(rad);\n          const sinA = Math.sin(rad);\n          const a = cosA * sx;\n          const b = sinA * sx;\n          const c = -sinA * sy;\n          const d = cosA * sy;\n          const tx = ins.x - (a * bp.x + c * bp.y);\n          const ty = ins.y - (b * bp.x + d * bp.y);\n\n          const nextVisited = new Set(visited);\n          nextVisited.add(blk.name);\n          expandList(\n            blk.entities,\n            multiplyAffine(mat, [a, b, c, d, tx, ty]),\n            effLayer,\n            effAci,\n            depth + 1,\n            nextVisited\n          );\n          continue;\n        }\n      }\n\n      // eslint-disable-next-line @typescript-eslint/no-explicit-any\n      const clone: any = {\n        id: `${e.id}${depth > 0 ? `_${expanded.length}` : \'\'}`,\n        type: e.type,\n        layer: effLayer,\n        aci: effAci,\n        linetype: e.linetype || \'CONTINUOUS\',\n        lineweight: e.lineweight,\n      };\n\n      if (e.type === \'LINE\' && e.start && e.end) {\n        clone.start = isIdentity\n          ? { x: e.start.x, y: e.start.y }\n          : applyAffine(mat, e.start);\n        clone.end = isIdentity\n          ? { x: e.end.x, y: e.end.y }\n          : applyAffine(mat, e.end);\n      } else if (e.type === \'LWPOLYLINE\' && e.vertices) {\n        clone.closed = e.closed;\n        clone.vertices = isIdentity\n          ? e.vertices.map((v) => ({ x: v.x, y: v.y, bulge: v.bulge }))\n          : e.vertices.map((v) => {\n              const p = applyAffine(mat, v);\n              return { x: p.x, y: p.y, bulge: v.bulge };\n            });\n      } else if ((e.type === \'CIRCLE\' || e.type === \'ARC\') && e.center) {"
