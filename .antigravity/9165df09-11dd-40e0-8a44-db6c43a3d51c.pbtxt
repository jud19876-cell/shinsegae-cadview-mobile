            }
            lines {
              text: "  LineEntity,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  Point2D,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  PolylineEntity,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  Vertex2D,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "} from \'../types/cad\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "const MAX_COORD_ABS = 1e7;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "const MIN_GEOM_SPAN = 1e-4; // 0.0001 units: below this is a degenerate microscopic dot"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Validates whether a numerical coordinate is finite, non-NaN, and within sane CAD boundaries."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function isSaneCoord(v: unknown): v is number {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    typeof v === \'number\' &&"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    Number.isFinite(v) &&"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    !Number.isNaN(v) &&"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    Math.abs(v) <= MAX_COORD_ABS"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Validates a 2D point."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function isSanePoint(pt: unknown): pt is Point2D {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (!pt || typeof pt !== \'object\') return false;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const p = pt as Point2D;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return isSaneCoord(p.x) && isSaneCoord(p.y);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Sanitizes and validates a single CAD entity."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Returns null if the entity is degenerate, microscopic, or has infinite/invalid coordinates."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function sanitizeCadEntity(ent: CadEntity | null | undefined): CadEntity | null {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (!ent || !ent.type) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  switch (ent.type) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    case \'LINE\': {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const line = ent as LineEntity;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (!isSanePoint(line.start) || !isSanePoint(line.end)) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const dx = line.end.x - line.start.x;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const dy = line.end.y - line.start.y;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const len = Math.hypot(dx, dy);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Filter out zero-length lines / microscopic points"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (!Number.isFinite(len) || len < MIN_GEOM_SPAN) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Filter out astronomical infinite rays / overflow lines"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (len > MAX_COORD_ABS) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return line;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    case \'LWPOLYLINE\': {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const poly = ent as PolylineEntity;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (!Array.isArray(poly.vertices) || poly.vertices.length < 2) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const saneVerts: Vertex2D[] = [];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      let minX = Infinity,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        minY = Infinity,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        maxX = -Infinity,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        maxY = -Infinity;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      for (let i = 0; i < poly.vertices.length; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const v = poly.vertices[i];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (!v || !isSaneCoord(v.x) || !isSaneCoord(v.y)) continue;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // Skip consecutive duplicate vertices (microscopic zero-length segment)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (saneVerts.length > 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const prev = saneVerts[saneVerts.length - 1];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const dist = Math.hypot(v.x - prev.x, v.y - prev.y);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (dist < MIN_GEOM_SPAN) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // Keep bulge if present on the duplicate"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            if (v.bulge && !prev.bulge) prev.bulge = v.bulge;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            continue;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        saneVerts.push({"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          x: v.x,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          y: v.y,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          bulge: typeof v.bulge === \'number\' && Number.isFinite(v.bulge) ? v.bulge : undefined,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        });"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (v.x < minX) minX = v.x;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (v.y < minY) minY = v.y;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (v.x > maxX) maxX = v.x;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (v.y > maxY) maxY = v.y;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (saneVerts.length < 2) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Filter out polylines whose total bounding span is microscopic (noise/dots)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const spanW = maxX - minX;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const spanH = maxY - minY;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (Math.hypot(spanW, spanH) < MIN_GEOM_SPAN) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      poly.vertices = saneVerts;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return poly;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    case \'CIRCLE\': {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (!isSanePoint(ent.center)) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (!Number.isFinite(ent.radius) || ent.radius < MIN_GEOM_SPAN || ent.radius > MAX_COORD_ABS) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        return null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return ent;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    case \'ARC\': {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (!isSanePoint(ent.center)) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (!Number.isFinite(ent.radius) || ent.radius < MIN_GEOM_SPAN || ent.radius > MAX_COORD_ABS) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        return null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const sa = Number(ent.startAngle || 0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const ea = Number(ent.endAngle || 0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (!Number.isFinite(sa) || !Number.isFinite(ea)) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Normalize angles"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ent.startAngle = ((sa % 360) + 360) % 360;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ent.endAngle = ((ea % 360) + 360) % 360;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return ent;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    case \'ELLIPSE\': {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (!isSanePoint(ent.center) || !isSanePoint(ent.majorAxis)) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const majLen = Math.hypot(ent.majorAxis.x, ent.majorAxis.y);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (!Number.isFinite(majLen) || majLen < MIN_GEOM_SPAN || majLen > MAX_COORD_ABS) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        return null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      let ratio = Number(ent.axisRatio || 0.5);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (!Number.isFinite(ratio) || ratio <= 0) ratio = 0.5;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (ratio > 1) ratio = 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ent.axisRatio = ratio;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return ent;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    case \'TEXT\': {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (!isSanePoint(ent.position)) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      let h = Number(ent.height || 0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (!Number.isFinite(h) || h < MIN_GEOM_SPAN || h > MAX_COORD_ABS) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        h = 10;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ent.height = h;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (!Number.isFinite(ent.rotation)) ent.rotation = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (!ent.text || typeof ent.text !== \'string\' || !ent.text.trim()) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return ent;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    case \'INSERT\': {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (!isSanePoint(ent.position)) return null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (!ent.blockName || typeof ent.blockName !== \'string\') return null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      let sx = Number(ent.scaleX !== undefined ? ent.scaleX : 1);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      let sy = Number(ent.scaleY !== undefined ? ent.scaleY : 1);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (!Number.isFinite(sx) || Math.abs(sx) < 1e-7 || Math.abs(sx) > 1e6) sx = 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (!Number.isFinite(sy) || Math.abs(sy) < 1e-7 || Math.abs(sy) > 1e6) sy = 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ent.scaleX = sx;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ent.scaleY = sy;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (!Number.isFinite(ent.rotation)) ent.rotation = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return ent;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    case \'RASTER_PREVIEW\': {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return ent;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    default:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      return null;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Sanitizes an array of entities, removing microscopic or invalid items."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function sanitizeEntityList(list: CadEntity[]): CadEntity[] {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (!Array.isArray(list)) return [];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const result: CadEntity[] = [];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  for (let i = 0; i < list.length; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const s = sanitizeCadEntity(list[i]);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (s) result.push(s);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return result;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Preprocesses and sanitizes a complete DrawingModel, cleaning both top-level entities and block definitions."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " */"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function sanitizeDrawingModel(model: DrawingModel): DrawingModel {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (!model) return model;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Sanitize top-level entities"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const cleanEntities = sanitizeEntityList(model.entities || []);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Sanitize all block entities and base points"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const cleanBlocks: Record<string, CadBlock> = {};"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
