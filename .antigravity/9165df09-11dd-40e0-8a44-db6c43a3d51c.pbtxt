      arguments_json: "{\"CodeContent\":\"/**\\n * @license\\n * SPDX-License-Identifier: Apache-2.0\\n */\\n\\nimport { DrawingModel } from \'../types/cad\';\\n\\nexport function downloadBlobFile(\\n  filename: string,\\n  content: string,\\n  mime: string = \'text/html;charset=utf-8\'\\n): void {\\n  const blob = new Blob([content], { type: mime });\\n  const url = URL.createObjectURL(blob);\\n  const a = document.createElement(\'a\');\\n  a.href = url;\\n  a.download = filename;\\n  document.body.appendChild(a);\\n  a.click();\\n  document.body.removeChild(a);\\n  URL.revokeObjectURL(url);\\n}\\n\\nexport function buildStandaloneViewerHtml(\\n  embeddedModel: DrawingModel | null = null\\n): string {\\n  // If the user provided the attachment index_c6b94c45.html in public/assets/aistudio/, we can also use that pristine standalone version as the base template!\\n  const hasEmbedded = embeddedModel && embeddedModel.entities && embeddedModel.entities.length > 0;\\n  \\n  let embeddedJson = \'null\';\\n  if (hasEmbedded) {\\n    const cleanModel = {\\n      fileName: embeddedModel.fileName,\\n      formatVersion: embeddedModel.formatVersion,\\n      layers: embeddedModel.layers,\\n      blocks: embeddedModel.blocks || {},\\n      entities: embeddedModel.entities,\\n      extents: embeddedModel.extents,\\n    };\\n    embeddedJson = JSON.stringify(cleanModel).replace(/<\\\\/script>/gi, \'<\\\\\\\\/script>\');\\n  }\\n\\n  // We read the existing template if available or generate a pristine self-contained HTML\\n  const template = `<!DOCTYPE html>\\n<html lang=\\\"ko\\\" data-ui-theme=\\\"light\\\">\\n<head>\\n  <meta charset=\\\"UTF-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\\\">\\n  <title>CADView Mobile \342\200\224 \353\252\250\353\260\224\354\235\274 DWG / DXF \353\217\204\353\251\264 \353\267\260\354\226\264</title>\\n  <meta name=\\\"theme-color\\\" content=\\\"#1E3A8A\\\">\\n  <meta name=\\\"mobile-web-app-capable\\\" content=\\\"yes\\\">\\n  <meta name=\\\"apple-mobile-web-app-capable\\\" content=\\\"yes\\\">\\n  <meta name=\\\"apple-mobile-web-app-status-bar-style\\\" content=\\\"black-translucent\\\">\\n  <meta name=\\\"apple-mobile-web-app-title\\\" content=\\\"CAD \353\217\204\353\251\264\353\267\260\354\226\264\\\">\\n  <link rel=\\\"manifest\\\" href=\\\"manifest.json\\\">\\n  <script src=\\\"https://cdn.tailwindcss.com/3.4.17\\\"></script>\\n  <script src=\\\"https://cdn.jsdelivr.net/npm/lucide@0.460.0/dist/umd/lucide.min.js\\\"></script>\\n  <link rel=\\\"preconnect\\\" href=\\\"https://fonts.googleapis.com\\\">\\n  <link rel=\\\"preconnect\\\" href=\\\"https://fonts.gstatic.com\\\" crossorigin>\\n  <link href=\\\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Noto+Sans+KR:wght@400;500;600;700&display=swap\\\" rel=\\\"stylesheet\\\">\\n  <style>\\n    * { box-sizing: border-box; user-select: none; -webkit-user-select: none; }\\n    html, body {\\n      margin: 0; padding: 0;\\n      width: 100vw; height: 100vh; height: 100dvh;\\n      overflow: hidden;\\n      font-family: \'Inter\', \'Noto Sans KR\', sans-serif;\\n      touch-action: none;\\n      background-color: #F8F7F4;\\n      color: #0F172A;\\n    }\\n    .ci-burgundy-btn {\\n      background: #C8102E; border: 1px solid #9f0c24; color: #ffffff;\\n      box-shadow: 0 2px 6px rgba(200, 16, 46, 0.25);\\n    }\\n    .ci-navy-btn {\\n      background: #1E3A8A; border: 1px solid #172554; color: #ffffff;\\n      box-shadow: 0 2px 6px rgba(30, 58, 138, 0.25);\\n    }\\n  </style>\\n</head>\\n<body class=\\\"bg-[#F8F7F4] text-slate-900 flex flex-col w-screen h-screen overflow-hidden\\\">\\n  <div id=\\\"root\\\"></div>\\n  <script>\\n    window.__EMBEDDED_CAD_DATA__ = ${embeddedJson};\\n  </script>\\n</body>\\n</html>`;\\n\\n  return template;\\n}\\n\", \"Description\":\"Create standalone viewer export and blob downloader utility\", \"Overwrite\":true, \"TargetFile\":\"/src/lib/standaloneExport.ts\", \"toolAction\":\"Writing standaloneExport.ts\", \"toolSummary\":\"Create standalone export utility\"}"
      thinking_signature: "\022\226\006\n\223\006\001i\024}\023`,\vo\332\312psOG`\3530\237\2079\005 \2069\331Yu8I{\312<F\326\245\021\032\035\370O\256H\273?u\371\267\200\004s\f\206}\026\026Ov9\233~\257\201=-\030\334\375\025\357j\266\373=Ak\226~\202\335\035\234\312O\244\275q\025l\365\200\244\241%Q\a{\226{c+\002Wx={b\003\"h\035\020\"S\344\247y\234.F\330\231\354Y\3154HHy-L\355\334h\024\246\223\n\312\266\027_\0270kW,V\356\243\372;\233\205f\376\204\"\025\215\034K\362\005\324\371\022}$Q\245\227S\274\341\n\370;\374\251%\340\332o\004lz<.\005xA\371\367\264\236\027\350\2008\351o\357\243\024\"\200\266\212\334\001\242\336]\'VQ<D\r\212\345\337\337\002\271\215\302z\215\023$\303\bo\"\312\212N@\234\360\363\"\027v\365\276\301\277\224Q\344\235\367*<\314\221\256\216`\332{\215\364\311\306\200\'[\032\307\bb\357G\311\026\370\350\204\363!w\207\304\032\177Ql\b\234\205\r<3S\327`/\311\334\2475\215\333\0322k\300\367\344\232\030,\336\302\t\301:8\333\301\364\342\367\233\200\356\232\241\354\003\341Q\177\257P\201~J5)\025\276\335.\"\270\257\005\255IM\242\326bQ3\212c\031\365<]\035*C\347\241\327\321\363\016}\250\343\257`\304\3451\352\331\214F\031\235\037[FUJ\210\357\rNF\370C*\240k\266P_\032\335\272\357\331\232O\3748\320\023\350\236\355\205\006\367q$\2731&D\376\223\266\300\332r\3140<\270\ru\035\307I\373X\0050~\273\003i\027i\002\314\340\230b\020\274\301w\342\234\262xu\003\005\355\030\303C3\263F\025\326\002\261\270O7\246v\267D\026\036E\202\376\307)\305\003\2351\276U\371L\373P\347j$Q\203\031\\\213\227\0350\251\2246\024\024\363uX*8\340\"\374\223S\036\322w\032\224\353\307\320\"p\366\263<\266\v\273\271\204YE\352\316\2275\237J\030@P7\035\327t\032\005=\233\260\354\020\237\262\3372\221\a\2223\031\327m\271e\323\312\246\272\311k\3756\232=\315\321\255\213\262\336T\234\214\327\377ct\330\203>\271\365},\001\310N$\242\227\205\330\2325\016\3115\004\352F\025T4\304\277\235\312\212\030\207C\373\241\r\231\350S\377\265\201}:\333Y\320\344\320\311J\030S/\3451\234%\234D\266\203h\243-\\9\201\322\240\236\372v%6\231\210\315\301$