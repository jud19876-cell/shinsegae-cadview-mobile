            }
            lines {
              text: "  useEffect(() => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const container = containerRef.current;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
