n  // Synchronize HTML theme attribute\\n  useEffect(() => {\\n    document.documentElement.setAttribute(\\n      \'data-ui-theme\',\\n      theme === \'white\' ? \'light\' : \'dark\'\\n    );\\n  }, [theme]);\"},{\"AllowMultiple\":false,\"EndLine\":540,\"ReplacementContent\":\"      {/* 2. Universal Mode Bar (Hidden in Fullscreen Immersive Mode) */}\\n      {!isMenuHidden && (\\n        <UniversalModeBar\\n          zoom={zoom}\\n          mouseWorld={mouseWorld}\\n          unitScaleFactor={unitScaleFactor}\\n          theme={theme}\\n          themePreference={themePreference}\\n          textScale={textScale}\\n          onSetThemePreference={handleSetThemePreference}\\n          onTextScaleDown={() => setTextScale((s) => Math.max(0.25, +(s * 0.8).toFixed(2)))}\\n          onTextScaleUp={() => setTextScale((s) => Math.min(4.0, +(s * 1.25).toFixed(2)))}\\n        />\\n      )}\",\"StartLine\":527,\"TargetContent\":\"      {/* 2. Universal Mode Bar (Hidden in Fullscreen Immersive Mode) */}\\n      {!isMenuHidden && (\\n        <UniversalModeBar\\n          zoom={zoom}\\n          mouseWorld={mouseWorld}\\n          unitScaleFactor={unitScaleFactor}\\n          theme={theme}\\n          textScale={textScale}\\n          onSetTheme={setTheme}\\n          onTextScaleDown={() => setTextScale((s) => Math.max(0.25, +(s * 0.8).toFixed(2)))}\\n          onTextScaleUp={() => setTextScale((s) => Math.min(4.0, +(s * 1.25).toFixed(2)))}\\n        />\\n      )}\"}],\"TargetFile\":\"/src/App.tsx\",\"toolAction\":\"Updating theme preferences in App.tsx\",\"toolSummary\":\"Update theme preferences in App.tsx\"}"
