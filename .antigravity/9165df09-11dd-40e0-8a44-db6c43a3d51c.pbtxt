    content: "\n        {/* Body */}\n        <div className=\"p-4 space-y-4 overflow-y-auto custom-scrollbar text-xs text-slate-700 dark:text-slate-300 leading-relaxed\">\n          {/* Option 1: Direct Standalone HTML */}\n          <div className=\"p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 space-y-2\">\n            <div className=\"font-bold text-[#1E3A8A] dark:text-emerald-400 flex items-center justify-between\">\n              <span>\353\260\251\353\262\225 1. \353\213\250\354\235\274 \355\214\214\354\235\274(.html)\353\241\234 \353\260\233\354\225\204 \353\202\264 \355\217\260\354\227\220\354\204\234 \353\260\224\353\241\234 \354\223\260\352\270\260</span>\n              <span className=\"text-[10px] font-mono px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 font-bold\">\n                \354\204\244\354\271\230 \354\227\206\354\235\264 \353\260\224\353\241\234 \354\236\221\353\217\231\n              </span>\n            </div>\n            <p className=\"text-[11px] text-slate-500 dark:text-slate-400\">\n              \354\225\204\353\236\230 \353\262\204\355\212\274\354\235\204 \353\210\214\353\237\254 \354\231\204\354\204\261\353\220\234 <strong>index.html</strong> \355\214\214\354\235\274\354\235\204 \353\213\244\354\232\264\353\260\233\354\235\200 \355\233\204, \354\271\264\354\271\264\354\230\244\355\206\241(\353\202\230\354\231\200\354\235\230 \354\261\204\355\214\205)\354\235\264\353\202\230 \352\265\254\352\270\200 \353\223\234\353\235\274\354\235\264\353\270\214\353\241\234 \353\202\264 \354\212\244\353\247\210\355\212\270\355\217\260\354\227\220 \354\240\204\354\206\241\355\225\230\354\227\254 \355\201\254\353\241\254 \353\270\214\353\235\274\354\232\260\354\240\200\353\241\234 \354\227\264\353\251\264 \354\204\234\353\262\204 \354\227\206\354\235\264 \354\246\211\354\213\234 \353\217\204\353\251\264\354\235\204 \353\263\274 \354\210\230 \354\236\210\354\212\265\353\213