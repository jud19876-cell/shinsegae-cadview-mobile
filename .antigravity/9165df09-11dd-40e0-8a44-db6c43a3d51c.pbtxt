  planner_response {
    response: "\354\212\244\353\247\210\355\212\270\355\217\260\354\227\220\354\204\234 **.DWG** \353\260\217 **.DXF** \353\217\204\353\251\264\354\235\204 \354\204\234\353\262\204 \354\240\204\354\206\241 \354\227\206\354\235\264 100% \352\270\260\352\270\260 \353\202\264\353\266\200\354\227\220\354\204\234 \354\264\210\352\263\240\354\206\215\354\234\274\353\241\234 \354\227\264\352\263\240, \352\260\234\354\235\270 \353\260\260\355\217\254 \353\260\217 \354\225\261 \354\204\244\354\271\230\352\260\200 \352\260\200\353\212\245\355\225\230\353\217\204\353\241\235 **CADView Mobile** \354\225\261\354\235\204 \354\231\204\354\204\261\355\226\210\354\212\265\353\213\210\353\213\244.\n\n---\n\n### \360\237\223\261 \354\243\274\354\232\224 \352\270\260\353\212\245 \353\260\217 \354\212\244\353\247\210\355\212\270\355\217\260 \354\265\234\354\240\201\355\231\224\n\n1. **\354\264\210\352\263\240\354\206\215 \352\270\260\352\270\260 \353\202\264 \353\217\204\353\251\264 \355\225\264\353\217\205 (\354\204\234\353\262\204 \353\266\210\355\225\204\354\232\224)**\n   - **DWG \354\247\200\354\233\220**: LibreDWG WebAssembly \354\227\224\354\247\204\354\235\204 \355\203\221\354\236\254\355\225\230\354\227\254 AutoCAD 2000~2018+ DWG \353\260\224\354\235\264\353\204\210\353\246\254 \354\212\244\355\212\270\353\246\274\354\235\204 \352\270\260\352\270\260 \353\202\264\354\227\220\354\204\234 \354\246\211\354\213\234 \355\214\214\354\213\261\n   - **DXF \354\247\200\354\233\220**: \354\204\240(LINE), \355\217\264\353\246\254\353\235\274\354\235\270(LWPOLYLINE), \354\233\220/\355\230\270(CIRCLE/ARC), \355\203\200\354\233\220, \353\270\224\353\241\235(INSERT), \354\271\230\354\210\230\354\204\240(DIMENSION), \355\225\264\354\271\230, \354\212\244\355\224\214\353\235\274\354\235\270 \354\240\204\353\251\264 \354\247\200\354\233\220\n   - **\355\225\234\352\270\200 \354\231\204\353\262\275 \354\247\200\354\233\220**: EUC-KR / UTF-8 \354\236\220\353\217\231 \352\260\220\354\247\200 \353\260\217 AutoCAD \355\212\271\354\210\230 \352\270\260\355\230\270(`%%c` $\\rightarrow$ `\303\230`, `\\P` $\\rightarrow$ \354\244\204\353\260\224\352\277\210 \353\223\261) \353\263\265\354\233\220\n   - **OCS/WCS \353\260\230\354\240\204 \354\242\214\355\221\234 \353\263\264\354\240\225**: \353\257\270\353\237\254 \353\263\265\354\202\254\353\220\234 \353\270\224\353\241\235\354\235\264\353\202\230 \354\235\214\354\210\230 \353\262\225\354\204\240 \353\262\241\355\204\260(`extrusion.z = -1`) \352\260\235\354\262\264\353\217\204 \354\240\234\354\236\220\353\246\254 \354\234\204\354\271\230\354\227\220 \354\240\225\355\231\225\355\236\210 \353\240\214\353\215\224\353\247\201\n\n2. **\353\252\250\353\260\224\354\235\274 \354\240\204\354\232\251 \355\204\260\354\271\230 UX & \354\240\225\353\260\200 \352\263\204\354\270\241**\n   - **60FPS \355\225\230\353\223\234\354\233\250\354\226\264 \352\260\200\354\206\215**: \353\240\210\354\235\264\354\226\264\302\267\354\203\211\354\203\201\353\263\204 `Float32Array` \354\242\214\355\221\234 \353\260\260\354\271\230\353\241\234 \354\240\200\354\202\254\354\226\221 \355\217\260\354\227\220\354\204\234\353\217\204 \353\266\200\353\223\234\353\237\254\354\232\264 \355\225\200\354\271\230 \354\244\214 & \355\214\254\n   - **\354\236\220\354\204\235 \354\212\244\353\203\205(OSNAP) & \354\240\225\353\260\200 \355\204\260\354\271\230 \353\243\250\355\216\230(\353\217\213\353\263\264\352\270\260)**: \354\206\220\352\260\200\353\235\275\354\234\274\353\241\234 \355\231\224\353\251\264\354\235\204 \352\260\200\353\246\254\354\247\200 \354\225\212\353\217\204\353\241\235 \355\204\260\354\271\230 \354\247\200\354\240\220 \354\203\201\353\213\250\354\227\220 2.5\353\260\260 \355\231\225\353\214\200 \354\233\220\355\230\225 \353\240\214\354\246\210 \355\221\234\354\213\234\n   - **2\354\240\220 \352\270\260\354\244\200 \354\266\225\354\262\231(Scale) \352\265\220\354\240\225**: \353\217\204\353\251\264 \354\271\230\354\210\230\354\204\240(\354\230\210: 6000mm)\354\235\204 \354\236\205\353\240\245\355\225\230\353\251\264 \353\252\250\353\223\240 \354\270\241\354\240\225\352\260\222\354\235\204 1:1 \354\213\244\354\240\234 \354\271\230\354\210\230\353\241\234 \354\236\220\353\217\231 \355\231\230\354\202\260\n   - **\353\240\210\354\235\264\354\226\264 \354\240\234\354\226\264 & \353\254\270\354\236\220 \352\262\200\354\203\211**: \353\240\210\354\235\264\354\226\264\353\263\204 \354\274\234\352\270\260/\353\201\204\352\270\260 \353\260\217 \353\217\204\353\251\264 \353\202\264 \354\204\244\353\271\204\353\252\205\302\267\353\266\200\355\222\210\353\262\210\355\230\270 \352\262\200\354\203\211 \355\233\204 \355\225\264\353\213\271 \354\234\204\354\271\230\353\241\234 \354\236\220\353\217\231 \354\271\264\353\251\224\353\235\274 \354\240\220\355\224\204\n   - **3\352\260\200\354\247\200 \355\205\214\353\247\210**: \353\260\261\354\247\200(\354\206\214\355\224\204\355\212\270 \354\225\204\354\235\264\353\263\264\353\246\254), \353\213\244\355\201\254(AutoCAD \355\221\234\354\244\200), \354\262\255\354\202\254\354\247\204(\354\227\224\354\247\200\353\213\210\354\226\264\353\247\201 \353\270\224\353\243\250)\n\n3. **\352\260\234\354\235\270 \353\260\260\355\217\254 & \354\212\244\353\247\210\355\212\270\355\217\260 \354\225\261 \354\204\244\354\271\230 (PWA / APK)**\n   - **\353\260\251\353\262\225 1. \353\213\250\354\235\274 \355\214\214\354\235\274(.html) \353\213\244\354\232\264\353\241\234\353\223\234**: \354\203\201\353\213\250 [\355\217\260 \354\204\244\354\271\230\302\267\353\260\260\355\217\254] $\\rightarrow$ [\353\267\260\354\226\264 \355\214\214\354\235\274 \353\213\244\354\232\264\353\241\234\353\223\234]\353\245\274 \353\210\214\353\237\254 `index.html` \355\214\214\354\235\274\354\235\204 \354\271\264\354\271\264\354\230\244\355\206\241\354\235\264\353\202\230 \355\201\264\353\235\274\354\232\260\353\223\234\353\241\234 \353\202\264 \355\217\260\354\227\220 \353\263\264\353\202\270 \353\222\244 \355\201\254\353\241\254\354\234\274\353\241\234 \354\227\264\353\251\264 \354\235\270\355\204\260\353\204\267 \354\227\206\354\235\264\353\217\204 \354\230\201\352\265\254 \354\202\254\354\232\251 \352\260\200\353\212\245\n   - **\353\260\251\353\262\225 2. \354\212\244\353\247\210\355\212\270\355\217\260 \355\231\210 \355\231\224\353\251\264 \354\225\261(PWA) \354\204\244\354\271\230**: \353\270\214\353\235\274\354\232\260\354\240\200 \354\203\201\353\213\250 [\354\225\261 \354\204\244\354\271\230] \353\262\204\355\212\274 \353\230\220\353\212\224 \353\251\224\353\211\264(\342\213\256) $\\rightarrow$ **[\354\225\261 \354\204\244\354\271\230 / \355\231\210 \355\231\224\353\251\264\354\227\220 \354\266\224\352\260\200]**\353\245\274 \353\210\204\353\245\264\353\251\264 \355\231\210 \355\231\224\353\251\264\354\227\220 \354\213\244\354\240\234 \354\225\261 \354\225\204\354\235\264\354\275\230\354\235\264 \354\203\235\354\204\261\353\220\230\352\263\240 \354\240\204\354\262\264 \355\231\224\353\251\264 \354\225\261\354\234\274\353\241\234 \352\265\254\353\217\231\n   - **\353\260\251\353\262\225 3. \354\225\210\353\223\234\353\241\234\354\235\264\353\223\234 \354\210\234\354\240\225 .APK \355\214\214\354\235\274 \354\266\224\354\266\234**: \353\252\250\353\213\254\354\227\220\354\204\234 \354\240\234\352\263\265\353\220\230\353\212\224 \354\243\274\354\206\214\353\245\274 \353\263\265\354\202\254\355\225\230\354\227\254 PWABuilder\354\227\220 \354\236\205\353\240\245\355\225\230\353\251\264 1\353\266\204 \353\247\214\354\227\220 \354\204\244\354\271\230\354\232\251 `.apk` \355\214\214\354\235\274 \354\203\235\354\204\261\n   - **\353\260\251\353\262\225 4. \355\230\204\354\236\254 \353\217\204\353\251\264 \353\202\264\354\236\245 HTML \354\240\200\354\236\245**: \354\227\264\353\246\260 \353\217\204\353\251\264 \353\215\260\354\235\264\355\204\260\353\245\274 HTML \354\275\224\353\223\234 \354\225\210\354\227\220 \354\213\254\354\226\264\354\204\234 \354\240\200\354\236\245\355\225\230\353\257\200\353\241\234, \353\217\231\353\243\214\353\202\230 \355\230\204\354\236\245 \354\236\221\354\227\205\354\236\220\354\227\220\352\262\214 \354\240\204\354\206\241 \354\213\234 \355\201\264\353\246\255 \355\225\234 \353\262\210\354\234\274\353\241\234 \353\217\204\353\251\264\354\235\264 \353\260\224\353\241\234 \354\227\264\353\246\275\353\213\210\353\213\244."
