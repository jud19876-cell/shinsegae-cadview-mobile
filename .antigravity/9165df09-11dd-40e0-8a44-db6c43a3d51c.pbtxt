        target_content: "        if (noRot) {\n          for (let i = 0; i < coords.length; i += 4) {\n            const sx1 = halfW + (coords[i] - camX) * zoom;\n            const sy1 = halfH - (coords[i + 1] - camY) * zoom;\n            const sx2 = halfW + (coords[i + 2] - camX) * zoom;\n            const sy2 = halfH - (coords[i + 3] - camY) * zoom;\n            if (\n              (sx1 < 0 && sx2 < 0) ||\n              (sx1 > cw && sx2 > cw) ||\n              (sy1 < 0 && sy2 < 0) ||\n              (sy1 > ch && sy2 > ch)\n            )\n              continue;\n            ctx.moveTo(sx1, sy1);\n            ctx.lineTo(sx2, sy2);\n          }\n        } else {\n          for (let i = 0; i < coords.length; i += 4) {\n            const dx1 = coords[i] - camX;\n            const dy1 = coords[i + 1] - camY;\n            const sx1 = halfW + (dx1 * cosA - dy1 * sinA) * zoom;\n            const sy1 = halfH - (dx1 * sinA + dy1 * cosA) * zoom;\n            const dx2 = coords[i + 2] - camX;\n            const dy2 = coords[i + 3] - camY;\n            const sx2 = halfW + (dx2 * cosA - dy2 * sinA) * zoom;\n            const sy2 = halfH - (dx2 * sinA + dy2 * cosA) * zoom;\n            ctx.moveTo(sx1, sy1);\n            ctx.lineTo(sx2, sy2);\n          }\n        }\n\n        // Polylines\n        const polys = batch.polylines;\n        for (let pIdx = 0; pIdx < polys.length; pIdx++) {\n          const verts = polys[pIdx].vertices;\n          if (verts.length < 2) continue;\n          const v0 = verts[0];\n          if (!isFinite(v0.x) || !isFinite(v0.y)) continue;\n          const s0 = worldToScreen(v0.x, v0.y);\n          if (!isFinite(s0.x) || !isFinite(s0.y)) continue;\n          ctx.moveTo(s0.x, s0.y);\n          for (let k = 1; k < verts.length; k++) {\n            const vk = verts[k];\n            if (!isFinite(vk.x) || !isFinite(vk.y)) continue;\n            const sk = worldToScreen(vk.x, vk.y);\n            if (!isFinite(sk.x) || !isFinite(sk.y)) continue;\n            ctx.lineTo(sk.x, sk.y);\n          }\n          if (polys[pIdx].closed) ctx.closePath();\n        }"
        replacement_content: "        if (noRot) {\n          for (let i = 0; i < coords.length; i += 4) {\n            const x1 = coords[i];\n            const y1 = coords[i + 1];\n            const x2 = coords[i + 2];\n            const y2 = coords[i + 3];\n            const adx = Math.abs(x2 - x1);\n            const ady = Math.abs(y2 - y1);\n            // Drop anomalous diagonal streaks crossing between machines/views\n            if (adx > 80 && ady > 80 && Math.hypot(adx, ady) > 500) continue;\n\n            const sx1 = halfW + (x1 - camX) * zoom;\n            const sy1 = halfH - (y1 - camY) * zoom;\n            const sx2 = halfW + (x2 - camX) * zoom;\n            const sy2 = halfH - (y2 - camY) * zoom;\n            if (\n              (sx1 < 0 && sx2 < 0) ||\n              (sx1 > cw && sx2 > cw) ||\n              (sy1 < 0 && sy2 < 0) ||\n              (sy1 > ch && sy2 > ch)\n            )\n              continue;\n            ctx.moveTo(sx1, sy1);\n            ctx.lineTo(sx2, sy2);\n          }\n        } else {\n          for (let i = 0; i < coords.length; i += 4) {\n            const x1 = coords[i];\n            const y1 = coords[i + 1];\n            const x2 = coords[i + 2];\n            const y2 = coords[i + 3];\n            const adx = Math.abs(x2 - x1);\n            const ady = Math.abs(y2 - y1);\n            if (adx > 80 && ady > 80 && Math.hypot(adx, ady) > 500) continue;\n\n            const dx1 = x1 - camX;\n            const dy1 = y1 - camY;\n            const sx1 = halfW + (dx1 * cosA - dy1 * sinA) * zoom;\n            const sy1 = halfH - (dx1 * sinA + dy1 * cosA) * zoom;\n            const dx2 = x2 - camX;\n            const dy2 = y2 - camY;\n            const sx2 = halfW + (dx2 * cosA - dy2 * sinA) * zoom;\n            const sy2 = halfH - (dx2 * sinA + dy2 * cosA) * zoom;\n            ctx.moveTo(sx1, sy1);\n            ctx.lineTo(sx2, sy2);\n          }\n        }\n\n        // Polylines\n        const polys = batch.polylines;\n        for (let pIdx = 0; pIdx < polys.length; pIdx++) {\n          const verts = polys[pIdx].vertices;\n          if (verts.length < 2) continue;\n          const v0 = verts[0];\n          if (!isFinite(v0.x) || !isFinite(v0.y)) continue;\n          const s0 = worldToScreen(v0.x, v0.y);\n          if (!isFinite(s0.x) || !isFinite(s0.y)) continue;\n          ctx.moveTo(s0.x, s0.y);\n          for (let k = 1; k < verts.length; k++) {\n            const vk = verts[k];\n            const vp = verts[k - 1];\n            if (!isFinite(vk.x) || !isFinite(vk.y)) continue;\n            const sk = worldToScreen(vk.x, vk.y);\n            if (!isFinite(sk.x) || !isFinite(sk.y)) continue;\n\n            const segDx = Math.abs(vk.x - vp.x);\n            const segDy = Math.abs(vk.y - vp.y);\n            // If segment is an anomalous diagonal leap across views, jump instead of drawing a line\n            if (segDx > 80 && segDy > 80 && Math.hypot(segDx, segDy) > 500) {\n              ctx.moveTo(sk.x, sk.y);\n            } else {\n              ctx.lineTo(sk.x, sk.y);\n            }\n          }\n          if (polys[pIdx].closed) {\n            const lastV = verts[verts.length - 1];\n            const cDx = Math.abs(lastV.x - v0.x);\n            const cDy = Math.abs(lastV.y - v0.y);\n            if (!(cDx > 80 && cDy > 80 && Math.hypot(cDx, cDy) > 500)) {\n              ctx.closePath();\n            }\n          }\n        }"
