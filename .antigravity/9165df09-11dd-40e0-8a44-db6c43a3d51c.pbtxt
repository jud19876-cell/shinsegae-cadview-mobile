    content: "            <path d=\"M20 27.5L29.5 33.75L20 40L10.5 33.75L20 27.5Z\" fill=\"#0061FF\"/>\n          </svg>\n          <span>Dropbox</span>\n          {dropboxAccount && (\n            <span className=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\" />\n          )}\n        </button>\n      </div>\n\n      {/* ========================================================================= */}\n      {/* GOOGLE DRIVE PANEL */}\n      {/* ========================================================================= */}\n      {provider === \'google\' && (\n        <div className=\"space-y-4 flex-1 flex flex-col min-h-0\">\n          {/* Auth Bar */}\n          {!googleUser ? (\n            <div className=\"p-4 rounded-xl bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-slate-800/80 dark:to-blue-950/40 border border-blue-200 dark:border-blue-900/50 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left\">\n              <div className=\"space-y-1\">\n                <div className=\"flex items-center justify-center sm:justify-start gap-1.5 text-xs font-bold text-[#1E3A8A] dark:text-blue-300\">\n                  <ShieldCheck className=\"w-4 h-4 text-emerald-600 dark:text-emerald-400\" />\n                  <span>Google Workspace \352\263\265\354\213\235 OAuth \354\227\260\353\217\231</span>\n                </div>\n                <p className=\"text-xs text-slate-600 dark:text-slate-300\">\n                  Google \352\263\204\354\240\225\354\234\274\353\241\234 \353\241\234\352\267\270\354\235\270\355\225\230\354\227\254 \353\202\264 \353\223\234\353\235\274\354\235\264\353\270\214\354\235\230 DWG/DXF \353\217\204\353\251\264\354\235\204 \354\247\201\354\240\221 \352\262\200\354\203\211\355\225\230\352\263\240 \354\227\275\353\213\210\353\213\244.\n                </p>\n              </div>\n              <button\n                onClick={handleGoogleSignIn}\n                disabled={isGoogleLoading}\n                className=\"w-full sm:w-auto bg-[#1E3A8A] hover:bg-[#172e6e] text-white px-4 py-2.5 rounded-xl text-xs font-bold flex items-center justify-center gap-2 active:scale-95 transition shadow-sm shrink-0 disabled:opacity-50\"\n              >\n                <LogIn className=\"w-4 h-4\" />\n                <span>Google Drive \353\241\234\352\267\270\354\235\270</span>\n              </button>\n            </div>\n          ) : (\n            <div className=\"p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 flex items-center justify-between gap-2\">\n              <div className=\"flex items-center gap-2.5 min-w-0\">\n                {googleUser.photoURL ? (\n                  <img\n                    src={googleUser.photoURL}\n                    alt={googleUser.displayName || \'\'}\n                    className=\"w-8 h-8 rounded-full border border-blue-300\"\n                  />\n                ) : (\n                  <div className=\"w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-xs flex items-center justify-center\">\n                    {(googleUser.displayName || googleUser.email || \'G\')[0].toUpperCase()}\n                  </div>\n                )}\n                <div className=\"min-w-0\">\n                  <div className=\"text-xs font-bold text-slate-800 dark:text-white truncate\">\n                    {googleUser.displayName || \'Google \354\202\254\354\232\251\354\236\220\'}\n                  </div>\n                  <div className=\"text-[10px] text-slate-500 dark:text-slate-400 truncate\">\n                    {googleUser.email}\n                  </div>\n                </div>\n              </div>\n              <div className=\"flex items-center gap-1.5 shrink-0\">\n                <button\n                  onClick={() => loadGoogleFiles(googleSearchQuery)}\n                  disabled={isGoogleLoading}\n                  className=\"p-1.5 rounded-lg bg-white dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 border border-slate-200 dark:border-slate-600 transition\"\n                  title=\"\355\214\214\354\235\274 \353\252\251\353\241\235 \354\203\210\353\241\234\352\263\240\354\271\250\"\n                >\n                  <RefreshCw className={`w-3.5 h-3.5 ${isGoogleLoading ? \'animate-spin\' : \'\'}`} />\n                </button>\n                <button\n                  onClick={handleGoogleSignOut}\n                  className=\"px-2.5 py-1.5 rounded-lg text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/30 text-xs font-semibold flex items-center gap-1 transition\"\n                  title=\"\353\241\234\352\267\270\354\225\204\354\233\203\"\n                >\n                  <LogOut className=\"w-3.5 h-3.5\" />\n                  <span className=\"hidden sm:inline\">\353\241\234\352\267\270\354\225\204\354\233\203</span>\n                </button>\n              </div>\n            </div>\n          )}\n\n          {/* Search Bar (Enabled if logged in) */}\n          {googleUser && (\n            <div className=\"relative\">\n              <input\n                type=\"text\"\n                placeholder=\"Google Drive \353\202\264 DWG / DXF \355\214\214\354\235\274\353\252\205 \352\262\200\354\203\211...\"\n                value={googleSearchQuery}\n                onChange={(e) => setGoogleSearchQuery(e.target.value)}\n                onKeyDown={(e) => {\n                  if (e.key === \'Enter\') {\n                    loadGoogleFiles(googleSearchQuery);\n                  }\n                }}\n                className=\"w-full pl-9 pr-16 py-2 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-[#1E3A8A]\"\n              />\n              <Search className=\"w-4 h-4 text-slate-400 absolute left-3 top-2.5\" />\n              <button\n                onClick={() => loadGoogleFiles(googleSearchQuery)}\n                className=\"absolute right-1.5 top-1.5 bg-[#1E3A8A] text-white px-2 py-1 rounded-lg text-[10px] font-bold\"\n              >\n                \352\262\200\354\203\211\n              </button>\n            </div>\n          )}\n\n          {/* Google Error Message */}\n          {googleError && (\n            <div className=\"p-3 rounded-xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-900/50 text-xs text-rose-700 dark:text-rose-300 flex items-center gap-2\">\n              <AlertCircle className=\"w-4 h-4 shrink-0\" />\n              <span>{googleError}</span>\n            </div>\n          )}\n\n          {/* Google Files List */}\n          <div className=\"flex-1 overflow-y-auto space-y-2 min-h-[180px] custom-scrollbar\">\n            {isGoogleLoading ? (\n              <div className=\"py-12 flex flex-col items-center justify-center text-slate-400 text-center space-y-2\">\n                <div className=\"w-8 h-8 rounded-full border-3 border-[#1E3A8A]/30 border-t-[#1E3A8A] animate-spin\" />\n                <p className=\"text-xs font-semibold\">{googleLoadingAction || \'\353\241\234\353\224\251 \354\244\221...\'}</p>\n              </div>\n            ) : !googleUser ? (\n              <div className=\"py-12 text-center text-slate-400 space-y-2 border border-dashed border-slate-200 dark:border-slate-800 rounded-2xl p-6\">\n                <Cloud className=\"w-10 h-10 mx-auto text-[#1E3A8A] dark:text-blue-400 opacity-60\" />\n                <div className=\"text-xs font-bold text-slate-700 dark:text-slate-200\">\n                  Google Drive\354\227\220 \354\227\260\352\262\260\353\220\230\354\247\200 \354\225\212\354\225\230\354\212\265\353\213\210\353\213\244\n                </div>\n                <p className=\"text-[11px] text-slate-500 max-w-sm mx-auto\">\n                  \354\203\201\353\213\250\354\235\230 [Google Drive \353\241\234\352\267\270\354\235\270] \353\262\204\355\212\274\354\235\204 \353\210\214\353\237\254 \352\263\204\354\240\225\354\235\204 \354\227\260\352\262\260\355\225\230\353\251\264 \353\223\234\353\235\274\354\235\264\353\270\214 \353\202\264 \353\252\250\353\223\240 CAD \353\217\204\353\251\264\354\235\204 \354\246\211\354\213\234 \354\227\264 \354\210\230 \354\236\210\354\212\265\353\213\210\353\213\244.\n                </p>\n              </div>\n            ) : googleFiles.length === 0 ? (\n              <div className=\"py-12 text-center text-slate-400 space-y-2 border border-dashed border-slate-200 dark:border-slate-800 rounded-2xl p-6\">\n                <FileCode className=\"w-10 h-10 mx-auto text-slate-300 dark:text-slate-600\" />\n                <div className=\"text-xs font-bold text-slate-700 dark:text-slate-200\">\n                  {googleSearchQuery ? `\'${googleSearchQuery}\' \352\262\200\354\203\211 \352\262\260\352\263\274\352\260\200 \354\227\206\354\212\265\353\213\210\353\213\244` : \'Google Drive\354\227\220 DWG/DXF \355\214\214\354\235\274\354\235\264 \354\227\206\354\212\265\353\213\210\353\213\244\'}\n                </div>\n                <p className=\"text-[11px] text-slate-500 max-w-sm mx-auto\">\n                  Google Drive\354\227\220 .dwg \353\230\220\353\212\224 .dxf \355\214\214\354\235\274\354\235\204 \354\227\205\353\241\234\353\223\234\355\225\234 \355\233\204 \354\232\260\354\270\241 \354\203\201\353\213\250\354\235\230 \354\203\210\353\241\234\352\263\240\354\271\250 \353\262\204\355\212\274\354\235\204 \353\210\214\353\237\254\354\243\274\354\204\270\354\232\224.\n                </p>\n              </div>\n            ) : (\n              <div className=\"space-y-1.5\">\n                <div className=\"text-[11px] font-bold text-slate-500 dark:text-slate-400 px-1 flex items-center justify-between\">\n                  <span>\352\262\200\354\203\211\353\220\234 \353\217\204\353\251\264 ({googleFiles.length}\352\260\234)</span>\n                  <span>\355\201\264\353\246\255 \354\213\234 \354\246\211\354\213\234 \354\227\264\352\270\260</span>\n                </div>\n                {googleFiles.map((file) => {\n                  const isDwg = file.name.toLowerCase().endsWith(\'.dwg\');\n                  return (\n                    <div\n                      key={file.id}\n                      onClick={() => handleSelectGoogleFile(file)}"
