      create_file {
        instruction: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React from \'react\';\nimport { X, Building, Cog, Trash2 } from \'lucide-react\';\n\ninterface SamplesModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onLoadArchSample: () => void;\n  onLoadMechSample: () => void;\n  onClearCanvas: () => void;\n}\n\nexport const SamplesModal: React.FC<SamplesModalProps> = ({\n  isOpen,\n  onClose,\n  onLoadArchSample,\n  onLoadMechSample,\n  onClearCanvas,\n}) => {\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 bg-black/60 backdrop-blur-xs z-50 flex items-end sm:items-center justify-center p-0 sm:p-4\">\n      <div className=\"bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-800 w-full sm:max-w-md rounded-t-2xl sm:rounded-2xl p-4 shadow-2xl space-y-3\">\n        <div className=\"flex items-center justify-between pb-2 border-b border-slate-200 dark:border-slate-800\">\n          <h3 className=\"text-sm font-bold text-slate-900 dark:text-white\">\n            \354\203\230\355\224\214 \353\217\204\353\251\264 \353\260\217 \353\251\224\353\252\250\353\246\254 \354\264\210\352\270\260\355\231\224\n          </h3>\n          <button\n            onClick={onClose}\n            className=\"text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 p-1\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        <p className=\"text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed\">\n          \354\203\210 \353\217\204\353\251\264\354\235\204 \354\227\264 \353\225\214 \352\270\260\354\241\264 \353\217\204\353\251\264\352\263\274 \352\262\271\354\271\230\354\247\200 \354\225\212\353\217\204\353\241\235 \353\251\224\353\252\250\353\246\254\353\245\274 \354\225\210\354\240\204\355\225\230\352\262\214 \354\264\210\352\270\260\355\231\224\355\225\234 \355\233\204 \353\266\210\353\237\254\354\230\265\353\213\210\353\213\244.\n        </p>\n\n        <div className=\"space-y-2\">\n          {/* Architectural Sample */}\n          <button\n            onClick={() => {\n              onLoadArchSample();\n              onClose();\n            }}\n            className=\"w-full text-left p-3 rounded-xl bg-slate-50 hover:bg-slate-100 dark:bg-slate-800/80 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700/70 flex items-center gap-3 transition\"\n          >\n            <div className=\"w-9 h-9 rounded-lg bg-[#1E3A8A]/10 text-[#1E3A8A] flex items-center justify-center font-bold\">\n              <Building className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <div className=\"text-xs font-bold text-slate-800 dark:text-white\">\n                \354\230\244\355\224\274\354\212\244 \352\261\264\354\266\225 \355\217\211\353\251\264\353\217\204 \354\203\230\355\224\214 (A-101.dwg)\n              </div>\n              <div className=\"text-[11px] text-slate-500 dark:text-slate-400\">\n                \353\214\200\355\232\214\354\235\230\354\213\244, R&D \354\227\260\352\265\254\354\206\214, \354\204\234\353\262\204\354\213\244, \353\262\275\354\262\264, \354\260\275\355\230\270 \353\260\217 \354\271\230\354\210\230\354\204\240\n              </div>\n            </div>\n          </button>\n\n          {/* Mechanical Sample */}\n          <button\n            onClick={() => {\n              onLoadMechSample();\n              onClose();\n            }}\n            className=\"w-full text-left p-3 rounded-xl bg-slate-50 hover:bg-slate-100 dark:bg-slate-800/80 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700/70 flex items-center gap-3 transition\"\n          >\n            <div className=\"w-9 h-9 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold\">\n              <Cog className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <div className=\"text-xs font-bold text-slate-800 dark:text-white\">\n                \354\240\225\353\260\200 \352\270\260\352\263\204 \355\224\214\353\236\234\354\247\200 \354\241\260\353\246\275\353\217\204 (M-204.dwg)\n              </div>\n              <div className=\"text-[11px] text-slate-500 dark:text-slate-400\">\n                \354\231\270\355\230\225\354\204\240, \354\244\221\354\213\254\354\204\240, PCD \303\230360 \353\263\274\355\212\270 \355\231\200 \353\260\217 \354\240\225\353\260\200 \354\271\230\354\210\230\n              </div>\n            </div>\n          </button>\n\n          {/* Clear Canvas */}\n          <button\n            onClick={() => {\n              onClearCanvas();\n              onClose();\n            }}\n            className=\"w-full text-left p-3 rounded-xl bg-rose-50 hover:bg-rose-100 dark:bg-[#C8102E]/10 dark:hover:bg-[#C8102E]/20 border border-rose-200 dark:border-[#C8102E]/30 flex items-center gap-3 transition\"\n          >\n            <div className=\"w-9 h-9 rounded-lg bg-[#C8102E] text-white flex items-center justify-center font-bold\">\n              <Trash2 className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <div className=\"text-xs font-bold text-[#C8102E]\">\n                \355\230\204\354\236\254 \353\217\204\353\251\264 \353\213\253\352\270\260 (\355\231\224\353\251\264 \353\271\204\354\232\260\352\270\260)\n              </div>\n              <div className=\"text-[11px] text-slate-500 dark:text-slate-400\">\n                \355\231\224\353\251\264\354\227\220 \354\227\264\353\246\260 \353\217\204\353\251\264 \353\251\224\353\252\250\353\246\254\353\245\274 \354\231\204\354\240\204\355\236\210 \354\264\210\352\270\260\355\231\224\355\225\251\353\213\210\353\213\244.\n              </div>\n            </div>\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
