            }
            lines {
              text: "        if (rawPx < 3.5) continue;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const p = worldToScreen(ent.position.x, ent.position.y);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        if (p.x < -120 || p.x > cw + 120 || p.y < -60 || p.y > ch + 60) continue;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const fontPx = Math.min(56, rawPx);"
