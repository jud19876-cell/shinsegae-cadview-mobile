  planner_response {
    response: "\354\272\220\353\223\234 \353\217\204\353\251\264 \353\241\234\353\215\224(`lib/libreDwgLoader.ts`, `lib/dxfParser.ts`) \353\260\217 \353\252\250\353\215\270 \355\231\225\354\236\245 \353\213\250\352\263\204(`lib/modelExpander.ts`)\354\227\220 \353\254\264\355\225\234\353\214\200 \354\242\214\355\221\234\354\231\200 \353\257\270\354\204\270 \354\235\264\354\203\201 \354\240\220\354\235\204 \354\202\254\354\240\204\354\227\220 \352\260\220\354\247\200\355\225\230\352\263\240 \355\225\204\355\204\260\353\247\201/\354\240\225\352\267\234\355\231\224\355\225\230\353\212\224 **CAD \352\270\260\355\225\230 \354\240\204\354\262\230\353\246\254 \355\214\214\354\235\264\355\224\204\353\235\274\354\235\270(`lib/cadSanitizer.ts`)**\354\235\204 \352\265\254\354\266\225\355\226\210\354\212\265\353\213\210\353\213\244.\n\n### \354\243\274\354\232\224 \352\260\234\354\204\240 \353\202\264\354\227\255\n\n1. **CAD \352\270\260\355\225\230 \354\234\204\354\203\235 \354\262\230\353\246\254 \353\252\250\353\223\210 \352\265\254\354\266\225 (`src/lib/cadSanitizer.ts`)**\n   * **\353\254\264\355\225\234\353\214\200/\354\235\264\354\203\201 \354\242\214\355\221\234 \352\262\200\354\246\235 (`isSaneCoord`, `isSanePoint`)**:\n     * `NaN`, `Infinity`, \353\271\204\354\210\230\354\271\230\352\260\222 \353\230\220\353\212\224 10,000,000(1e7) \353\213\250\354\234\204\353\245\274 \354\264\210\352\263\274\355\225\230\353\212\224 \353\240\210\354\235\264/\353\260\251\354\202\254\354\204\240 \354\230\244\353\262\204\355\224\214\353\241\234 \353\260\217 \354\264\210\352\270\260\355\231\224\353\220\230\354\247\200 \354\225\212\354\235\200 \353\251\224\353\252\250\353\246\254 \355\217\254\354\235\270\355\204\260 \354\242\214\355\221\234\353\245\274 \354\227\204\352\262\251\355\236\210 \354\260\250\353\213\250\355\225\251\353\213\210\353\213\244.\n   * **\353\257\270\354\204\270 \354\240\220 \353\260\217 \355\207\264\355\231\224 \354\232\224\354\206\214(Degenerate Entity) \355\225\204\355\204\260\353\247\201**:\n     * **\354\204\240(`LINE`)**: \352\270\270\354\235\264\352\260\200 `0.0001` \353\257\270\353\247\214\354\235\270 \354\230\201(0)\352\270\270\354\235\264 \353\257\270\354\204\270 \354\240\220 \353\230\220\353\212\224 `1e7` \354\235\264\354\203\201\354\235\230 \353\271\204\354\240\225\354\203\201 \353\254\264\355\225\234\353\214\200 \354\247\201\354\204\240\354\235\204 \354\246\211\354\213\234 \354\240\234\352\261\260\355\225\251\353\213\210\353\213\244.\n     * **\355\217\264\353\246\254\353\235\274\354\235\270(`LWPOLYLINE`)**:\n       * \352\261\260\353\246\254 `0.0001` \353\257\270\353\247\214\354\234\274\353\241\234 \354\244\221\353\263\265 \354\260\215\355\236\214 \354\227\260\354\206\215 \352\274\255\354\247\223\354\240\220\354\235\204 \355\206\265\355\225\251 \354\240\225\352\267\234\355\231\224\355\225\251\353\213\210\353\213\244.\n       * \352\274\255\354\247\223\354\240\220 \354\240\225\352\267\234\355\231\224 \355\233\204 \354\234\240\355\232\250 \354\240\220\354\235\264 2\352\260\234 \353\257\270\353\247\214\354\235\264\352\261\260\353\202\230 \354\240\204\354\262\264 \353\260\224\354\232\264\353\224\251 \353\260\225\354\212\244\352\260\200 \353\257\270\354\204\270 \354\240\220 \355\201\254\352\270\260\354\235\270 \353\205\270\354\235\264\354\246\210 \355\217\264\353\246\254\353\235\274\354\235\270\354\235\204 \353\260\260\354\240\234\355\225\251\353\213\210\353\213\244.\n     * **\354\233\220/\355\230\270(`CIRCLE`/`ARC`)**: \353\260\230\354\247\200\353\246\204\354\235\264 `0.0001` \354\235\264\355\225\230\354\235\270 \354\240\220\354\235\264\353\202\230 \353\271\204\354\240\225\354\203\201\354\240\201\354\234\274\353\241\234 \352\261\260\353\214\200\355\225\234 \355\230\270\353\245\274 \354\240\234\352\261\260\355\225\230\353\251\260, \352\260\201\353\217\204 \353\262\224\354\234\204\353\245\274 `[0, 360)`\354\234\274\353\241\234 \354\240\225\352\267\234\355\231\224\355\225\251\353\213\210\353\213\244.\n     * **\353\270\224\353\241\235 \354\260\270\354\241\260(`INSERT`) / \355\205\215\354\212\244\355\212\270(`TEXT`)**: \354\202\275\354\236\205\354\240\220 \354\242\214\355\221\234 \352\262\200\354\246\235 \353\260\217 `0` \353\230\220\353\212\224 \353\254\264\355\225\234\353\214\200 \354\212\244\354\274\200\354\235\274/\353\206\222\354\235\264 \352\260\222\354\235\204 \352\270\260\353\263\270 \354\240\225\354\203\201\354\271\230\353\241\234 \354\225\210\354\240\204\355\225\230\352\262\214 \354\240\225\352\267\234\355\231\224\355\225\251\353\213\210\353\213\244.\n\n2. **DWG \353\241\234\353\215\224 \354\240\204\354\262\230\353\246\254 \354\227\260\353\217\231 (`src/lib/libreDwgLoader.ts`)**\n   * Wasm \353\263\200\355\231\230 \353\213\250\352\263\204\354\235\230 \354\227\224\355\213\260\355\213\260 \353\247\265\355\225\221(`mapRawEntity`)\354\227\220\354\204\234 \354\203\235\354\204\261\353\220\234 \353\252\250\353\223\240 \354\227\224\355\213\260\355\213\260\353\245\274 1\354\260\250 \355\225\204\355\204\260\353\247\201\355\225\230\352\263\240, \354\265\234\354\242\205 \353\252\250\353\215\270 \353\260\230\355\231\230 \354\213\234 `sanitizeDrawingModel`\354\235\204 \355\206\265\355\225\264 \354\203\201\354\234\204 \354\227\224\355\213\260\355\213\260\353\277\220 \354\225\204\353\213\210\353\235\274 \353\270\224\353\241\235 \355\205\214\354\235\264\353\270\224 \353\202\264 \353\252\250\353\223\240 \355\225\230\354\234\204 \354\227\224\355\213\260\355\213\260\352\271\214\354\247\200 \354\240\204\354\262\230\353\246\254 \352\262\200\354\246\235\354\235\204 \355\206\265\352\263\274\354\213\234\355\202\265\353\213\210\353\213\244.\n\n3. **DXF \355\214\214\354\204\234 \354\240\204\354\262\230\353\246\254 \354\227\260\353\217\231 (`src/lib/dxfParser.ts`)**\n   * DXF \354\227\224\355\213\260\355\213\260 \355\214\214\354\213\261(`parseEntityGroup`) \353\260\217 \354\240\204\354\262\264 \353\217\204\353\251\264 \355\214\214\354\213\261 \352\262\260\352\263\274\354\227\220 \354\240\204\354\262\23