  planner_response {
    response: "\354\230\254\353\240\244\354\243\274\354\213\240 \355\231\224\353\251\264\354\227\220\354\204\234 \353\260\234\354\203\235\355\225\234 \354\230\244\353\245\230\354\235\230 \354\233\220\354\235\270\354\235\204 \353\266\204\354\204\235\355\225\230\352\263\240 \353\260\224\353\241\234\354\236\241\354\225\230\354\212\265\353\213\210\353\213\244. \353\230\220\355\225\234 **\352\265\254\352\270\200 \354\212\244\355\206\240\354\226\264 \354\266\234\354\213\234 \354\227\206\354\235\264 \352\260\234\354\235\270 \353\260\217 \354\247\200\354\235\270\353\223\244\353\247\214 \352\260\204\355\216\270\355\225\230\352\262\214 \354\223\260\354\213\244 \354\210\230 \354\236\210\353\212\224 \352\260\200\354\236\245 \355\231\225\354\213\244\355\225\234 \353\260\251\353\262\225**\354\235\204 \354\225\210\353\202\264\355\225\264 \353\223\234\353\246\275\353\213\210\353\213\244.\n\n---\n\n### 1. \355\231\224\353\251\264\354\227\220 \354\230\244\353\245\230\352\260\200 \353\234\254 \354\233\220\354\235\270\352\263\274 \354\241\260\354\271\230 \354\202\254\355\225\255\n* **\354\230\244\353\245\230 \354\233\220\354\235\270**: \n  PWABuilder\353\212\224 \354\233\220\353\236\230 \352\265\254\352\270\200 \355\224\214\353\240\210\354\235\264\354\212\244\355\206\240\354\226\264 \354\266\234\354\213\234\354\232\251 \355\214\250\355\202\244\354\247\200\353\245\274 \353\247\214\353\223\234\353\212\224 \354\231\270\353\266\200 \353\217\204\352\265\254\354\236\205\353\213\210\353\213\244. \353\213\271\354\213\234 \354\233\271\354\202\254\354\235\264\355\212\270\354\227\220 \354\240\225\354\240\201 `manifest.json` \355\214\214\354\235\274\354\235\264 \354\247\201\354\240\221 \354\227\260\352\262\260\353\220\230\354\226\264 \354\236\210\354\247\200 \354\225\212\354\225\204, PWABuilder \354\213\234\354\212\244\355\205\234\354\235\264 \352\270\260\353\263\270 \354\225\204\354\235\264\354\275\230 \354\243\274\354\206\214\353\245\274 \354\236\220\352\270\260\353\204\244 \353\217\204\353\251\