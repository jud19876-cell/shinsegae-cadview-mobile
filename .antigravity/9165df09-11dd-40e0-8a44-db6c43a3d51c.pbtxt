  view_file {
    absolute_path_uri: "file:///src/components/CADCanvas.tsx"
    start_line: 329
    end_line: 369
    content: "  const updateTouchLoupe = (sx: number, sy: number) => {\n    const wrapper = loupeWrapperRef.current;\n    const lCanv = loupeCanvasRef.current;\n    const canvas = canvasRef.current;\n    if (!wrapper || !lCanv || !canvas) return;\n\n    if (mode !== \'measure\' && mode !== \'calibrate\') {\n      wrapper.classList.add(\'hidden\');\n      return;\n    }\n    wrapper.classList.remove(\'hidden\');\n    const lw = 112;\n    const lh = 112;\n    wrapper.style.left = `${Math.max(8, Math.min(canvas.width - lw - 8, sx - lw / 2))}px`;\n    wrapper.style.top = `${Math.max(8, sy - lh - 40)}px`;\n\n    const lCtx = lCanv.getContext(\'2d\');\n    if (!lCtx) return;\n    lCtx.clearRect(0, 0, lw, lh);\n    const z = 2.4;\n    lCtx.drawImage(\n      canvas,\n      sx - lw / z / 2,\n      sy - lh / z / 2,\n      lw / z,\n      lh / z,\n      0,\n      0,\n      lw,\n      lh\n    );\n    lCtx.strokeStyle = \'#C8102E\';\n    lCtx.lineWidth = 1.4;\n    lCtx.beginPath();\n    lCtx.moveTo(lw / 2, 0);\n    lCtx.lineTo(lw / 2, lh);\n    lCtx.moveTo(0, lh / 2);\n    lCtx.lineTo(lw, lh / 2);\n    lCtx.stroke();\n  };\n"
    num_lines: 1511
    num_bytes: 51692
    line_range_bytes: 1062
  }
}
