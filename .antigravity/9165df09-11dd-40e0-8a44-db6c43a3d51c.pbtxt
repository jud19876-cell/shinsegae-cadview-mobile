        target_content: "  function isArtifactStreakSegment(p1: Point2D, p2: Point2D): boolean {\n    const dx = Math.abs(p2.x - p1.x);\n    const dy = Math.abs(p2.y - p1.y);\n    const len = Math.hypot(dx, dy);\n    if (len > maxDiag * 1.5) return true;\n    const isDiagonal = dx > len * 0.22 && dy > len * 0.22;\n    if (isDiagonal && len > maxDiag * 0.22) {\n      return true;\n    }\n    return false;\n  }\n\n  const finalEntities: CadEntity[] = [];\n  for (let i = 0; i < expanded.length; i++) {\n    const e = expanded[i];\n    if (e.type === \'LINE\' && e.start && e.end) {\n      if (isArtifactStreakSegment(e.start, e.end)) continue;\n      finalEntities.push(e);\n    } else if (e.type === \'LWPOLYLINE\' && e.vertices && e.vertices.length >= 2) {\n      if (e.closed && e.vertices.length >= 3) {\n        const v0 = e.vertices[0];\n        const vn = e.vertices[e.vertices.length - 1];\n        if (isArtifactStreakSegment(vn, v0)) {\n          e.closed = false;\n        }\n      }\n      let currentSubVerts = [e.vertices[0]];\n      for (let k = 1; k < e.vertices.length; k++) {\n        const prev = e.vertices[k - 1];\n        const cur = e.vertices[k];\n        if (isArtifactStreakSegment(prev, cur)) {\n          if (currentSubVerts.length >= 2) {\n            finalEntities.push({\n              id: `${e.id}_sub${k}`,\n              type: \'LWPOLYLINE\',\n              layer: e.layer,\n              aci: e.aci,\n              linetype: e.linetype,\n              lineweight: e.lineweight,\n              closed: false,\n              vertices: currentSubVerts,\n            });\n          }\n          currentSubVerts = [cur];\n        } else {\n          currentSubVerts.push(cur);\n        }\n      }\n      if (currentSubVerts.length >= 2) {\n        e.vertices = currentSubVerts;\n        finalEntities.push(e);\n      }\n    } else {\n      finalEntities.push(e);\n    }\n  }"
        replacement_content: "  function isArtifactStreakSegment(\n    p1: Point2D,\n    p2: Point2D,\n    layerName: string = \'\'\n  ): boolean {\n    const dx = Math.abs(p2.x - p1.x);\n    const dy = Math.abs(p2.y - p1.y);\n    const len = Math.hypot(dx, dy);\n    if (!isFinite(len) || len === 0) return true;\n    if (len > maxDiag * 1.5) return true;\n\n    // Diagonal streak cutting across viewports\n    const isDiagonal = dx > len * 0.18 && dy > len * 0.18;\n    if (isDiagonal && len > maxDiag * 0.20) {\n      return true;\n    }\n\n    // Long horizontal or vertical line cutting through interior\n    const isOrthogonal = dx < len * 0.02 || dy < len * 0.02;\n    if (isOrthogonal && len > Math.max(spanW, spanH) * 0.35) {\n      const lyrUpper = layerName.toUpperCase();\n      const isBorderLayer =\n        lyrUpper.includes(\'BORDER\') ||\n        lyrUpper.includes(\'TITLE\') ||\n        lyrUpper.includes(\'FRAME\') ||\n        lyrUpper.includes(\'SHEET\');\n      if (!isBorderLayer) {\n        const midX = (p1.x + p2.x) / 2;\n        const midY = (p1.y + p2.y) / 2;\n        const nearOuterX =\n          Math.abs(midX - minX) < spanW * 0.035 ||\n          Math.abs(midX - maxX) < spanW * 0.035;\n        const nearOuterY =\n          Math.abs(midY - minY) < spanH * 0.035 ||\n          Math.abs(midY - maxY) < spanH * 0.035;\n        if (!nearOuterX && !nearOuterY) {\n          return true;\n        }\n      }\n    }\n    return false;\n  }\n\n  const finalEntities: CadEntity[] = [];\n  for (let i = 0; i < expanded.length; i++) {\n    const e = expanded[i];\n    const lyrUpper = String(e.layer || \'\').toUpperCase();\n    if (\n      lyrUpper === \'DEFPOINTS\' ||\n      lyrUpper.includes(\'DEFPOINT\') ||\n      lyrUpper === \'NPLT\' ||\n      lyrUpper.includes(\'NO_PLOT\') ||\n      lyrUpper.includes(\'NON_PLOT\')\n    ) {\n      continue;\n    }\n\n    if (e.type === \'LINE\' && e.start && e.end) {\n      if (isArtifactStreakSegment(e.start, e.end, e.layer)) continue;\n      finalEntities.push(e);\n    } else if (e.type === \'LWPOLYLINE\' && e.vertices && e.vertices.length >= 2) {\n      // Calculate median segment length in this polyline to detect anomalous jumps\n      const segLengths: number[] = [];\n      for (let s = 1; s < Math.min(e.vertices.length, 30); s++) {\n        segLengths.push(\n          Math.hypot(\n            e.vertices[s].x - e.vertices[s - 1].x,\n            e.vertices[s].y - e.vertices[s - 1].y\n          )\n        );\n      }\n      segLengths.sort((a, b) => a - b);\n      const medianStep =\n        segLengths[Math.floor(segLengths.length / 2)] || 10;\n\n      // Check false polyline closure (connecting disparate ends of drawing)\n      if (e.closed && e.vertices.length >= 3) {\n        const v0 = e.vertices[0];\n        const vn = e.vertices[e.vertices.length - 1];\n        const closeDist = Math.hypot(vn.x - v0.x, vn.y - v0.y);\n        if (\n          isArtifactStreakSegment(vn, v0, e.layer) ||\n          (closeDist > Math.max(medianStep * 8, 80) &&\n            closeDist > Math.min(spanW, spanH) * 0.12)\n        ) {\n          e.closed = false;\n        }\n      }\n\n      // Filter internal jump streaks in polylines\n      let currentSubVerts = [e.vertices[0]];\n      for (let k = 1; k < e.vertices.length; k++) {\n        const prev = e.vertices[k - 1];\n        const cur = e.vertices[k];\n        const segLen = Math.hypot(cur.x - prev.x, cur.y - prev.y);\n        const isJump =\n          isArtifactStreakSegment(prev, cur, e.layer) ||\n          (segLen > Math.max(medianStep * 15, 200) &&\n            segLen > Math.min(spanW, spanH) * 0.18);\n\n        if (isJump) {\n          if (currentSubVerts.length >= 2) {\n            finalEntities.push({\n              id: `${e.id}_sub${k}`,\n              type: \'LWPOLYLINE\',\n              layer: e.layer,\n              aci: e.aci,\n              linetype: e.linetype,\n              lineweight: e.lineweight,\n              closed: false,\n              vertices: currentSubVerts,\n            });\n          }\n          currentSubVerts = [cur];\n        } else {\n          currentSubVerts.push(cur);\n        }\n      }\n      if (currentSubVerts.length >= 2) {\n        e.vertices = currentSubVerts;\n        finalEntities.push(e);\n      }\n    } else {\n      finalEntities.push(e);\n    }\n  }"
        start_line: 335
