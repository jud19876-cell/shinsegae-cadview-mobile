    content: "      }\n    } else if (e.type === \'CIRCLE\' || e.type === \'ARC\') {\n      includePt(e.center.x - e.radius, e.center.y - e.radius, !isExcluded);\n      includePt(e.center.x + e.radius, e.center.y + e.radius, !isExcluded);\n    } else if (e.type === \'RASTER_PREVIEW\') {\n      includePt(e.minX, e.minY, true);\n      includePt(e.maxX, e.maxY, true);\n    }\n  });\n\n  if (xSamples.length >= 40) {\n    xSamples.sort((a, b) => a - b);\n    ySamples.sort((a, b) => a - b);\n    // Only clip extreme isolated outliers (0.05%) so outer sheet border vertices are preserved\n    const low = Math.floor(xSamples.length * 0.0005);\n    const high = Math.min(\n      xSamples.length - 1,\n      Math.ceil(xSamples.length * 0.9995)\n    );\n    if (xSamples[high] > xSamples[low] && ySamples[high] > ySamples[low]) {\n      minX = xSamples[low];\n      maxX = xSamples[high];\n      minY = ySamples[low];\n      maxY = ySamples[high];\n    }\n  }\n\n  if (!isFinite(minX)) {\n    minX = 0;\n    minY = 0;\n    maxX = 1000;\n    maxY = 1000;\n  }\n  const extents: Extents2D = { minX, minY, maxX, maxY };\n\n  const spanW = Math.max(100, maxX - minX);\n  const spanH = Math.max(100, maxY - minY);\n  const maxDiag = Math.hypot(spanW, spanH);\n\n  function isArtifactStreakSegment(\n    p1: Point2D,\n    p2: Point2D\n  ): boolean {\n    const dx = Math.abs(p2.x - p1.x);\n    const dy = Math.abs(p2.y - p1.y);\n    const len = Math.hypot(dx, dy);\n    if (!isFinite(len) || len === 0) return true;\n    if (len > maxDiag * 1.5) return true;\n\n    // Diagonal streak cutting across viewports between disparate machines/views\n    const isDiagonal = dx > 350 && dy > 350;\n    if (isDiagonal && (len > 1000 || len > maxDiag * 0.15)) {\n      return true;\n    }\n\n    return false;\n  }\n\n  const finalEntities: CadEntity[] = [];\n  for (let i = 0; i < expanded.length; i++) {\n    const e = expanded[i];\n    const lyrUpper = String(e.layer || \'\').toUpperCase();\n    if (\n      lyrUpper === \'DEFPOINTS\' ||\n      lyrUpper.includes(\'DEFPOINT\') ||\n      lyrUpper === \'NPLT\' ||\n      lyrUpper.includes(\'NO_PLOT\') ||\n      lyrUpper.includes(\'NON_PLOT\')\n    ) {\n      continue;\n    }\n\n    if (e.type === \'LINE\' && e.start && e.end) {\n      if (isArtifactStreakSegment(e.start, e.end)) continue;\n      finalEntities.push(e);\n    } else if (e.type === \'LWPOLYLINE\' && e.vertices && e.vertices.length >= 2) {\n      // Calculate median segment length in this polyline to detect anomalous jumps\n      const segLengths: number[] = [];\n      for (let s = 1; s < Math.min(e.vertices.length, 30); s++) {\n        segLengths.push(\n          Math.hypot(\n            e.vertices[s].x - e.vertices[s - 1].x,\n            e.vertices[s].y - e.vertices[s - 1].y\n          )\n        );\n      }\n      segLengths.sort((a, b) => a - b);\n      const medianStep =\n        segLengths[Math.floor(segLengths.length / 2)] || 10;\n\n      // Check false polyline closure (connecting disparate ends of drawing across machines)\n      if (e.closed && e.vertices.length >= 2) {\n        const v0 = e.vertices[0];\n        const vn = e.vertices[e.vertices.length - 1];\n        const closeDist = Math.hypot(vn.x - v0.x, vn.y - v0.y);\n        const closeDx = Math.abs(vn.x - v0.x);\n        const closeDy = Math.abs(vn.y - v0.y);\n        if (\n          closeDist > 0.1 &&\n          ((closeDx > 300 && closeDy > 300) ||\n            closeDist > Math.max(medianStep * 4, 300) ||\n            closeDist > Math.min(spanW, spanH) * 0.1)\n        ) {\n          e.closed = false;\n        }\n      }\n\n      // Filter internal jump streaks in polylines\n      let currentSubVerts = [e.vertices[0]];\n      for (let k = 1; k < e.vertices.length; k++) {\n        const prev = e.vertices[k - 1];\n        const cur = e.vertices[k];\n        const segDx = Math.abs(cur.x - prev.x);\n        const segDy = Math.abs(cur.y - prev.y);\n        const segLen = Math.hypot(segDx, segDy);\n        const isJump =\n          isArtifactStreakSegment(prev, cur) ||\n          (segDx > 350 && segDy > 350 && segLen > Math.max(medianStep * 5, 800));\n\n        if (isJump) {\n          if (currentSubVerts.length >= 2) {\n            finalEntities.push({\n              ...e,\n              id: `${e.id}_sub${k}`,\n              closed: false,\n              vertices: currentSubVerts,\n            });\n          }\n          currentSubVerts = [cur];\n        } else {\n          currentSubVerts.push(cur);\n        }\n      }\n      if (currentSubVerts.length >= 2) {\n        e.vertices = currentSubVerts;\n        finalEntities.push(e);\n      }\n    } else {\n      finalEntities.push(e);\n    }\n  }\n\n  // Count entities per layer\n  finalEntities.forEach((e) => {\n    const lname = e.layer || \'0\';\n    if (!layers[lname]) {\n      const fallbackAci =\n        e.aci && e.aci !== 256 && e.aci !== 0 ? e.aci : 7;\n      layers[lname] = {\n        name: lname,\n        aci: fallbackAci,"
