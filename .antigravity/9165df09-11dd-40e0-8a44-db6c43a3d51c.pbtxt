    replacement_infos {
      original_chunk {
        target_content: "  const offscreenRef = useRef<HTMLCanvasElement | null>(null);\n  const animFrameRef = useRef<number | null>(null);\n\n  const latestRef = useRef({\n    camX,\n    camY,\n    zoom,\n    rotation,\n    mode,\n    unitScaleFactor,\n    screenToWorld,\n    findSnapPoint,\n    onUpdateCamera,\n    onUpdateMouseWorld,\n    handlePointTap,\n    updateTouchLoupe,\n  });\n\n  latestRef.current = {\n    camX,\n    camY,\n    zoom,\n    rotation,\n    mode,\n    unitScaleFactor,\n    screenToWorld,\n    findSnapPoint,\n    onUpdateCamera,\n    onUpdateMouseWorld,\n    handlePointTap,\n    updateTouchLoupe,\n  };\n\n  // Double-Buffered 60FPS Render Loop (100% Flicker-Free)\n  useEffect(() => {\n    const canvas = canvasRef.current;\n    if (!canvas) return;\n\n    const render = () => {\n      const cw = canvas.width;\n      const ch = canvas.height;\n      if (!cw || !ch) return;\n\n      let offscreen = offscreenRef.current;\n      if (!offscreen) {\n        offscreen = document.createElement(\'canvas\');\n        offscreenRef.current = offscreen;\n      }\n      if (offscreen.width !== cw || offscreen.height !== ch) {\n        offscreen.width = cw;\n        offscreen.height = ch;\n      }\n      const drawCtx = offscreen.getContext(\'2d\', { alpha: false });\n      if (!drawCtx) return;\n      const ctx = drawCtx;\n\n      // Surface Background: AI-Vault Soft Ivory vs Dark vs Blueprint\n      const bgMap = { white: \'#F8F7F4\', dark: \'#0B101B\', blueprint: \'#071B38\' };\n      ctx.fillStyle = bgMap[theme] || \'#F8F7F4\';\n      ctx.fillRect(0, 0, cw, ch);"
        replacement_content: "  interface RenderStateSnapshot {\n    cw: number;\n    ch: number;\n    camX: number;\n    camY: number;\n    zoom: number;\n    rotation: number;\n    theme: string;\n    showGrid: boolean;\n    enableOsnap: boolean;\n    textScale: number;\n    snapKey: string;\n    entitiesLen: number;\n    batchesLen: number;\n    textsLen: number;\n    rastersLen: number;\n    layersKey: string;\n    selectedId: string;\n    measurementsLen: number;\n    measurePointsKey: string;\n  }\n\n  const offscreenRef = useRef<HTMLCanvasElement | null>(null);\n  const animFrameRef = useRef<number | null>(null);\n  const isDirtyRef = useRef<boolean>(true);\n  const lastRenderStateRef = useRef<RenderStateSnapshot | null>(null);\n\n  const latestRef = useRef({\n    camX,\n    camY,\n    zoom,\n    rotation,\n    mode,\n    unitScaleFactor,\n    screenToWorld,\n    worldToScreen,\n    findSnapPoint,\n    onUpdateCamera,\n    onUpdateMouseWorld,\n    handlePointTap,\n    updateTouchLoupe,\n    theme,\n    showGrid,\n    enableOsnap,\n    textScale,\n    entities,\n    renderBatches,\n    textEntities,\n    rasterEntities,\n    layers,\n    selectedEntity,\n    measurements,\n    measurePoints,\n    requestRender: (_force?: boolean) => {},\n    ensureRendered: () => {},\n  });\n\n  latestRef.current = {\n    camX,\n    camY,\n    zoom,\n    rotation,\n    mode,\n    unitScaleFactor,\n    screenToWorld,\n    worldToScreen,\n    findSnapPoint,\n    onUpdateCamera,\n    onUpdateMouseWorld,\n    handlePointTap,\n    updateTouchLoupe,\n    theme,\n    showGrid,\n    enableOsnap,\n    textScale,\n    entities,\n    renderBatches,\n    textEntities,\n    rasterEntities,\n    layers,\n    selectedEntity,\n    measurements,\n    measurePoints,\n    requestRender: (force?: boolean) => {\n      requestRender(force);\n    },\n    ensureRendered: () => {\n      render();\n    },\n  };\n\n  // Request-on-Demand Double-Buffered Render Function (Only draws when visual changes occur)\n  const render = useCallback(() => {\n    const canvas = canvasRef.current;\n    if (!canvas) return;\n\n    const cw = canvas.width;\n    const ch = canvas.height;\n    if (!cw || !ch) return;\n\n    const {\n      camX,\n      camY,\n      zoom,\n      rotation,\n      theme,\n      showGrid,\n      enableOsnap,\n      textScale,\n      entities,\n      renderBatches,\n      textEntities,\n      rasterEntities,\n      layers,\n      selectedEntity,\n      measurements,\n      measurePoints,\n      worldToScreen,\n      screenToWorld,\n    } = latestRef.current;\n\n    // Check snap point\n    const curSnap = snapPointRef.current;\n    const snapKey = curSnap ? `${curSnap.x.toFixed(1)},${curSnap.y.toFixed(1)},${curSnap.type}` : \'\';\n\n    // Quick layer visibility signature\n    let layersKey = \'\';\n    const layerNames = Object.keys(layers);\n    for (let i = 0; i < layerNames.length; i++) {\n      const k = layerNames[i];\n      layersKey += `${k}:${layers[k]?.visible ? 1 : 0},`;\n    }\n\n    const selectedId = selectedEntity ? `${selectedEntity.type}_${selectedEntity.id || \'\'}` : \'\';\n    const measurePointsKey = measurePoints.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(\';\');\n\n    const last = lastRenderStateRef.current;\n    const hasVisualChanges =\n      isDirtyRef.current ||\n      !last ||\n      last.cw !== cw ||\n      last.ch !== ch ||\n      last.camX !== camX ||\n      last.camY !== camY ||\n      last.zoom !== zoom ||\n      last.rotation !== rotation ||\n      last.theme !== theme ||\n      last.showGrid !== showGrid ||\n      last.enableOsnap !== enableOsnap ||\n      last.textScale !== textScale ||\n      last.snapKey !== snapKey ||\n      last.entitiesLen !== entities.length ||\n      last.batchesLen !== renderBatches.length ||\n      last.textsLen !== textEntities.length ||\n      last.rastersLen !== rasterEntities.length ||\n      last.layersKey !== layersKey ||\n      last.selectedId !== selectedId ||\n      last.measurementsLen !== measurements.length ||\n      last.measurePointsKey !== measurePointsKey;\n\n    if (!hasVisualChanges) {\n      // Request-on-demand: Zero visual changes between frames, bypass redraw completely!\n      return;\n    }\n\n    // Mark state as clean and record snapshot\n    isDirtyRef.current = false;\n    lastRenderStateRef.current = {\n      cw,\n      ch,\n      camX,\n      camY,\n      zoom,\n      rotation,\n      theme,\n      showGrid,\n      enableOsnap,\n      textScale,\n      snapKey,\n      entitiesLen: entities.length,\n      batchesLen: renderBatches.length,\n      textsLen: textEntities.length,\n      rastersLen: rasterEntities.length,\n      layersKey,\n      selectedId,\n      measurementsLen: measurements.length,\n      measurePointsKey,\n    };\n\n    let offscreen = offscreenRef.current;\n    if (!offscreen) {\n      offscreen = document.createElement(\'canvas\');\n      offscreenRef.current = offscreen;\n    }\n    if (offscreen.width !== cw || offscreen.height !== ch) {\n      offscreen.width = cw;\n      offscreen.height = ch;\n    }\n    const drawCtx = offscreen.getContext(\'2d\', { alpha: false });\n    if (!drawCtx) return;\n    const ctx = drawCtx;\n\n    // Surface Background: AI-Vault Soft Ivory vs Dark vs Blueprint\n    const bgMap = { white: \'#F8F7F4\', dark: \'#0B101B\', blueprint: \'#071B38\' };\n    ctx.fillStyle = bgMap[theme] || \'#F8F7F4\';\n    ctx.fillRect(0, 0, cw, ch);"
