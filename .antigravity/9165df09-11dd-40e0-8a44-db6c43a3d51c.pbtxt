        target_content: "export function parseDxfText(\n  dxfText: string,\n  fileName: string = \'drawing.dxf\'\n): DrawingModel {\n  const rawLines = dxfText\n    .replace(/\\r\\n/g, \'\\n\')\n    .replace(/\\r/g, \'\\n\')\n    .split(\'\\n\');\n  const pairs: Array<{ code: number; value: string }> = [];\n\n  for (let i = 0; i + 1 < rawLines.length; i += 2) {\n    const code = parseInt(rawLines[i].trim(), 10);\n    if (!isNaN(code)) pairs.push({ code, value: rawLines[i + 1].trim() });\n  }\n\n  const layers: Record<string, LayerInfo> = {};\n  const blocks: Record<string, CadBlock> = {};\n  const entities: CadEntity[] = [];\n\n  let section = \'\';\n  let inLayerTable = false;\n  let currentLayer: LayerInfo | null = null;\n  let currentBlock: CadBlock | null = null;\n  let idSeq = 1;\n\n  function parseEntityGroup(startIdx: number): {\n    entity: CadEntity | null;\n    nextIndex: number;\n  } {\n    const type = pairs[startIdx].value;\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    const ent: any = {\n      id: `DXF_${idSeq++}`,\n      type,\n      layer: \'0\',\n      aci: null,\n      linetype: \'CONTINUOUS\',\n      lineweight: 1.2,\n      vertices: [],\n    };\n    let i = startIdx + 1;\n    let curVertex: Vertex2D | null = null;\n    const ext = { x: 0, y: 0, z: 1 };\n\n    while (i < pairs.length) {\n      const c = pairs[i].code;\n      const v = pairs[i].value;\n      if (c === 0) break;\n\n      if (c === 8) ent.layer = cleanCadText(v) || \'0\';\n      else if (c === 6) ent.linetype = v;\n      else if (c === 60) ent.invisible = parseInt(v, 10) === 1;\n      else if (c === 67) ent.inPaperSpace = parseInt(v, 10) === 1;\n      else if (c === 62) ent.aci = parseInt(v, 10);\n      else if (c === 420) ent.aci = parseInt(v, 10);"
        replacement_content: "export function parseDxfText(\n  dxfText: string,\n  fileName: string = \'drawing.dxf\'\n): DrawingModel {\n  // Fast zero-duplication line scanner for large DXF files\n  const pairs: Array<{ code: number; value: string }> = [];\n  const textLen = dxfText.length;\n  let cursor = 0;\n\n  function scanLine(): string | null {\n    if (cursor >= textLen) return null;\n    let nl = dxfText.indexOf(\'\\n\', cursor);\n    if (nl === -1) nl = textLen;\n    let end = nl;\n    if (end > cursor && dxfText.charCodeAt(end - 1) === 13) {\n      end--; // skip \\r\n    }\n    const str = dxfText.slice(cursor, end).trim();\n    cursor = nl + 1;\n    return str;\n  }\n\n  while (cursor < textLen) {\n    const cLine = scanLine();\n    if (cLine === null) break;\n    const vLine = scanLine();\n    if (vLine === null) break;\n    const code = parseInt(cLine, 10);\n    if (!isNaN(code)) pairs.push({ code, value: vLine });\n  }\n\n  const layers: Record<string, LayerInfo> = {};\n  const blocks: Record<string, CadBlock> = {};\n  const entities: CadEntity[] = [];\n\n  let section = \'\';\n  let inLayerTable = false;\n  let currentLayer: LayerInfo | null = null;\n  let currentBlock: CadBlock | null = null;\n  let idSeq = 1;\n\n  function parseEntityGroup(startIdx: number): {\n    entity: CadEntity | null;\n    nextIndex: number;\n  } {\n    const type = pairs[startIdx].value;\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    const ent: any = {\n      id: `DXF_${idSeq++}`,\n      type,\n      layer: \'0\',\n      aci: null,\n      linetype: \'CONTINUOUS\',\n      lineweight: 1.2,\n      vertices: [],\n      flags: 0,\n    };\n    let i = startIdx + 1;\n    let curVertex: Vertex2D | null = null;\n    const ext = { x: 0, y: 0, z: 1 };\n\n    while (i < pairs.length) {\n      const c = pairs[i].code;\n      const v = pairs[i].value;\n      if (c === 0) break;\n\n      if (c === 8) ent.layer = cleanCadText(v) || \'0\';\n      else if (c === 6) ent.linetype = v;\n      else if (c === 60) ent.invisible = parseInt(v, 10) === 1;\n      else if (c === 67) ent.inPaperSpace = parseInt(v, 10) === 1;\n      else if (c === 62) ent.aci = parseInt(v, 10);\n      else if (c === 420) ent.aci = parseInt(v, 10);\n      else if (c === 70) {\n        const flg = parseInt(v, 10) || 0;\n        ent.flags = flg;\n        if (type === \'LWPOLYLINE\' || type === \'POLYLINE\' || type === \'SPLINE\') {\n          ent.closed = (flg & 1) !== 0;\n        }\n      }"
        start_line: 135
        end_line: 212
      }
