    content: "      ent.type = \'LWPOLYLINE\';\n      ent.closed = false;\n      const pts =\n        ent.fitPoints && ent.fitPoints.length >= 2\n          ? ent.fitPoints\n          : ent.controlPoints || [];\n      ent.vertices = pts;\n      delete ent.fitPoints;\n      delete ent.controlPoints;\n    }\n\n    if (type === \'POLYLINE\') {\n      ent.type = \'LWPOLYLINE\';\n      while (i < pairs.length) {\n        if (pairs[i].code === 0 && pairs[i].value === \'VERTEX\') {\n          i++;\n          const vtx = { x: 0, y: 0, bulge: 0 };\n          let isSplineFrameVertex = false;\n          while (i < pairs.length && pairs[i].code !== 0) {\n            if (pairs[i].code === 10) vtx.x = parseFloat(pairs[i].value);\n            else if (pairs[i].code === 20) vtx.y = parseFloat(pairs[i].value);\n            else if (pairs[i].code === 42) vtx.bulge = parseFloat(pairs[i].value);\n            else if (\n              pairs[i].code === 70 &&\n              (parseInt(pairs[i].value, 10) & 16) !== 0\n            ) {\n              isSplineFrameVertex = true;\n            }\n            i++;\n          }\n          if (!isSplineFrameVertex) ent.vertices.push(vtx);"
