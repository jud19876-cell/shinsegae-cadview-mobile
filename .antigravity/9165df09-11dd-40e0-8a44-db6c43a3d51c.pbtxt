4\236\221\354\240\220(\354\232\260\354\270\241 \355\203\200\354\233\214 \352\262\275\352\263\240\353\223\261)\354\234\274\353\241\234 \352\260\225\354\240\234 `closePath()` \353\214\200\352\260\201\354\204\240\354\235\264 \352\267\270\353\240\244\354\247\200\353\215\230 \354\233\220\354\235\270\354\235\204 \354\210\230\354\240\225\355\226\210\354\212\265\353\213\210\353\213\244.\n  * \352\263\265\354\213\235 DWG \355\224\214\353\236\230\352\267\270 \352\267\234\352\262\251(`flag & 1`) \353\260\217 `closed === true`\353\247\214 \353\213\253\355\236\214 \352\262\275\353\241\234\353\241\234 \354\235\270\354\213\235\355\225\230\353\217\204\353\241\235 \354\227\204\352\262\251\355\231\224\355\226\210\354\212\265\353\213\210\353\213\244.\n* **\353\267\260\355\217\254\355\212\270/\352\270\260\352\263\204 \352\260\204 \354\240\220\355\224\204 \354\212\244\355\212\270\353\246\255 \354\260\250\353\213\250**:\n  * \352\270\260\352\263\204 \352\260\204 \354\235\264\352\262\251 \352\263\265\352\260\204\354\235\204 \352\260\200\353\241\234\354\247\200\353\245\264\353\212\224 \353\271\204\354\240\225\354\203\201\354\240\201\354\235\270 \353\214\200\352\260\201\354\204\240 \354\240\220\355\224\204 \354\204\270\352\267\270\353\250\274\355\212\270(`dx > 350 && dy > 350 && len > 1000`)\354\227\220 \353\214\200\355\225\264 \352\262\275\353\241\234\353\245\274 \353\266\204\353\246\254(Split)\355\225\230\352\263\240 \354\225\204\355\213\260\355\214\251\355\212\270\353\245\274 \355\225\204\355\204\260\353\247\201\355\225\230\354\227\254 \353\266\210\355\225\204\354\232\224\355\225\234 \353\214\200\352\260\201\354\204\240\354\235\264 \355\231\224\353\251\264\354\227\220 \353\202\230\355\203\200\353\202\230\354\247\200 \354\225\212\353\217\204\353\241\235 \354\262\230\353\246\254\355\226\210\354\212\265\353\213\210\353\213\244."
