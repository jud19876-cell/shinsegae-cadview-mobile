            }
            lines {
              text: "        const rect = canvas.getBoundingClientRect();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const sx = e.changedTouches[0].clientX - rect.left;"
