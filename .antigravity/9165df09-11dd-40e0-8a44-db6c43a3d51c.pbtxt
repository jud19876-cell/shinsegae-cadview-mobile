    content: "        linetype: e.linetype || \'CONTINUOUS\',\n        lineweight: e.lineweight,\n      };\n\n      if (e.type === \'LINE\' && e.start && e.end) {\n        clone.start = isIdentity\n          ? { x: e.start.x, y: e.start.y }\n          : applyAffine(mat, e.start);\n        clone.end = isIdentity\n          ? { x: e.end.x, y: e.end.y }\n          : applyAffine(mat, e.end);\n      } else if (e.type === \'LWPOLYLINE\' && e.vertices) {\n        clone.closed = e.closed;\n        clone.vertices = isIdentity\n          ? e.vertices.map((v) => ({ x: v.x, y: v.y, bulge: v.bulge }))\n          : e.vertices.map((v) => {\n              const p = applyAffine(mat, v);\n              return { x: p.x, y: p.y, bulge: v.bulge };\n            });\n      } else if ((e.type === \'CIRCLE\' || e.type === \'ARC\') && e.center) {\n        clone.center = isIdentity\n          ? { x: e.center.x, y: e.center.y }\n          : applyAffine(mat, e.center);\n        clone.radius = (e.radius || 0) * scaleFactor;\n        if (e.type === \'ARC\') {\n          if (isIdentity) {\n            clone.startAngle = e.startAngle || 0;\n            clone.endAngle = e.endAngle || 0;\n          } else if (det < 0) {\n            clone.startAngle = transformAngleDeg(mat, e.endAngle || 0);\n            clone.endAngle = transformAngleDeg(mat, e.startAngle || 0);\n          } else {\n            clone.startAngle = transformAngleDeg(mat, e.startAngle || 0);\n            clone.endAngle = transformAngleDeg(mat, e.endAngle || 0);\n          }\n        }\n      } else if (e.type === \'ELLIPSE\' && e.center) {\n        clone.center = isIdentity\n          ? { x: e.center.x, y: e.center.y }\n          : applyAffine(mat, e.center);\n        const maj = e.majorAxis || { x: 10, y: 0 };\n        clone.majorAxis = isIdentity\n          ? { x: maj.x, y: maj.y }\n          : {\n              x: mat[0] * maj.x + mat[2] * maj.y,\n              y: mat[1] * maj.x + mat[3] * maj.y,\n            };\n        clone.axisRatio = e.axisRatio || 0.5;\n      } else if (e.type === \'TEXT\' && e.position) {\n        clone.position = isIdentity\n          ? { x: e.position.x, y: e.position.y }\n          : applyAffine(mat, e.position);\n        clone.height = (e.height || 0) * scaleFactor;\n        let wRot = isIdentity\n          ? e.rotation || 0\n          : transformAngleDeg(mat, e.rotation || 0);\n        if (det < 0 && wRot > 90 && wRot <= 270) {\n          wRot = (wRot + 180) % 360;\n        }\n        clone.rotation = wRot;\n        clone.text = e.text;\n        clone.align = e.align;\n        clone.isMtext = e.isMtext;\n      } else if (e.type === \'RASTER_PREVIEW\') {\n        clone.img = e.img;\n        clone.minX = e.minX;\n        clone.minY = e.minY;\n        clone.maxX = e.maxX;\n        clone.maxY = e.maxY;\n      } else {\n        continue;\n      }\n\n      const cleanClone = sanitizeCadEntity(clone);\n      if (cleanClone) expanded.push(cleanClone);\n    }\n  }\n\n  expandList(\n    model.entities || [],\n    [1, 0, 0, 1, 0, 0],\n    null,\n    null,\n    0,\n    new Set()\n  );\n\n  let minX = Infinity,\n    minY = Infinity,\n    maxX = -Infinity,\n    maxY = -Infinity;\n  const xSamples: number[] = [];\n  const ySamples: number[] = [];\n\n  function includePt(x: number, y: number, isGeom: boolean) {\n    if (!isFinite(x) || !isFinite(y)) return;\n    if (x < minX) minX = x;\n    if (y < minY) minY = y;\n    if (x > maxX) maxX = x;\n    if (y > maxY) maxY = y;\n    if (isGeom && xSamples.length < 30000) {\n      xSamples.push(x);\n      ySamples.push(y);\n    }\n  }\n\n  expanded.forEach((e) => {\n    const lname = e.layer || \'0\';\n    const isExcluded =\n      lname.toUpperCase() === \'DEFPOINTS\' ||\n      (layers[lname] && !layers[lname].visible);\n\n    if (e.type === \'LINE\') {\n      includePt(e.start.x, e.start.y, !isExcluded);\n      includePt(e.end.x, e.end.y, !isExcluded);\n    } else if (e.type === \'LWPOLYLINE\') {\n      const step = Math.max(1, Math.floor(e.vertices.length / 8));\n      for (let i = 0; i < e.vertices.length; i += step) {\n        includePt(e.vertices[i].x, e.vertices[i].y, !isExcluded);\n      }"
