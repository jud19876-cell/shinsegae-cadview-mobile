    content: "      type !== \'LEADER\' &&\n      type !== \'MTEXT\'\n    ) {\n      if (ent.type === \'LWPOLYLINE\' && ent.vertices.length >= 2) {\n        ent.vertices = ent.vertices.map((v: Vertex2D) => {\n          const p = ocs.pt(v.x, v.y);\n          return { x: p.x, y: p.y, bulge: (v.bulge || 0) * ocs.flipX };\n        });\n      } else if (\n        (ent.type === \'CIRCLE\' || ent.type === \'ARC\') &&\n        ent.center\n      ) {\n        ent.center = ocs.pt(ent.center.x, ent.center.y);\n        if (ent.type === \'ARC\' && ocs.flipX < 0) {\n          const sa = ent.startAngle || 0,\n            ea = ent.endAngle || 0;\n          ent.startAngle = 180 - ea;\n          ent.endAngle = 180 - sa;\n        }\n      } else if (ent.type === \'INSERT\' && ent.position && type === \'INSERT\') {\n        ent.position = ocs.pt(ent.position.x, ent.position.y);\n        if (ocs.flipX < 0) {\n          ent.scaleX = -(ent.scaleX !== undefined ? ent.scaleX : 1);\n          ent.rotation = -(ent.rotation || 0);\n        }\n      } else if (ent.type === \'TEXT\' && ent.position) {\n        ent.position = ocs.pt(ent.position.x, ent.position.y);\n        if (ocs.flipX < 0) ent.rotation = -(ent.rotation || 0);\n      }\n    }\n\n    if (ent.type === \'LWPOLYLINE\' && ent.vertices.length >= 2) {\n      ent.vertices = expandVerticesWithBulge(ent.vertices, ent.closed);\n    }\n\n    return { entity: ent as CadEntity, nextIndex: i };\n  }\n\n  let idx = 0;\n  while (idx < pairs.length) {\n    const p = pairs[idx];\n    if (\n      p.code === 0 &&\n      p.value === \'SECTION\' &&\n      idx + 1 < pairs.length &&\n      pairs[idx + 1].code === 2\n    ) {\n      section = pairs[idx + 1].value;\n      idx += 2;\n      continue;\n    }\n    if (p.code === 0 && p.value === \'ENDSEC\') {\n      section = \'\';\n      inLayerTable = false;\n      currentBlock = null;\n      idx++;\n      continue;\n    }\n\n    if (section === \'TABLES\') {\n      if ("
