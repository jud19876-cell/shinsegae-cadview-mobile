        instruction: "Add offscreen buffer and alias ctx = drawCtx in render"
        is_edit: true
        file {
          absolute_uri: "file:///src/components/CADCanvas.tsx"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "  // 60FPS Render Loop\n  useEffect(() => {\n    const canvas = canvasRef.current;\n    if (!canvas) return;\n    const ctx = canvas.getContext(\'2d\', { alpha: false });\n    if (!ctx) return;\n\n    let animId: number;\n    const render = () => {\n      const cw = canvas.width;\n      const ch = canvas.height;\n      if (!cw || !ch) return;\n\n      // Surface Background: AI-Vault Soft Ivory vs Dark vs Blueprint\n      const bgMap = { white: \'#F8F7F4\', dark: \'#0B101B\', blueprint: \'#071B38\' };\n      ctx.fillStyle = bgMap[theme] || \'#F8F7F4\';\n      ctx.fillRect(0, 0, cw, ch);"
          replacement_content: "  const offscreenRef = useRef<HTMLCanvasElement | null>(null);\n  const animFrameRef = useRef<number | null>(null);\n\n  const latestRef = useRef({\n    camX,\n    camY,\n    zoom,\n    rotation,\n    mode,\n    unitScaleFactor,\n    screenToWorld,\n    findSnapPoint,\n    onUpdateCamera,\n    onUpdateMouseWorld,\n    handlePointTap,\n  });\n\n  latestRef.current = {\n    camX,\n    camY,\n    zoom,\n    rotation,\n    mode,\n    unitScaleFactor,\n    screenToWorld,\n    findSnapPoint,\n    onUpdateCamera,\n    onUpdateMouseWorld,\n    handlePointTap,\n  };\n\n  // Double-Buffered 60FPS Render Loop (100% Flicker-Free)\n  useEffect(() => {\n    const canvas = canvasRef.current;\n    if (!canvas) return;\n\n    const render = () => {\n      const cw = canvas.width;\n      const ch = canvas.height;\n      if (!cw || !ch) return;\n\n      let offscreen = offscreenRef.current;\n      if (!offscreen) {\n        offscreen = document.createElement(\'canvas\');\n        offscreenRef.current = offscreen;\n      }\n      if (offscreen.width !== cw || offscreen.height !== ch) {\n        offscreen.width = cw;\n        offscreen.height = ch;\n      }\n      const drawCtx = offscreen.getContext(\'2d\', { alpha: false });\n      if (!drawCtx) return;\n      const ctx = drawCtx;\n\n      // Surface Background: AI-Vault Soft Ivory vs Dark vs Blueprint\n      const bgMap = { white: \'#F8F7F4\', dark: \'#0B101B\', blueprint: \'#071B38\' };\n      ctx.fillStyle = bgMap[theme] || \'#F8F7F4\';\n      ctx.fillRect(0, 0, cw, ch);"
          start_line: 401
          end_line: 425
        }
      }
    }
