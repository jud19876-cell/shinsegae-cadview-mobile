        replacement_content: "      // Atomic double-buffer copy from offscreen canvas to visible onscreen canvas (100% flicker-free)\n      const onScreenCtx = canvas.getContext(\'2d\', { alpha: false });\n      if (onScreenCtx) {\n        onScreenCtx.drawImage(offscreen, 0, 0);\n      }\n    },\n    []\n  );\n\n  // Request-on-demand: Coalesce into at most 1 render per VSYNC frame\n  const requestRender = useCallback(\n    (force = false) => {\n      if (force) {\n        isDirtyRef.current = true;\n      }\n      if (animFrameRef.current !== null) {\n        return;\n      }\n      animFrameRef.current = requestAnimationFrame(() => {\n        animFrameRef.current = null;\n        render();\n      });\n    },\n    [render]\n  );\n\n  // Request-on-demand: Trigger frame only when visual props or canvas dimensions update\n  useEffect(() => {\n    isDirtyRef.current = true;\n    requestRender();\n    return () => {\n      if (animFrameRef.current !== null) {\n        cancelAnimationFrame(animFrameRef.current);\n        animFrameRef.current = null;\n      }\n    };\n  }, [\n    theme,\n    showGrid,\n    entities,\n    renderBatches,\n    textEntities,\n    rasterEntities,\n    layers,\n    selectedEntity,\n    measurements,\n    measurePoints,\n    camX,\n    camY,\n    zoom,\n    rotation,\n    textScale,\n    enableOsnap,\n    canvasDimensions,\n    requestRender,\n  ]);"
