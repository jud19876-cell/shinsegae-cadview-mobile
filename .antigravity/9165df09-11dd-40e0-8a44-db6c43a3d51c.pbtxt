  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useState, useEffect, useCallback } from \'react\';\nimport {\n  Cloud,\n  Search,\n  RefreshCw,\n  LogOut,\n  LogIn,\n  FileCode,\n  FolderSync,\n  ExternalLink,\n  CheckCircle2,\n  AlertCircle,\n  Clock,\n  HardDrive,\n  Download,\n  Link,\n  Key,\n  ShieldCheck,\n  ChevronRight,\n  ArrowRight,\n  Info,\n} from \'lucide-react\';\nimport {\n  signInWithGoogleDrive,\n  signOutFromGoogleDrive,\n  subscribeToGoogleAuth,\n  listGoogleDriveDwgFiles,\n  downloadGoogleDriveFile,\n  formatFileSize,\n  getDriveAccessToken,\n  GoogleDriveFileItem,\n} from \'../lib/googleDrive\';\nimport {\n  connectDropboxWithToken,\n  disconnectDropbox,\n  getDropboxAccount,\n  getDropboxToken,\n  listDropboxDwgFiles,\n  downloadDropboxFile,\n  downloadFromDropboxSharedLink,\n  DropboxFileItem,\n  DropboxAccount,\n} from \'../lib/dropbox\';\nimport { User } from \'firebase/auth\';\n\ninterface CloudStorageExplorerProps {\n  onOpenCloudFile: (arrayBuffer: ArrayBuffer, fileName: string) => Promise<void>;\n  showToast: (msg: string) => void;\n  activeProvider?: \'google\' | \'dropbox\';\n}\n\nexport const CloudStorageExplorer: React.FC<CloudStorageExplorerProps> = ({\n  onOpenCloudFile,\n  showToast,\n  activeProvider = \'google\',\n}) => {\n  const [provider, setProvider] = useState<\'google\' | \'dropbox\'>(activeProvider);\n\n  // Google Drive state\n  const [googleUser, setGoogleUser] = useState<User | null>(null);\n  const [googleFiles, setGoogleFiles] = useState<GoogleDriveFileItem[]>([]);\n  const [googleSearchQuery, setGoogleSearchQuery] = useState(\'\');\n  const [isGoogleLoading, setIsGoogleLoading] = useState(false);\n  const [googleLoadingAction, setGoogleLoadingAction] = useState(\'\');\n  const [googleError, setGoogleError] = useState<string | null>(null);\n\n  // Dropbox state\n  const [dropboxAccount, setDropboxAccount] = useState<DropboxAccount | null>(getDropboxAccount());\n  const [dropboxTokenInput, setDropboxTokenInput] = useState(\'\');\n  const [dropboxShareUrl, setDropboxShareUrl] = useState(\'\');\n  const [dropboxFiles, setDropboxFiles] = useState<DropboxFileItem[]>([]);\n  const [dropboxSearchQuery, setDropboxSearchQuery] = useState(\'\');\n  const [isDropboxLoading, setIsDropboxLoading] = useState(false);\n  const [dropboxLoadingAction, setDropboxLoadingAction] = useState(\'\');\n  const [dropboxError, setDropboxError] = useState<string | null>(null);\n  const [showTokenHelp, setShowTokenHelp] = useState(false);\n\n  // Listen to Google Auth changes\n  useEffect(() => {\n    const unsubscribe = subscribeToGoogleAuth((user) => {\n      setGoogleUser(user);\n      if (user && getDriveAccessToken()) {\n        loadGoogleFiles();\n      } else {\n        setGoogleFiles([]);\n      }\n    });\n    return () => unsubscribe();\n  }, []);\n\n  // Load Google Drive files\n  const loadGoogleFiles = useCallback(async (query: string = \'\') => {\n    try {\n      setIsGoogleLoading(true);\n      setGoogleLoadingAction(\'Google Drive\354\227\220\354\204\234 DWG/DXF \353\217\204\353\251\264\354\235\204 \352\262\200\354\203\211\355\225\230\353\212\224 \354\244\221...\');\n      setGoogleError(null);\n      const res = await listGoogleDriveDwgFiles(query);\n      setGoogleFiles(res.files);\n    } catch (err: any) {\n      console.error(\'Failed to load Google Drive files:\', err);\n      const msg = err?.message || \'Google Drive \355\214\214\354\235\274\354\235\204 \353\266\210\353\237\254\354\230\254 \354\210\230 \354\227\206\354\212\265\353\213\210\353\213\244.\';\n      setGoogleError(msg);\n      showToast(`Google Drive: ${msg}`);\n    } finally {\n      setIsGoogleLoading(false);\n      setGoogleLoadingAction(\'\');\n    }\n  }, [showToast]);\n\n  // Handle Google Login\n  const handleGoogleSignIn = async () => {\n    try {\n      setIsGoogleLoading(true);\n      setGoogleLoadingAction(\'Google \352\263\204\354\240\225 \353\241\234\352\267\270\354\235\270 \354\244\221...\');\n      setGoogleError(null);\n      const { user } = await signInWithGoogleDrive();\n      setGoogleUser(user);\n      showToast(`${user.displayName || user.email} \352\263\204\354\240\225\354\234\274\353\241\234 Google Drive \354\227\260\353\217\231 \354\231\204\353\243\214`);\n      await loadGoogleFiles();\n    } catch (err: any) {\n      console.error(\'Google sign in error:\', err);\n      const msg = err?.message || \'Google Drive \353\241\234\352\267\270\354\235\270\354\227\220 \354\213\244\355\214\250\355\226\210\354\212\265\353\213\210\353\213\244.\';\n      setGoogleError(msg);\n      showToast(`\353\241\234\352\267\270\354\235\270 \354\213\244\355\214\250: ${msg}`);\n    } finally {\n      setIsGoogleLoading(false);\n      setGoogleLoadingAction(\'\');\n    }\n  };\n\n  // Handle Google Sign Out\n  const handleGoogleSignOut = async () => {\n    try {\n      await signOutFromGoogleDrive();\n      setGoogleUser(null);\n      setGoogleFiles([]);\n      showToast(\'Google Drive \352\263\204\354\240\225\354\227\220\354\204\234 \353\241\234\352\267\270\354\225\204\354\233\203\353\220\230\354\227\210\354\212\265\353\213\210\353\213\244.\');\n    } catch (err: any) {\n      showToast(\'\353\241\234\352\267\270\354\225\204\354\233\203 \354\244\221 \354\230\244\353\245\230\352\260\200 \353\260\234\354\203\235\355\226\210\354\212\265\353\213\210\353\213\244.\');\n    }\n  };\n\n  // Handle Opening a Google Drive File\n  const handleSelectGoogleFile = async (file: GoogleDriveFileItem) => {\n    try {\n      setIsGoogleLoading(true);\n      setGoogleLoadingAction(`${file.name} \353\213\244\354\232\264\353\241\234\353\223\234 \353\260\217 \355\214\214\354\213\261 \354\244\200\353\271\204 \354\244\221...`);\n      const buffer = await downloadGoogleDriveFile(file.id);\n      await onOpenCloudFile(buffer, file.name);\n    } catch (err: any) {\n      console.error(\'Open Google Drive file error:\', err);\n      showToast(`\355\214\214\354\235\274 \354\227\264\352\270\260 \354\213\244\355\214\250: ${err?.message || \'\354\225\214 \354\210\230 \354\227\206\353\212\224 \354\230\244\353\245\230\'}`);\n    } finally {\n      setIsGoogleLoading(false);\n      setGoogleLoadingAction(\'\');\n    }\n  };\n\n  // Load Dropbox files\n  const loadDropboxFiles = useCallback(async (query: string = \'\') => {\n    if (!getDropboxToken()) return;\n    try {\n      setIsDropboxLoading(true);\n      setDropboxLoadingAction(\'Dropbox\354\227\220\354\204\234 \353\217\204\353\251\264 \353\252\251\353\241\235\354\235\204 \354\241\260\355\232\214\355\225\230\353\212\224 \354\244\221...\');\n      setDropboxError(null);\n      const files = await listDropboxDwgFiles(\'\', query);\n      setDropboxFiles(files);\n    } catch (err: any) {\n      console.error(\'Failed to load Dropbox files:\', err);\n      const msg = err?.message || \'Dropbox \353\217\204\353\251\264 \353\252\251\353\241\235\354\235\204 \352\260\200\354\240\270\354\230\244\354\247\200 \353\252\273\355\226\210\354\212\265\353\213\210\353\213\244.\';\n      setDropboxError(msg);\n      showToast(`Dropbox: ${msg}`);\n    } finally {\n      setIsDropboxLoading(false);\n      setDropboxLoadingAction(\'\');\n    }\n  }, [showToast]);\n\n  // Initial Dropbox files load if token exists\n  useEffect(() => {\n    if (getDropboxToken()) {\n      loadDropboxFiles();\n    }\n  }, [loadDropboxFiles]);\n\n  // Handle Dropbox Token Connection\n  const handleConnectDropbox = async () => {\n    if (!dropboxTokenInput.trim()) {\n      showToast(\'Dropbox \354\225\241\354\204\270\354\212\244 \355\206\240\355\201\260\354\235\204 \354\236\205\353\240\245\355\225\264 \354\243\274\354\204\270\354\232\224.\');\n      return;\n    }\n    try {\n      setIsDropboxLoading(true);\n      setDropboxLoadingAction(\'Dropbox \352\263\204\354\240\225 \354\235\270\354\246\235 \354\244\221...\');\n      setDropboxError(null);\n      const acc = await connectDropboxWithToken(dropboxTokenInput.trim());\n      setDropboxAccount(acc);\n      setDropboxTokenInput(\'\');\n      showToast(`${acc.displayName} \352\263\204\354\240\225\354\234\274\353\241\234 Dropbox \354\227\260\353\217\231 \354\231\204\353\243\214!`);\n      await loadDropboxFiles();\n    } catch (err: any) {\n      const msg = err?.message || \'Dropbox \354\227\260\353\217\231\354\227\220 \354\213\244\355\214\250\355\226\210\354\212\265\353\213\210\353\213\244.\';\n      setDropboxError(msg);\n      showToast(`Dropbox \354\227\260\353\217\231 \354\213\244\355\214\250: ${msg}`);\n    } finally {\n      setIsDropboxLoading(false);\n      setDropboxLoadingAction(\'\');\n    }\n  };\n\n  // Handle Dropbox Disconnect\n  const handleDisconnectDropbox = () => {\n    disconnectDropbox();\n    setDropboxAccount(null);\n    setDropboxFiles([]);\n    showToast(\'Dropbox \354\227\260\353\217\231\354\235\264 \355\225\264\354\240\234\353\220\230\354\227\210\354\212\265\353\213\210\353\213\244.\');\n  };\n\n  // Handle Opening a Dropbox File via API\n  const handleSelectDropboxFile = async (file: DropboxFileItem) => {\n    try {\n      setIsDropboxLoading(true);\n      setDropboxLoadingAction(`${file.name} \353\213\244\354\232\264\353\241\234\353\223\234 \354\244\221...`);\n      const buffer = await downloadDropboxFile(file.pathLower);\n      await onOpenCloudFile(buffer, file.name);\n    } catch (err: any) {\n      showToast(`Dropbox \355\214\214\354\235\274 \354\227\264\352\270\260 \354\213\244\355\214\250: ${err?.message || \'\354\225\214 \354\210\230 \354\227\206\353\212\224 \354\230\244\353\245\230\'}`);\n    } finally {\n      setIsDropboxLoading(false);\n      setDropboxLoadingAction(\'\');\n    }\n  };\n\n  // Handle Opening a Dropbox Shared Link\n  const handleOpenDropboxSharedLink = async () => {\n    if (!dropboxShareUrl.trim()) {\n      showToast(\'Dropbox \352\263\265\354\234\240 \353\247\201\355\201\254 URL\354\235\204 \354\236\205\353\240\245\355\225\264\354\243\274\354\204\270\354\232\224.\');\n      return;\n    }\n    try {\n      setIsDropboxLoading(true);\n      setDropboxLoadingAction(\'Dropbox \352\263\265\354\234\240 \353\247\201\355\201\254\354\227\220\354\204\234 \353\217\204\353\251\264 \353\213\244\354\232\264\353\241\234\353\223\234 \354\244\221...\');\n      const { arrayBuffer, fileName } = await downloadFromDropboxSharedLink(dropboxShareUrl.trim());\n      await onOpenCloudFile(arrayBuffer, fileName);\n      setDropboxShareUrl(\'\');\n    } catch (err: any) {\n      showToast(`\352\263\265\354\234\240 \353\247\201\355\201\254 \354\227\264\352\270\260 \354\213\244\355\214\250: ${err?.message || \'\353\247\201\355\201\254\353\245\274 \355\231\225\354\235\270\355\225\264\354\243\274\354\204\270\354\232\224.\'}`);\n    } finally {\n      setIsDropboxLoading(false);\n      setDropboxLoadingAction(\'\');\n    }\n  };\n\n  return (\n    <div className=\"flex flex-col h-full space-y-4\">\n      {/* Cloud Provider Tabs */}\n      <div className=\"flex p-1 bg-slate-100 dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700/60 shrink-0\">\n        <button\n          onClick={() => setProvider(\'google\')}\n          className={`flex-1 py-2 px-3 rounded-lg text-xs font-bold flex items-center justify-center gap-2 transition ${\n            provider === \'google\'\n              ? \'bg-white dark:bg-slate-900 text-[#1E3A8A] dark:text-blue-400 shadow-xs\'\n              : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white\'\n          }`}\n        >\n          {/* Google Drive SVG Logo */}\n          <svg className=\"w-4 h-4 shrink-0\" viewBox=\"0 0 87.3 78\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"m6.6 66.85 3.85 6.65c.8 1.4 1.95 2.5 3.3 3.3l13.75-23.8h-27.5c0 1.55.4 3.1 1.2 4.5z\" fill=\"#0066da\"/>\n            <path d=\"m43.65 25-13.75-23.8c-1.35.8-2.5 1.9-3.3 3.3l-25.4 44c-.8 1.4-1.2 2.95-1.2 4.5h27.5z\" fill=\"#00ac47\"/>\n            <path d=\"m73.55 76.8c1.35-.8 2.5-1.9 3.3-3.3l1.6-2.75 7.65-13.25c.8-1.4 1.2-2.95 1.2-4.5h-27.5l5.85 10.15z\" fill=\"#ea4335\"/>\n            <path d=\"m43.65 25 13.75-23.8c-1.35-.8-2.9-1.2-4.5-1.2h-18.5c-1.6 0-3.15.45-4.5 1.2z\" fill=\"#00832d\"/>\n            <path d=\"m59.8 53h-32.3l-13.75 23.8c1.35.8 2.9 1.2 4.5 1.2h50.8c1.6 0 3.15-.45 4.5-1.2z\" fill=\"#2684fc\"/>\n            <path d=\"m73.4 26.5-12.7-22c-.8-1.4-1.95-2.5-3.3-3.3l-13.75 23.8 16.15 28h27.45c0-1.55-.4-3.1-1.2-4.5z\" fill=\"#ffba00\"/>\n          </svg>\n          <span>Google Drive</span>\n          {googleUser && (\n            <span className=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\" />\n          )}\n        </button>\n\n        <button\n          onClick={() => setProvider(\'dropbox\')}\n          className={`flex-1 py-2 px-3 rounded-lg text-xs font-bold flex items-center justify-center gap-2 transition ${\n            provider === \'dropbox\'\n              ? \'bg-white dark:bg-slate-900 text-[#0061FF] dark:text-blue-400 shadow-xs\'\n              : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white\'\n          }`}\n        >\n          {/* Dropbox SVG Logo */}\n          <svg className=\"w-4 h-4 shrink-0\" viewBox=\"0 0 40 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M10.5 7.5L20 13.75L10.5 20L1 13.75L10.5 7.5Z\" fill=\"#0061FF\"/>\n            <path d=\"M29.5 7.5L39 13.75L29.5 20L20 13.75L29.5 7.5Z\" fill=\"#0061FF\"/>\n            <path d=\"M1 26.25L10.5 20L20 26.25L10.5 32.5L1 26.25Z\" fill=\"#0061FF\"/>\n            <path d=\"M39 26.25L29.5 20L20 26.25L29.5 32.5L39 26.25Z\" fill=\"#0061FF\"/>\n            <path d=\"M20 27.5L29.5 33.75L20 40L10.5 33.75L20 27.5Z\" fill=\"#0061FF\"/>\n          </svg>\n          <span>Dropbox</span>\n          {dropboxAccount && (\n            <span className=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\" />\n          )}\n        </button>\n      </div>\n\n      {/* ========================================================================= */}\n      {/* GOOGLE DRIVE PANEL */}\n      {/* ========================================================================= */}\n      {provider === \'google\' && (\n        <div className=\"space-y-4 flex-1 flex flex-col min-h-0\">\n          {/* Auth Bar */}\n          {!googleUser ? (\n            <div className=\"p-4 rounded-xl bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-slate-800/80 dark:to-blue-950/40 border border-blue-200 dark:border-blue-900/50 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left\">\n              <div className=\"space-y-1\">\n                <div className=\"flex items-center justify-center sm:justify-start gap-1.5 text-xs font-bold text-[#1E3A8A] dark:text-blue-300\">\n                  <ShieldCheck className=\"w-4 h-4 text-emerald-600 dark:text-emerald-400\" />\n                  <span>Google Workspace \352\263\265\354\213\235 OAuth \354\227\260\353\217\231</span>\n                </div>\n                <p className=\"text-xs text-slate-600 dark:text-slate-300\">\n                  Google \352\263\204\354\240\225\354\234\274\353\241\234 \353\241\234\352\267\270\354\235\270\355\225\230\354\227\254 \353\202\264 \353\223\234\353\235\274\354\235\264\353\270\214\354\235\230 DWG/DXF \353\217\204\353\251\264\354\235\204 \354\247\201\354\240\221 \352\262\200\354\203\211\355\225\230\352\263\240 \354\227\275\353\213\210\353\213\244.\n                </p>\n              </div>\n              <button\n                onClick={handleGoogleSignIn}\n                disabled={isGoogleLoading}\n                className=\"w-full sm:w-auto bg-[#1E3A8A] hover:bg-[#172e6e] text-white px-4 py-2.5 rounded-xl text-xs font-bold flex items-center justify-center gap-2 active:scale-95 transition shadow-sm shrink-0 disabled:opacity-50\"\n              >\n                <LogIn className=\"w-4 h-4\" />\n                <span>Google Drive \353\241\234\352\267\270\354\235\270</span>\n              </button>\n            </div>\n          ) : (\n            <div className=\"p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 flex items-center justify-between gap-2\">\n              <div className=\"flex items-center gap-2.5 min-w-0\">\n                {googleUser.photoURL ? (\n                  <img\n                    src={googleUser.photoURL}\n                    alt={googleUser.displayName || \'\'}\n                    className=\"w-8 h-8 rounded-full border border-blue-300\"\n                  />\n                ) : (\n                  <div className=\"w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-xs flex items-center justify-center\">\n                    {(googleUser.displayName || googleUser.email || \'G\')[0].toUpperCase()}\n                  </div>\n                )}\n                <div className=\"min-w-0\">\n                  <div className=\"text-xs font-bold text-slate-800 dark:text-white truncate\">\n                    {googleUser.displayName || \'Google \354\202\254\354\232\251\354\236\220\'}\n                  </div>\n                  <div className=\"text-[10px] text-slate-500 dark:text-slate-400 truncate\">\n                    {googleUser.email}\n                  </div>\n                </div>\n              </div>\n              <div className=\"flex items-center gap-1.5 shrink-0\">\n                <button\n                  onClick={() => loadGoogleFiles(googleSearchQuery)}\n                  disabled={isGoogleLoading}\n                  className=\"p-1.5 rounded-lg bg-white dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 border border-slate-200 dark:border-slate-600 transition\"\n                  title=\"\355\214\214\354\235\274 \353\252\251\353\241\235 \354\203\210\353\241\234\352\263\240\354\271\250\"\n                >\n                  <RefreshCw className={`w-3.5 h-3.5 ${isGoogleLoading ? \'animate-spin\' : \'\'}`} />\n                </button>\n                <button\n                  onClick={handleGoogleSignOut}\n                  className=\"px-2.5 py-1.5 rounded-lg text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/30 text-xs font-semibold flex items-center gap-1 transition\"\n                  title=\"\353\241\234\352\267\270\354\225\204\354\233\203\"\n                >\n                  <LogOut className=\"w-3.5 h-3.5\" />\n                  <span className=\"hidden sm:inline\">\353\241\234\352\267\270\354\225\204\354\233\203</span>\n                </button>\n              </div>\n            </div>\n          )}\n\n          {/* Search Bar (Enabled if logged in) */}\n          {googleUser && (\n            <div className=\"relative\">\n              <input\n                type=\"text\"\n                placeholder=\"Google Drive \353\202\264 DWG / DXF \355\214\214\354\235\274\353\252\205 \352\262\200\354\203\211...\"\n                value={googleSearchQuery}\n                onChange={(e) => setGoogleSearchQuery(e.target.value)}\n                onKeyDown={(e) => {\n                  if (e.key === \'Enter\') {\n                    loadGoogleFiles(googleSearchQuery);\n                  }\n                }}\n                className=\"w-full pl-9 pr-16 py-2 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-[#1E3A8A]\"\n              />\n              <Search className=\"w-4 h-4 text-slate-400 absolute left-3 top-2.5\" />\n              <button\n                onClick={() => loadGoogleFiles(googleSearchQuery)}\n                className=\"absolute right-1.5 top-1.5 bg-[#1E3A8A] text-white px-2 py-1 rounded-lg text-[10px] font-bold\"\n              >\n                \352\262\200\354\203\211\n              </button>\n            </div>\n          )}\n\n          {/* Google Error Message */}\n          {googleError && (\n            <div className=\"p-3 rounded-xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-900/50 text-xs text-rose-700 dark:text-rose-300 flex items-center gap-2\">\n              <AlertCircle className=\"w-4 h-4 shrink-0\" />\n              <span>{googleError}</span>\n            </div>\n          )}\n\n          {/* Google Files List */}\n          <div className=\"flex-1 overflow-y-auto space-y-2 min-h-[180px] custom-scrollbar\">\n            {isGoogleLoading ? (\n              <div className=\"py-12 flex flex-col items-center justify-center text-slate-400 text-center space-y-2\">\n                <div className=\"w-8 h-8 rounded-full border-3 border-[#1E3A8A]/30 border-t-[#1E3A8A] animate-spin\" />\n                <p className=\"text-xs font-semibold\">{googleLoadingAction || \'\353\241\234\353\224\251 \354\244\221...\'}</p>\n              </div>\n            ) : !googleUser ? (\n              <div className=\"py-12 text-center text-slate-400 space-y-2 border border-dashed border-slate-200 dark:border-slate-800 rounded-2xl p-6\">\n                <Cloud className=\"w-10 h-10 mx-auto text-[#1E3A8A] dark:text-blue-400 opacity-60\" />\n                <div className=\"text-xs font-bold text-slate-700 dark:text-slate-200\">\n                  Google Drive\354\227\220 \354\227\260\352\262\260\353\220\230\354\247\200 \354\225\212\354\225\230\354\212\265\353\213\210\353\213\244\n                </div>\n                <p className=\"text-[11px] text-slate-500 max-w-sm mx-auto\">\n                  \354\203\201\353\213\250\354\235\230 [Google Drive \353\241\234\352\267\270\354\235\270] \353\262\204\355\212\274\354\235\204 \353\210\214\353\237\254 \352\263\204\354\240\225\354\235\204 \354\227\260\352\262\260\355\225\230\353\251\264 \353\223\234\353\235\274\354\235\264\353\270\214 \353\202\264 \353\252\250\353\223\240 CAD \353\217\204\353\251\264\354\235\204 \354\246\211\354\213\234 \354\227\264 \354\210\230 \354\236\210\354\212\265\353\213\210\353\213\244.\n                </p>\n              </div>\n            ) : googleFiles.length === 0 ? (\n              <div className=\"py-12 text-center text-slate-400 space-y-2 border border-dashed border-slate-200 dark:border-slate-800 rounded-2xl p-6\">\n                <FileCode className=\"w-10 h-10 mx-auto text-slate-300 dark:text-slate-600\" />\n                <div className=\"text-xs font-bold text-slate-700 dark:text-slate-200\">\n                  {googleSearchQuery ? `\'${googleSearchQuery}\' \352\262\200\354\203\211 \352\262\260\352\263\274\352\260\200 \354\227\206\354\212\265\353\213\210\353\213\244` : \'Google Drive\354\227\220 DWG/DXF \355\214\214\354\235\274\354\235\264 \354\227\206\354\212\265\353\213\210\353\213\244\'}\n                </div>\n                <p className=\"text-[11px] text-slate-500 max-w-sm mx-auto\">\n                  Google Drive\354\227\220 .dwg \353\230\220\353\212\224 .dxf \355\214\214\354\235\274\354\235\204 \354\227\205\353\241\234\353\223\234\355\225\234 \355\233\204 \354\232\260\354\270\241 \354\203\201\353\213\250\354\235\230 \354\203\210\353\241\234\352\263\240\354\271\250 \353\262\204\355\212\274\354\235\204 \353\210\214\353\237\254\354\243\274\354\204\270\354\232\224.\n                </p>\n              </div>\n            ) : (\n              <div className=\"space-y-1.5\">\n                <div className=\"text-[11px] font-bold text-slate-500 dark:text-slate-400 px-1 flex items-center justify-between\">\n                  <span>\352\262\200\354\203\211\353\220\234 \353\217\204\353\251\264 ({googleFiles.length}\352\260\234)</span>\n                  <span>\355\201\264\353\246\255 \354\213\234 \354\246\211\354\213\234 \354\227\264\352\270\260</span>\n                </div>\n                {googleFiles.map((file) => {\n                  const isDwg = file.name.toLowerCase().endsWith(\'.dwg\');\n                  return (\n                    <div\n                      key={file.id}\n                      onClick={() => handleSelectGoogleFile(file)}\n                      className=\"group cursor-pointer p-3 rounded-xl bg-slate-50 hover:bg-blue-50/60 dark:bg-slate-800/60 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700/70 hover:border-blue-400 dark:hover:border-blue-500 flex items-center justify-between gap-3 transition shadow-xs\"\n                    >\n                      <div className=\"flex items-center gap-3 min-w-0 flex-1\">\n                        <div\n                          className={`w-9 h-9 rounded-xl flex items-center justify-center font-bold text-xs shrink-0 ${\n                            isDwg\n                              ? \'bg-[#C8102E]/10 text-[#C8102E] border border-[#C8102E]/20\'\n                              : \'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20\'\n                          }`}\n                        >\n                          {isDwg ? \'DWG\' : \'DXF\'}\n                        </div>\n                        <div className=\"min-w-0 flex-1\">\n                          <div className=\"text-xs font-bold text-slate-800 dark:text-slate-100 truncate group-hover:text-[#1E3A8A] dark:group-hover:text-blue-400\">\n                            {file.name}\n                          </div>\n                          <div className=\"text-[10px] text-slate-500 dark:text-slate-400 flex items-center gap-2 mt-0.5 font-mono\">\n                            <span>{formatFileSize(file.size)}</span>\n                            {file.modifiedTime && (\n                              <span>\302\267 {new Date(file.modifiedTime).toLocaleDateString()}</span>\n                            )}\n                          </div>\n                        </div>\n                      </div>\n                      <button\n                        onClick={(e) => {\n                          e.stopPropagation();\n                          handleSelectGoogleFile(file);\n                        }}\n                        className=\"bg-[#1E3A8A] hover:bg-[#172e6e] text-white px-3 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1 active:scale-95 transition shrink-0\"\n                      >\n                        <Download className=\"w-3.5 h-3.5\" />\n                        <span>\354\227\264\352\270\260</span>\n                      </button>\n                    </div>\n                  );\n                })}\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* ========================================================================= */}\n      {/* DROPBOX PANEL */}\n      {/* ========================================================================= */}\n      {provider === \'dropbox\' && (\n        <div className=\"space-y-4 flex-1 flex flex-col min-h-0\">\n          {/* Quick Option 1: Direct Shared Link Import */}\n          <div className=\"p-3.5 rounded-xl bg-gradient-to-r from-blue-50 to-sky-50 dark:from-slate-800/80 dark:to-blue-950/40 border border-blue-200 dark:border-blue-900/50 space-y-2.5\">\n            <div className=\"flex items-center justify-between\">\n              <span className=\"text-xs font-bold text-[#0061FF] dark:text-blue-300 flex items-center gap-1.5\">\n                <Link className=\"w-4 h-4\" />\n                <span>Dropbox \352\263\265\354\234\240 \353\247\201\355\201\254\353\241\234 \354\246\211\354\213\234 \353\217\204\353\251\264 \354\227\264\352\270\260</span>\n              </span>\n              <span className=\"text-[10px] bg-blue-100 dark:bg-blue-900/50 text-[#0061FF] dark:text-blue-300 px-2 py-0.5 rounded-full font-bold\">\n                \353\241\234\352\267\270\354\235\270 \353\266\210\355\225\204\354\232\224\n              </span>\n            </div>\n            <p className=\"text-[11px] text-slate-600 dark:text-slate-300\">\n              Dropbox \353\247\201\355\201\254(https://www.dropbox.com/s/...)\353\245\274 \353\266\231\354\227\254\353\204\243\354\234\274\353\251\264 \354\225\261\354\227\220\354\204\234 \353\260\224\353\241\234 \353\213\244\354\232\264\353\241\234\353\223\234 \353\260\217 \353\240\214\353\215\224\353\247\201\355\225\251\353\213\210\353\213\244.\n            </p>\n            <div className=\"flex gap-2\">\n              <input\n                type=\"url\"\n                placeholder=\"Dropbox \353\217\204\353\251\264 \352\263\265\354\234\240 \353\247\201\355\201\254 URL \353\266\231\354\227\254\353\204\243\352\270\260...\"\n                value={dropboxShareUrl}\n                onChange={(e) => setDropboxShareUrl(e.target.value)}\n                onKeyDown={(e) => {\n                  if (e.key === \'Enter\') handleOpenDropboxSharedLink();\n                }}\n                className=\"flex-1 px-3 py-2 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-[#0061FF]\"\n              />\n              <button\n                onClick={handleOpenDropboxSharedLink}\n                disabled={isDropboxLoading || !dropboxShareUrl.trim()}\n                className=\"bg-[#0061FF] hover:bg-[#0052d9] text-white px-3.5 py-2 rounded-xl text-xs font-bold flex items-center gap-1.5 active:scale-95 transition disabled:opacity-50 shrink-0\"\n              >\n                <Download className=\"w-3.5 h-3.5\" />\n                <span>\353\217\204\353\251\264 \354\227\264\352\270\260</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Option 2: Dropbox Account Integration */}\n          {!dropboxAccount ? (\n            <div className=\"p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/80 space-y-2.5\">\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-1.5 text-xs font-bold text-slate-800 dark:text-white\">\n                  <Key className=\"w-4 h-4 text-amber-500\" />\n                  <span>Dropbox \352\263\204\354\240\225 \354\227\260\353\217\231 (API Token)</span>\n                </div>\n                <button\n                  onClick={() => setShowTokenHelp((prev) => !prev)}\n                  className=\"text-[11px] text-slate-500 hover:text-blue-600 dark:hover:text-blue-400 flex items-center gap-0.5\"\n                >\n                  <Info className=\"w-3 h-3\" />\n                  <span>\355\206\240\355\201\260 \353\260\234\352\270\211 \354\225\210\353\202\264</span>\n                </button>\n              </div>\n\n              {showTokenHelp && (\n                <div className=\"p-2.5 rounded-lg bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/50 text-[11px] text-amber-900 dark:text-amber-200 space-y-1\">\n                  <p className=\"font-semibold\">Dropbox \355\206\240\355\201\260 \353\260\234\352\270\211 30\354\264\210 \352\260\200\354\235\264\353\223\234:</p>\n                  <ol className=\"list-decimal pl-4 space-y-0.5\">\n                    <li>\n                      <a\n                        href=\"https://www.dropbox.com/developers/apps\"\n                        target=\"_blank\"\n                        rel=\"noreferrer\"\n                        className=\"underline font-bold text-blue-600 dark:text-blue-400 inline-flex items-center gap-0.5\"\n                      >\n                        Dropbox App Console <ExternalLink className=\"w-2.5 h-2.5 inline\" />\n                      </a>\n                      \354\227\220\354\204\234 \'Create app\' \355\201\264\353\246\255\n                    </li>\n                    <li>Scoped access \354\204\240\355\203\235 \353\260\217 files.content.read \352\266\214\355\225\234 \354\262\264\355\201\254</li>\n                    <li>\'Generated access token\' \353\262\204\355\212\274\354\235\204 \353\210\214\353\237\254 \353\263\265\354\202\254 \355\233\204 \354\225\204\353\236\230\354\227\220 \353\266\231\354\227\254\353\204\243\352\270\260</li>\n                  </ol>\n                </div>\n              )}\n\n              <div className=\"flex gap-2\">\n                <input\n                  type=\"password\"\n                  placeholder=\"Dropbox Access Token \353\266\231\354\227\254\353\204\243\352\270\260...\"\n                  value={dropboxTokenInput}\n                  onChange={(e) => setDropboxTokenInput(e.target.value)}\n                  onKeyDown={(e) => {\n                    if (e.key === \'Enter\') handleConnectDropbox();\n                  }}\n                  className=\"flex-1 px-3 py-2 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-[#0061FF]\"\n                />\n                <button\n                  onClick={handleConnectDropbox}\n                  disabled={isDropboxLoading || !dropboxTokenInput.trim()}\n                  className=\"bg-slate-900 dark:bg-blue-600 hover:bg-slate-800 text-white px-3.5 py-2 rounded-xl text-xs font-bold active:scale-95 transition disabled:opacity-50 shrink-0 flex items-center gap-1\"\n                >\n                  <FolderSync className=\"w-3.5 h-3.5\" />\n                  <span>\354\227\260\353\217\231\355\225\230\352\270\260</span>\n                </button>\n              </div>\n            </div>\n          ) : (\n            <div className=\"p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 flex items-center justify-between gap-2\">\n              <div className=\"flex items-center gap-2.5 min-w-0\">\n                {dropboxAccount.profilePhotoUrl ? (\n                  <img\n                    src={dropboxAccount.profilePhotoUrl}\n                    alt={dropboxAccount.displayName}\n                    className=\"w-8 h-8 rounded-full border border-blue-400\"\n                  />\n                ) : (\n                  <div className=\"w-8 h-8 rounded-full bg-[#0061FF] text-white font-bold text-xs flex items-center justify-center\">\n                    {dropboxAccount.displayName[0].toUpperCase()}\n                  </div>\n                )}\n                <div className=\"min-w-0\">\n                  <div className=\"text-xs font-bold text-slate-800 dark:text-white truncate\">\n                    {dropboxAccount.displayName}\n                  </div>\n                  <div className=\"text-[10px] text-slate-500 dark:text-slate-400 truncate\">\n                    {dropboxAccount.email || \'Dropbox \352\263\204\354\240\225\'}\n                  </div>\n                </div>\n              </div>\n              <div className=\"flex items-center gap-1.5 shrink-0\">\n                <button\n                  onClick={() => loadDropboxFiles(dropboxSearchQuery)}\n                  disabled={isDropboxLoading}\n                  className=\"p-1.5 rounded-lg bg-white dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 border border-slate-200 dark:border-slate-600 transition\"\n                  title=\"\355\214\214\354\235\274 \353\252\251\353\241\235 \354\203\210\353\241\234\352\263\240\354\271\250\"\n                >\n                  <RefreshCw className={`w-3.5 h-3.5 ${isDropboxLoading ? \'animate-spin\' : \'\'}`} />\n                </button>\n                <button\n                  onClick={handleDisconnectDropbox}\n                  className=\"px-2.5 py-1.5 rounded-lg text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/30 text-xs font-semibold flex items-center gap-1 transition\"\n                  title=\"\354\227\260\353\217\231 \355\225\264\354\240\234\"\n                >\n                  <LogOut className=\"w-3.5 h-3.5\" />\n                  <span className=\"hidden sm:inline\">\354\227\260\353\217\231 \355\225\264\354\240\234</span>\n                </button>\n              </div>\n            </div>\n          )}\n\n          {/* Dropbox Search Bar (If connected) */}\n          {dropboxAccount && (\n            <div className=\"relative\">\n              <input\n                type=\"text\"\n                placeholder=\"Dropbox \353\202\264 DWG / DXF \355\214\214\354\235\274\353\252\205 \352\262\200\354\203\211...\"\n                value={dropboxSearchQuery}\n                onChange={(e) => setDropboxSearchQuery(e.target.value)}\n                onKeyDown={(e) => {\n                  if (e.key === \'Enter\') loadDropboxFiles(dropboxSearchQuery);\n                }}\n                className=\"w-full pl-9 pr-16 py-2 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-xs text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-[#0061FF]\"\n              />\n              <Search className=\"w-4 h-4 text-slate-400 absolute left-3 top-2.5\" />\n              <button\n                onClick={() => loadDropboxFiles(dropboxSearchQuery)}\n                className=\"absolute right-1.5 top-1.5 bg-[#0061FF] text-white px-2 py-1 rounded-lg text-[10px] font-bold\"\n              >\n                \352\262\200\354\203\211\n              </button>\n            </div>\n          )}\n\n          {/* Dropbox Error Message */}\n          {dropboxError && (\n            <div className=\"p-3 rounded-xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-900/50 text-xs text-rose-700 dark:text-rose-300 flex items-center gap-2\">\n              <AlertCircle className=\"w-4 h-4 shrink-0\" />\n              <span>{dropboxError}</span>\n            </div>\n          )}\n\n          {/* Dropbox File List */}\n          <div className=\"flex-1 overflow-y-auto space-y-2 min-h-[160px] custom-scrollbar\">\n            {isDropboxLoading ? (\n              <div className=\"py-10 flex flex-col items-center justify-center text-slate-400 text-center space-y-2\">\n                <div className=\"w-8 h-8 rounded-full border-3 border-[#0061FF]/30 border-t-[#0061FF] animate-spin\" />\n                <p className=\"text-xs font-semibold\">{dropboxLoadingAction || \'\353\241\234\353\224\251 \354\244\221...\'}</p>\n              </div>\n            ) : dropboxAccount && dropboxFiles.length === 0 ? (\n              <div className=\"py-8 text-center text-slate-400 space-y-2 border border-dashed border-slate-200 dark:border-slate-800 rounded-2xl p-6\">\n                <FileCode className=\"w-8 h-8 mx-auto text-slate-300 dark:text-slate-600\" />\n                <div className=\"text-xs font-bold text-slate-700 dark:text-slate-200\">\n                  {dropboxSearchQuery ? `\'${dropboxSearchQuery}\' \352\262\200\354\203\211 \352\262\260\352\263\274\352\260\200 \354\227\206\354\212\265\353\213\210\353\213\244` : \'Dropbox\354\227\220 DWG/DXF \355\214\214\354\235\274\354\235\264 \354\227\206\354\212\265\353\213\210\353\213\244\'}\n                </div>\n                <p className=\"text-[11px] text-slate-500 max-w-sm mx-auto\">\n                  Dropbox \355\217\264\353\215\224\354\227\220 .dwg \353\230\220\353\212\224 .dxf \355\214\214\354\235\274\354\235\204 \353\204\243\354\235\200 \355\233\204 \354\203\210\353\241\234\352\263\240\354\271\250\355\225\230\352\261\260\353\202\230 \354\234\204\354\235\230 \352\263\265\354\234\240 \353\247\201\355\201\254 \354\236\205\353\240\245\354\260\275\354\235\204 \354\235\264\354\232\251\355\225\264\354\243\274\354\204\270\354\232\224.\n                </p>\n              </div>\n            ) : dropboxAccount && dropboxFiles.length > 0 ? (\n              <div className=\"space-y-1.5\">\n                <div className=\"text-[11px] font-bold text-slate-500 dark:text-slate-400 px-1 flex items-center justify-between\">\n                  <span>Dropbox \353\217\204\353\251\264 ({dropboxFiles.length}\352\260\234)</span>\n                  <span>\355\201\264\353\246\255 \354\213\234 \354\246\211\354\213\234 \354\227\264\352\270\260</span>\n                </div>\n                {dropboxFiles.map((file) => {\n                  const isDwg = file.name.toLowerCase().endsWith(\'.dwg\');\n                  return (\n                    <div\n                      key={file.id}\n                      onClick={() => handleSelectDropboxFile(file)}\n                      className=\"group cursor-pointer p-3 rounded-xl bg-slate-50 hover:bg-blue-50/60 dark:bg-slate-800/60 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700/70 hover:border-blue-400 dark:hover:border-blue-500 flex items-center justify-between gap-3 transition shadow-xs\"\n                    >\n                      <div className=\"flex items-center gap-3 min-w-0 flex-1\">\n                        <div\n                          className={`w-9 h-9 rounded-xl flex items-center justify-center font-bold text-xs shrink-0 ${\n                            isDwg\n                              ? \'bg-[#C8102E]/10 text-[#C8102E] border border-[#C8102E]/20\'\n                              : \'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20\'\n                          }`}\n                        >\n                          {isDwg ? \'DWG\' : \'DXF\'}\n                        </div>\n                        <div className=\"min-w-0 flex-1\">\n                          <div className=\"text-xs font-bold text-slate-800 dark:text-slate-100 truncate group-hover:text-[#0061FF] dark:group-hover:text-blue-400\">\n                            {file.name}\n                          </div>\n                          <div className=\"text-[10px] text-slate-500 dark:text-slate-400 flex items-center gap-2 mt-0.5 font-mono\">\n                            <span>{formatFileSize(file.size)}</span>\n                            {file.serverModified && (\n                              <span>\302\267 {new Date(file.serverModified).toLocaleDateString()}</span>\n                            )}\n                          </div>\n                        </div>\n                      </div>\n                      <button\n                        onClick={(e) => {\n                          e.stopPropagation();\n                          handleSelectDropboxFile(file);\n                        }}\n                        className=\"bg-[#0061FF] hover:bg-[#0052d9] text-white px-3 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1 active:scale-95 transition shrink-0\"\n                      >\n                        <Download className=\"w-3.5 h-3.5\" />\n                        <span>\354\227\264\352\270\260</span>\n                      </button>\n                    </div>\n                  );\n                })}\n              </div>\n            ) : null}\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
