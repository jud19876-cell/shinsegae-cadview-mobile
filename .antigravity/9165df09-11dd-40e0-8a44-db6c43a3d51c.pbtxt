  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { ArcEntity, CircleEntity, DrawingModel, LineEntity, PolylineEntity, TextEntity } from \'../types/cad\';\n\nexport function createSampleArch(): DrawingModel {\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  const entities: any[] = [];\n  let id = 1;\n\n  const layers = {\n    \'A-WALL\': { name: \'A-WALL (\353\262\275\354\262\264)\', aci: 7, color: \'#0f172a\', visible: true, count: 0 },\n    \'A-DOOR\': { name: \'A-DOOR (\354\260\275\355\230\270)\', aci: 4, color: \'#0369a1\', visible: true, count: 0 },\n    \'A-FURN\': { name: \'A-FURN (\352\260\200\352\265\254/\354\204\244\353\271\204)\', aci: 3, color: \'#15803d\', visible: true, count: 0 },\n    \'A-GRID\': { name: \'A-GRID (\354\244\221\354\213\254\354\204\240)\', aci: 1, color: \'#dc2626\', visible: true, count: 0 },\n    \'A-DIM\': { name: \'A-DIM (\354\271\230\354\210\230\354\204\240)\', aci: 2, color: \'#b45309\', visible: true, count: 0 },\n    \'A-TEXT\': { name: \'A-TEXT (\354\213\244\353\252\205)\', aci: 6, color: \'#a21caf\', visible: true, count: 0 },\n  };\n\n  // Outer boundary\n  const wall1: PolylineEntity = {\n    id: `E${id++}`,\n    type: \'LWPOLYLINE\',\n    layer: \'A-WALL\',\n    lineweight: 2.2,\n    closed: true,\n    vertices: [\n      { x: 0, y: 0 },\n      { x: 18000, y: 0 },\n      { x: 18000, y: 10000 },\n      { x: 0, y: 10000 },\n    ],\n  };\n  entities.push(wall1);\n\n  // Inner perimeter wall (200mm thick)\n  const wall2: PolylineEntity = {\n    id: `E${id++}`,\n    type: \'LWPOLYLINE\',\n    layer: \'A-WALL\',\n    lineweight: 1.5,\n    closed: true,\n    vertices: [\n      { x: 200, y: 200 },\n      { x: 17800, y: 200 },\n      { x: 17800, y: 9800 },\n      { x: 200, y: 9800 },\n    ],\n  };\n  entities.push(wall2);\n\n  // Internal partition walls\n  const wallLines: LineEntity[] = [\n    { id: `E${id++}`, type: \'LINE\', layer: \'A-WALL\', lineweight: 1.8, start: { x: 200, y: 5000 }, end: { x: 17800, y: 5000 } },\n    { id: `E${id++}`, type: \'LINE\', layer: \'A-WALL\', lineweight: 1.8, start: { x: 6000, y: 5000 }, end: { x: 6000, y: 9800 } },\n    { id: `E${id++}`, type: \'LINE\', layer: \'A-WALL\', lineweight: 1.8, start: { x: 12000, y: 200 }, end: { x: 12000, y: 9800 } },\n  ];\n  entities.push(...wallLines);\n\n  // Doors with swing arcs\n  const doors = [\n    [1200, 5000],\n    [7200, 5000],\n    [13200, 5000],\n  ];\n  doors.forEach(([dx, dy]) => {\n    const doorLine: LineEntity = {\n      id: `E${id++}`,\n      type: \'LINE\',\n      layer: \'A-DOOR\',\n      start: { x: dx, y: dy },\n      end: { x: dx, y: dy + 900 },\n    };\n    const doorArc: ArcEntity = {\n      id: `E${id++}`,\n      type: \'ARC\',\n      layer: \'A-DOOR\',\n      center: { x: dx, y: dy },\n      radius: 900,\n      startAngle: 0,\n      endAngle: 90,\n    };\n    entities.push(doorLine, doorArc);\n  });\n\n  // Conference Table in Room 101\n  const table: PolylineEntity = {\n    id: `E${id++}`,\n    type: \'LWPOLYLINE\',\n    layer: \'A-FURN\',\n    closed: true,\n    vertices: [\n      { x: 1600, y: 6800 },\n      { x: 4600, y: 6800 },\n      { x: 4600, y: 8400 },\n      { x: 1600, y: 8400 },\n    ],\n  };\n  entities.push(table);\n\n  // Conference Chairs\n  [2000, 2750, 3500, 4200].forEach((cx) => {\n    const chairTop: CircleEntity = {\n      id: `E${id++}`,\n      type: \'CIRCLE\',\n      layer: \'A-FURN\',\n      center: { x: cx, y: 6500 },\n      radius: 180,\n    };\n    const chairBottom: CircleEntity = {\n      id: `E${id++}`,\n      type: \'CIRCLE\',\n      layer: \'A-FURN\',\n      center: { x: cx, y: 8700 },\n      radius: 180,\n    };\n    entities.push(chairTop, chairBottom);\n  });\n\n  // Korean Room Labels\n  const roomTexts: TextEntity[] = [\n    { id: `E${id++}`, type: \'TEXT\', layer: \'A-TEXT\', position: { x: 3000, y: 6000 }, height: 260, text: \'101 \353\214\200\355\232\214\354\235\230\354\213\244 (30.0m\302\262)\', align: \'center\' },\n    { id: `E${id++}`, type: \'TEXT\', layer: \'A-TEXT\', position: { x: 9000, y: 7400 }, height: 260, text: \'102 \352\270\260\354\210\240\354\227\260\352\265\254\354\206\214 (R&D)\', align: \'center\' },\n    { id: `E${id++}`, type: \'TEXT\', layer: \'A-TEXT\', position: { x: 15000, y: 7400 }, height: 260, text: \'103 \354\240\204\354\202\260/\354\204\234\353\262\204\354\213\244\', align: \'center\' },\n    { id: `E${id++}`, type: \'TEXT\', layer: \'A-TEXT\', position: { x: 6000, y: 2600 }, height: 280, text: \'104 \353\251\224\354\235\270 \354\230\244\355\224\210 \354\212\244\355\212\234\353\224\224\354\230\244 \353\241\234\353\271\204\', align: \'center\' },\n    { id: `E${id++}`, type: \'TEXT\', layer: \'A-TEXT\', position: { x: 15000, y: 2600 }, height: 260, text: \'105 CAD \353\217\204\353\251\264\354\204\244\352\263\204\354\213\244\', align: \'center\' },\n  ];\n  entities.push(...roomTexts);\n\n  // Exterior Dimension line\n  const dimLine: LineEntity = {\n    id: `E${id++}`,\n    type: \'LINE\',\n    layer: \'A-DIM\',\n    start: { x: 0, y: 10600 },\n    end: { x: 18000, y: 10600 },\n  };\n  const dimText: TextEntity = {\n    id: `E${id++}`,\n    type: \'TEXT\',\n    layer: \'A-DIM\',\n    position: { x: 9000, y: 10800 },\n    height: 240,\n    text: \'\354\264\235 \355\217\255 18,000 mm (18.0 m)\',\n    align: \'center\',\n  };\n  entities.push(dimLine, dimText);\n\n  return {\n    fileName: \'A-101_\354\230\244\355\224\274\354\212\244_\352\261\264\354\266\225\355\217\211\353\251\264\353\217\204.dwg\',\n    formatVersion: \'AutoCAD 2018\',\n    layers,\n    blocks: {},\n    entities,\n  };\n}\n\nexport function createSampleMech(): DrawingModel {\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  const entities: any[] = [];\n  let id = 1;\n\n  const layers = {\n    \'M-OUTLINE\': { name: \'M-OUTLINE (\354\231\270\355\230\225\354\204\240)\', aci: 7, color: \'#0f172a\', visible: true, count: 0 },\n    \'M-CENTER\': { name: \'M-CENTER (\354\244\221\354\213\254\354\204\240)\', aci: 1, color: \'#dc2626\', visible: true, count: 0 },\n    \'M-DIM\': { name: \'M-DIM (\354\271\230\354\210\230/\352\263\265\354\260\250)\', aci: 2, color: \'#b45309\', visible: true, count: 0 },\n  };\n\n  // Concentric flange circles\n  [240, 180, 115, 65].forEach((r, idx) => {\n    const circ: CircleEntity = {\n      id: `M${id++}`,\n      type: \'CIRCLE\',\n      layer: idx === 1 ? \'M-CENTER\' : \'M-OUTLINE\',\n      linetype: idx === 1 ? \'CENTER\' : \'CONTINUOUS\',\n      center: { x: 0, y: 0 },\n      radius: r,\n    };\n    entities.push(circ);\n  });\n\n  // 8 Bolt holes on PCD 360 (radius 180)\n  for (let i = 0; i < 8; i++) {\n    const rad = (i * 45 * Math.PI) / 180;\n    const hole: CircleEntity = {\n      id: `M${id++}`,\n      type: \'CIRCLE\',\n      layer: \'M-OUTLINE\',\n      center: { x: Math.cos(rad) * 180, y: Math.sin(rad) * 180 },\n      radius: 18,\n    };\n    entities.push(hole);\n  }\n\n  // Cross centerlines\n  const cl1: LineEntity = {\n    id: `M${id++}`,\n    type: \'LINE\',\n    layer: \'M-CENTER\',\n    linetype: \'CENTER\',\n    start: { x: -290, y: 0 },\n    end: { x: 290, y: 0 },\n  };\n  const cl2: LineEntity = {\n    id: `M${id++}`,\n    type: \'LINE\',\n    layer: \'M-CENTER\',\n    linetype: \'CENTER\',\n    start: { x: 0, y: -290 },\n    end: { x: 0, y: 290 },\n  };\n  entities.push(cl1, cl2);\n\n  // Dimension & Specification Text\n  const specText: TextEntity = {\n    id: `M${id++}`,\n    type: \'TEXT\',\n    layer: \'M-DIM\',\n    position: { x: 0, y: 280 },\n    height: 18,\n    text: \'\303\230480 FLANGE / PCD \303\230360 (8-\303\23036 BOLT HOLES)\',\n    align: \'center\',\n  };\n  entities.push(specText);\n\n  return {\n    fileName: \'M-204_\355\204\260\353\271\210\355\224\214\353\236\234\354\247\200_\354\240\225\353\260\200\354\241\260\353\246\275\353\217\204.dwg\',\n    formatVersion: \'AutoCAD 2018\',\n    layers,\n    blocks: {},\n    entities,\n  };\n}\n"
        path {
          absolute_uri: "file:///src/lib/sampleDrawings.ts"
        }
        overwrite: true
      }
    }
