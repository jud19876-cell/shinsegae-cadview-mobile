    content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\n/* eslint-disable @typescript-eslint/no-explicit-any */\nimport {\n  CadBlock,\n  CadEntity,\n  DrawingModel,\n  LayerInfo,\n  RasterPreviewEntity,\n} from \'../types/cad\';\nimport { buildOcsTransform, expandVerticesWithBulge } from \'./dxfParser\';\nimport { cleanCadText } from \'./textSanitizer\';\n\nlet cachedWasmBinary: ArrayBuffer | null = null;\n\nasync function fetchLibreDwgWasm(urls: string[]): Promise<ArrayBuffer | null> {\n  if (cachedWasmBinary && cachedWasmBinary.byteLength > 100000) {\n    return cachedWasmBinary;\n  }\n  for (let i = 0; i < urls.length; i++) {\n    try {\n      const res = await fetch(urls[i], { mode: \'cors\', credentials: \'omit\' });\n      if (res.ok) {\n        const buf = await res.arrayBuffer();\n        const u8 = new Uint8Array(buf, 0, 4);\n        if (\n          u8[0] === 0x00 &&\n          u8[1] === 0x61 &&\n          u8[2] === 0x73 &&\n          u8[3] === 0x6d\n        ) {\n          cachedWasmBinary = buf;\n          return buf;\n        }\n      }\n    } catch {\n      // Continue next CDN url\n    }\n  }\n  return null;\n}\n\nexport async function createLibreDwgEngine(\n  onProgress?: (msg: string) => void\n): Promise<{ instance: any; rawWasmMod: any; Dwg_File_Type: any }> {\n  const cdnConfigs = [\n    {\n      ver: \'0.8.1\',\n      distJs:\n        \'https://cdn.jsdelivr.net/npm/@mlightcad/libredwg-web@0.8.1/dist/libredwg-web.js\',\n      wasmDir:\n        \'https://cdn.jsdelivr.net/npm/@mlightcad/libredwg-web@0.8.1/wasm/\',\n      wasmUrls: [\n        \'https://cdn.jsdelivr.net/npm/@mlightcad/libredwg-web@0.8.1/wasm/libredwg-web.wasm\',\n        \'https://cdn.jsdelivr.net/npm/@mlightcad/libredwg-web@0.8.1/dist/libredwg-web.wasm\',\n      ],\n    },\n    {\n      ver: \'0.7.14\',\n      distJs:\n        \'https://cdn.jsdelivr.net/npm/@mlightcad/libredwg-web@0.7.14/dist/libredwg-web.js\',\n      wasmDir:\n        \'https://cdn.jsdelivr.net/npm/@mlightcad/libredwg-web@0.7.14/wasm/\',\n      wasmUrls: [\n        \'https://cdn.jsdelivr.net/npm/@mlightcad/libredwg-web@0.7.14/wasm/libredwg-web.wasm\',\n      ],\n    },\n  ];\n\n  for (let i = 0; i < cdnConfigs.length; i++) {\n    const cfg = cdnConfigs[i];\n    try {\n      if (onProgress)\n        onProgress(`LibreDWG WebAssembly \354\244\200\353\271\204 \354\244\221 (v${cfg.ver})...`);\n      const wasmBinary = await fetchLibreDwgWasm(cfg.wasmUrls);\n      /* @vite-ignore */\n      const mod = await import(cfg.distJs);\n      const LibreDwg = mod.LibreDwg || (mod.default && mod.default.LibreDwg);\n      const Dwg_File_Type = mod.Dwg_File_Type ||\n        (mod.default && mod.default.Dwg_File_Type) || { DWG: 0, DXF: 1 };\n      const createModuleFn =\n        mod.createModule ||\n        (mod.default && mod.default.createModule) ||\n        (typeof mod.default === \'function\' ? mod.default : null);\n\n      const moduleConfig: any = {\n        locateFile: (p: string) =>\n          p.endsWith(\'.wasm\') ? cfg.wasmUrls[0] : cfg.wasmDir + p,\n      };\n      if (wasmBinary) moduleConfig.wasmBinary = wasmBinary;\n\n      let rawWasmMod: any = null;\n      if (typeof createModuleFn === \'function\') {\n        try {\n          rawWasmMod = await createModuleFn(moduleConfig);\n        } catch {\n          // ignore\n        }\n      }\n\n      let instance: any = null;\n      if (rawWasmMod && LibreDwg) {\n        try {\n          instance = new LibreDwg(rawWasmMod);\n        } catch {\n          // ignore\n        }\n      }\n      if (!instance && LibreDwg && typeof LibreDwg.create === \'function\') {\n        try {\n          instance = await LibreDwg.create(moduleConfig);\n        } catch {\n          instance = await LibreDwg.create(cfg.wasmDir);\n        }\n      }\n      if (instance) {\n        return { instance, rawWasmMod, Dwg_File_Type };\n      }\n    } catch {\n      // try next\n    }\n  }\n  throw new Error(\'LibreDWG WebAssembly \354\227\224\354\247\204 \353\241\234\353\223\234\354\227\220 \354\213\244\355\214\250\355\226\210\354\212\265\353\213\210\353\213\244.\');\n}\n\nexport async function extractDwgThumbnail(\n  uint8: Uint8Array\n): Promise<{ img: HTMLImageElement; width: number; height: number } | null> {\n  try {\n    if (!uint8 || uint8.length < 64) return null;\n    const view = new DataView(\n      uint8.buffer,\n      uint8.byteOffset,\n      uint8.byteLength\n    );\n    const sentinel = [\n      0x1f, 0x25, 0x6d, 0x07, 0xd4, 0x36, 0x28, 0x28, 0x9d, 0xd7, 0x5c, 0x9f,\n      0x62, 0xe4, 0x64, 0x4d,\n    ];\n    let sentinelPos = -1;\n\n    if (uint8.length > 0x15) {\n      const ptr = view.getUint32(0x0d, true);\n      if (ptr > 0 && ptr + 32 < uint8.length) {\n        let match = true;\n        for (let i = 0; i < 16; i++) {\n          if (uint8[ptr + i] !== sentinel[i]) {\n            match = false;\n            break;\n          }\n        }\n        if (match) sentinelPos = ptr;\n      }\n    }\n\n    let blob: Blob | null = null;\n    if (sentinelPos >= 0 && sentinelPos + 21 < uint8.length) {\n      const count = uint8[sentinelPos + 20];\n      let descPos = sentinelPos + 21;\n      for (let i = 0; i < count && descPos + 9 <= uint8.length; i++) {\n        const recType = uint8[descPos];\n        const recOffset = view.getUint32(descPos + 1, true);\n        const recSize = view.getUint32(descPos + 5, true);\n        descPos += 9;\n\n        if (\n          recOffset > 0 &&\n          recSize > 32 &&\n          recOffset + recSize <= uint8.length\n        ) {\n          if (\n            recType === 6 ||\n            (uint8[recOffset] === 0x89 && uint8[recOffset + 1] === 0x50)\n          ) {\n            blob = new Blob([uint8.slice(recOffset, recOffset + recSize)], {\n              type: \'image/png\',\n            });\n            break;\n          } else if (recType === 2) {\n            const dib = uint8.slice(recOffset, recOffset + recSize);\n            const dibView = new DataView(\n              dib.buffer,\n              dib.byteOffset,\n              dib.byteLength\n            );\n            const biSize = dibView.getUint32(0, true);\n            const biBitCount = dibView.getUint16(14, true);\n            const biClrUsed = dibView.getUint32(32, true);\n            const paletteBytes =\n              biBitCount <= 8\n                ? (biClrUsed > 0 ? biClrUsed : 1 << biBitCount) * 4\n                : 0;\n            const bfOffBits = 14 + biSize + paletteBytes;\n            const totalSize = 14 + dib.byteLength;\n            const bmpBuf = new Uint8Array(totalSize);\n            const bmpView = new DataView(bmpBuf.buffer);\n            bmpBuf[0] = 0x42;\n            bmpBuf[1] = 0x4d;\n            bmpView.setUint32(2, totalSize, true);\n            bmpView.setUint32(10, bfOffBits, true);\n            bmpBuf.set(dib, 14);\n            blob = new Blob([bmpBuf], { type: \'image/bmp\' });\n            break;\n          }\n        }\n      }\n    }\n\n    if (!blob) return null;\n    const url = URL.createObjectURL(blob);\n    return await new Promise((resolve) => {\n      const img = new Image();\n      img.onload = () =>\n        resolve({\n          img,\n          width: img.naturalWidth || 800,\n          height: img.naturalHeight || 600,\n        });\n      img.onerror = () => {\n        URL.revokeObjectURL(url);\n        resolve(null);\n      };\n      img.src = url;\n    });\n  } catch {\n    return null;\n  }\n}\n\nexport function normalizeLibreDwgDb(\n  db: any,\n  fileName: string,\n  versionLabel: string\n): DrawingModel {\n  const layers: Record<string, LayerInfo> = {};\n  const blocks: Record<string, CadBlock> = {};\n  const entities: CadEntity[] = [];\n  let idSeq = 1;\n  let tableBlockSeq = 1;\n\n  const layerEntries =\n    (db && db.tables && db.tables.LAYER && db.tables.LAYER.entries) ||\n    (db && db.tables && db.tables.layer && db.tables.layer.layers) ||\n    [];\n\n  if (Array.isArray(layerEntries)) {\n    layerEntries.forEach((l: any) => {\n      if (!l) return;\n      const lname = cleanCadText(l.name) || \'0\';\n      const lAci =\n        l.colorIndex !== undefined && l.colorIndex !== null\n          ? Math.abs(l.colorIndex)\n          : l.color !== undefined\n            ? l.color\n            : 7;\n      const lnameUpper = lname.toUpperCase();\n      const isDefpoints =\n        lnameUpper === \'DEFPOINTS\' ||\n        lnameUpper.includes(\'DEFPOINT\') ||\n        lnameUpper === \'NPLT\' ||\n        lnameUpper.includes(\'NO_PLOT\') ||\n        lnameUpper.includes(\'NON_PLOT\');\n      const isOff = Boolean(\n        l.off ||\n          l.frozen ||\n          (typeof l.colorIndex === \'number\' && l.colorIndex < 0) ||\n          isDefpoints\n      );\n      layers[lname] = {\n        name: lname,\n        aci: lAci,\n        color: \'#0f172a\',\n        visible: !isOff,\n        count: 0,\n      };\n    });\n  }\n\n  function isValidCoord(v: any): boolean {\n    return (\n      v !== undefined &&\n      v !== null &&\n      typeof v === \'number\' &&\n      isFinite(v) &&\n      Math.abs(v) < 1e9\n    );\n  }\n\n  function toDegreesIfRadians(val: any): number {\n    const n = Number(val || 0);\n    if (!isFinite(n) || n === 0) return 0;\n    if (Math.abs(n) <= Math.PI * 2 + 0.0001) {\n      return (n * 180) / Math.PI;\n    }\n    return n;\n  }\n\n  function mapRawEntity(raw: any, insideBlock?: boolean): CadEntity | null {\n    if (!raw || !raw.type) return null;\n    try {\n      const t = String(raw.type).toUpperCase();\n      if (t === \'XLINE\' || t === \'RAY\' || t === \'VIEWPORT\' || t === \'WIPEOUT\') return null;\n      if (insideBlock && t === \'ATTDEF\') return null;\n\n      // Filter hidden/invisible entities\n      if (\n        raw.invisible === 1 ||\n        raw.invisible === true ||\n        raw.invis === 1 ||\n        raw.is_invisible === 1 ||\n        raw.is_invisible === true ||\n        raw.visibility === 1\n      ) {\n        return null;\n      }\n\n      // Filter PaperSpace layout entities when parsing model space\n      if (\n        raw.in_paperspace === 1 ||\n        raw.in_paperspace === true ||\n        raw.paperspace === 1 ||\n        raw.paperspace === true\n      ) {\n        return null;\n      }\n\n      // Filter entities on non-plot/Defpoints layers\n      const rawLname = cleanCadText(raw.layer) || \'0\';\n      const rawLnameUpper = rawLname.toUpperCase();\n      if (\n        rawLnameUpper === \'DEFPOINTS\' ||\n        rawLnameUpper.includes(\'DEFPOINT\') ||\n        rawLnameUpper === \'NPLT\' ||\n        rawLnameUpper.includes(\'NO_PLOT\') ||\n        rawLnameUpper.includes(\'NON_PLOT\')\n      ) {\n        return null;\n      }\n\n      let entAci: number | null = null;\n      if (raw.colorIndex !== undefined && raw.colorIndex !== null) {\n        entAci = raw.colorIndex;\n      } else if (raw.color !== undefined && raw.color !== null) {\n        entAci = raw.color;\n      }\n\n      const ent: any = {\n        id: raw.handle ? String(raw.handle) : `DWG_${idSeq++}`,\n        type: t,\n        layer: cleanCadText(raw.layer) || \'0\',\n        aci: entAci,\n        linetype: raw.lineType || raw.linetype || \'CONTINUOUS\',\n        lineweight: 1.2,\n      };\n\n      const extVec =\n        raw.extrusionDirection ||\n        raw.extrusion ||\n        raw.normal ||\n        raw.extrusionVector;\n      const ocs = buildOcsTransform(extVec);\n      const elev = isValidCoord(raw.elevation) ? raw.elevation : 0;\n\n      if (t === \'LINE\') {\n        const s =\n          raw.startPoint || raw.start || (raw.vertices && raw.vertices[0]);\n        const e =\n          raw.endPoint || raw.end || (raw.vertices && raw.vertices[1]);\n        if (\n          !s ||\n          !e ||\n          !isValidCoord(s.x) ||\n          !isValidCoord(s.y) ||\n          !isValidCoord(e.x) ||\n          !isValidCoord(e.y)\n        )\n          return null;\n        ent.start = { x: s.x, y: s.y };\n        ent.end = { x: e.x, y: e.y };\n      } else if (\n        t === \'LWPOLYLINE\' ||\n        t === \'POLYLINE\' ||\n        t === \'POLYLINE2D\' ||\n        t === \'POLYLINE3D\' ||\n        t === \'LEADER\'\n      ) {\n        ent.type = \'LWPOLYLINE\';\n        const vlist = raw.vertices || raw.points || [];\n        if (!Array.isArray(vlist) || vlist.length < 2) return null;\n\n        const rawFlag = Number(\n          raw.flag !== undefined ? raw.flag : raw.flags || 0\n        );\n        if (t === \'LEADER\') {\n          ent.closed = false;\n        } else if (t === \'LWPOLYLINE\') {\n          ent.closed = Boolean(raw.shape || raw.closed || (rawFlag & 512) !== 0);\n        } else {\n          ent.closed = Boolean(raw.shape || raw.closed || (rawFlag & 1) !== 0);\n        }\n\n        const isWcsPoly = t === \'POLYLINE3D\' || t === \'LEADER\';\n        const rawVerts: any[] = [];\n        for (let i = 0; i < vlist.length; i++) {\n          const v = vlist[i];\n          if (!v) continue;\n          if (v.flag && (v.flag & 16) !== 0) continue;\n          const pt = v.point || v;\n          const vx = Number(\n            pt.x !== undefined ? pt.x : Array.isArray(pt) ? pt[0] : NaN\n          );\n          const vy = Number(\n            pt.y !== undefined ? pt.y : Array.isArray(pt) ? pt[1] : NaN\n          );\n          const vz = Number(pt.z !== undefined ? pt.z : elev);\n          if (isValidCoord(vx) && isValidCoord(vy)) {\n            const wPt = isWcsPoly\n              ? { x: vx, y: vy }\n              : ocs.pt(vx, vy, isFinite(vz) ? vz : 0);\n            const rawBulge = Number(v.bulge || 0);\n            rawVerts.push({\n              x: wPt.x,\n              y: wPt.y,\n              bulge: isWcsPoly ? rawBulge : rawBulge * ocs.flipX,\n            });\n          }\n        }\n        if (rawVerts.length < 2) return null;\n        ent.vertices = expandVerticesWithBulge(rawVerts, ent.closed);\n      } else if (t === \'CIRCLE\') {\n        if (!raw.center || !isValidCoord(raw.center.x) || !isValidCoord(raw.center.y))\n          return null;\n        ent.center = ocs.pt(raw.center.x, raw.center.y, raw.center.z || elev);\n        ent.radius = Number(raw.radius || 0);\n        if (!(ent.radius > 0)) return null;\n      } else if (t === \'ARC\') {\n        if (!raw.center || !isValidCoord(raw.center.x) || !isValidCoord(raw.center.y))\n          return null;\n        ent.center = ocs.pt(raw.center.x, raw.center.y, raw.center.z || elev);\n        ent.radius = Number(raw.radius || 0);\n        if (!(ent.radius > 0)) return null;\n        let sa = toDegreesIfRadians(raw.startAngle);\n        let ea = toDegreesIfRadians(raw.endAngle);\n        if (ocs.flipX < 0) {\n          const newSa = 180 - ea;\n          const newEa = 180 - sa;\n          sa = newSa;\n          ea = newEa;\n        }\n        ent.startAngle = sa;\n        ent.endAngle = ea;\n      } else if (t === \'ELLIPSE\') {\n        if (!raw.center || !isValidCoord(raw.center.x) || !isValidCoord(raw.center.y))\n          return null;\n        ent.center = { x: raw.center.x, y: raw.center.y };\n        const maj = raw.majorAxisEndPoint || raw.majorAxis || { x: 10, y: 0 };\n        ent.majorAxis = { x: Number(maj.x || 10), y: Number(maj.y || 0) };\n        ent.axisRatio = Number(raw.axisRatio || raw.minorToMajorRatio || 0.5);\n      } else if (\n        t === \'TEXT\' ||\n        t === \'MTEXT\' ||\n        t === \'ATTRIB\' ||\n        t === \'ATTDEF\'\n      ) {\n        const nestedText =\n          raw.text && typeof raw.text === \'object\' ? raw.text : null;\n        const pos =\n          (nestedText &&\n            (nestedText.startPoint ||\n              nestedText.insertionPoint ||\n              nestedText.position)) ||\n          raw.startPoint ||\n          raw.insertionPoint ||\n          raw.position ||\n          raw.alignmentPoint || { x: 0, y: 0 };\n        if (!isValidCoord(pos.x) || !isValidCoord(pos.y)) return null;\n        ent.type = \'TEXT\';\n        ent.isMtext = t === \'MTEXT\';\n        ent.position =\n          t === \'MTEXT\'\n            ? { x: pos.x, y: pos.y }\n            : ocs.pt(pos.x, pos.y, pos.z || elev);\n        ent.height = Number(\n          (nestedText && nestedText.textHeight) ||\n            raw.textHeight ||\n            raw.height ||\n            0\n        );\n        let rot = toDegreesIfRadians(\n          (nestedText && nestedText.rotation) || raw.rotation || 0\n        );\n        if (t !== \'MTEXT\' && ocs.flipX < 0) rot = -rot;\n        ent.rotation = isFinite(rot) ? rot : 0;\n        const strVal =\n          (nestedText && nestedText.text) ||\n          raw.text ||\n          raw.string ||\n          raw.value ||\n          \'\';\n        ent.text = cleanCadText(strVal);\n        if (!ent.text) return null;\n      } else if (t === \'INSERT\') {\n        const pos =\n          raw.insertionPoint || raw.position || raw.insPt || { x: 0, y: 0 };\n        if (!isValidCoord(pos.x) || !isValidCoord(pos.y)) return null;\n        const bname = cleanCadText(raw.name || raw.blockName || raw.block || \'\');\n        if (!bname) return null;\n\n        const rawSx =\n          raw.xScale !== undefined\n            ? raw.xScale\n            : raw.scaleX !== undefined\n              ? raw.scaleX\n              : raw.scale && raw.scale.x !== undefined\n                ? raw.scale.x\n                : raw.scaleFactor && raw.scaleFactor.x !== undefined\n                  ? raw.scaleFactor.x\n                  : 1;\n        const rawSy =\n          raw.yScale !== undefined\n            ? raw.yScale\n            : raw.scaleY !== undefined\n              ? raw.scaleY\n              : raw.scale && raw.scale.y !== undefined\n                ? raw.scale.y\n                : raw.scaleFactor && raw.scaleFactor.y !== undefined\n                  ? raw.scaleFactor.y\n                  : 1;\n\n        let sx = Number(rawSx);\n        let sy = Number(rawSy);\n        if (!isFinite(sx) || sx === 0) sx = 1;\n        if (!isFinite(sy) || sy === 0) sy = 1;\n\n        let rot = toDegreesIfRadians(raw.rotation || 0);\n        const wPos = ocs.pt(pos.x, pos.y, pos.z || 0);\n        if (ocs.flipX < 0) {\n          sx = -sx;\n          rot = -rot;\n        }\n\n        ent.position = wPos;\n        ent.blockName = bname;\n        ent.scaleX = sx;\n        ent.scaleY = sy;\n        ent.rotation = isFinite(rot) ? rot : 0;\n      } else if (\n        t === \'DIMENSION\' ||\n        t.startsWith(\'DIMENSION_\') ||\n        t === \'ARC_DIMENSION\' ||\n        t === \'LARGE_RADIAL_DIMENSION\'\n      ) {\n        const bname = cleanCadText(\n          raw.block || raw.blockName || raw.name || raw.anonymousBlockName || \'\'\n        );\n        if (bname) {\n          ent.type = \'INSERT\';\n          ent.blockName = bname;\n          // In AutoCAD DWG, entities in dimension blocks (*D...) are already defined in WCS.\n          // Positioning them at insertionPoint causes massive duplicate/offset lines across the drawing.\n          ent.position = { x: 0, y: 0 };\n          ent.scaleX = 1;\n          ent.scaleY = 1;\n          ent.rotation = 0;\n        } else {\n          return null;\n        }\n      } else if (t === \'ACAD_TABLE\' || t === \'TABLE\') {\n        const bname = cleanCadText(\n          raw.block || raw.blockName || raw.name || `*T${tableBlockSeq++}`\n        );\n        const pos =\n          raw.insertionPoint || raw.startPoint || raw.position || { x: 0, y: 0 };\n        ent.type = \'INSERT\';\n        ent.blockName = bname;\n        ent.position =\n          isValidCoord(pos.x) && isValidCoord(pos.y)\n            ? { x: pos.x, y: pos.y }\n            : { x: 0, y: 0 };\n        ent.scaleX = 1;\n        ent.scaleY = 1;\n        ent.rotation = 0;\n      } else if (t === \'SPLINE\') {\n        const pts =\n          (raw.fitPoints && raw.fitPoints.length >= 2)\n            ? raw.fitPoints\n            : raw.controlPoints || raw.vertices || [];\n        if (!Array.isArray(pts) || pts.length < 2) return null;\n        ent.type = \'LWPOLYLINE\';\n        ent.closed = false;\n        ent.vertices = pts\n          .map((p: any) => ({ x: Number(p.x), y: Number(p.y) }))\n          .filter((p: any) => isValidCoord(p.x) && isValidCoord(p.y));\n        if (ent.vertices.length < 2) return null;\n      } else if (t === \'SOLID\' || t === \'3DFACE\' || t === \'TRACE\') {\n        let pts =\n          raw.points ||\n          raw.vertices ||\n          [\n            raw.firstCorner || raw.corner1,\n            raw.secondCorner || raw.corner2,\n            raw.thirdCorner || raw.corner3,\n            raw.fourthCorner || raw.corner4,\n          ].filter(Boolean);\n        if (!Array.isArray(pts) || pts.length < 3) return null;\n        if ((t === \'SOLID\' || t === \'TRACE\') && pts.length === 4) {\n          pts = [pts[0], pts[1], pts[3], pts[2]];\n        }\n        const isWcsFace = t === \'3DFACE\';\n        ent.type = \'LWPOLYLINE\';\n        ent.closed = true;\n        ent.vertices = pts\n          .map((p: any) => {\n            const px = Number(p.x),\n              py = Number(p.y);\n            if (!isValidCoord(px) || !isValidCoord(py)) return null;\n            return isWcsFace ? { x: px, y: py } : ocs.pt(px, py, p.z || elev);\n          })\n          .filter(Boolean);\n        if (ent.vertices.length < 3) return null;\n      } else {\n        return null;\n      }\n\n      return ent as CadEntity;\n    } catch {\n      return null;\n    }\n  }\n\n  const rawBlocks =\n    (db && db.tables && db.tables.BLOCK_RECORD && db.tables.BLOCK_RECORD.entries) ||\n    (db && db.blocks) ||\n    [];\n  let modelSpaceFallback: CadEntity[] = [];\n  let paperSpaceFallback: CadEntity[] = [];\n\n  function processBlockRecord(b: any, fallbackName?: string) {\n    if (!b) return;\n    const bname = cleanCadText(b.name || fallbackName || \'\');\n    if (!bname) return;\n    const upper = bname.toUpperCase();\n    const bEnts = (Array.isArray(b.entities) ? b.entities : [])\n      .map((r: any) => mapRawEntity(r, true))\n      .filter((e: any): e is CadEntity => e !== null);\n\n    if (upper.startsWith(\'*MODEL_SPACE\')) {\n      if (bEnts.length > modelSpaceFallback.length) modelSpaceFallback = bEnts;\n      return;\n    }\n    if (upper.startsWith(\'*PAPER_SPACE\')) {\n      if (bEnts.length > paperSpaceFallback.length) paperSpaceFallback = bEnts;\n      return;\n    }\n\n    const bpSrc =\n      b.basePoint ||\n      b.origin ||\n      b.insertionPoint ||\n      (b.block && (b.block.basePoint || b.block.origin)) || { x: 0, y: 0 };\n\n    blocks[bname] = {\n      name: bname,\n      basePoint: {\n        x: isValidCoord(bpSrc.x) ? bpSrc.x : 0,\n        y: isValidCoord(bpSrc.y) ? bpSrc.y : 0,\n      },\n      entities: bEnts,\n    };\n  }\n\n  if (Array.isArray(rawBlocks)) {\n    rawBlocks.forEach((b: any) => processBlockRecord(b));\n  } else if (typeof rawBlocks === \'object\' && rawBlocks !== null) {\n    Object.keys(rawBlocks).forEach((k) => processBlockRecord(rawBlocks[k], k));\n  }\n\n  const rawEnts = db && Array.isArray(db.entities) ? db.entities : [];\n  rawEnts.forEach((r: any) => {\n    const m = mapRawEntity(r, false);\n    if (m) entities.push(m);\n  });\n\n  if (entities.length === 0 && modelSpaceFallback.length > 0) {\n    modelSpaceFallback.forEach((e) => entities.push(e));\n  } else if (entities.length === 0 && paperSpaceFallback.length > 0) {\n    paperSpaceFallback.forEach((e) => entities.push(e));\n  }\n\n  return {\n    fileName,\n    formatVersion: versionLabel || \'DWG\',\n    layers,\n    blocks,\n    entities,\n  };\n}\n\nexport async function parseBinaryDwgFile(\n  arrayBuffer: ArrayBuffer,\n  fileName: string,\n  versionLabel: string,\n  onProgress?: (msg: string) => void\n): Promise<DrawingModel> {\n  const uint8 = new Uint8Array(arrayBuffer);\n  const previewObj = await extractDwgThumbnail(uint8);\n  let model: DrawingModel | null = null;\n\n  try {\n    const engine = await createLibreDwgEngine(onProgress);\n    const instance = engine.instance;\n    if (onProgress)\n      onProgress(`DWG \353\260\224\354\235\264\353\204\210\353\246\254 \354\212\244\355\212\270\353\246\274 \355\225\264\353\217\205 \354\244\221 (${versionLabel})...`);\n\n    let dwgPtr: any = null;\n    if (instance && typeof instance.dwg_read_data === \'function\') {\n      try {\n        dwgPtr = instance.dwg_read_data(arrayBuffer, engine.Dwg_File_Type.DWG);\n      } catch {\n        // ignore\n      }\n    }\n    const wasm =\n      engine.rawWasmMod ||\n      (instance && (instance.wasmInstance || instance.module));\n    if (!dwgPtr && wasm && wasm.FS && typeof wasm.dwg_read_file === \'function\') {\n      try {\n        wasm.FS.writeFile(\'safe_in.dwg\', uint8);\n        const res = wasm.dwg_read_file(\'safe_in.dwg\');\n        try {\n          wasm.FS.unlink(\'safe_in.dwg\');\n        } catch {\n          // ignore\n        }\n        dwgPtr = res && res.data ? res.data : typeof res === \'number\' ? res : null;\n      } catch {\n        // ignore\n      }\n    }\n\n    if (dwgPtr) {\n      if (onProgress) onProgress(\'OCS/WCS \354\242\214\355\221\234 \353\263\200\355\231\230 \353\260\217 \353\270\224\353\241\235 \354\265\234\354\240\201\355\231\224 \354\244\221...\');\n      const db = instance.convert(dwgPtr);\n      if (db) {\n        model = normalizeLibreDwgDb(db, fileName, versionLabel);\n      }\n      try {\n        instance.dwg_free(dwgPtr);\n      } catch {\n        // ignore\n      }\n    }\n  } catch (err) {\n    console.warn(\'LibreDWG WebAssembly parse warning:\', err);\n  }\n\n  if (\n    (!model || !model.entities || model.entities.length === 0) &&\n    previewObj\n  ) {\n    const w = Math.max(1200, previewObj.width * 4);\n    const h = Math.max(900, previewObj.height * 4);\n    const rasterEnt: RasterPreviewEntity = {\n      id: \'PREVIEW_IMG\',\n      type: \'RASTER_PREVIEW\',\n      layer: \'0\',\n      img: previewObj.img,\n      minX: 0,\n      minY: 0,\n      maxX: w,\n      maxY: h,\n    };\n    return {\n      fileName,\n      formatVersion: `${versionLabel} (\353\202\264\354\236\245 \355\224\204\353\246\254\353\267\260 \353\263\265\354\233\220)`,\n      layers: {\n        \'0\': {\n          name: \'0\',\n          aci: 7,\n          color: \'#0f172a\',\n          visible: true,\n          count: 1,\n        },\n      },\n      blocks: {},\n      entities: [rasterEnt],\n      extents: { minX: 0, minY: 0, maxX: w, maxY: h },\n    };\n  }\n\n  if (!model || !model.entities || model.entities.length === 0) {\n    throw new Error(\n      \'\354\235\264 DWG \355\214\214\354\235\274\354\235\200 \354\247\200\354\233\220\353\220\230\354\247\200 \354\225\212\353\212\224 \354\225\224\355\230\270\355\231\224 \353\230\220\353\212\224 \355\212\271\354\210\230 \355\217\254\353\247\267\354\236\205\353\213\210\353\213\244. DXF\353\241\234 \353\263\200\355\231\230 \355\233\204 \354\227\264\354\226\264\353\263\264\354\204\270\354\232\224.\'\n    );\n  }\n\n  return model;\n}\n"
    num_lines: 802
    num_bytes: 25316
    line_range_bytes: 25316
  }
}
