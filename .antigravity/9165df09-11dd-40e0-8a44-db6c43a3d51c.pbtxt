    content: "    const isDiagonal = dx > len * 0.22 && dy > len * 0.22;\n    if (isDiagonal && len > maxDiag * 0.22) {\n      return true;\n    }\n    return false;\n  }\n\n  const finalEntities: CadEntity[] = [];\n  for (let i = 0; i < expanded.length; i++) {\n    const e = expanded[i];\n    if (e.type === \'LINE\' && e.start && e.end) {\n      if (isArtifactStreakSegment(e.start, e.end)) continue;\n      finalEntities.push(e);\n    } else if (e.type === \'LWPOLYLINE\' && e.vertices && e.vertices.length >= 2) {\n      if (e.closed && e.vertices.length >= 3) {\n        const v0 = e.vertices[0];\n        const vn = e.vertices[e.vertices.length - 1];\n        if (isArtifactStreakSegment(vn, v0)) {\n          e.closed = false;\n        }\n      }\n      let currentSubVerts = [e.vertices[0]];\n      for (let k = 1; k < e.vertices.length; k++) {\n        const prev = e.vertices[k - 1];\n        const cur = e.vertices[k];\n        if (isArtifactStreakSegment(prev, cur)) {\n          if (currentSubVerts.length >= 2) {\n            finalEntities.push({\n              id: `${e.id}_sub${k}`,\n              type: \'LWPOLYLINE\',\n              layer: e.layer,\n              aci: e.aci,\n              linetype: e.linetype,\n              lineweight: e.lineweight,\n              closed: false,\n              vertices: currentSubVerts,\n            });\n          }\n          currentSubVerts = [cur];\n        } else {\n          currentSubVerts.push(cur);\n        }\n      }\n      if (currentSubVerts.length >= 2) {\n        e.vertices = currentSubVerts;\n        finalEntities.push(e);\n      }\n    } else {\n      finalEntities.push(e);\n    }\n  }\n\n  // Count entities per layer\n  finalEntities.forEach((e) => {\n    const lname = e.layer || \'0\';\n    if (!layers[lname]) {\n      const fallbackAci =\n        e.aci && e.aci !== 256 && e.aci !== 0 ? e.aci : 7;\n      layers[lname] = {\n        name: lname,\n        aci: fallbackAci,\n        color: resolveCadColorValue(fallbackAci, theme),\n        visible: true,\n        count: 0,\n      };\n    }\n    layers[lname].count++;\n  });\n\n  // Clamp MText height runaway\n  const extSpan = Math.max(10, Math.min(spanW, spanH));\n  const validHeights = finalEntities\n    .filter((e): e is TextEntity => e.type === \'TEXT\' && e.height > 0 && e.height < extSpan * 0.06)\n    .map((e) => e.height)\n    .sort((a, b) => a - b);\n  const medianH =\n    validHeights.length > 0\n      ? validHeights[Math.floor(validHeights.length * 0.6)]\n      : extSpan * 0.012;\n  const maxH = Math.max(medianH * 3.0, extSpan * 0.03);\n\n  finalEntities.forEach((e) => {\n    if (e.type === \'TEXT\') {\n      if (!(e.height > 0) || e.height > maxH) e.height = medianH;\n    }\n  });\n\n  // Compile Render Batches\n  const batchMap: Record<\n    string,\n    {\n      layer: string;\n      color: string;\n      dashType: \'S\' | \'D\' | \'C\';\n      lines: number[];\n      polylines: PolylineEntity[];\n      circles: CircleEntity[];\n      arcs: ArcEntity[];\n      ellipses: EllipseEntity[];\n    }\n  > = {};\n  const textList: TextEntity[] = [];\n  const rasterList: RasterPreviewEntity[] = [];\n\n  for (let i = 0; i < finalEntities.length; i++) {\n    const e = finalEntities[i];\n    if (e.type === \'TEXT\') {\n      textList.push(e);\n      continue;\n    }\n    if (e.type === \'RASTER_PREVIEW\') {"
