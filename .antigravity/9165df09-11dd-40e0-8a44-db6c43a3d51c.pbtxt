    absolute_path_uri: "file:///src/lib/dxfParser.ts"
    start_line: 479
    end_line: 513
    content: "        }\n        continue;\n      } else if (p.code === 0 && p.value === \'ENDBLK\') {\n        currentBlock = null;\n        idx++;\n        continue;\n      } else if (p.code === 0 && currentBlock) {\n        const res = parseEntityGroup(idx);\n        if (res.entity) currentBlock.entities.push(res.entity);\n        idx = res.nextIndex;\n        continue;\n      }\n      idx++;\n    } else if (section === \'ENTITIES\') {\n      if (p.code === 0) {\n        const res = parseEntityGroup(idx);\n        if (res.entity) entities.push(res.entity);\n        idx = res.nextIndex;\n        continue;\n      }\n      idx++;\n    } else {\n      idx++;\n    }\n  }\n\n  return {\n    fileName,\n    formatVersion: \'DXF\',\n    layers,\n    blocks,\n    entities,\n  };\n}\n"
    num_lines: 514
