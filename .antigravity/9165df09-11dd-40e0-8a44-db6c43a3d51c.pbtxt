  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport {\n  CadBlock,\n  CadEntity,\n  DrawingModel,\n  LayerInfo,\n  Point2D,\n  Vertex2D,\n} from \'../types/cad\';\nimport { cleanCadText } from \'./textSanitizer\';\n\nexport interface OcsTransform {\n  isIdentity: boolean;\n  flipX: number;\n  pt: (x: number, y: number, z?: number) => Point2D;\n}\n\nexport function buildOcsTransform(extObj: unknown): OcsTransform {\n  if (!extObj) {\n    return { isIdentity: true, flipX: 1, pt: (x, y) => ({ x, y }) };\n  }\n  let nx = 0,\n    ny = 0,\n    nz = 1;\n\n  if (Array.isArray(extObj) && extObj.length >= 3) {\n    nx = Number(extObj[0] || 0);\n    ny = Number(extObj[1] || 0);\n    nz = Number(extObj[2] !== undefined ? extObj[2] : 1);\n  } else if (typeof extObj === \'object\') {\n    const o = extObj as { x?: number; y?: number; z?: number };\n    nx = Number(o.x || 0);\n    ny = Number(o.y || 0);\n    nz = Number(o.z !== undefined ? o.z : 1);\n  }\n\n  if (!isFinite(nx) || !isFinite(ny) || !isFinite(nz)) {\n    return { isIdentity: true, flipX: 1, pt: (x, y) => ({ x, y }) };\n  }\n\n  const len = Math.hypot(nx, ny, nz);\n  if (len < 1e-9) {\n    return { isIdentity: true, flipX: 1, pt: (x, y) => ({ x, y }) };\n  }\n  nx /= len;\n  ny /= len;\n  nz /= len;\n\n  // Standard normal (0, 0, +1)\n  if (Math.abs(nx) < 1e-5 && Math.abs(ny) < 1e-5 && nz > 0) {\n    return { isIdentity: true, flipX: 1, pt: (x, y) => ({ x, y }) };\n  }\n  // Mirrored normal (0, 0, -1) -> WCS_X = -OCS_X, WCS_Y = OCS_Y\n  if (Math.abs(nx) < 1e-5 && Math.abs(ny) < 1e-5 && nz < 0) {\n    return { isIdentity: false, flipX: -1, pt: (x, y) => ({ x: -x, y }) };\n  }\n\n  // Arbitrary Axis Algorithm (AutoCAD DXF spec)\n  let axX: number, axY: number, axZ: number;\n  if (Math.abs(nx) < 1 / 64 && Math.abs(ny) < 1 / 64) {\n    const alen = Math.hypot(nz, -nx) || 1;\n    axX = nz / alen;\n    axY = 0;\n    axZ = -nx / alen;\n  } else {\n    const alen = Math.hypot(-ny, nx) || 1;\n    axX = -ny / alen;\n    axY = nx / alen;\n    axZ = 0;\n  }\n  const ayX = ny * axZ - nz * axY;\n  const ayY = nz * axX - nx * axZ;\n\n  return {\n    isIdentity: false,\n    flipX: nz < 0 ? -1 : 1,\n    pt: (x, y, z = 0) => ({\n      x: x * axX + y * ayX + z * nx,\n      y: x * axY + y * ayY + z * ny,\n    }),\n  };\n}\n\nexport function expandVerticesWithBulge(\n  rawVerts: Vertex2D[],\n  isClosed?: boolean\n): Vertex2D[] {\n  if (!rawVerts || rawVerts.length < 2) return rawVerts || [];\n  const out: Vertex2D[] = [];\n  const segCount = isClosed ? rawVerts.length : rawVerts.length - 1;\n\n  for (let i = 0; i < rawVerts.length; i++) {\n    const p1 = rawVerts[i];\n    out.push({ x: p1.x, y: p1.y });\n\n    if (i < segCount && p1.bulge && Math.abs(p1.bulge) > 1e-4) {\n      const p2 = rawVerts[(i + 1) % rawVerts.length];\n      const chordDx = p2.x - p1.x;\n      const chordDy = p2.y - p1.y;\n      const chordLen = Math.hypot(chordDx, chordDy);\n\n      if (chordLen > 1e-6) {\n        const b = p1.bulge;\n        const theta = 4 * Math.atan(b);\n        const radius = Math.abs(chordLen / (2 * Math.sin(Math.abs(theta) / 2)));\n        const midX = (p1.x + p2.x) / 2;\n        const midY = (p1.y + p2.y) / 2;\n        const cotQuarter = (1 - b * b) / (2 * b);\n        const cx = midX - (chordDy / 2) * cotQuarter;\n        const cy = midY + (chordDx / 2) * cotQuarter;\n        const startA = Math.atan2(p1.y - cy, p1.x - cx);\n        const steps = Math.max(\n          4,\n          Math.min(16, Math.ceil(Math.abs(theta) / (Math.PI / 12)))\n        );\n\n        for (let s = 1; s < steps; s++) {\n          const a = startA + (theta * s) / steps;\n          out.push({\n            x: cx + Math.cos(a) * radius,\n            y: cy + Math.sin(a) * radius,\n          });\n        }\n      }\n    }\n  }\n  return out;\n}\n\nexport function parseDxfText(\n  dxfText: string,\n  fileName: string = \'drawing.dxf\'\n): DrawingModel {\n  const rawLines = dxfText\n    .replace(/\\r\\n/g, \'\\n\')\n    .replace(/\\r/g, \'\\n\')\n    .split(\'\\n\');\n  const pairs: Array<{ code: number; value: string }> = [];\n\n  for (let i = 0; i + 1 < rawLines.length; i += 2) {\n    const code = parseInt(rawLines[i].trim(), 10);\n    if (!isNaN(code)) pairs.push({ code, value: rawLines[i + 1].trim() });\n  }\n\n  const layers: Record<string, LayerInfo> = {};\n  const blocks: Record<string, CadBlock> = {};\n  const entities: CadEntity[] = [];\n\n  let section = \'\';\n  let inLayerTable = false;\n  let currentLayer: LayerInfo | null = null;\n  let currentBlock: CadBlock | null = null;\n  let idSeq = 1;\n\n  function parseEntityGroup(startIdx: number): {\n    entity: CadEntity | null;\n    nextIndex: number;\n  } {\n    const type = pairs[startIdx].value;\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    const ent: any = {\n      id: `DXF_${idSeq++}`,\n      type,\n      layer: \'0\',\n      aci: null,\n      linetype: \'CONTINUOUS\',\n      lineweight: 1.2,\n      vertices: [],\n    };\n    let i = startIdx + 1;\n    let curVertex: Vertex2D | null = null;\n    const ext = { x: 0, y: 0, z: 1 };\n\n    while (i < pairs.length) {\n      const c = pairs[i].code;\n      const v = pairs[i].value;\n      if (c === 0) break;\n\n      if (c === 8) ent.layer = cleanCadText(v) || \'0\';\n      else if (c === 6) ent.linetype = v;\n      else if (c === 62) ent.aci = parseInt(v, 10);\n      else if (c === 420) ent.aci = parseInt(v, 10);\n      else if (c === 210) ext.x = parseFloat(v);\n      else if (c === 220) ext.y = parseFloat(v);\n      else if (c === 230) ext.z = parseFloat(v);\n      else if (type === \'LINE\') {\n        if (c === 10) {\n          ent.start = ent.start || {};\n          ent.start.x = parseFloat(v);\n        } else if (c === 20) {\n          ent.start = ent.start || {};\n          ent.start.y = parseFloat(v);\n        } else if (c === 11) {\n          ent.end = ent.end || {};\n          ent.end.x = parseFloat(v);\n        } else if (c === 21) {\n          ent.end = ent.end || {};\n          ent.end.y = parseFloat(v);\n        }\n      } else if (type === \'LWPOLYLINE\' || type === \'LEADER\') {\n        ent.type = \'LWPOLYLINE\';\n        if (c === 70) {\n          const flg = parseInt(v, 10) || 0;\n          ent.closed = type !== \'LEADER\' && (flg & 1) !== 0;\n        } else if (c === 10) {\n          curVertex = { x: parseFloat(v), y: 0, bulge: 0 };\n          ent.vertices.push(curVertex);\n        } else if (c === 20 && curVertex) {\n          curVertex.y = parseFloat(v);\n        } else if (c === 42 && curVertex) {\n          curVertex.bulge = parseFloat(v);\n        }\n      } else if (type === \'CIRCLE\' || type === \'ARC\') {\n        if (c === 10) {\n          ent.center = ent.center || { x: 0, y: 0 };\n          ent.center.x = parseFloat(v);\n        } else if (c === 20) {\n          ent.center = ent.center || { x: 0, y: 0 };\n          ent.center.y = parseFloat(v);\n        } else if (c === 40) ent.radius = parseFloat(v);\n        else if (c === 50) ent.startAngle = parseFloat(v);\n        else if (c === 51) ent.endAngle = parseFloat(v);\n      } else if (type === \'ELLIPSE\') {\n        if (c === 10) {\n          ent.center = ent.center || { x: 0, y: 0 };\n          ent.center.x = parseFloat(v);\n        } else if (c === 20) {\n          ent.center = ent.center || { x: 0, y: 0 };\n          ent.center.y = parseFloat(v);\n        } else if (c === 11) {\n          ent.majorAxis = ent.majorAxis || { x: 1, y: 0 };\n          ent.majorAxis.x = parseFloat(v);\n        } else if (c === 21) {\n          ent.majorAxis = ent.majorAxis || { x: 1, y: 0 };\n          ent.majorAxis.y = parseFloat(v);\n        } else if (c === 40) ent.axisRatio = parseFloat(v);\n      } else if (type === \'TEXT\' || type === \'MTEXT\' || type === \'ATTRIB\') {\n        ent.type = \'TEXT\';\n        ent.isMtext = type === \'MTEXT\';\n        if (c === 10) {\n          ent.position = ent.position || { x: 0, y: 0 };\n          ent.position.x = parseFloat(v);\n        } else if (c === 20) {\n          ent.position = ent.position || { x: 0, y: 0 };\n          ent.position.y = parseFloat(v);\n        } else if (c === 40) ent.height = parseFloat(v);\n        else if (c === 50) ent.rotation = parseFloat(v);\n        else if (c === 1 || c === 3) ent.rawText = (ent.rawText || \'\') + v;\n      } else if (type === \'INSERT\' || type === \'DIMENSION\') {\n        if (c === 2) ent.blockName = cleanCadText(v);\n        else if (c === 10) {\n          ent.position = ent.position || { x: 0, y: 0 };\n          ent.position.x = parseFloat(v);\n        } else if (c === 20) {\n          ent.position = ent.position || { x: 0, y: 0 };\n          ent.position.y = parseFloat(v);\n        } else if (c === 41) ent.scaleX = parseFloat(v);\n        else if (c === 42) ent.scaleY = parseFloat(v);\n        else if (c === 50) ent.rotation = parseFloat(v);\n      } else if (type === \'SPLINE\' || type === \'SOLID\' || type === \'TRACE\') {\n        if (c === 10 || c === 11 || c === 12 || c === 13) {\n          curVertex = { x: parseFloat(v), y: 0 };\n          ent.vertices.push(curVertex);\n        } else if (\n          (c === 20 || c === 21 || c === 22 || c === 23) &&\n          curVertex\n        ) {\n          curVertex.y = parseFloat(v);\n        }\n      }\n      i++;\n    }\n\n    const ocs = buildOcsTransform(ext);\n\n    if (type === \'LINE\') {\n      if (\n        !ent.start ||\n        !ent.end ||\n        ent.start.x === undefined ||\n        ent.start.y === undefined ||\n        ent.end.x === undefined ||\n        ent.end.y === undefined\n      ) {\n        return { entity: null, nextIndex: i };\n      }\n    }\n    if (ent.rawText !== undefined) {\n      ent.text = cleanCadText(ent.rawText);\n      delete ent.rawText;\n    }\n    if (type === \'DIMENSION\' && ent.blockName) {\n      ent.type = \'INSERT\';\n      ent.position = { x: 0, y: 0 };\n    }\n    if (type === \'SOLID\' || type === \'TRACE\') {\n      ent.type = \'LWPOLYLINE\';\n      ent.closed = true;\n      if (ent.vertices.length === 4) {\n        const tmp = ent.vertices[2];\n        ent.vertices[2] = ent.vertices[3];\n        ent.vertices[3] = tmp;\n      }\n    } else if (type === \'SPLINE\') {\n      ent.type = \'LWPOLYLINE\';\n    }\n\n    if (type === \'POLYLINE\') {\n      ent.type = \'LWPOLYLINE\';\n      while (i < pairs.length) {\n        if (pairs[i].code === 0 && pairs[i].value === \'VERTEX\') {\n          i++;\n          const vtx = { x: 0, y: 0, bulge: 0 };\n          let isSplineFrameVertex = false;\n          while (i < pairs.length && pairs[i].code !== 0) {\n            if (pairs[i].code === 10) vtx.x = parseFloat(pairs[i].value);\n            else if (pairs[i].code === 20) vtx.y = parseFloat(pairs[i].value);\n            else if (pairs[i].code === 42) vtx.bulge = parseFloat(pairs[i].value);\n            else if (\n              pairs[i].code === 70 &&\n              (parseInt(pairs[i].value, 10) & 16) !== 0\n            ) {\n              isSplineFrameVertex = true;\n            }\n            i++;\n          }\n          if (!isSplineFrameVertex) ent.vertices.push(vtx);\n        } else if (pairs[i].code === 0 && pairs[i].value === \'SEQEND\') {\n          i++;\n          while (i < pairs.length && pairs[i].code !== 0) i++;\n          break;\n        } else break;\n      }\n    }\n\n    // Apply OCS -> WCS transformation\n    if (\n      !ocs.isIdentity &&\n      type !== \'LINE\' &&\n      type !== \'SPLINE\' &&\n      type !== \'LEADER\' &&\n      type !== \'MTEXT\'\n    ) {\n      if (ent.type === \'LWPOLYLINE\' && ent.vertices.length >= 2) {\n        ent.vertices = ent.vertices.map((v: Vertex2D) => {\n          const p = ocs.pt(v.x, v.y);\n          return { x: p.x, y: p.y, bulge: (v.bulge || 0) * ocs.flipX };\n        });\n      } else if (\n        (ent.type === \'CIRCLE\' || ent.type === \'ARC\') &&\n        ent.center\n      ) {\n        ent.center = ocs.pt(ent.center.x, ent.center.y);\n        if (ent.type === \'ARC\' && ocs.flipX < 0) {\n          const sa = ent.startAngle || 0,\n            ea = ent.endAngle || 0;\n          ent.startAngle = 180 - ea;\n          ent.endAngle = 180 - sa;\n        }\n      } else if (ent.type === \'INSERT\' && ent.position && type === \'INSERT\') {\n        ent.position = ocs.pt(ent.position.x, ent.position.y);\n        if (ocs.flipX < 0) {\n          ent.scaleX = -(ent.scaleX !== undefined ? ent.scaleX : 1);\n          ent.rotation = -(ent.rotation || 0);\n        }\n      } else if (ent.type === \'TEXT\' && ent.position) {\n        ent.position = ocs.pt(ent.position.x, ent.position.y);\n        if (ocs.flipX < 0) ent.rotation = -(ent.rotation || 0);\n      }\n    }\n\n    if (ent.type === \'LWPOLYLINE\' && ent.vertices.length >= 2) {\n      ent.vertices = expandVerticesWithBulge(ent.vertices, ent.closed);\n    }\n\n    return { entity: ent as CadEntity, nextIndex: i };\n  }\n\n  let idx = 0;\n  while (idx < pairs.length) {\n    const p = pairs[idx];\n    if (\n      p.code === 0 &&\n      p.value === \'SECTION\' &&\n      idx + 1 < pairs.length &&\n      pairs[idx + 1].code === 2\n    ) {\n      section = pairs[idx + 1].value;\n      idx += 2;\n      continue;\n    }\n    if (p.code === 0 && p.value === \'ENDSEC\') {\n      section = \'\';\n      inLayerTable = false;\n      currentBlock = null;\n      idx++;\n      continue;\n    }\n\n    if (section === \'TABLES\') {\n      if (\n        p.code === 0 &&\n        p.value === \'TABLE\' &&\n        idx + 1 < pairs.length &&\n        pairs[idx + 1].value === \'LAYER\'\n      ) {\n        inLayerTable = true;\n        idx += 2;\n        continue;\n      }\n      if (p.code === 0 && p.value === \'ENDTAB\') {\n        inLayerTable = false;\n        currentLayer = null;\n        idx++;\n        continue;\n      }\n      if (inLayerTable) {\n        if (p.code === 0 && p.value === \'LAYER\') {\n          currentLayer = {\n            name: \'0\',\n            aci: 7,\n            color: \'#0f172a\',\n            visible: true,\n            count: 0,\n          };\n        } else if (currentLayer) {\n          if (p.code === 2) {\n            currentLayer.name = cleanCadText(p.value) || \'0\';\n            layers[currentLayer.name] = currentLayer;\n          } else if (p.code === 62) {\n            const col = parseInt(p.value, 10);\n            currentLayer.aci = Math.abs(col);\n            if (col < 0) currentLayer.visible = false;\n          } else if (p.code === 420) {\n            currentLayer.aci = parseInt(p.value, 10);\n          }\n        }\n      }\n      idx++;\n    } else if (section === \'BLOCKS\') {\n      if (p.code === 0 && p.value === \'BLOCK\') {\n        currentBlock = {\n          name: \'\',\n          basePoint: { x: 0, y: 0 },\n          entities: [],\n        };\n        idx++;\n        while (idx < pairs.length && pairs[idx].code !== 0) {\n          if (pairs[idx].code === 2) {\n            currentBlock.name = cleanCadText(pairs[idx].value);\n            blocks[currentBlock.name] = currentBlock;\n          } else if (pairs[idx].code === 10) {\n            currentBlock.basePoint.x = parseFloat(pairs[idx].value);\n          } else if (pairs[idx].code === 20) {\n            currentBlock.basePoint.y = parseFloat(pairs[idx].value);\n          }\n          idx++;\n        }\n        continue;\n      } else if (p.code === 0 && p.value === \'ENDBLK\') {\n        currentBlock = null;\n        idx++;\n        continue;\n      } else if (p.code === 0 && currentBlock) {\n        const res = parseEntityGroup(idx);\n        if (res.entity) currentBlock.entities.push(res.entity);\n        idx = res.nextIndex;\n        continue;\n      }\n      idx++;\n    } else if (section === \'ENTITIES\') {\n      if (p.code === 0) {\n        const res = parseEntityGroup(idx);\n        if (res.entity) entities.push(res.entity);\n        idx = res.nextIndex;\n        continue;\n      }\n      idx++;\n    } else {\n      idx++;\n    }\n  }\n\n  return {\n    fileName,\n    formatVersion: \'DXF\',\n    layers,\n    blocks,\n    entities,\n  };\n}\n"
        path {
          absolute_uri: "file:///src/lib/dxfParser.ts"
        }
        overwrite: true
      }
    }
