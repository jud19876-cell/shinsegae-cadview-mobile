    end_line: 59
    content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useRef } from \'react\';\nimport {\n  X,\n  FolderOpen,\n  Clock,\n  Trash2,\n  Building,\n  Cog,\n  History,\n  FileCheck,\n  ChevronRight,\n} from \'lucide-react\';\nimport { RecentDrawingItem, formatRelativeTime } from \'../lib/drawingStorage\';\n\ninterface FileSelectModalProps {\n  isOpen: boolean;\n  recentDrawings: RecentDrawingItem[];\n  onClose: () => void;\n  onOpenFileClick: () => void;\n  onSelectRecent: (item: RecentDrawingItem) => void;\n  onDeleteRecent: (id: string, e: React.MouseEvent) => void;\n  onClearAllRecent: () => void;\n  onLoadArchSample: () => void;\n  onLoadMechSample: () => void;\n  onClearCanvas: () => void;\n}\n\nexport const FileSelectModal: React.FC<FileSelectModalProps> = ({\n  isOpen,\n  recentDrawings,\n  onClose,\n  onOpenFileClick,\n  onSelectRecent,\n  onDeleteRecent,\n  onClearAllRecent,\n  onLoadArchSample,\n  onLoadMechSample,\n  onClearCanvas,\n}) => {\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 bg-black/60 backdrop-blur-xs z-50 flex items-end sm:items-center justify-center p-0 sm:p-4\">\n      <div className=\"bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-800 w-full sm:max-w-2xl rounded-t-2xl sm:rounded-2xl max-h-[88vh] flex flex-col shadow-2xl overflow-hidden\">\n        {/* Header */}\n        <div className=\"px-4 py-3.5 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"w-8 h-8 rounded-lg bg-[#1E3A8A] text-white flex items-center justify-center shadow-xs\">\n              <FolderOpen className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h3 className=\"text-sm font-bold text-slate-900 dark:text-white\">\n                \353\217\204\353\251\264 \355\214\214\354\235\274 \354\227\264\352\270\260 \353\260\217 \354\265\234\352\267\274 \353\252\251\353\241\235"
