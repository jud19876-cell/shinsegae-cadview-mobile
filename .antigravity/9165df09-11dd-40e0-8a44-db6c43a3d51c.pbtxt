  view_file {
    absolute_path_uri: "file:///src/lib/modelExpander.ts"
    start_line: 304
    end_line: 379
    content: "  });\n\n  if (xSamples.length >= 40) {\n    xSamples.sort((a, b) => a - b);\n    ySamples.sort((a, b) => a - b);\n    const low = Math.floor(xSamples.length * 0.005);\n    const high = Math.min(\n      xSamples.length - 1,\n      Math.ceil(xSamples.length * 0.995)\n    );\n    if (xSamples[high] > xSamples[low] && ySamples[high] > ySamples[low]) {\n      minX = xSamples[low];\n      maxX = xSamples[high];\n      minY = ySamples[low];\n      maxY = ySamples[high];\n    }\n  }\n\n  if (!isFinite(minX)) {\n    minX = 0;\n    minY = 0;\n    maxX = 1000;\n    maxY = 1000;\n  }\n  const extents: Extents2D = { minX, minY, maxX, maxY };\n\n  const spanW = Math.max(100, maxX - minX);\n  const spanH = Math.max(100, maxY - minY);\n  const maxDiag = Math.hypot(spanW, spanH);\n\n  function isArtifactStreakSegment(\n    p1: Point2D,\n    p2: Point2D,\n    layerName: string = \'\'\n  ): boolean {\n    const dx = Math.abs(p2.x - p1.x);\n    const dy = Math.abs(p2.y - p1.y);\n    const len = Math.hypot(dx, dy);\n    if (!isFinite(len) || len === 0) return true;\n    if (len > maxDiag * 1.5) return true;\n\n    // Diagonal streak cutting across viewports\n    const isDiagonal = dx > len * 0.18 && dy > len * 0.18;\n    if (isDiagonal && len > maxDiag * 0.20) {\n      return true;\n    }\n\n    // Long horizontal or vertical line cutting through interior\n    const isOrthogonal = dx < len * 0.02 || dy < len * 0.02;\n    if (isOrthogonal && len > Math.max(spanW, spanH) * 0.35) {\n      const lyrUpper = layerName.toUpperCase();\n      const isBorderLayer =\n        lyrUpper.includes(\'BORDER\') ||\n        lyrUpper.includes(\'TITLE\') ||\n        lyrUpper.includes(\'FRAME\') ||\n        lyrUpper.includes(\'SHEET\');\n      if (!isBorderLayer) {\n        const midX = (p1.x + p2.x) / 2;\n        const midY = (p1.y + p2.y) / 2;\n        const nearOuterX =\n          Math.abs(midX - minX) < spanW * 0.035 ||\n          Math.abs(midX - maxX) < spanW * 0.035;\n        const nearOuterY =\n          Math.abs(midY - minY) < spanH * 0.035 ||\n          Math.abs(midY - maxY) < spanH * 0.035;\n        if (!nearOuterX && !nearOuterY) {\n          return true;\n        }\n      }\n    }\n    return false;\n  }\n\n  const finalEntities: CadEntity[] = [];\n  for (let i = 0; i < expanded.length; i++) {\n    const e = expanded[i];"
