      thinking_signature: "\022\232\016\n\227\016\001i\024}\023\0252\n\364;\000\177\r\364\302\f\275H\305E\020Q\032NwK\377o\240\207n\221\304(\304\330\221\023\252\001o\334{+(dfv\247.\231\017\274\302\243\231\306\323\337\346)Q\332\375f5\304\235\305\211o2\375\327\276|\214h\000\203\034\214eH\204p\330p\306J\b\2339.} R\366=\370\255$\026W3\024\020\277\001\024\202\005\304FS\305\255^\254T\200\220\367\370\331Y,\003\355)\23090\200$\377Zh\217c\331\004\221\207\362\235\203(\023\305\243gr\034\215\231\026i\363\314\000\245\026F\363\226\0266\245\310\377\327\003K\316-\f\322v\022~\310\a\311\302\004\227<R5\b\257\'\305\217\350R\254\022\315.\326\a-J\364Y.\325/O\006\365\373\201\3463;\346\372\301\330= \003\344\331/u\330\243\022\203><bD\034\221\020\322\312\355\310\357B\223\242\2719\335H\260{d^2YxR\261\341\330^\351r\351\267?\255z\257\316\367\003\236\027RlU\016\2469\223,\262\201\304}OP\204\271\302\016\"\002\314(\"\210\231#\016_z>=\204\213\372yq`\220\271!5\265_4\375\211\\\022~VF6\201\210\247\222\222\t~]\241>\251\335\261\361\326s\355\003o\355\203\304\327\235y\2556\343\234\033\360\307\260\320\2165\200\214\330`1rF!\346\213\265\354\306\207\367k\257\303Va\231\264zo\0347\302\250\017(-\346&\226d\321X\264\241\005#\026\373\252\v\240w\302\371\346\333\3736!$Q\022\363\217\031\030\203Y<\aw\213\353\017\024\246\305U;\217Am_1G\2162\311\204\233\027\354F\251\301AYjv\347\241C\374_\350.\024\232\206\313\033\274\306!N\020\270\263\\\v\330\001b\310\bR\315?\350\025\253>\006\020\223h\325\2567wE\177-\306\377Y\331\"\346^\320\354\267\223\226\245\b\250X\312\277\271\377G\260\027\f\241\006W\001gE\fQp\344\353c\3549\032\035~\260}\234\256\261\265\001\332M\314d\350\355nm\316\237\035\0333\205\351\304a`OV\223C\030\375\312\337\224\203\036e\316Hf7\035e#\023D\216^\371\354\344\312\237\303N2\024\327\340\022{%\215\212\025\372\027\221\316\252d\016\374\201\270\374\245\350\024z{\202\364\006&\356\346\350\206~[6\207\237\025D1oS[\264\323\307\330SV\275\271n&\0238K;\352\241\026\252\256 \260\236(5\006\251D\205\367\314cl\235,Z\0270\362Clt\340+p\330\245\252f\002$\262\212\031\031x@\316>\250<\256`\001\235m\232%\225nG\313\235L\r,\an\250q\270<\211|Yh\320\253\032qR\347*\fE\262E\001\344\024\266\377@\037rq\322\215\242p\"C\373\302V\336\370N\331\255\241\252\362\0238B\342\357\242;\261\212\300\3418\3172p\272\376\001\336\n>\304\250\227qF8M0Gi\333X\200\\\356\337\276\317\333IV\334{\253\337E0;\326\006\215\n{\241UH\025\255Z\216\313\270{\00697\360\033\353\v\"\022\003/\212\'\215\345F\022\0167:\315\312\363pl\220V\313\'+FZ#dlk\302\201Wy5\245\a&\b\006\346\271\226+\005\352\343\317u\025\316\337\356\026\266\031\201\243\3754H\370\004\353H\374\326`\256^\257\334:\250\211\277\325P\237\023\363\351\374\235\267\377\276p\205\264\235\3640\3579qL\223\371\235q\366\201Y\324-\021\235\362-M\'\020\233\223\330\362.P+Q$\030\352*\343\201\255\220\217Y7x\205\024\351g\247\233\246\350\240z\306\374\236\344\'\377\vC\036R\037W1]|\276\b\316\002\247C\272]\335sY\022\277(\223P\223\f\321\035S\342\336;\210\026\310!\323\350G\302\032\216F\004Y\225\2657\320\ft\245k=/\025\032x\272e\351\335\235\351\020\263Jb\313;?\334\337\236\241\025\355\220\267\300E\036\305\2535\251@\327\336\277kN\250\313\216\267 2\0009\216\356\222p|\344\306\327G\030>\336>39\005\000\203]\221\225O\215t\035,\372\221\024\237\227\200\032\313\243q\252X\376\303\027~N\326$\031\202b\017\356\300\330s\247q\002\2459+\310eS\376\233\247\357\211\236\312:\352\223(\377=n<\224@T*\343\271k\317\352\334\304D\205\035\326\177\035\216\306\\k\b\245 t\374\360\231\260H\205Uf\311I\263\326\001\353\366W\"d\"\034\260)\177\214\202\254\346\2713\0341\272L\272\205\366\235\224\bB\337sj\365\340\330\302\227\230,\275zw\367G\304l\005\276\201.\315\235\002\036\263k\374W\362\2467j\021\322\362E\341\372p\f\366[\310\aC\364\315\224\273C\225\027\210G\251W\232\234\331\353*\223\262\366\351\201\333H\270\023K\354\307r\324\240\275\304\021>\336x\020MX\223\201\367\021\326\377\256zJ\236\344B\026$\'\344o\206\034\374^!\320\3334\264\022\235D&\244\213\207s\321\356o\311\314\31378\002\332\252\037q\277\355\2505\366\347\255\021\264\021t\230\t\273\230j|j\vi\346R\21