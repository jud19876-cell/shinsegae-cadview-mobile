      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Filter polyface mesh face records in POLYLINE entities\", \"EndLine\":400, \"Instruction\":\"Filter polyface mesh face records and mesh closure so they do not produce diagonal phantom streaks\", \"ReplacementContent\":\"    if (type === \'POLYLINE\') {\\n      ent.type = \'LWPOLYLINE\';\\n      const isMesh = (ent.flags & 64) !== 0 || (ent.flags & 16) !== 0;\\n      if (isMesh) ent.closed = false;\\n      while (i < pairs.length) {\\n        if (pairs[i].code === 0 && pairs[i].value === \'VERTEX\') {\\n          i++;\\n          const vtx = { x: 0, y: 0, bulge: 0 };\\n          let vtxFlag = 0;\\n          while (i < pairs.length && pairs[i].code !== 0) {\\n            if (pairs[i].code === 10) vtx.x = parseFloat(pairs[i].value);\\n            else if (pairs[i].code === 20) vtx.y = parseFloat(pairs[i].value);\\n            else if (pairs[i].code === 42) vtx.bulge = parseFloat(pairs[i].value);\\n            else if (pairs[i].code === 70) vtxFlag = parseInt(pairs[i].value, 10) || 0;\\n            i++;\\n          }\\n          // In DXF: Polyface mesh face records have (vtxFlag & 128) === 0.\\n          // They contain vertex index numbers, NOT coordinates!\\n          // We must discard face records and spline frame control vertices ((vtxFlag & 16) !== 0).\\n          const isFaceRecord = isMesh && (vtxFlag & 128) === 0;\\n          const isSplineFrame = (vtxFlag & 16) !== 0;\\n          if (!isFaceRecord && !isSplineFrame) {\\n            ent.vertices.push(vtx);\\n          }\\n        } else if (pairs[i].code === 0 && pairs[i].value === \'SEQEND\') {\\n          i++;\\n          while (i < pairs.length && pairs[i].code !== 0) i++;\\n          break;\\n        } else break;\\n      }\\n    }\", \"StartLine\":376, \"TargetContent\":\"    if (type === \'POLYLINE\') {\\n      ent.type = \'LWPOLYLINE\';\\n      while (i < pairs.length) {\\n        if (pairs[i].code === 0 && pairs[i].value === \'VERTEX\')