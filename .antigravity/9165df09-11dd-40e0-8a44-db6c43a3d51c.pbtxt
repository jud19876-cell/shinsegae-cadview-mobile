  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useState } from \'react\';\nimport {\n  X,\n  FolderOpen,\n  Clock,\n  Trash2,\n  Building,\n  Cog,\n  History,\n  FileCheck,\n  ChevronRight,\n  Cloud,\n  HardDrive,\n} from \'lucide-react\';\nimport { RecentDrawingItem, formatRelativeTime } from \'../lib/drawingStorage\';\nimport { CloudStorageExplorer } from \'./CloudStorageExplorer\';\n\nexport type FileModalTab = \'local\' | \'cloud_google\' | \'cloud_dropbox\';\n\ninterface FileSelectModalProps {\n  isOpen: boolean;\n  recentDrawings: RecentDrawingItem[];\n  initialTab?: FileModalTab;\n  onClose: () => void;\n  onOpenFileClick: () => void;\n  onSelectRecent: (item: RecentDrawingItem) => void;\n  onDeleteRecent: (id: string, e: React.MouseEvent) => void;\n  onClearAllRecent: () => void;\n  onLoadArchSample: () => void;\n  onLoadMechSample: () => void;\n  onClearCanvas: () => void;\n  onOpenCloudFile: (arrayBuffer: ArrayBuffer, fileName: string) => Promise<void>;\n  showToast: (msg: string) => void;\n}\n\nexport const FileSelectModal: React.FC<FileSelectModalProps> = ({\n  isOpen,\n  recentDrawings,\n  initialTab = \'local\',\n  onClose,\n  onOpenFileClick,\n  onSelectRecent,\n  onDeleteRecent,\n  onClearAllRecent,\n  onLoadArchSample,\n  onLoadMechSample,\n  onClearCanvas,\n  onOpenCloudFile,\n  showToast,\n}) => {\n  const [activeTab, setActiveTab] = useState<FileModalTab>(initialTab);\n\n  // Sync initial tab when reopened\n  React.useEffect(() => {\n    if (isOpen && initialTab) {\n      setActiveTab(initialTab);\n    }\n  }, [isOpen, initialTab]);\n\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 bg-black/60 backdrop-blur-xs z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 animate-fade-in\">\n      <div className=\"bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-800 w-full sm:max-w-2xl rounded-t-2xl sm:rounded-2xl max-h-[92vh] sm:max-h-[88vh] flex flex-col shadow-2xl overflow-hidden\">\n        {/* Header */}\n        <div className=\"px-4 py-3 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between shrink-0\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-8 h-8 rounded-lg bg-[#1E3A8A] text-white flex items-center justify-center shadow-xs\">\n              <FolderOpen className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h3 className=\"text-sm font-bold text-slate-900 dark:text-white\">\n                \353\217\204\353\251\264 \355\214\214\354\235\274 \354\227\264\352\270\260 \353\260\217 \355\201\264\353\235\274\354\232\260\353\223\234 \354\227\260\353\217\231\n              </h3>\n              <p className=\"text-[11px] text-slate-500 dark:text-slate-400\">\n                \352\270\260\352\270\260 \353\202\264 \355\214\214\354\235\274, \354\265\234\352\267\274 \354\227\264\354\226\264\353\263\270 \353\217\204\353\251\264 \353\230\220\353\212\224 \355\201\264\353\235\274\354\232\260\353\223\234(Google Drive/Dropbox) \353\217\204\353\251\264\354\235\204 \354\227\275\353\213\210\353\213\244\n              </p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 p-1\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Tab Navigation */}\n        <div className=\"flex border-b border-slate-200 dark:border-slate-800 px-4 bg-slate-50/60 dark:bg-slate-800/40 shrink-0 gap-2 overflow-x-auto no-scrollbar\">\n          <button\n            onClick={() => setActiveTab(\'local\')}\n            className={`py-2.5 px-3 border-b-2 text-xs font-bold flex items-center gap-1.5 transition whitespace-nowrap ${\n              activeTab === \'local\'\n                ? \'border-[#1E3A8A] text-[#1E3A8A] dark:border-blue-400 dark:text-blue-400\'\n                : \'border-transparent text-slate-500 hover:text-slate-800 dark:hover:text-slate-200\'\n            }`}\n          >\n            <HardDrive className=\"w-3.5 h-3.5\" />\n            <span>\353\202\264 \352\270\260\352\270\260 & \354\265\234\352\267\274 ({recentDrawings.length})</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'cloud_google\')}\n            className={`py-2.5 px-3 border-b-2 text-xs font-bold flex items-center gap-1.5 transition whitespace-nowrap ${\n              activeTab === \'cloud_google\'\n                ? \'border-[#1E3A8A] text-[#1E3A8A] dark:border-blue-400 dark:text-blue-400\'\n                : \'border-transparent text-slate-500 hover:text-slate-800 dark:hover:text-slate-200\'\n            }`}\n          >\n            <svg className=\"w-3.5 h-3.5\" viewBox=\"0 0 87.3 78\" xmlns=\"http://www.w3.org/2000/svg\">\n              <path d=\"m6.6 66.85 3.85 6.65c.8 1.4 1.95 2.5 3.3 3.3l13.75-23.8h-27.5c0 1.55.4 3.1 1.2 4.5z\" fill=\"#0066da\"/>\n              <path d=\"m43.65 25-13.75-23.8c-1.35.8-2.5 1.9-3.3 3.3l-25.4 44c-.8 1.4-1.2 2.95-1.2 4.5h27.5z\" fill=\"#00ac47\"/>\n              <path d=\"m73.55 76.8c1.35-.8 2.5-1.9 3.3-3.3l1.6-2.75 7.65-13.25c.8-1.4 1.2-2.95 1.2-4.5h-27.5l5.85 10.15z\" fill=\"#ea4335\"/>\n              <path d=\"m43.65 25 13.75-23.8c-1.35-.8-2.9-1.2-4.5-1.2h-18.5c-1.6 0-3.15.45-4.5 1.2z\" fill=\"#00832d\"/>\n              <path d=\"m59.8 53h-32.3l-13.75 23.8c1.35.8 2.9 1.2 4.5 1.2h50.8c1.6 0 3.15-.45 4.5-1.2z\" fill=\"#2684fc\"/>\n              <path d=\"m73.4 26.5-12.7-22c-.8-1.4-1.95-2.5-3.3-3.3l-13.75 23.8 16.15 28h27.45c0-1.55-.4-3.1-1.2-4.5z\" fill=\"#ffba00\"/>\n            </svg>\n            <span>Google Drive</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'cloud_dropbox\')}\n            className={`py-2.5 px-3 border-b-2 text-xs font-bold flex items-center gap-1.5 transition whitespace-nowrap ${\n              activeTab === \'cloud_dropbox\'\n                ? \'border-[#0061FF] text-[#0061FF] dark:border-blue-400 dark:text-blue-400\'\n                : \'border-transparent text-slate-500 hover:text-slate-800 dark:hover:text-slate-200\'\n            }`}\n          >\n            <svg className=\"w-3.5 h-3.5\" viewBox=\"0 0 40 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n              <path d=\"M10.5 7.5L20 13.75L10.5 20L1 13.75L10.5 7.5Z\" fill=\"#0061FF\"/>\n              <path d=\"M29.5 7.5L39 13.75L29.5 20L20 13.75L29.5 7.5Z\" fill=\"#0061FF\"/>\n              <path d=\"M1 26.25L10.5 20L20 26.25L10.5 32.5L1 26.25Z\" fill=\"#0061FF\"/>\n              <path d=\"M39 26.25L29.5 20L20 26.25L29.5 32.5L39 26.25Z\" fill=\"#0061FF\"/>\n              <path d=\"M20 27.5L29.5 33.75L20 40L10.5 33.75L20 27.5Z\" fill=\"#0061FF\"/>\n            </svg>\n            <span>Dropbox</span>\n          </button>\n        </div>\n\n        {/* Content Body */}\n        <div className=\"p-4 overflow-y-auto custom-scrollbar flex-1\">\n          {/* TAB 1: LOCAL & RECENT */}\n          {activeTab === \'local\' && (\n            <div className=\"space-y-5\">\n              {/* Primary Action: Open from Device */}\n              <div className=\"p-4 rounded-2xl bg-gradient-to-r from-slate-900 to-[#1E3A8A] text-white shadow-md flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3\">\n                <div className=\"space-y-1\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"text-xs font-bold px-2 py-0.5 rounded-full bg-white/20 text-white font-mono\">\n                      DWG \302\267 DXF\n                    </span>\n                    <span className=\"text-xs text-blue-200\">100% \353\241\234\354\273\254 \355\225\264\353\217\205</span>\n                  </div>\n                  <h4 className=\"text-sm font-bold\">\353\202\264 \352\270\260\352\270\260\354\227\220\354\204\234 \354\203\210 \353\217\204\353\251\264 \355\214\214\354\235\274 \354\227\264\352\270\260</h4>\n                  <p className=\"text-[11px] text-slate-200 leading-relaxed\">\n                    \354\204\234\353\262\204 \354\240\204\354\206\241 \354\227\206\354\235\264 \354\212\244\353\247\210\355\212\270\355\217\260 \353\251\224\353\252\250\353\246\254\354\227\220\354\204\234 \354\246\211\354\213\234 \353\240\214\353\215\224\353\247\201\353\220\251\353\213\210\353\213\244.\n                  </p>\n                </div>\n                <button\n                  onClick={() => {\n                    onOpenFileClick();\n                    onClose();\n                  }}\n                  className=\"bg-[#C8102E] hover:bg-[#a50d26] text-white border border-[#9f0c24] px-4 py-2.5 rounded-xl text-xs font-bold flex items-center gap-2 active:scale-95 transition shadow-sm shrink-0 w-full sm:w-auto justify-center\"\n                >\n                  <FolderOpen className=\"w-4 h-4\" />\n                  <span>\355\214\214\354\235\274 \354\204\240\355\203\235\355\225\230\352\270\260</span>\n                </button>\n              </div>\n\n              {/* Cloud Shortcut Banner */}\n              <div className=\"p-3 rounded-xl bg-blue-50 dark:bg-slate-800/60 border border-blue-200 dark:border-blue-900/40 flex items-center justify-between gap-2\">\n                <div className=\"flex items-center gap-2 text-xs text-slate-700 dark:text-slate-200\">\n                  <Cloud className=\"w-4 h-4 text-[#1E3A8A] dark:text-blue-400 shrink-0\" />\n                  <span>\355\201\264\353\235\274\354\232\260\353\223\234 \354\240\200\354\236\245\354\206\214(Google Drive, Dropbox)\354\227\220 \353\217\204\353\251\264\354\235\264 \354\236\210\353\202\230\354\232\224?</span>\n                </div>\n                <button\n                  onClick={() => setActiveTab(\'cloud_google\')}\n                  className=\"text-xs font-bold text-[#1E3A8A] dark:text-blue-400 hover:underline shrink-0\"\n                >\n                  \355\201\264\353\235\274\354\232\260\353\223\234 \354\227\264\352\270\260 \342\206\222\n                </button>\n              </div>\n\n              {/* Section: Recent Drawings */}\n              <div className=\"space-y-2.5\">\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex items-center gap-2\">\n                    <History className=\"w-4 h-4 text-[#1E3A8A] dark:text-blue-400\" />\n                    <h4 className=\"text-xs font-bold text-slate-900 dark:text-white\">\n                      \354\265\234\352\267\274 \354\227\264\354\226\264\353\263\270 \353\217\204\353\251\264 ({recentDrawings.length})\n                    </h4>\n                  </div>\n                  {recentDrawings.length > 0 && (\n                    <button\n                      onClick={onClearAllRecent}\n                      className=\"text-[11px] text-slate-400 hover:text-rose-500 transition flex items-center gap-1\"\n                    >\n                      <Trash2 className=\"w-3 h-3\" />\n                      <span>\352\270\260\353\241\235 \354\240\204\354\262\264 \354\202\255\354\240\234</span>\n                    </button>\n                  )}\n                </div>\n\n                {recentDrawings.length === 0 ? (\n                  <div className=\"p-6 rounded-xl border border-dashed border-slate-300 dark:border-slate-800 text-center text-slate-400 space-y-1\">\n                    <Clock className=\"w-6 h-6 mx-auto opacity-40 mb-1\" />\n                    <p className=\"text-xs font-medium\">\354\265\234\352\267\274 \354\227\264\354\226\264\353\263\270 \353\217\204\353\251\264 \352\270\260\353\241\235\354\235\264 \354\227\206\354\212\265\353\213\210\353\213\244.</p>\n                    <p className=\"text-[11px] text-slate-500\">\n                      \353\217\204\353\251\264\354\235\204 \354\227\264\353\251\264 \354\272\224\353\262\204\354\212\244 \354\215\270\353\204\244\354\235\274\352\263\274 \353\247\210\354\247\200\353\247\211 \354\227\264\353\236\214 \354\213\234\352\260\204\354\235\264 \354\227\254\352\270\260\354\227\220 \354\236\220\353\217\231 \353\263\264\352\264\200\353\220\251\353\213\210\353\213\244.\n                    </p>\n                  </div>\n                ) : (\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                    {recentDrawings.map((item) => (\n                      <div\n                        key={item.id}\n                        onClick={() => {\n                          onSelectRecent(item);\n                          onClose();\n                        }}\n                        className=\"group relative cursor-pointer rounded-xl bg-slate-50 hover:bg-slate-100 dark:bg-slate-800/80 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700/80 p-2.5 flex flex-col justify-between transition shadow-xs hover:shadow-md\"\n                      >\n                        {/* Thumbnail preview */}\n                        <div className=\"relative w-full h-28 rounded-lg overflow-hidden bg-slate-950 border border-slate-200 dark:border-slate-800 mb-2\">\n                          {item.thumbnail ? (\n                            <img\n                              src={item.thumbnail}\n                              alt={item.fileName}\n                              className=\"w-full h-full object-contain\"\n                            />\n                          ) : (\n                            <div className=\"w-full h-full flex items-center justify-center text-slate-500 text-xs font-mono\">\n                              \353\257\270\353\246\254\353\263\264\352\270\260 \354\227\206\354\235\214\n                            </div>\n                          )}\n                          <span className=\"absolute top-1.5 left-1.5 text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-black/70 text-white backdrop-blur-xs\">\n                            {item.formatVersion || \'CAD\'}\n                          </span>\n                          <button\n                            onClick={(e) => {\n                              e.stopPropagation();\n                              onDeleteRecent(item.id, e);\n                            }}\n                            className=\"absolute top-1.5 right-1.5 w-6 h-6 rounded-md bg-black/60 hover:bg-rose-600 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition\"\n                            title=\"\354\265\234\352\267\274 \353\252\251\353\241\235\354\227\220\354\204\234 \354\202\255\354\240\234\"\n                          >\n                            <Trash2 className=\"w-3.5 h-3.5\" />\n                          </button>\n                        </div>\n\n                        {/* Metadata */}\n                        <div className=\"space-y-1\">\n                          <div className=\"flex items-center justify-between gap-1\">\n                            <span className=\"text-xs font-bold text-slate-800 dark:text-slate-100 truncate flex-1\">\n                              {item.fileName}\n                            </span>\n                            <ChevronRight className=\"w-3.5 h-3.5 text-slate-400 group-hover:translate-x-0.5 transition shrink-0\" />\n                          </div>\n                          <div className=\"flex items-center justify-between text-[10px] text-slate-500 dark:text-slate-400 font-mono\">\n                            <span>\n                              \352\260\235\354\262\264 {item.entityCount.toLocaleString()}\352\260\234 \302\267 L {item.layerCount}\352\260\234\n                            </span>\n                            <span className=\"flex items-center gap-1 text-[#1E3A8A] dark:text-blue-300 font-semibold\">\n                              <Clock className=\"w-2.5 h-2.5\" />\n                              {formatRelativeTime(item.lastOpenedAt)}\n                            </span>\n                          </div>\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n                )}\n              </div>\n\n              {/* Section: Built-in CAD Samples */}\n              <div className=\"space-y-2\">\n                <h4 className=\"text-xs font-bold text-slate-900 dark:text-white flex items-center gap-2\">\n                  <FileCheck className=\"w-4 h-4 text-emerald-600 dark:text-emerald-400\" />\n                  <span>\355\205\214\354\212\244\355\212\270\354\232\251 \354\240\225\353\260\200 \354\203\230\355\224\214 \353\217\204\353\251\264</span>\n                </h4>\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n                  <button\n                    onClick={() => {\n                      onLoadArchSample();\n                      onClose();\n                    }}\n                    className=\"text-left p-3 rounded-xl bg-slate-50 hover:bg-slate-100 dark:bg-slate-800/80 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700/70 flex items-center gap-3 transition shadow-xs\"\n                  >\n                    <div className=\"w-9 h-9 rounded-lg bg-[#1E3A8A]/10 text-[#1E3A8A] dark:text-blue-300 flex items-center justify-center shrink-0 font-bold\">\n                      <Building className=\"w-4 h-4\" />\n                    </div>\n                    <div className=\"min-w-0 flex-1\">\n                      <div className=\"text-xs font-bold text-slate-800 dark:text-white truncate\">\n                        \352\261\264\354\266\225 \355\217\211\353\251\264\353\217\204 (A-101.dwg)\n                      </div>\n                      <div className=\"text-[10px] text-slate-500 dark:text-slate-400 truncate\">\n                        \353\214\200\355\232\214\354\235\230\354\213\244, \354\227\260\352\265\254\354\206\214, \353\262\275\354\262\264 \353\260\217 \354\271\230\354\210\230\354\204\240\n                      </div>\n                    </div>\n                  </button>\n\n                  <button\n                    onClick={() => {\n                      onLoadMechSample();\n                      onClose();\n                    }}\n                    className=\"text-left p-3 rounded-xl bg-slate-50 hover:bg-slate-100 dark:bg-slate-800/80 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700/70 flex items-center gap-3 transition shadow-xs\"\n                  >\n                    <div className=\"w-9 h-9 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 font-bold\">\n                      <Cog className=\"w-4 h-4\" />\n                    </div>\n                    <div className=\"min-w-0 flex-1\">\n                      <div className=\"text-xs font-bold text-slate-800 dark:text-white truncate\">\n                        \352\270\260\352\263\204 \355\224\214\353\236\234\354\247\200 \354\241\260\353\246\275\353\217\204 (M-204.dwg)\n                      </div>\n                      <div className=\"text-[10px] text-slate-500 dark:text-slate-400 truncate\">\n                        PCD \303\230360 \353\263\274\355\212\270 \355\231\200 \353\260\217 \354\240\225\353\260\200 \354\271\230\354\210\230\n                      </div>\n                    </div>\n                  </button>\n                </div>\n              </div>\n\n              {/* Section: Reset / Clear Canvas */}\n              <div className=\"pt-1 border-t border-slate-200 dark:border-slate-800\">\n                <button\n                  onClick={() => {\n                    onClearCanvas();\n                    onClose();\n                  }}\n                  className=\"w-full text-left p-2.5 rounded-xl hover:bg-rose-50 dark:hover:bg-rose-950/20 text-[#C8102E] flex items-center justify-between text-xs font-semibold transition\"\n                >\n                  <div className=\"flex items-center gap-2\">\n                    <Trash2 className=\"w-4 h-4\" />\n                    <span>\355\230\204\354\236\254 \353\217\204\353\251\264 \353\213\253\352\270\260 (\355\231\224\353\251\264 \353\271\204\354\232\260\352\270\260)</span>\n                  </div>\n                  <span className=\"text-[11px] text-slate-400\">\353\251\224\353\252\250\353\246\254 \354\264\210\352\270\260\355\231\224</span>\n                </button>\n              </div>\n            </div>\n          )}\n\n          {/* TAB 2 & 3: GOOGLE DRIVE & DROPBOX */}\n          {(activeTab === \'cloud_google\' || activeTab === \'cloud_dropbox\') && (\n            <CloudStorageExplorer\n              activeProvider={activeTab === \'cloud_google\' ? \'google\' : \'dropbox\'}\n              showToast={showToast}\n              onOpenCloudFile={async (buffer, fileName) => {\n                await onOpenCloudFile(buffer, fileName);\n                onClose();\n              }}\n            />\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
