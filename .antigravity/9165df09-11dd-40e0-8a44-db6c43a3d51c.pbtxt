      create_file {
        instruction: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { initializeApp, getApps, getApp } from \'firebase/app\';\nimport {\n  getAuth,\n  GoogleAuthProvider,\n  signInWithPopup,\n  signOut,\n  onAuthStateChanged,\n} from \'firebase/auth\';\nimport firebaseConfig from \'../../firebase-applet-config.json\';\n\n// Initialize Firebase\nconst app = getApps().length > 0 ? getApp() : initializeApp(firebaseConfig);\nexport const auth = getAuth(app);\n\n// In-memory token storage (DO NOT persist in localStorage or sessionStorage)\nlet inMemoryDriveAccessToken: string | null = null;\n\nexport interface GoogleAuthUser {\n  displayName?: string | null;\n  email?: string | null;\n  photoURL?: string | null;\n  uid?: string;\n}\n\nlet currentGoogleUser: GoogleAuthUser | null = null;\nconst authListeners: Array<(user: GoogleAuthUser | null) => void> = [];\n\nexport interface GoogleDriveFileItem {\n  id: string;\n  name: string;\n  size?: string;\n  mimeType: string;\n  modifiedTime?: string;\n  thumbnailLink?: string;\n  iconLink?: string;\n  webContentLink?: string;\n}\n\ndeclare global {\n  interface Window {\n    google?: any;\n  }\n}\n\n/**\n * Returns current cached access token\n */\nexport function getDriveAccessToken(): string | null {\n  return inMemoryDriveAccessToken;\n}\n\n/**\n * Returns current authenticated Google user\n */\nexport function getCurrentGoogleUser(): GoogleAuthUser | null {\n  return currentGoogleUser;\n}\n\nfunction notifyAuthState(user: GoogleAuthUser | null) {\n  currentGoogleUser = user;\n  authListeners.forEach((cb) => cb(user));\n}\n\n/**\n * Listen to Google Auth state changes\n */\nexport function subscribeToGoogleAuth(callback: (user: GoogleAuthUser | null) => void) {\n  authListeners.push(callback);\n  callback(currentGoogleUser);\n\n  // Also hook into Firebase Auth if Firebase is used\n  const unsubscribeFirebase = onAuthStateChanged(auth, (firebaseUser) => {\n    if (firebaseUser && inMemoryDriveAccessToken) {\n      const u: GoogleAuthUser = {\n        displayName: firebaseUser.displayName,\n        email: firebaseUser.email,\n        photoURL: firebaseUser.photoURL,\n        uid: firebaseUser.uid,\n      };\n      notifyAuthState(u);\n    }\n  });\n\n  return () => {\n    const idx = authListeners.indexOf(callback);\n    if (idx !== -1) authListeners.splice(idx, 1);\n    unsubscribeFirebase();\n  };\n}\n\n/**\n * Ensure Google Identity Services (GSI) script is loaded\n */\nexport async function ensureGsiLoaded(): Promise<boolean> {\n  if (typeof window === \'undefined\') return false;\n  if (window.google?.accounts?.oauth2) return true;\n\n  return new Promise((resolve) => {\n    let checkCount = 0;\n    const interval = setInterval(() => {\n      if (window.google?.accounts?.oauth2) {\n        clearInterval(interval);\n        resolve(true);\n      }\n      checkCount++;\n      if (checkCount > 15) {\n        clearInterval(interval);\n        resolve(Boolean(window.google?.accounts?.oauth2));\n      }\n    }, 100);\n  });\n}\n\n/**\n * Primary Sign In using Google Identity Services (GIS) Token Client\n * Bypasses third-party cookie restrictions and identitytoolkit network blocks\n */\nasync function signInWithGsi(): Promise<{ user: GoogleAuthUser; accessToken: string }> {\n  await ensureGsiLoaded();\n\n  if (!window.google?.accounts?.oauth2) {\n    throw new Error(\'Google Identity Services \353\235\274\354\235\264\353\270\214\353\237\254\353\246\254\353\245\274 \353\266\210\353\237\254\354\230\244\354\247\200 \353\252\273\355\226\210\354\212\265\353\213\210\353\213\244.\');\n  }\n\n  const clientId = firebaseConfig.oAuthClientId;\n  if (!clientId) {\n    throw new Error(\'OAuth Client ID\352\260\200 \352\265\254\354\204\261\353\220\230\354\247\200 \354\225\212\354\225\230\354\212\265\353\213\210\353\213\244.\');\n  }\n\n  return new Promise((resolve, reject) => {\n    try {\n      const client = window.google.accounts.oauth2.initTokenClient({\n        client_id: clientId,\n        scope:\n          \'https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/userinfo.profile https://www.googleapis.com/auth/userinfo.email\',\n        callback: async (response: any) => {\n          if (response.error) {\n            console.error(\'GSI token response error:\', response);\n            reject(new Error(response.error_description || response.error || \'Google \354\235\270\354\246\235\354\227\220 \354\213\244\355\214\250\355\226\210\354\212\265\353\213\210\353\213\244.\'));\n            return;\n          }\n\n          const accessToken = response.access_token;\n          if (!accessToken) {\n            reject(new Error(\'Google Drive \354\240\221\352\267\274 \355\206\240\355\201\260\354\235\204 \353\260\234\352\270\211\353\260\233\354\247\200 \353\252\273\355\226\210\354\212\265\353\213\210\353\213\244.\'));\n            return;\n          }\n\n          inMemoryDriveAccessToken = accessToken;\n\n          // Fetch user profile info using the token\n          let user: GoogleAuthUser = {\n            displayName: \'Google Drive \354\202\254\354\232\251\354\236\220\',\n            email: \'\',\n          };\n\n          try {\n            const profileRes = await fetch(\'https://www.googleapis.com/oauth2/v3/userinfo\', {\n              headers: { Authorization: `Bearer ${accessToken}` },\n            });\n            if (profileRes.ok) {\n              const profile = await profileRes.json();\n              user = {\n                displayName: profile.name || profile.email || \'Google \354\202\254\354\232\251\354\236\220\',\n                email: profile.email || \'\',\n                photoURL: profile.picture,\n                uid: profile.sub,\n              };\n            }\n          } catch (e) {\n            console.warn(\'Failed to fetch userinfo from Google:\', e);\n          }\n\n          notifyAuthState(user);\n          resolve({ user, accessToken });\n        },\n      });\n\n      client.requestAccessToken({ prompt: \'select_account\' });\n    } catch (err) {\n      reject(err);\n    }\n  });\n}\n\n/**\n * Fallback Sign In using Firebase Auth signInWithPopup\n */\nasync function signInWithFirebasePopup(): Promise<{ user: GoogleAuthUser; accessToken: string }> {\n  const provider = new GoogleAuthProvider();\n  provider.addScope(\'https://www.googleapis.com/auth/drive.readonly\');\n  provider.setCustomParameters({\n    prompt: \'select_account\',\n  });\n\n  const result = await signInWithPopup(auth, provider);\n  const credential = GoogleAuthProvider.credentialFromResult(result);\n  const token = credential?.accessToken;\n\n  if (!token) {\n    throw new Error(\'Google Drive \354\240\221\352\267\274 \355\206\240\355\201\260\354\235\204 \353\260\234\352\270\211\353\260\233\354\247\200 \353\252\273\355\226\210\354\212\265\353\213\210\353\213\244.\');\n  }\n\n  inMemoryDriveAccessToken = token;\n  const user: GoogleAuthUser = {\n    displayName: result.user.displayName,\n    email: result.user.email,\n    photoURL: result.user.photoURL,\n    uid: result.user.uid,\n  };\n  notifyAuthState(user);\n  return { user, accessToken: token };\n}\n\n/**\n * Main Sign In function: Tries Google Identity Services first, falls back to Firebase Auth\n */\nexport async function signInWithGoogleDrive(): Promise<{\n  user: GoogleAuthUser;\n  accessToken: string;\n}> {\n  // Strategy 1: Google Identity Services (GIS) Token Client\n  try {\n    const hasGsi = await ensureGsiLoaded();\n    if (hasGsi && window.google?.accounts?.oauth2) {\n      return await signInWithGsi();\n    }\n  } catch (gsiError: any) {\n    console.warn(\'GSI sign-in failed, trying Firebase popup fallback:\', gsiError);\n    if (gsiError?.message?.includes(\'popup_closed\') || gsiError?.message?.includes(\'closed\')) {\n      throw new Error(\'\353\241\234\352\267\270\354\235\270 \355\214\235\354\227\205\354\235\264 \353\213\253\355\230\224\354\212\265\353\213\210\353\213\244.\');\n    }\n  }\n\n  // Strategy 2: Firebase Auth signInWithPopup\n  try {\n    return await signInWithFirebasePopup();\n  } catch (firebaseError: any) {\n    console.error(\'Firebase Auth sign-in failed:\', firebaseError);\n\n    if (firebaseError?.code === \'auth/popup-closed-by-user\') {\n      throw new Error(\'\353\241\234\352\267\270\354\235\270 \355\214\235\354\227\205\354\235\264 \353\213\253\355\230\224\354\212\265\353\213\210\353\213\244.\');\n    }\n\n    if (\n      firebaseError?.code === \'auth/network-request-failed\' ||\n      firebaseError?.message?.includes(\'network-request-failed\')\n    ) {\n      throw new Error(\n        \'\353\270\214\353\235\274\354\232\260\354\240\200\354\235\230 \355\214\235\354\227\205 \354\260\250\353\213\250 \353\230\220\353\212\224 \354\204\234\353\223\234\355\214\214\355\213\260 \354\277\240\355\202\244 \354\260\250\353\213\250\354\234\274\353\241\234 \354\235\270\355\225\264 \353\204\244\355\212\270\354\233\214\355\201\254 \355\206\265\354\213\240\354\235\264 \354\213\244\355\214\250\355\226\210\354\212\265\353\213\210\353\213\244. \354\225\204\353\236\230 [\352\263\265\354\234\240 \353\247\201\355\201\254 \354\247\201\354\240\221 \354\227\264\352\270\260] \353\230\220\353\212\224 [\355\206\240\355\201\260 \354\236\205\353\240\245]\354\235\204 \354\235\264\354\232\251\355\225\264 \353\263\264\354\204\270\354\232\224.\'\n      );\n    }\n\n    throw firebaseError;\n  }\n}\n\n/**\n * Connect with a manually provided Google Access Token\n */\nexport async function connectWithGoogleToken(\n  token: string\n): Promise<{ user: GoogleAuthUser; accessToken: string }> {\n  const cleanToken = token.trim();\n  if (!cleanToken) {\n    throw new Error(\'Google \354\225\241\354\204\270\354\212\244 \355\206\240\355\201\260\354\235\204 \354\236\205\353\240\245\355\225\264 \354\243\274\354\204\270\354\232\224.\');\n  }\n\n  // Verify token by querying userinfo\n  let user: GoogleAuthUser = {\n    displayName: \'Google \352\263\204\354\240\225\',\n    email: \'\',\n  };\n\n  try {\n    const res = await fetch(\'https://www.googleapis.com/oauth2/v3/userinfo\', {\n      headers: { Authorization: `Bearer ${cleanToken}` },\n    });\n    if (res.ok) {\n      const data = await res.json();\n      user = {\n        displayName: data.name || data.email || \'Google \354\202\254\354\232\251\354\236\220\',\n        email: data.email || \'\',\n        photoURL: data.picture,\n        uid: data.sub,\n      };\n    }\n  } catch {\n    // If userinfo endpoint fails, verify with drive endpoint directly\n  }\n\n  // Test drive access\n  const driveCheck = await fetch(\n    \'https://www.googleapis.com/drive/v3/files?pageSize=1&fields=files(id)\',\n    {\n      headers: { Authorization: `Bearer ${cleanToken}` },\n    }\n  );\n\n  if (!driveCheck.ok) {\n    if (driveCheck.status === 401) {\n      throw new Error(\'\354\234\240\355\232\250\355\225\230\354\247\200 \354\225\212\352\261\260\353\202\230 \353\247\214\353\243\214\353\220\234 Google Drive \355\206\240\355\201\260\354\236\205\353\213\210\353\213\244.\');\n    }\n    throw new Error(`Google Drive \355\206\240\355\201\260 \352\262\200\354\246\235 \354\213\244\355\214\250 (${driveCheck.status})`);\n  }\n\n  inMemoryDriveAccessToken = cleanToken;\n  notifyAuthState(user);\n  return { user, accessToken: cleanToken };\n}\n\n/**\n * Sign out from Google Drive\n */\nexport async function signOutFromGoogleDrive(): Promise<void> {\n  inMemoryDriveAccessToken = null;\n  notifyAuthState(null);\n  try {\n    await signOut(auth);\n  } catch {\n    // Ignore sign out errors\n  }\n}\n\n/**\n * List DWG & DXF files from Google Drive\n */\nexport async function listGoogleDriveDwgFiles(\n  searchKeyword: string = \'\',\n  nextPageToken?: string\n): Promise<{ files: GoogleDriveFileItem[]; nextPageToken?: string }> {\n  if (!inMemoryDriveAccessToken) {\n    throw new Error(\'Google Drive \353\241\234\352\267\270\354\235\270\354\235\264 \355\225\204\354\232\224\355\225\251\353\213\210\353\213\244.\');\n  }\n\n  // Filters for DWG and DXF extensions or CAD MIME types, excluding trashed\n  let query =\n    \"(name contains \'.dwg\' or name contains \'.DWG\' or name contains \'.dxf\' or name contains \'.DXF\' or mimeType = \'application/acad\' or mimeType = \'image/vnd.dwg\' or mimeType = \'image/vnd.dxf\') and trashed = false\";\n\n  if (searchKeyword.trim()) {\n    const escaped = searchKeyword.replace(/\'/g, \"\\\\\'\");\n    query += ` and name contains \'${escaped}\'`;\n  }\n\n  const fields =\n    \'nextPageToken,files(id,name,size,mimeType,modifiedTime,thumbnailLink,iconLink,webContentLink)\';\n  const params = new URLSearchParams({\n    q: query,\n    fields,\n    pageSize: \'50\',\n    orderBy: \'modifiedTime desc\',\n  });\n\n  if (nextPageToken) {\n    params.set(\'pageToken\', nextPageToken);\n  }\n\n  const response = await fetch(`https://www.googleapis.com/drive/v3/files?${params.toString()}`, {\n    headers: {\n      Authorization: `Bearer ${inMemoryDriveAccessToken}`,\n    },\n  });\n\n  if (!response.ok) {\n    if (response.status === 401) {\n      inMemoryDriveAccessToken = null;\n      notifyAuthState(null);\n      throw new Error(\'\354\204\270\354\205\230\354\235\264 \353\247\214\353\243\214\353\220\230\354\227\210\354\212\265\353\213\210\353\213\244. \353\213\244\354\213\234 \353\241\234\352\267\270\354\235\270\355\225\264 \354\243\274\354\204\270\354\232\224.\');\n    }\n    const errText = await response.text();\n    console.error(\'Drive API error response:\', errText);\n    throw new Error(`Google Drive \355\214\214\354\235\274 \353\252\251\353\241\235 \354\241\260\355\232\214 \354\213\244\355\214\250 (${response.status})`);\n  }\n\n  const data = await response.json();\n  return {\n    files: data.files || [],\n    nextPageToken: data.nextPageToken,\n  };\n}\n\n/**\n * Download a file from Google Drive as ArrayBuffer\n */\nexport async function downloadGoogleDriveFile(fileId: string): Promise<ArrayBuffer> {\n  if (!inMemoryDriveAccessToken) {\n    throw new Error(\'Google Drive \353\241\234\352\267\270\354\235\270\354\235\264 \355\225\204\354\232\224\355\225\251\353\213\210\353\213\244.\');\n  }\n\n  const url = `https://www.googleapis.com/drive/v3/files/${fileId}?alt=media`;\n  const response = await fetch(url, {\n    headers: {\n      Authorization: `Bearer ${inMemoryDriveAccessToken}`,\n    },\n  });\n\n  if (!response.ok) {\n    if (response.status === 401) {\n      inMemoryDriveAccessToken = null;\n      notifyAuthState(null);\n      throw new Error(\'\354\235\270\354\246\235\354\235\264 \353\247\214\353\243\214\353\220\230\354\227\210\354\212\265\353\213\210\353\213\244. \353\213\244\354\213\234 \353\241\234\352\267\270\354\235\270\355\225\264 \354\243\274\354\204\270\354\232\224.\');\n    }\n    throw new Error(`Google Drive \355\214\214\354\235\274 \353\213\244\354\232\264\353\241\234\353\223\234 \354\213\244\355\214\250 (${response.status})`);\n  }\n\n  return await response.arrayBuffer();\n}\n\n/**\n * Extract Google Drive file ID from a link or string\n */\nexport function extractGoogleDriveFileId(urlOrId: string): string | null {\n  const str = urlOrId.trim();\n  if (!str) return null;\n\n  // Direct alphanumeric ID check\n  if (/^[a-zA-Z0-9_-]{20,}$/.test(str)) {\n    return str;\n  }\n\n  // /file/d/FILE_ID pattern\n  const match1 = str.match(/\\/file\\/d\\/([a-zA-Z0-9_-]+)/);\n  if (match1 && match1[1]) return match1[1];\n\n  // id=FILE_ID pattern\n  const match2 = str.match(/[?&]id=([a-zA-Z0-9_-]+)/);\n  if (match2 && match2[1]) return match2[1];\n\n  return null;\n}\n\n/**\n * Download DWG/DXF directly from a Google Drive shared link\n */\nexport async function downloadFromGoogleDriveSharedLink(\n  sharedUrlOrId: string\n): Promise<{ arrayBuffer: ArrayBuffer; fileName: string }> {\n  const fileId = extractGoogleDriveFileId(sharedUrlOrId);\n  if (!fileId) {\n    throw new Error(\'\354\234\240\355\232\250\355\225\234 Google Drive \355\214\214\354\235\274 ID \353\230\220\353\212\224 \352\263\265\354\234\240 \353\247\201\355\201\254\353\245\274 \354\260\276\354\235\204 \354\210\230 \354\227\206\354\212\265\353\213\210\353\213\244.\');\n  }\n\n  // If we have an active access token, use Drive v3 API to get metadata & binary\n  if (inMemoryDriveAccessToken) {\n    try {\n      const metaRes = await fetch(\n        `https://www.googleapis.com/drive/v3/files/${fileId}?fields=name`,\n        {\n          headers: { Authorization: `Bearer ${inMemoryDriveAccessToken}` },\n        }\n      );\n      let fileName = \'googledrive_drawing.dwg\';\n      if (metaRes.ok) {\n        const meta = await metaRes.json();\n        if (meta.name) fileName = meta.name;\n      }\n      const buffer = await downloadGoogleDriveFile(fileId);\n      return { arrayBuffer: buffer, fileName };\n    } catch (e) {\n      console.warn(\'Authenticated download failed, falling back to public download:\', e);\n    }\n  }\n\n  // Direct public download link\n  const directUrl = `https://drive.usercontent.google.com/download?id=${fileId}&export=download`;\n  const res = await fetch(directUrl);\n  if (!res.ok) {\n    throw new Error(`Google Drive\354\227\220\354\204\234 \355\214\214\354\235\274\354\235\204 \353\213\244\354\232\264\353\241\234\353\223\234\355\225\230\354\247\200 \353\252\273\355\226\210\354\212\265\353\213\210\353\213\244 (${res.status}). \355\214\214\354\235\274\354\235\230 \'\353\247\201\355\201\254\352\260\200 \354\236\210\353\212\224 \353\252\250\353\223\240 \354\202\254\354\232\251\354\236\220\' \352\263\265\354\234\240 \354\204\244\354\240\225\354\235\204 \355\231\225\354\235\270\355\225\230\354\204\270\354\232\224.`);\n  }\n\n  const arrayBuffer = await res.arrayBuffer();\n  return { arrayBuffer, fileName: \'googledrive_drawing.dwg\' };\n}\n\n/**\n * Helper to format file size\n */\nexport function formatFileSize(bytes?: string | number): string {\n  if (!bytes) return \'\355\201\254\352\270\260 \353\257\270\354\203\201\';\n  const num = typeof bytes === \'string\' ? parseInt(bytes, 10) : bytes;\n  if (isNaN(num) || num <= 0) return \'0 B\';\n  if (num < 1024) return `${num} B`;\n  if (num < 1024 * 1024) return `${(num / 1024).toFixed(1)} KB`;\n  return `${(num / (1024 * 1024)).toFixed(2)} MB`;\n}\n"
