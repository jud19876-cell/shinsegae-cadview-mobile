    content: "        } else if (c === 20) {\n          ent.position = ent.position || { x: 0, y: 0 };\n          ent.position.y = parseFloat(v);\n        } else if (c === 40) ent.height = parseFloat(v);\n        else if (c === 50) ent.rotation = parseFloat(v);\n        else if (c === 1 || c === 3) ent.rawText = (ent.rawText || \'\') + v;\n      } else if (type === \'INSERT\' || type === \'DIMENSION\') {\n        if (c === 2) ent.blockName = cleanCadText(v);\n        else if (c === 10) {\n          ent.position = ent.position || { x: 0, y: 0 };\n          ent.position.x = parseFloat(v);\n        } else if (c === 20) {\n          ent.position = ent.position || { x: 0, y: 0 };\n          ent.position.y = parseFloat(v);\n        } else if (c === 41) ent.scaleX = parseFloat(v);\n        else if (c === 42) ent.scaleY = parseFloat(v);\n        else if (c === 50) ent.rotation = parseFloat(v);\n      } else if (type === \'SPLINE\') {\n        // In DXF SPLINE: 11/21 are fit points, 10/20 are control points.\n        // 12/22 & 13/23 are tangent vectors, NOT coordinates!\n        if (c === 11) {\n          curVertex = { x: parseFloat(v), y: 0 };\n          ent.fitPoints = ent.fitPoints || [];\n          ent.fitPoints.push(curVertex);\n        } else if (c === 21 && curVertex) {\n          curVertex.y = parseFloat(v);\n        } else if (c === 10) {\n          curVertex = { x: parseFloat(v), y: 0 };\n          ent.controlPoints = ent.controlPoints || [];\n          ent.controlPoints.push(curVertex);\n        } else if (c === 20 && curVertex) {\n          curVertex.y = parseFloat(v);\n        }\n      } else if (type === \'SOLID\' || type === \'TRACE\') {\n        if (c === 10 || c === 11 || c === 12 || c === 13) {\n          curVertex = { x: parseFloat(v), y: 0 };\n          ent.vertices.push(curVertex);\n        } else if (\n          (c === 20 || c === 21 || c === 22 || c === 23) &&\n          curVertex\n        ) {\n          curVertex.y = parseFloat(v);\n        }\n      }\n      i++;\n    }\n\n    if (ent.invisible || ent.inPaperSpace) {\n      return { entity: null, nextIndex: i };\n    }\n    const layerUpper = String(ent.layer || \'\').toUpperCase();\n    if (\n      layerUpper === \'DEFPOINTS\' ||\n      layerUpper.includes(\'DEFPOINT\') ||\n      layerUpper === \'NPLT\' ||\n      layerUpper.includes(\'NO_PLOT\')\n    ) {\n      return { entity: null, nextIndex: i };\n    }\n\n    const ocs = buildOcsTransform(ext);\n\n    if (type === \'LINE\') {\n      if (\n        !ent.start ||\n        !ent.end ||\n        ent.start.x === undefined ||\n        ent.start.y === undefined ||\n        ent.end.x === undefined ||\n        ent.end.y === undefined\n      ) {\n        return { entity: null, nextIndex: i };\n      }\n    }\n    if (ent.rawText !== undefined) {\n      ent.text = cleanCadText(ent.rawText);\n      delete ent.rawText;\n    }\n    if (type === \'DIMENSION\' && ent.blockName) {\n      ent.type = \'INSERT\';\n      ent.position = { x: 0, y: 0 };\n    }\n    if (type === \'SOLID\' || type === \'TRACE\') {\n      ent.type = \'LWPOLYLINE\';\n      ent.closed = true;\n      if (ent.vertices.length === 4) {\n        const tmp = ent.vertices[2];\n        ent.vertices[2] = ent.vertices[3];\n        ent.vertices[3] = tmp;\n      }\n    } else if (type === \'SPLINE\') {\n      ent.type = \'LWPOLYLINE\';\n      ent.closed = false;\n      const pts =\n        ent.fitPoints && ent.fitPoints.length >= 2\n          ? ent.fitPoints\n          : ent.controlPoints || [];\n      ent.vertices = pts;\n      delete ent.fitPoints;\n      delete ent.controlPoints;\n    }\n\n    if (type === \'POLYLINE\') {\n      ent.type = \'LWPOLYLINE\';\n      while (i < pairs.length) {\n        if (pairs[i].code === 0 && pairs[i].value === \'VERTEX\') {\n          i++;\n          const vtx = { x: 0, y: 0, bulge: 0 };\n          let isSplineFrameVertex = false;\n          while (i < pairs.length && pairs[i].code !== 0) {\n            if (pairs[i].code === 10) vtx.x = parseFloat(pairs[i].value);\n            else if (pairs[i].code === 20) vtx.y = parseFloat(pairs[i].value);\n            else if (pairs[i].code === 42) vtx.bulge = parseFloat(pairs[i].value);\n            else if (\n              pairs[i].code === 70 &&\n              (parseInt(pairs[i].value, 10) & 16) !== 0\n            ) {\n              isSplineFrameVertex = true;\n            }\n            i++;\n          }\n          if (!isSplineFrameVertex) ent.vertices.push(vtx);\n        } else if (pairs[i].code === 0 && pairs[i].value === \'SEQEND\') {\n          i++;\n          while (i < pairs.length && pairs[i].code !== 0) i++;\n          break;\n        } else break;\n      }\n    }\n\n    // Apply OCS -> WCS transformation"
