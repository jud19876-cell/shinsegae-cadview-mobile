      original_chunk {
        target_content: "      } else if (t === \'INSERT\') {\n        const pos =\n          raw.insertionPoint || raw.position || raw.insPt || { x: 0, y: 0 };\n        if (!isValidCoord(pos.x) || !isValidCoord(pos.y)) return null;\n        const bname = cleanCadText(raw.name || raw.blockName || raw.block || \'\');\n        if (!bname) return null;\n\n        const rawSx =\n          raw.xScale !== undefined\n            ? raw.xScale\n            : raw.scaleX !== undefined\n              ? raw.scaleX\n              : raw.scale && raw.scale.x !== undefined\n                ? raw.scale.x\n                : raw.scaleFactor && raw.scaleFactor.x !== undefined\n                  ? raw.scaleFactor.x\n                  : 1;\n        const rawSy =\n          raw.yScale !== undefined\n            ? raw.yScale\n            : raw.scaleY !== undefined\n              ? raw.scaleY\n              : raw.scale && raw.scale.y !== undefined\n                ? raw.scale.y\n                : raw.scaleFactor && raw.scaleFactor.y !== undefined\n                  ? raw.scaleFactor.y\n                  : 1;\n\n        let sx = Number(rawSx);\n        let sy = Number(rawSy);\n        if (!isFinite(sx) || sx === 0) sx = 1;\n        if (!isFinite(sy) || sy === 0) sy = 1;\n\n        let rot = toDegreesIfRadians(raw.rotation || 0);\n        const wPos = ocs.pt(pos.x, pos.y, pos.z || 0);\n        if (ocs.flipX < 0) {\n          sx = -sx;\n          rot = -rot;\n        }\n\n        ent.position = wPos;\n        ent.blockName = bname;\n        ent.scaleX = sx;\n        ent.scaleY = sy;\n        ent.rotation = isFinite(rot) ? rot : 0;\n      } else if (\n        t === \'DIMENSION\' ||\n        t.startsWith(\'DIMENSION_\') ||\n        t === \'ARC_DIMENSION\' ||\n        t === \'LARGE_RADIAL_DIMENSION\'\n      ) {\n        const bname = cleanCadText(\n          raw.block || raw.blockName || raw.name || raw.anonymousBlockName || \'\'\n        );\n        if (bname) {\n          ent.type = \'INSERT\';\n          ent.blockName = bname;\n          // In AutoCAD DWG, entities in dimension blocks (*D...) are already defined in WCS.\n          // Positioning them at insertionPoint causes massive duplicate/offset lines across the drawing.\n          ent.position = { x: 0, y: 0 };\n          ent.scaleX = 1;\n          ent.scaleY = 1;\n          ent.rotation = 0;\n        } else {\n          return null;\n        }"
        replacement_content: "      } else if (t === \'INSERT\') {\n        const pos =\n          raw.insertionPoint || raw.position || raw.insPt || { x: 0, y: 0 };\n        if (!isValidCoord(pos.x) || !isValidCoord(pos.y)) return null;\n        const bname = extractBlockName(raw);\n        if (!bname) return null;\n\n        const rawSx =\n          raw.xScale !== undefined\n            ? raw.xScale\n            : raw.scaleX !== undefined\n              ? raw.scaleX\n              : raw.scale && raw.scale.x !== undefined\n                ? raw.scale.x\n                : raw.scaleFactor && raw.scaleFactor.x !== undefined\n                  ? raw.scaleFactor.x\n                  : 1;\n        const rawSy =\n          raw.yScale !== undefined\n            ? raw.yScale\n            : raw.scaleY !== undefined\n              ? raw.scaleY\n              : raw.scale && raw.scale.y !== undefined\n                ? raw.scale.y\n                : raw.scaleFactor && raw.scaleFactor.y !== undefined\n                  ? raw.scaleFactor.y\n                  : 1;\n\n        let sx = Number(rawSx);\n        let sy = Number(rawSy);\n        if (!isFinite(sx) || sx === 0) sx = 1;\n        if (!isFinite(sy) || sy === 0) sy = 1;\n\n        let rot = toDegreesIfRadians(raw.rotation || 0);\n        const wPos = ocs.pt(pos.x, pos.y, pos.z || 0);\n        if (ocs.flipX < 0) {\n          sx = -sx;\n          rot = -rot;\n        }\n\n        ent.position = wPos;\n        ent.blockName = bname;\n        ent.scaleX = sx;\n        ent.scaleY = sy;\n        ent.rotation = isFinite(rot) ? rot : 0;\n      } else if (\n        t === \'DIMENSION\' ||\n        t.startsWith(\'DIMENSION_\') ||\n        t === \'ARC_DIMENSION\' ||\n        t === \'LARGE_RADIAL_DIMENSION\'\n      ) {\n        const bname = extractBlockName(raw);\n        if (bname) {\n          ent.type = \'INSERT\';\n          ent.blockName = bname;\n          // In AutoCAD DWG, entities in dimension blocks (*D...) are defined in WCS.\