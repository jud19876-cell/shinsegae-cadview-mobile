  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nexport type CadTheme = \'white\' | \'dark\' | \'blueprint\';\nexport type ToolMode = \'pan\' | \'select\' | \'measure\' | \'calibrate\';\n\nexport interface Point2D {\n  x: number;\n  y: number;\n}\n\nexport interface Vertex2D extends Point2D {\n  bulge?: number;\n}\n\nexport interface Extents2D {\n  minX: number;\n  minY: number;\n  maxX: number;\n  maxY: number;\n}\n\nexport interface LayerInfo {\n  name: string;\n  aci: number;\n  color: string;\n  visible: boolean;\n  count: number;\n}\n\nexport interface CadEntityBase {\n  id: string;\n  type: string;\n  layer: string;\n  aci?: number | null;\n  linetype?: string;\n  lineweight?: number;\n}\n\nexport interface LineEntity extends CadEntityBase {\n  type: \'LINE\';\n  start: Point2D;\n  end: Point2D;\n}\n\nexport interface PolylineEntity extends CadEntityBase {\n  type: \'LWPOLYLINE\';\n  vertices: Vertex2D[];\n  closed?: boolean;\n}\n\nexport interface CircleEntity extends CadEntityBase {\n  type: \'CIRCLE\';\n  center: Point2D;\n  radius: number;\n}\n\nexport interface ArcEntity extends CadEntityBase {\n  type: \'ARC\';\n  center: Point2D;\n  radius: number;\n  startAngle: number;\n  endAngle: number;\n}\n\nexport interface EllipseEntity extends CadEntityBase {\n  type: \'ELLIPSE\';\n  center: Point2D;\n  majorAxis: Point2D;\n  axisRatio: number;\n}\n\nexport interface TextEntity extends CadEntityBase {\n  type: \'TEXT\';\n  position: Point2D;\n  height: number;\n  rotation?: number;\n  text: string;\n  align?: CanvasTextAlign;\n  isMtext?: boolean;\n}\n\nexport interface InsertEntity extends CadEntityBase {\n  type: \'INSERT\';\n  blockName: string;\n  position: Point2D;\n  scaleX?: number;\n  scaleY?: number;\n  rotation?: number;\n}\n\nexport interface RasterPreviewEntity extends CadEntityBase {\n  type: \'RASTER_PREVIEW\';\n  img: HTMLImageElement;\n  minX: number;\n  minY: number;\n  maxX: number;\n  maxY: number;\n}\n\nexport type CadEntity =\n  | LineEntity\n  | PolylineEntity\n  | CircleEntity\n  | ArcEntity\n  | EllipseEntity\n  | TextEntity\n  | InsertEntity\n  | RasterPreviewEntity;\n\nexport interface CadBlock {\n  name: string;\n  basePoint: Point2D;\n  entities: CadEntity[];\n}\n\nexport interface DrawingModel {\n  fileName: string;\n  formatVersion: string;\n  layers: Record<string, LayerInfo>;\n  blocks: Record<string, CadBlock>;\n  entities: CadEntity[];\n  extents?: Extents2D;\n}\n\nexport interface RenderBatch {\n  layer: string;\n  color: string;\n  dashType: \'S\' | \'D\' | \'C\'; // Solid, Dashed, Center\n  lineCoords: Float32Array;\n  polylines: PolylineEntity[];\n  circles: CircleEntity[];\n  arcs: ArcEntity[];\n  ellipses: EllipseEntity[];\n}\n\nexport interface MeasurementItem {\n  id: string;\n  p1: Point2D;\n  p2: Point2D;\n  label: string;\n  distanceMm: number;\n}\n\nexport interface SnapPoint {\n  x: number;\n  y: number;\n  type: \'END\' | \'MID\' | \'CEN\';\n}\n"
        path {
          absolute_uri: "file:///src/types/cad.ts"
        }
        overwrite: true
      }
    }
