  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useState } from \'react\';\nimport { X, Download, Share2, Smartphone, Rocket, ExternalLink, Check, Copy } from \'lucide-react\';\nimport { usePWAInstall } from \'../hooks/usePWAInstall\';\nimport { downloadBlobFile } from \'../lib/standaloneExport\';\n\ninterface DeployModalProps {\n  isOpen: boolean;\n  fileName: string;\n  hasDrawing: boolean;\n  onClose: () => void;\n  onDownloadStandaloneHtml: () => void;\n  onExportEmbeddedHtml: () => void;\n}\n\nexport const DeployModal: React.FC<DeployModalProps> = ({\n  isOpen,\n  fileName,\n  hasDrawing,\n  onClose,\n  onDownloadStandaloneHtml,\n  onExportEmbeddedHtml,\n}) => {\n  const { isInstallable, isInstalled, isIOS, install } = usePWAInstall();\n  const [ghToken, setGhToken] = useState(\'\');\n  const [ghRepo, setGhRepo] = useState(\'my-cad-viewer\');\n  const [deployLogs, setDeployLogs] = useState<string[]>([]);\n  const [isDeploying, setIsDeploying] = useState(false);\n  const [copiedAppUrl, setCopiedAppUrl] = useState(false);\n\n  if (!isOpen) return null;\n\n  const currentUrl = typeof window !== \'undefined\' ? window.location.href : \'\';\n\n  const handleCopyUrl = () => {\n    navigator.clipboard.writeText(currentUrl);\n    setCopiedAppUrl(true);\n    setTimeout(() => setCopiedAppUrl(false), 2000);\n  };\n\n  const handleRunGhDeploy = async () => {\n    const token = ghToken.trim();\n    const repo = (ghRepo.trim() || \'my-cad-viewer\').replace(/[^a-zA-Z0-9._-]/g, \'-\');\n    setDeployLogs([]);\n\n    if (!token) {\n      setDeployLogs([\'\342\232\240\357\270\217 GitHub Personal Access Token(ghp_...)\354\235\204 \354\236\205\353\240\245\355\225\264 \354\243\274\354\204\270\354\232\224.\']);\n      return;\n    }\n\n    setIsDeploying(true);\n    const headers = {\n      Authorization: `Bearer ${token}`,\n      Accept: \'application/vnd.github+json\',\n      \'Content-Type\': \'application/json\',\n    };\n\n    const toB64 = (str: string) => {\n      const bytes = new TextEncoder().encode(str);\n      let bin = \'\';\n      for (let i = 0; i < bytes.length; i += 0x8000) {\n        bin += String.fromCharCode.apply(null, Array.from(bytes.subarray(i, i + 0x8000)));\n      }\n      return btoa(bin);\n    };\n\n    try {\n      setDeployLogs((prev) => [...prev, \'\342\217\263 1/3. GitHub \352\263\204\354\240\225 \354\235\270\354\246\235 \353\260\217 \354\240\200\354\236\245\354\206\214 \355\231\225\354\235\270 \354\244\221...\']);\n      const uRes = await fetch(\'https://api.github.com/user\', { headers });\n      if (!uRes.ok) throw new Error(\'\355\206\240\355\201\260 \354\235\270\354\246\235 \354\213\244\355\214\250 (repo \352\266\214\355\225\234\354\235\204 \355\231\225\354\235\270\355\225\230\354\204\270\354\232\224)\');\n      const uData = await uRes.json();\n      const owner = uData.login;\n\n      let rRes = await fetch(`https://api.github.com/repos/${owner}/${repo}`, { headers });\n      let rData = null;\n      if (rRes.status === 404) {\n        const cRes = await fetch(\'https://api.github.com/user/repos\', {\n          method: \'POST\',\n          headers,\n          body: JSON.stringify({ name: repo, private: false, auto_init: true }),\n        });\n        if (!cRes.ok) throw new Error(\'\354\203\210 \354\240\200\354\236\245\354\206\214 \354\203\235\354\204\261\354\227\220 \354\213\244\355\214\250\355\226\210\354\212\265\353\213\210\353\213\244.\');\n        rData = await cRes.json();\n        await new Promise((r) => setTimeout(r, 1200));\n      } else {\n        rData = await rRes.json();\n      }\n      const branch = (rData && rData.default_branch) || \'main\';\n\n      async function putFile(path: string, contentStr: string, msg: string) {\n        let sha: string | null = null;\n        const chk = await fetch(\n          `https://api.github.com/repos/${owner}/${repo}/contents/${path}?ref=${branch}`,\n          { headers }\n        );\n        if (chk.ok) sha = (await chk.json()).sha;\n        const body: Record<string, string> = { message: msg, content: toB64(contentStr), branch };\n        if (sha) body.sha = sha;\n        const pRes = await fetch(\n          `https://api.github.com/repos/${owner}/${repo}/contents/${path}`,\n          { method: \'PUT\', headers, body: JSON.stringify(body) }\n        );\n        if (!pRes.ok) throw new Error(`${path} \354\227\205\353\241\234\353\223\234 \354\213\244\355\214\250`);\n      }\n\n      setDeployLogs((prev) => [\n        ...prev,\n        \'\342\217\263 2/3. index.html \353\260\217 \353\252\250\353\260\224\354\235\274 PWA manifest \354\227\205\353\241\234\353\223\234 \354\244\221...\',\n      ]);\n\n      // Fetch the standalone HTML template from /public/assets/aistudio/index_c6b94c45.html or current page\n      let standaloneContent = \'\';\n      try {\n        const resHtml = await fetch(\'/assets/aistudio/index_c6b94c45.html\');\n        if (resHtml.ok) {\n          standaloneContent = await resHtml.text();\n        }\n      } catch {\n        // fallback to document html\n      }\n      if (!standaloneContent) {\n        standaloneContent = \'<!DOCTYPE html>\\n\' + document.documentElement.outerHTML;\n      }\n\n      const manifestStr = JSON.stringify(\n        {\n          name: \'CADView \353\252\250\353\260\224\354\235\274 \353\217\204\353\251\264 \353\267\260\354\226\264\',\n          short_name: \'CAD\353\267\260\354\226\264\',\n          start_url: \'./index.html\',\n          display: \'standalone\',\n          background_color: \'#F8F7F4\',\n          theme_color: \'#1E3A8A\',\n          icons: [\n            {\n              src: \'data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 192 192\"><rect width=\"192\" height=\"192\" rx=\"38\" fill=\"%231E3A8A\"/><path d=\"M48 144L96 48l48 96H48z\" fill=\"none\" stroke=\"%23ffffff\" stroke-width=\"14\" stroke-linejoin=\"round\"/></svg>\',\n              sizes: \'192x192\',\n              type: \'image/svg+xml\',\n              purpose: \'any maskable\',\n            },\n          ],\n        },\n        null,\n        2\n      );\n\n      await putFile(\'index.html\', standaloneContent, \'Deploy Mobile CAD Viewer\');\n      await putFile(\'manifest.json\', manifestStr, \'Add PWA manifest\');\n      await putFile(\'.nojekyll\', \'\', \'Add .nojekyll\');\n\n      setDeployLogs((prev) => [\n        ...prev,\n        \'\342\217\263 3/3. GitHub Pages \353\254\264\353\243\214 \355\230\270\354\212\244\355\214\205 \355\231\234\354\204\261\355\231\224 \354\244\221...\',\n      ]);\n      await fetch(`https://api.github.com/repos/${owner}/${repo}/pages`, {\n        method: \'POST\',\n        headers,\n        body: JSON.stringify({ source: { branch, path: \'/\' } }),\n      });\n\n      const liveUrl = `https://${owner}.github.io/${repo}/`;\n      setDeployLogs((prev) => [\n        ...prev,\n        `\342\234\205 \353\260\260\355\217\254 \354\204\261\352\263\265! (\354\225\275 1\353\266\204 \353\222\244 \355\231\234\354\204\261\355\231\224\353\220\251\353\213\210\353\213\244)`,\n        `\360\237\224\227 \353\202\264 \354\240\204\354\232\251 \353\252\250\353\260\224\354\235\274 \354\233\271 \354\225\261 \354\243\274\354\206\214: ${liveUrl}`,\n        \'\360\237\221\211 \354\212\244\353\247\210\355\212\270\355\217\260 \355\201\254\353\241\254\354\227\220\354\204\234 \354\234\204 \354\243\274\354\206\214 \354\240\221\354\206\215 \355\233\204 [\354\225\261 \354\204\244\354\271\230]\353\245\274 \353\210\204\353\245\264\353\251\264 \354\212\244\353\247\210\355\212\270\355\217\260\354\227\220 \354\225\261\354\235\264 \354\203\235\354\204\261\353\220\251\353\213\210\353\213\244.\',\n      ]);\n    } catch (err: unknown) {\n      const msg = err instanceof Error ? err.message : String(err);\n      setDeployLogs((prev) => [...prev, `\342\235\214 \354\230\244\353\245\230: ${msg}`]);\n    } finally {\n      setIsDeploying(false);\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 bg-black/65 backdrop-blur-xs z-50 flex items-end sm:items-center justify-center p-0 sm:p-4\">\n      <div className=\"bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 w-full sm:max-w-xl rounded-t-2xl sm:rounded-2xl max-h-[88vh] flex flex-col shadow-2xl overflow-hidden\">\n        {/* Header */}\n        <div className=\"px-4 py-3 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <Smartphone className=\"w-5 h-5 text-[#1E3A8A]\" />\n            <h3 className=\"text-sm font-bold text-slate-900 dark:text-white\">\n              \354\212\244\353\247\210\355\212\270\355\217\260 \354\204\244\354\271\230 &amp; \352\260\234\354\235\270\354\232\251 \353\254\264\353\243\214 \353\260\260\355\217\254\n            </h3>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 p-1\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Body */}\n        <div className=\"p-4 space-y-4 overflow-y-auto custom-scrollbar text-xs text-slate-700 dark:text-slate-300 leading-relaxed\">\n          {/* Option 1: Direct Standalone HTML */}\n          <div className=\"p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 space-y-2\">\n            <div className=\"font-bold text-[#1E3A8A] dark:text-emerald-400 flex items-center justify-between\">\n              <span>\353\260\251\353\262\225 1. \353\213\250\354\235\274 \355\214\214\354\235\274(.html)\353\241\234 \353\260\233\354\225\204 \353\202\264 \355\217\260\354\227\220\354\204\234 \353\260\224\353\241\234 \354\223\260\352\270\260</span>\n              <span className=\"text-[10px] font-mono px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 font-bold\">\n                \354\204\244\354\271\230 \354\227\206\354\235\264 \353\260\224\353\241\234 \354\236\221\353\217\231\n              </span>\n            </div>\n            <p className=\"text-[11px] text-slate-500 dark:text-slate-400\">\n              \354\225\204\353\236\230 \353\262\204\355\212\274\354\235\204 \353\210\214\353\237\254 \354\231\204\354\204\261\353\220\234 <strong>index.html</strong> \355\214\214\354\235\274\354\235\204 \353\213\244\354\232\264\353\260\233\354\235\200 \355\233\204, \354\271\264\354\271\264\354\230\244\355\206\241(\353\202\230\354\231\200\354\235\230 \354\261\204\355\214\205)\354\235\264\353\202\230 \352\265\254\352\270\200 \353\223\234\353\235\274\354\235\264\353\270\214\353\241\234 \353\202\264 \354\212\244\353\247\210\355\212\270\355\217\260\354\227\220 \354\240\204\354\206\241\355\225\230\354\227\254 \355\201\254\353\241\254 \353\270\214\353\235\274\354\232\260\354\240\200\353\241\234 \354\227\264\353\251\264 \354\204\234\353\262\204 \354\227\206\354\235\264 \354\246\211\354\213\234 \353\217\204\353\251\264\354\235\204 \353\263\274 \354\210\230 \354\236\210\354\212\265\353\213\210\353\213\244.\n            </p>\n            <div className=\"flex flex-wrap gap-2 pt-1\">\n              <button\n                onClick={onDownloadStandaloneHtml}\n                className=\"bg-[#C8102E] hover:bg-[#a50d26] text-white py-2 px-3.5 rounded-xl font-bold flex items-center justify-center gap-1.5 active:scale-95 transition shadow-xs flex-1\"\n              >\n                <Download className=\"w-3.5 h-3.5\" />\n                <span>\354\231\204\354\204\261\353\220\234 \353\267\260\354\226\264 \355\214\214\354\235\274 (index.html) \353\213\244\354\232\264\353\241\234\353\223\234</span>\n              </button>\n              {hasDrawing && (\n                <button\n                  onClick={onExportEmbeddedHtml}\n                  className=\"bg-slate-200 hover:bg-slate-300 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 py-2 px-3 rounded-xl font-semibold flex items-center justify-center gap-1.5 transition\"\n                  title=\"\355\230\204\354\236\254 \354\227\264\353\246\260 \353\217\204\353\251\264 \353\215\260\354\235\264\355\204\260\353\245\274 HTML \354\225\210\354\227\220 \354\213\254\354\226\264\354\204\234 \353\263\204\353\217\204 \355\214\214\354\235\274 \354\204\240\355\203\235 \354\227\206\354\235\264 \353\260\224\353\241\234 \354\227\264\353\246\254\353\217\204\353\241\235 \354\240\200\354\236\245\355\225\251\353\213\210\353\213\244\"\n                >\n                  <Share2 className=\"w-3.5 h-3.5\" />\n                  <span>\355\230\204\354\236\254 \353\217\204\353\251\264 \353\202\264\354\236\245 HTML \354\240\200\354\236\245</span>\n                </button>\n              )}\n            </div>\n          </div>\n\n          {/* Option 2: Mobile PWA Install */}\n          <div className=\"p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 space-y-2\">\n            <div className=\"font-bold text-[#1E3A8A] dark:text-indigo-300 flex items-center justify-between\">\n              <span>\353\260\251\353\262\225 2. \354\212\244\353\247\210\355\212\270\355\217\260 \355\231\210 \355\231\224\353\251\264\354\227\220 \354\240\225\354\213\235 \354\225\261(PWA)\354\234\274\353\241\234 \354\204\244\354\271\230</span>\n              <span className=\"text-[10px] font-mono px-1.5 py-0.5 rounded bg-[#1E3A8A]/10 text-[#1E3A8A] dark:text-indigo-300 font-bold\">\n                \354\225\261 \354\225\204\354\235\264\354\275\230 \354\203\235\354\204\261\n              </span>\n            </div>\n\n            {isInstalled ? (\n              <div className=\"p-2.5 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 font-medium\">\n                \342\234\205 \355\230\204\354\236\254 \354\212\244\353\247\210\355\212\270\355\217\260\354\227\220 \353\217\205\353\246\275 \354\213\244\355\226\211\355\230\225 \354\225\261\354\234\274\353\241\234 \354\240\225\354\203\201 \354\204\244\354\271\230\353\220\230\354\226\264 \354\213\244\355\226\211 \354\244\221\354\236\205\353\213\210\353\213\244!\n              </div>\n            ) : isInstallable ? (\n              <div className=\"space-y-2\">\n                <p className=\"text-[11px] text-slate-500 dark:text-slate-400\">\n                  \353\270\214\353\235\274\354\232\260\354\240\200 \354\204\244\354\271\230 \352\270\260\353\212\245\354\235\264 \352\260\220\354\247\200\353\220\230\354\227\210\354\212\265\353\213\210\353\213\244. \354\225\204\353\236\230 \353\262\204\355\212\274\354\235\204 \353\210\204\353\245\264\353\251\264 \354\212\244\353\247\210\355\212\270\355\217\260 \353\260\224\355\203\225\355\231\224\353\251\264\354\227\220 \354\246\211\354\213\234 CAD \353\267\260\354\226\264 \354\225\261 \354\225\204\354\235\264\354\275\230\354\235\264 \354\266\224\352\260\200\353\220\251\353\213\210\353\213\244.\n                </p>\n                <button\n                  onClick={install}\n                  className=\"w-full bg-[#1E3A8A] hover:bg-[#172e6e] text-white py-2 px-4 rounded-xl font-bold flex items-center justify-center gap-2 shadow-xs transition\"\n                >\n                  <Download className=\"w-4 h-4\" />\n                  <span>\354\212\244\353\247\210\355\212\270\355\217\260\354\227\220 \354\225\261\354\234\274\353\241\234 \354\247\200\352\270\210 \354\204\244\354\271\230\355\225\230\352\270\260</span>\n                </button>\n              </div>\n            ) : isIOS ? (\n              <div className=\"space-y-1 text-[11px] text-slate-600 dark:text-slate-300\">\n                <p className=\"font-semibold text-slate-900 dark:text-white\">\354\225\204\354\235\264\355\217\260 / \354\225\204\354\235\264\355\214\250\353\223\234 (iOS Safari) \354\204\244\354\271\230 \353\260\251\353\262\225:</p>\n                <ol className=\"list-decimal pl-5 space-y-1 text-slate-500 dark:text-slate-400\">\n                  <li>\354\202\254\355\214\214\353\246\254(Safari) \353\270\214\353\235\274\354\232\260\354\240\200 \355\225\230\353\213\250 <strong>\352\263\265\354\234\240(Share)</strong> \353\262\204\355\212\274 \355\204\260\354\271\230</li>\n                  <li>\353\251\224\353\211\264 \353\252\251\353\241\235\354\227\220\354\204\234 <strong>[\355\231\210 \355\231\224\353\251\264\354\227\220 \354\266\224\352\260\200 (Add to Home Screen)]</strong> \354\204\240\355\203\235</li>\n                  <li>\355\231\210 \355\231\224\353\251\264\354\227\220 \354\240\225\354\213\235 CADView \354\225\261 \354\225\204\354\235\264\354\275\230\354\235\264 \354\203\235\354\204\261\353\220\251\353\213\210\353\213\244.</li>\n                </ol>\n              </div>\n            ) : (\n              <div className=\"space-y-1 text-[11px] text-slate-600 dark:text-slate-300\">\n                <p className=\"font-semibold text-slate-900 dark:text-white\">\354\225\210\353\223\234\353\241\234\354\235\264\353\223\234 \354\212\244\353\247\210\355\212\270\355\217\260 (Chrome) \354\204\244\354\271\230 \353\260\251\353\262\225:</p>\n                <ol className=\"list-decimal pl-5 space-y-1 text-slate-500 dark:text-slate-400\">\n                  <li>\355\201\254\353\241\254 \353\270\214\353\235\274\354\232\260\354\240\200 \354\232\260\354\270\241 \354\203\201\353\213\250 <strong>\353\251\224\353\211\264 (\342\213\256)</strong> \355\204\260\354\271\230</li>\n                  <li><strong>[\354\225\261 \354\204\244\354\271\230]</strong> \353\230\220\353\212\224 <strong>[\355\231\210 \355\231\224\353\251\264\354\227\220 \354\266\224\352\260\200]</strong> \355\204\260\354\271\230</li>\n                </ol>\n              </div>\n            )}\n          </div>\n\n          {/* Option 3: APK Package Generation Guide */}\n          <div className=\"p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 space-y-2\">\n            <div className=\"font-bold text-[#1E3A8A] dark:text-amber-400 flex items-center justify-between\">\n              <span>\353\260\251\353\262\225 3. \354\225\210\353\223\234\353\241\234\354\235\264\353\223\234 \354\210\234\354\240\225 .APK \354\204\244\354\271\230 \355\214\214\354\235\274 \353\247\214\353\223\244\352\270\260</span>\n              <span className=\"text-[10px] font-mono px-1.5 py-0.5 rounded bg-amber-500/15 text-amber-700 dark:text-amber-300 font-bold\">\n                1\353\266\204 \354\231\204\354\204\261\n              </span>\n            </div>\n            <p className=\"text-[11px] text-slate-500 dark:text-slate-400\">\n              \355\230\204\354\236\254 \354\233\271 \354\243\274\354\206\214\353\245\274 <strong>PWABuilder.com</strong>\354\227\220 \354\236\205\353\240\245\355\225\230\353\251\264 \352\265\254\352\270\200 \355\224\214\353\240\210\354\235\264\354\212\244\355\206\240\354\226\264 \353\223\261\353\241\235\354\232\251 \353\230\220\353\212\224 \354\247\201\354\240\221 \354\212\244\353\247\210\355\212\270\355\217\260\354\227\220 \354\204\244\354\271\230\355\225\240 \354\210\230 \354\236\210\353\212\224 \354\210\234\354\240\225 <strong>.apk \355\214\214\354\235\274</strong>\354\235\204 \353\254\264\353\243\214\353\241\234 \354\203\235\354\204\261\355\225\240 \354\210\230 \354\236\210\354\212\265\353\213\210\353\213\244.\n            </p>\n            <div className=\"flex items-center gap-2 pt-1\">\n              <input\n                type=\"text\"\n                readOnly\n                value={currentUrl}\n                className=\"flex-1 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg px-2.5 py-1.5 text-[11px] font-mono text-slate-700 dark:text-slate-300\"\n              />\n              <button\n                onClick={handleCopyUrl}\n                className=\"px-3 py-1.5 rounded-lg bg-slate-200 dark:bg-slate-800 text-xs font-semibold flex items-center gap-1\"\n              >\n                {copiedAppUrl ? <Check className=\"w-3.5 h-3.5 text-emerald-600\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                <span>{copiedAppUrl ? \'\353\263\265\354\202\254\353\220\250\' : \'\354\243\274\354\206\214 \353\263\265\354\202\254\'}</span>\n              </button>\n              <a\n                href=\"https://www.pwabuilder.com\"\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"bg-[#1E3A8A] text-white px-3 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1 shadow-xs\"\n              >\n                <span>PWABuilder \354\227\264\352\270\260</span>\n                <ExternalLink className=\"w-3 h-3\" />\n              </a>\n            </div>\n          </div>\n\n          {/* Option 4: Personal GitHub Pages Free Hosting */}\n          <div className=\"p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 space-y-2.5\">\n            <div className=\"font-bold text-[#1E3A8A] dark:text-indigo-300 flex items-center justify-between\">\n              <span>\353\260\251\353\262\225 4. GitHub \355\206\240\355\201\260\354\234\274\353\241\234 \353\202\264 \352\260\234\354\235\270 \354\240\204\354\232\251 \354\233\271 \355\230\270\354\212\244\355\214\205 \353\260\260\355\217\254</span>\n              <a\n                href=\"https://github.com/settings/tokens/new?description=Mobile-CAD-Viewer&scopes=repo\"\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"text-[10px] px-2 py-0.5 rounded bg-[#1E3A8A] text-white font-semibold\"\n              >\n                \360\237\224\221 \355\206\240\355\201\260 \353\260\234\352\270\211 \342\206\227\n              </a>\n            </div>\n            <p className=\"text-[11px] text-slate-500 dark:text-slate-400\">\n              GitHub Personal Access Token(<code className=\"font-mono font-bold\">ghp_...</code>)\354\235\204 \354\236\205\353\240\245\355\225\230\352\263\240 \353\260\260\355\217\254\353\245\274 \353\210\204\353\245\264\353\251\264 \355\217\211\354\203\235 \353\254\264\353\243\214\353\241\234 \354\234\240\354\247\200\353\220\230\353\212\224 \353\202\230\353\247\214\354\235\230 CAD \353\267\260\354\226\264 \354\233\271\354\202\254\354\235\264\355\212\270(<code className=\"font-mono\">https://\354\225\204\354\235\264\353\224\224.github.io/my-cad-viewer/</code>)\352\260\200 \354\236\220\353\217\231 \352\260\234\354\204\244\353\220\251\353\213\210\353\213\244.\n            </p>\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1\">\n              <input\n                type=\"password\"\n                placeholder=\"GitHub \355\206\240\355\201\260 (ghp_...)\"\n                value={ghToken}\n                onChange={(e) => setGhToken(e.target.value)}\n                className=\"bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-2 text-xs font-mono focus:outline-none focus:border-[#1E3A8A]\"\n              />\n              <input\n                type=\"text\"\n                placeholder=\"\354\240\200\354\236\245\354\206\214 \354\235\264\353\246\204\"\n                value={ghRepo}\n                onChange={(e) => setGhRepo(e.target.value)}\n                className=\"bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-2 text-xs font-mono focus:outline-none focus:border-[#1E3A8A]\"\n              />\n            </div>\n            <button\n              onClick={handleRunGhDeploy}\n              disabled={isDeploying}\n              className=\"bg-[#1E3A8A] hover:bg-[#172e6e] disabled:opacity-60 text-white w-full py-2.5 px-4 rounded-xl font-bold text-xs flex items-center justify-center gap-1.5 shadow-xs transition\"\n            >\n              <Rocket className=\"w-4 h-4\" />\n              <span>{isDeploying ? \'\353\260\260\355\217\254 \354\247\204\355\226\211 \354\244\221...\' : \'\360\237\232\200 \353\202\264 \352\260\234\354\235\270 GitHub \354\233\271 \354\225\261\354\234\274\353\241\234 \354\236\220\353\217\231 \353\260\260\355\217\254\'}</span>\n            </button>\n\n            {deployLogs.length > 0 && (\n              <div className=\"p-2.5 rounded-xl bg-slate-900 border border-slate-800 font-mono text-[11px] space-y-1 text-slate-200\">\n                {deployLogs.map((log, idx) => (\n                  <div key={idx} className=\"break-all\">\n                    {log}\n                  </div>\n                ))}\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
