      thinking_signature: "\022\233\005\n\230\005\001i\024}\023Z\313\a`\221\373$\226TN\242\204n=\257f\256\322}\307\3367B\335\260\033(\212\310\f\366\200OC\346\226*\236\016*&\343W\252<\326j\001\277\2047\300M=\217\r1\262\212\364\022\316RlF]\212\204\260\246\310\277\320\224BA\312\215}dPA;\256\324\2654\341c\317\361\\\213\241\361n\370\226\360\3048\254\257\317\250\341\v\276\r~\225\327\220~\364\336\307\250\362\365m\240uz\247C\222\030\206\235\025\3516\273\224\264U\027\2508LH\226\204o\210\277i\337\016`\210?\270\344\355D\214\213-\276 :Y\263\203=\2122X\266(\237\302M\374\202\'\221\347\354\335\367\231\017\342Yv\210\365\353R\331`Y\265\316\222\204\024\"\206;2\220{\357\334\240G#\223=V\t\255A\276\333H\246n%\256\376\374d\264\323%\ta\2224lI~\353\244v\320q\001\200S\2165X\357@\371\020!ZW\333\244v\321?\032Q\"\376\3772\\g\n0)\026\271z4\f\224\303\3736.\205\241~\303\026(\205\034E*d\020\'\313\377\377\0244\2252:Z\277\207\036\000<O\034T[\032S4\343p\2604\331:\221\"\276\000-N\357\221\215\357\341\267\244\035\\\361$\030\272\027d3:\272uU:\335w\241\r\376\313]:y\247\003iV\267\257\313\254\245\227e\az\230\022+\363\317\304%\362a\304\223N\360j#\037\354T\246\215\260\026nDb\033\351r\360\322\230\3213\213\020\024\222\356\214\202\302P\002\253B\367\237m\221\233\366\273h\333\205\244S\326\233\\\306\352\221\026\227y\003\343\210\367\017\250\203^\240[\300\356{\340\371\006@\323\343\r\240\\{\rJ\334\f\311\001\327\3268\311n0S\227)\321Z\364\371\250\361Sim\230`\332\227\335\212\320F\212C\250\b+\'\367\220\314\350c\204B\364\374\356\366z<:\375\253\250\252\242\030N\375w\337\020ps\244\212R\310+\3521\301{A\352\325\031\306\276\204\021\b\347\357s?\026\377x\351\322\335\030Rnc\023\004\251Dm\246\260~L\216x)\357\205\267\220N\266\341E>z\344\017_9\306s\323/\002\367\027Z\316\233O\323\3411\000\301\216\2350\2775\213O\376\277$\207r5\265\032\277A\037wO\023\031\3302/|\377\257\364\317\246Pu\214.\344:\250\237\\\304\030^\351\364\024h?\036\025\'\366\t\261\250\316\316\346j\341\267"
