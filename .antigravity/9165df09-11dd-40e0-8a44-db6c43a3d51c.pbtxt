            }
            lines {
              text: "        const distMm = Math.hypot(p2.x - p1.x, p2.y - p1.y) * unitScaleFactor;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        onAddMeasurement(p1, p2, distMm);"
