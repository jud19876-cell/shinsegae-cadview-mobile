  view_file {
    absolute_path_uri: "file:///src/lib/libreDwgLoader.ts"
    start_line: 569
    end_line: 614
    content: "        ent.blockName = bname;\n        ent.scaleX = sx;\n        ent.scaleY = sy;\n        ent.rotation = isFinite(rot) ? rot : 0;\n      } else if (\n        t === \'DIMENSION\' ||\n        t.startsWith(\'DIMENSION_\') ||\n        t === \'ARC_DIMENSION\' ||\n        t === \'LARGE_RADIAL_DIMENSION\'\n      ) {\n        const bname = extractBlockName(raw);\n        if (bname) {\n          ent.type = \'INSERT\';\n          ent.blockName = bname;\n          // In AutoCAD DWG, entities in dimension blocks (*D...) are defined in WCS.\n          // Setting position to (0,0) and matching basePoint (0,0) retains exact WCS coordinates.\n          ent.position = { x: 0, y: 0 };\n          ent.scaleX = 1;\n          ent.scaleY = 1;\n          ent.rotation = 0;\n        } else {\n          return null;\n        }\n      } else if (t === \'ACAD_TABLE\' || t === \'TABLE\') {\n        const bname = cleanCadText(\n          raw.block || raw.blockName || raw.name || `*T${tableBlockSeq++}`\n        );\n        const pos =\n          raw.insertionPoint || raw.startPoint || raw.position || { x: 0, y: 0 };\n        ent.type = \'INSERT\';\n        ent.blockName = bname;\n        ent.position =\n          isValidCoord(pos.x) && isValidCoord(pos.y)\n            ? { x: pos.x, y: pos.y }\n            : { x: 0, y: 0 };\n        ent.scaleX = 1;\n        ent.scaleY = 1;\n        ent.rotation = 0;\n      } else if (t === \'SPLINE\') {\n        const pts =\n          (raw.fitPoints && raw.fitPoints.length >= 2)\n            ? raw.fitPoints\n            : raw.controlPoints || raw.vertices || [];\n        if (!Array.isArray(pts) || pts.length < 2) return null;\n        ent.type = \'LWPOLYLINE\';\n        ent.closed = false;"
    num_lines: 827
    num_bytes: 25879
    line_range_bytes: 1656
  }
}
