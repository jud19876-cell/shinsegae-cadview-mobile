    content: "      pinchDistStartRef.current = 0;\n    };\n\n    canvas.addEventListener(\'mousedown\', onMouseDown);\n    window.addEventListener(\'mousemove\', onMouseMove);\n    window.addEventListener(\'mouseup\', onMouseUp);\n    canvas.addEventListener(\'wheel\', onWheel, { passive: false });\n\n    canvas.addEventListener(\'touchstart\', onTouchStart, { passive: false });\n    canvas.addEventListener(\'touchmove\', onTouchMove, { passive: false });\n    canvas.addEventListener(\'touchend\', onTouchEnd);\n\n    return () => {\n      canvas.removeEventListener(\'mousedown\', onMouseDown);\n      window.removeEventListener(\'mousemove\', onMouseMove);\n      window.removeEventListener(\'mouseup\', onMouseUp);\n      canvas.removeEventListener(\'wheel\', onWheel);\n\n      canvas.removeEventListener(\'touchstart\', onTouchStart);\n      canvas.removeEventListener(\'touchmove\', onTouchMove);\n      canvas.removeEventListener(\'touchend\', onTouchEnd);\n    };\n  }, [\n    camX,\n    camY,\n    zoom,\n    rotation,\n    mode,\n    findSnapPoint,\n    screenToWorld,\n    onUpdateCamera,\n    onUpdateMouseWorld,\n  ]);\n\n  return (\n    <main\n      ref={containerRef}\n      className=\"relative flex-1 w-full bg-[#F8F7F4] dark:bg-[#0B101B] overflow-hidden\"\n    >\n      <canvas\n        ref={canvasRef}\n        className=\"block w-full h-full cursor-grab active:cursor-grabbing\"\n      />\n\n      {/* Empty State Welcome Screen */}\n      {entities.length === 0 && !isLoading && (\n        <div className=\"absolute inset-0 z-10 flex flex-col items-center justify-center p-6 text-center bg-[#F8F7F4]/95 dark:bg-[#0B101B]/95\">\n          <div className=\"w-16 h-16 rounded-2xl bg-[#1E3A8A] text-white flex items-center justify-center mb-4 shadow-lg\">\n            <Compass className=\"w-8 h-8\" />\n          </div>\n          <div className=\"inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-[#1E3A8A]/10 text-[#1E3A8A] dark:text-blue-300 border border-[#1E3A8A]/25 text-[11px] font-bold mb-2\">\n            <span>AI-VAULT MOBILE CAD CONSOLE</span>\n          </div>\n          <h2 className=\"text-base sm:text-lg font-bold text-slate-900 dark:text-white mb-1.5\">\n            \353\252\250\353\260\224\354\235\274 DWG \302\267 DXF \354\240\225\353\260\200 \353\217\204\353\251\264 \353\267\260\354\226\264\n          </h2>\n          <p className=\"text-xs text-slate-500 dark:text-slate-400 max-w-sm leading-relaxed mb-6\">\n            \354\212\244\353\247\210\355\212\270\355\217\260\354\235\264\353\202\230 \355\203\234\353\270\224\353\246\277\354\227\220 \354\240\200\354\236\245\353\220\234 <strong>.dwg</strong> \353\260\217 <strong>.dxf</strong> \354\233\220\353\263\270 \353\217\204\353\251\264\354\235\204 \354\204\234\353\262\204 \354\240\204\354\206\241 \354\227\206\354\235\264 100% \353\270\214\353\235\274\354\232\260\354\240\200 \353\202\264\353\266\200\354\227\220\354\204\234 \354\246\211\354\213\234 \355\225\264\353\217\205\355\225\230\354\227\254 \355\231\225\353\214\200\302\267\354\266\225\354\206\214\302\267\353\240\210\354\235\264\354\226\264 \354\240\234\354\226\264\302\267\354\271\230\354\210\230 \354\270\241\354\240\225\354\235\204 \354\210\230\355\226\211\355\225\251\353\213\210\353\213\244.\n          </p>\n          <div className=\"flex flex-col sm:flex-row items-center gap-2.5 w-full max-w-xs\">\n            <button\n              onClick={onOpenFileClick}\n              className=\"bg-[#C8102E] hover:bg-[#a50d26] text-white w-full py-3 px-4 rounded-xl text-xs font-bold flex items-center justify-center gap-2 active:scale-95 transition shadow-sm\"\n            >\n              <FolderOpen className=\"w-4 h-4\" />\n              <span>\353\202\264 \352\270\260\352\270\260\354\227\220\354\204\234 \353\217\204\353\251\264 \354\227\264\352\270\260 (.DWG / .DXF)</span>\n            </button>\n          </div>\n          <div className=\"mt-4 flex flex-wrap items-center justify-center gap-2\">\n            <button\n              onClick={onLoadArchSample}\n              className=\"px-3 py-1.5 rounded-lg bg-slate-200 hover:bg-slate-300 dark:bg-slate-800 dark:hover:bg-slate-700 text-[11px] font-semibold text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-700 transition\"\n            >\n              \360\237\223\220 \352\261\264\354\266\225 \355\217\211\353\251\264\353\217\204 \354\203\230\355\224\214 \354\227\264\352\270\260\n            </button>\n            <button\n              onClick={onLoadMechSample}\n              className=\"px-3 py-1.5 rounded-lg bg-slate-200 hover:bg-slate-300 dark:bg-slate-800 dark:hover:bg-slate-700 text-[11px] font-semibold text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-700 transition\"\n            >\n              \342\232\231\357\270\217 \352\270\260\352\263\204 \354\241\260\353\246\275\353\217\204 \354\203\230\355\224\214 \354\227\264\352\270\260\n            </button>\n          </div>\n\n          {/* Recent Drawings Preview Cards on Welcome Screen */}\n          {recentDrawings.length > 0 && (\n            <div className=\"w-full max-w-md mt-6 pt-4 border-t border-slate-200 dark:border-slate-800\">\n              <div className=\"flex items-center justify-between mb-2.5 px-1\">\n                <span className=\"text-xs font-bold flex items-center gap-1.5 text-slate-800 dark:text-slate-200\">\n                  <History className=\"w-3.5 h-3.5 text-[#1E3A8A] dark:text-blue-400\" />\n                  \354\265\234\352\267\274 \354\227\264\354\226\264\353\263\270 \353\217\204\353\251\264\n                </span>\n                {onOpenSelectModal && (\n                  <button\n                    onClick={onOpenSelectModal}\n                    className=\"text-[11px] text-[#1E3A8A] dark:text-blue-400 font-semibold hover:underline\"\n                  >\n                    \354\240\204\354\262\264 \353\263\264\352\270\260 ({recentDrawings.length}) \342\206\222\n                  </button>\n                )}\n              </div>\n              <div className=\"flex gap-2.5 overflow-x-auto pb-1.5 no-scrollbar\">\n                {recentDrawings.slice(0, 4).map((item) => (\n                  <div\n                    key={item.id}\n                    onClick={() => onSelectRecentDrawing?.(item)}\n                    className=\"w-36 shrink-0 cursor-pointer rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-2 text-left hover:shadow-md transition active:scale-95 shadow-xs\"\n                    title={`${item.fileName} \353\213\244\354\213\234 \354\227\264\352\270\260`}\n                  >\n                    <div className=\"w-full h-20 rounded-lg overflow-hidden bg-slate-950 mb-1.5 border border-slate-200 dark:border-slate-800 flex items-center justify-center\">\n                      {item.thumbnail ? (\n                        <img\n                          src={item.thumbnail}\n                          alt={item.fileName}\n                          className=\"w-full h-full object-contain\"\n                        />\n                      ) : (\n                        <span className=\"text-slate-500 text-[10px]\">\353\257\270\353\246\254\353\263\264\352\270\260</span>\n                      )}\n                    </div>\n                    <div className=\"text-[11px] font-bold text-slate-800 dark:text-slate-200 truncate\">\n                      {item.fileName}"
