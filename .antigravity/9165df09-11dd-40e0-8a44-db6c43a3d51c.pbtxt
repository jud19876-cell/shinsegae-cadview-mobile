  view_file {
    absolute_path_uri: "file:///src/components/Header.tsx"
    end_line: 99
    content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useRef } from \'react\';\nimport { Compass, FolderOpen, Layers, FileCode, Smartphone, Download } from \'lucide-react\';\nimport { usePWAInstall } from \'../hooks/usePWAInstall\';\n\ninterface HeaderProps {\n  fileName: string;\n  formatVersion: string;\n  entityCount: number;\n  layerCount: number;\n  onOpenFile: (file: File) => void;\n  onOpenLayersModal: () => void;\n  onOpenSamplesModal: () => void;\n  onOpenDeployModal: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  fileName,\n  formatVersion,\n  entityCount,\n  layerCount,\n  onOpenFile,\n  onOpenLayersModal,\n  onOpenSamplesModal,\n  onOpenDeployModal,\n}) => {\n  const fileInputRef = useRef<HTMLInputElement>(null);\n  const { isInstallable, install } = usePWAInstall();\n\n  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    if (e.target.files && e.target.files[0]) {\n      onOpenFile(e.target.files[0]);\n      setTimeout(() => {\n        if (fileInputRef.current) fileInputRef.current.value = \'\';\n      }, 1000);\n    }\n  };\n\n  return (\n    <header className=\"h-14 bg-white dark:bg-[#0f172a] border-b-2 border-[#1E3A8A] dark:border-slate-800 px-3 flex items-center justify-between gap-2 shrink-0 z-30 pt-safe shadow-sm\">\n      {/* Hidden File Input */}\n      <input\n        ref={fileInputRef}\n        type=\"file\"\n        accept=\"*/*,.dwg,.DWG,.dxf,.DXF,.json\"\n        className=\"hidden\"\n        onChange={handleFileChange}\n      />\n\n      {/* Brand & File Status */}\n      <div className=\"flex items-center gap-2.5 min-w-0 flex-1\">\n        <div className=\"w-9 h-9 rounded-xl bg-[#1E3A8A] text-white flex items-center justify-center shrink-0 shadow-sm\">\n          <Compass className=\"w-5 h-5 text-white\" />\n        </div>\n        <div className=\"min-w-0 flex-1\">\n          <div className=\"flex items-center gap-1.5\">\n            <h1 className=\"text-xs sm:text-sm font-bold text-slate-900 dark:text-white truncate\">\n              {fileName || \'\354\227\264\353\246\260 \353\217\204\353\251\264 \354\227\206\354\235\214\'}\n            </h1>\n            {formatVersion && (\n              <span className=\"text-[10px] font-mono px-1.5 py-0.5 rounded bg-[#1E3A8A]/10 text-[#1E3A8A] dark:bg-[#1E3A8A]/25 dark:text-blue-300 border border-[#1E3A8A]/30 shrink-0 font-semibold\">\n                {formatVersion}\n              </span>\n            )}\n          </div>\n          <p className=\"text-[11px] text-slate-500 dark:text-slate-400 truncate\">\n            {entityCount > 0\n              ? `\352\260\235\354\262\264 ${entityCount.toLocaleString()}\352\260\234 \302\267 \353\240\210\354\235\264\354\226\264 ${layerCount}\352\260\234`\n              : \'\353\217\204\353\251\264 \354\227\264\352\270\260 \353\262\204\355\212\274\354\235\204 \353\210\214\353\237\254 .dwg \353\230\220\353\212\224 .dxf \355\214\214\354\235\274\354\235\204 \354\204\240\355\203\235\355\225\230\354\204\270\354\232\224\'}\n          </p>\n        </div>\n      </div>\n\n      {/* Action Buttons */}\n      <div className=\"flex items-center gap-1.5 shrink-0\">\n        {/* Open Drawing Button */}\n        <button\n          onClick={() => fileInputRef.current?.click()}\n          className=\"bg-[#C8102E] hover:bg-[#a50d26] text-white border border-[#9f0c24] px-3.5 py-2 rounded-xl text-xs font-bold flex items-center gap-1.5 shadow-sm active:scale-95 transition\"\n          title=\"\353\202\264 \354\212\244\353\247\210\355\212\270\355\217\260 \353\230\220\353\212\224 PC\354\227\220\354\204\234 DWG/DXF \353\217\204\353\251\264 \355\214\214\354\235\274 \354\227\264\352\270\260\"\n        >\n          <FolderOpen className=\"w-4 h-4 shrink-0\" />\n          <span className=\"hidden sm:inline\">\353\217\204\353\251\264 \354\227\264\352\270\260</span>\n          <span className=\"sm:hidden\">\354\227\264\352\270\260</span>\n        </button>\n\n        {/* Layers & Search Modal Button */}\n        <button\n          onClick={onOpenLayersModal}\n          className=\"p-2 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-700 transition\"\n          title=\"\353\240\210\354\235\264\354\226\264 \354\240\234\354\226\264 \353\260\217 \353\217\204\353\251\264 \355\205\215\354\212\244\355\212\270 \352\262\200\354\203\211\"\n        >\n          <Layers className=\"w-4 h-4\" />\n        </button>\n\n        {/* Samples & Reset Modal Button */}"
    num_lines: 134
    num_bytes: 5374
    line_range_bytes: 3840
  }
}
