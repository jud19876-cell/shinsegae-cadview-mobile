  planner_response {
    response: "\354\212\244\353\247\210\355\212\270\355\217\260 DWG/DXF \353\217\204\353\251\264 \353\267\260\354\226\264\354\227\220\354\204\234 **Google Drive** \353\260\217 **Dropbox** \355\201\264\353\235\274\354\232\260\353\223\234 \354\240\200\354\236\245\354\206\214\354\235\230 \353\217\204\353\251\264 \355\214\214\354\235\274\354\235\204 \354\247\201\354\240\221 \352\262\200\354\203\211\355\225\230\352\263\240 \353\266\210\353\237\254\354\230\254 \354\210\230 \354\236\210\353\217\204\353\241\235 \354\227\260\353\217\231\354\235\204 \354\244\200\353\271\204\355\225\230\352\263\240 \354\236\210\354\212\265\353\213\210\353\213\244.\n\nGoogle Drive \352\263\204\354\240\225\354\227\220\354\204\234 \353\217\204\353\251\264 \355\214\214\354\235\274(`.dwg`, `.dxf`)\354\235\204 \354\225\210\354\240\204\355\225\230\352\262\214 \354\241\260\355\232\214\355\225\230\352\263\240 \353\213\244\354\232\264\353\241\234\353\223\234\355\225\230\352\270\260 \354\234\204\355\225\264 Google Workspace OAuth \352\266\214\355\225\234 \354\212\271\354\235\270\354\235\264 \355\225\204\354\232\224\355\225\251\353\213\210\353\213\244. \354\225\204\353\236\230 \355\221\234\354\213\234\353\220\230\353\212\224 \354\204\244\354\240\225 \354\271\264\353\223\234\353\245\274 \355\231\225\354\235\270\355\225\230\354\213\234\352\263\240 \354\212\271\354\235\270\354\235\204 \354\247\204\355\226\211\355\225\264 \354\243\274\354\204\270\354\232\224. \354\212\271\354\235\270\354\235\264 \354\231\204\353\243\214\353\220\230\353\251\264 Google Drive \353\260\217 Dropbox \355\201\264\353\235\274\354\232\260\353\223\234 \355\203\220\354\203\211\352\270\260\354\231\200 \354\213\244\354\213\234\352\260\204 \353\217\204\353\251\264 \354\227\264\353\236\214 \352\270\260\353\212\245\354\235\204 \353\260\224\353\241\234 \352\265\254\355\230\204\355\225\230\352\262\240\354\212\265\353\213\210\353\213\244."
    modified_response: "\354\212\244\353\247\210\355\212\270\355\217\260 DWG/DXF \353\217\204\353\251\264 \353\267\260\354\226\264\354\227\220\354\204\234 **Google Drive** \353\260\217 **Dropbox** \355\201\264\353\235\274\354\232\260\353\223\234 \354\240\200\354\236\245\354\206\214\354\235\230 \353\217\204\353\251\264 \355\214\214\354\235\274\354\235\204 \354\247\201\354\240\221 \352\262\200\354\203\211\355\225\230\352\263\240 \353\266\210\353\237\254\354\230\254 \354\210\230 \354\236\210\353\217\204\353\241\235 \354\227\260\353\217\231\354\235\204 \354\244\200\353\271\204\355\225\230\352\263\240 \354\236\210\354\212\265\353\213\210\353\213\244.\n\nGoogle Drive \352\263\204\354\240\225\354\227\220\354\204\234 \353\217\204\353\251\264 \355\214\214\354\235\274(`.dwg`, `.dxf`)\354\235\204 \354\225\210\354\240\204\355\225\230\352\262\214 \354\241\260\355\232\214\355\225\230\352\263\240 \353\213\244\354\232\264\353\241\234\353\223\234\355\225\230\352\270\260 \354\234\204\355\225\264 Google Workspace OAuth \352\266\214\355\225\234 \354\212\271\354\235\270\354\235\264 \355\225\204\354\232\224\355\225\251\353\213\210\353\213\244. \354\225\204\353\236\230 \355\221\234\354\213\234\353\220\230\353\212\224 \354\204\244\354\240\225 \354\271\264\353\223\234\353\245\274 \355\231\225\354\235\270\355\225\230\354\213\234\352\263\240 \354\212\271\354\235\270\354\235\204 \354\247\204\355\226\211\355\225\264 \354\243\274\354\204\270\354\232\224. \354\212\271\354\235\270\354\235\264 \354\231\204\353\243\214\353\220\230\353\251\264 Google Drive \353\260\217 Dropbox \355\201\264\353\235\274\354\232\260\353\223\234 \355\203\220\354\203\211\352\270\260\354\231\200 \354\213\244\354\213\234\352\260\204 \353\217\204\353\251\264 \354\227\264\353\236\214 \352\270\260\353\212\245\354\235\204 \353\260\224\353\241\234 \352\265\254\355\230\204\355\225\230\352\262\240\354\212\265\353\213\210\353\213\244."
