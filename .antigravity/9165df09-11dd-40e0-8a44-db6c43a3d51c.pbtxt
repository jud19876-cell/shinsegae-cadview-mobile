  planner_response {
    thinking: "**Developing the CAD Canvas**\n\nI\'m now focused on the high-performance `CADCanvas.tsx` component. I\'m prioritizing touch gesture support: one-finger panning and tapping, and two-finger pinch-zoom. I\'m also implementing mouse interactions like dragging and wheel zooming. Further, I\'m integrating floating pills for zooming, fitting extents, rotation, and clearing measurements.\n\n\n"
    tool_calls {
      id: "call_1208096"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"/**\\n * @license\\n * SPDX-License-Identifier: Apache-2.0\\n */\\n\\nimport React, { useRef, useEffect, useCallback } from \'react\';\\nimport {\\n  Maximize2,\\n  RotateCw,\\n  Eraser,\\n  FolderOpen,\\n  Compass,\\n} from \'lucide-react\';\\nimport {\\n  CadEntity,\\n  CadTheme,\\n  Extents2D,\\n  MeasurementItem,\\n  Point2D,\\n  RasterPreviewEntity,\\n  RenderBatch,\\n  SnapPoint,\\n  TextEntity,\\n  ToolMode,\\n} from \'../types/cad\';\\nimport { resolveCadColorValue } from \'../lib/cadColors\';\\n\\ninterface CADCanvasProps {\\n  theme: CadTheme;\\n  mode: ToolMode;\\n  showGrid: boolean;\\n  enableOsnap: boolean;\\n  textScale: number;\\n  unitScaleFactor: number;\\n  rotation: number;\\n  camX: number;\\n  camY: number;\\n  zoom: number;\\n  extents: Extents2D;\\n  entities: CadEntity[];\\n  renderBatches: RenderBatch[];\\n  textEntities: TextEntity[];\\n  rasterEntities: RasterPreviewEntity[];\\n  layers: Record<string, { visible: boolean; aci: number }>;\\n  selectedEntity: CadEntity | null;\\n  measurements: MeasurementItem[];\\n  measurePoints: Point2D[];\\n  isLoading: boolean;\\n  loadingMessage: string;\\n  onUpdateCamera: (camX: number, camY: number, zoom: number) => void;\\n  onRotate90: () => void;\\n  onSelectEntity: (entity: CadEntity | null) => void;\\n  onAddMeasurement: (p1: Point2D, p2: Point2D, distanceMm: number) => void;\\n  onStartCalibration: (rawDist: number) => void;\\n  onClearMeasurements: () => void;\\n  onCancelMode: () => void;\\n  onOpenFileClick: () => void;\\n  onLoadArchSample: () => void;\\n  onLoadMechSample: () => void;\\n  onUpdateMouseWorld: (pt: Point2D) => void;\\n}\\n\\nexport const CADCanvas: React.FC<CADCanvasProps> = ({\\n  theme,\\n  mode,\\n  showGrid,\\n  enableOsnap,\\n  textScale,\\n  unitScaleFactor,\\n  rotation,\\n  camX,\\n  camY,\\n  zoom,\\n  extents,\\n  entities,\\n  renderBatches,\\n  textEntities,\\n  rasterEntities,\\n  layers,\\n  selectedEntity,\\n  measurements,\\n  measurePoints,\\n  isLoading,\\n  loadingMessage,\\n  onUpdateCamera,\\n  onRotate90,\\n  onSelectEntity,\\n  onAddMeasurement,\\n  onStartCalibration,\\n  onClearMeasurements,\\n  onCancelMode,\\n  onOpenFileClick,\\n  onLoadArchSample,\\n  onLoadMechSample,\\n  onUpdateMouseWorld,\\n}) => {\\n  const containerRef = useRef<HTMLDivElement>(null);\\n  const canvasRef = useRef<HTMLCanvasElement>(null);\\n  const loupeWrapperRef = useRef<HTMLDivElement>(null);\\n  const loupeCanvasRef = useRef<HTMLCanvasElement>(null);\\n\\n  const isDraggingRef = useRef(false);\\n  const dragStartScreenRef = useRef({ x: 0, y: 0 });\\n  const dragStartCamRef = useRef({ x: 0, y: 0 });\\n  const pinchDistStartRef = useRef(0);\\n  const tapStartPosRef = useRef({ x: 0, y: 0 });\\n  const snapPointRef = useRef<SnapPoint | null>(null);\\n\\n  // Coordinate transforms\\n  const worldToScreen = useCallback(\\n    (wx: number, wy: number) => {\\n      const c = canvasRef.current;\\n      if (!c) return { x: 0, y: 0 };\\n      const cw = c.width;\\n      const ch = c.height;\\n      const dx = wx - camX;\\n      const dy = wy - camY;\\n      const rad = (rotation * Math.PI) / 180;\\n      const cosA = Math.cos(rad);\\n      const sinA = Math.sin(rad);\\n      const rx = dx * cosA - dy * sinA;\\n      const ry = dx * sinA + dy * cosA;\\n      return { x: cw / 2 + rx * zoom, y: ch / 2 - ry * zoom };\\n    },\\n    [camX, camY, zoom, rotation]\\n  );\\n\\n  const screenToWorld = useCallback(\\n    (sx: number, sy: number) => {\\n      const c = canvasRef.current;\\n      if (!c) return { x: 0, y: 0 };\\n      const cw = c.width;\\n      const ch = c.height;\\n      const rx = (sx - cw / 2) / zoom;\\n      const ry = -(sy - ch / 2) / zoom;\\n      const rad = (-rotation * Math.PI) / 180;\\n      const cosA = Math.cos(rad);\\n      const sinA = Math.sin(rad);\\n      return {\\n        x: camX + (rx * cosA - ry * sinA),\\n        y: camY + (rx * sinA + ry * cosA),\\n      };\\n    },\\n    [camX, camY, zoom, rotation]\\n  );\\n\\n  // OSNAP Finder\\n  const findSnapPoint = useCallback(\\n    (sx: number, sy: number): SnapPoint | null => {\\n      if (!enableOsnap || entities.length === 0) return null;\\n      let best: SnapPoint | null = null;\\n      let bestDist = 18;\\n      const wPt = screenToWorld(sx, sy);\\n      const worldRadius = 24 / zoom;\\n\\n      function check(wx: number, wy: number, type: \'END\' | \'MID\' | \'CEN\') {\\n        if (\\n          Math.abs(wx - wPt.x) > worldRadius ||\\n          Math.abs(wy - wPt.y) > worldRadius\\n        )\\n          return;\\n        const sp = worldToScreen(wx, wy);\\n        const d = Math.hypot(sp.x - sx, sp.y - sy);\\n        if (d < bestDist) {\\n          bestDist = d;\\n          best = { x: wx, y: wy, type };\\n        }\\n      }\\n\\n      for (let i = 0; i < entities.length; i++) {\\n        const e = entities[i];\\n        const lyr = layers[e.layer || \'0\'];\\n        if (lyr && !lyr.visible) continue;\\n\\n        if (e.type === \'LINE\' && e.start && e.end) {\\n          check(e.start.x, e.start.y, \'END\');\\n          check(e.end.x, e.end.y, \'END\');\\n          check((e.start.x + e.end.x) / 2, (e.start.y + e.end.y) / 2, \'MID\');\\n        } else if (e.type === \'LWPOLYLINE\' && e.vertices) {\\n          for (let k = 0; k < e.vertices.length; k++) {\\n            check(e.vertices[k].x, e.vertices[k].y, \'END\');\\n          }\\n        } else if ((e.type === \'CIRCLE\' || e.type === \'ARC\') && e.center) {\\n          check(e.center.x, e.center.y, \'CEN\');\\n        }\\n      }\\n      return best;\\n    },\\n    [enableOsnap, entities, layers, zoom, screenToWorld, worldToScreen]\\n  );\\n\\n  // Entity Finder\\n  const findEntityAt = useCallback(\\n    (sx: number, sy: number): CadEntity | null => {\\n      let best: CadEntity | null = null;\\n      let minDist = 14;\\n\\n      function distToSeg(\\n        px: number,\\n        py: number,\\n        x1: number,\\n        y1: number,\\n        x2: number,\\n        y2: number\\n      ) {\\n        const l2 = (x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1);\\n        if (l2 === 0) return Math.hypot(px - x1, py - y1);\\n        const t = Math.max(\\n          0,\\n          Math.min(1, ((px - x1) * (x2 - x1) + (py - y1) * (y2 - y1)) / l2)\\n        );\\n        return Math.hypot(px - (x1 + t * (x2 - x1)), py - (y1 + t * (y2 - y1)));\\n      }\\n\\n      for (let i = 0; i < entities.length; i++) {\\n        const e = entities[i];\\n        const lyr = layers[e.layer || \'0\'];\\n        if (lyr && !lyr.visible) continue;\\n\\n        if (e.type === \'LINE\' && e.start && e.end) {\\n          const p1 = worldToScreen(e.start.x, e.start.y);\\n          const p2 = worldToScreen(e.end.x, e.end.y);\\n          const d = distToSeg(sx, sy, p1.x, p1.y, p2.x, p2.y);\\n          if (d < minDist) {\\n            minDist = d;\\n            best = e;\\n          }\\n        } else if (\\n          e.type === \'LWPOLYLINE\' &&\\n          e.vertices &&\\n          e.vertices.length >= 2\\n        ) {\\n          for (let k = 0; k < e.vertices.length - 1; k++) {\\n            const p1 = worldToScreen(e.vertices[k].x, e.vertices[k].y);\\n            const p2 = worldToScreen(e.vertices[k + 1].x, e.vertices[k + 1].y);\\n            const d = distToSeg(sx, sy, p1.x, p1.y, p2.x, p2.y);\\n            if (d < minDist) {\\n              minDist = d;\\n              best = e;\\n            }\\n          }\\n        } else if ((e.type === \'CIRCLE\' || e.type === \'ARC\') && e.center) {\\n          const c = worldToScreen(e.center.x, e.center.y);\\n          const d = Math.abs(\\n            Math.hypot(sx - c.x, sy - c.y) - e.radius * zoom\\n          );\\n          if (d < minDist) {\\n            minDist = d;\\n            best = e;\\n          }\\n        } else if (e.type === \'TEXT\' && e.position) {\\n          const p = worldToScreen(e.position.x, e.position.y);\\n          const d = Math.hypot(sx - p.x, sy - p.y);\\n          if (d < 24 && d < minDist + 12) {\\n            minDist = Math.min(minDist, d);\\n            best = e;\\n          }\\n        }\\n      }\\n      return best;\\n    },\\n    [entities, layers, worldToScreen, zoom]\\n  );\\n\\n  // Fit Extents to Screen\\n  const handleFitExtents = useCallback(() => {\\n    const c = canvasRef.current;\\n    if (!c) return;\\n    const cw = c.width || 360;\\n    const ch = c.height || 600;\\n    const w = Math.max(10, extents.maxX - extents.minX);\\n    const h = Math.max(10, extents.maxY - extents.minY);\\n    const newCamX = (extents.minX + extents.maxX) / 2;\\n    const newCamY = (extents.minY + extents.maxY) / 2;\\n    const newZoom = Math.min((cw * 0.86) / w, (ch * 0.86) / h);\\n    onUpdateCamera(newCamX, newCamY, newZoom);\\n  }, [extents, onUpdateCamera]);\\n\\n  // Touch Loupe Magnifier\\n  const updateTouchLoupe = (sx: number, sy: number) => {\\n    const wrapper = loupeWrapperRef.current;\\n    const lCanv = loupeCanvasRef.current;\\n    const canvas = canvasRef.current;\\n    if (!wrapper || !lCanv || !canvas) return;\\n\\n    if (mode !== \'measure\' && mode !== \'calibrate\') {\\n      wrapper.classList.add(\'hidden\');\\n      return;\\n    }\\n    wrapper.classList.remove(\'hidden\');\\n    const lw = 112;\\n    const lh = 112;\\n    wrapper.style.left = `${Math.max(8, Math.min(canvas.width - lw - 8, sx - lw / 2))}px`;\\n    wrapper.style.top = `${Math.max(8, sy - lh - 40)}px`;\\n\\n    const lCtx = lCanv.getContext(\'2d\');\\n    if (!lCtx) return;\\n    lCtx.clearRect(0, 0, lw, lh);\\n    const z = 2.4;\\n    lCtx.drawImage(\\n      canvas,\\n      sx - lw / z / 2,\\n      sy - lh / z / 2,\\n      lw / z,\\n      lh / z,\\n      0,\\n      0,\\n      lw,\\n      lh\\n    );\\n    lCtx.strokeStyle = \'#C8102E\';\\n    lCtx.lineWidth = 1.4;\\n    lCtx.beginPath();\\n    lCtx.moveTo(lw / 2, 0);\\n    lCtx.lineTo(lw / 2, lh);\\n    lCtx.moveTo(0, lh / 2);\\n    lCtx.lineTo(lw, lh / 2);\\n    lCtx.stroke();\\n  };\\n\\n  const handlePointTap = (sx: number, sy: number) => {\\n    const snap = findSnapPoint(sx, sy);\\n    const wp = snap ? { x: snap.x, y: snap.y } : screenToWorld(sx, sy);\\n\\n    if (mode === \'select\') {\\n      const hit = findEntityAt(sx, sy);\\n      onSelectEntity(hit);\\n      return;\\n    }\\n\\n    if (mode === \'measure\') {\\n      if (measurePoints.length === 0) {\\n        onAddMeasurement(wp, wp, 0); // Temporary set first point\\n      } else if (measurePoints.length === 1) {\\n        const p1 = measurePoints[0];\\n        const p2 = wp;\\n        const distMm = Math.hypot(p2.x - p1.x, p2.y - p1.y) * unitScaleFactor;\\n        onAddMeasurement(p1, p2, distMm);\\n      }\\n      return;\\n    }\\n\\n    if (mode === \'calibrate\') {\\n      if (measurePoints.length === 0) {\\n        onAddMeasurement(wp, wp, 0);\\n      } else if (measurePoints.length === 1) {\\n        const p1 = measurePoints[0];\\n        const p2 = wp;\\n        const rawDist = Math.hypot(p2.x - p1.x, p2.y - p1.y);\\n        onStartCalibration(rawDist);\\n      }\\n    }\\n  };\\n\\n  // 60FPS Render Loop\\n  useEffect(() => {\\n    const canvas = canvasRef.current;\\n    if (!canvas) return;\\n    const ctx = canvas.getContext(\'2d\', { alpha: false });\\n    if (!ctx) return;\\n\\n    let animId: number;\\n    const render = () => {\\n      const cw = canvas.width;\\n      const ch = canvas.height;\\n      if (!cw || !ch) return;\\n\\n      // Surface Background: AI-Vault Soft Ivory vs Dark vs Blueprint\\n      const bgMap = { white: \'#F8F7F4\', dark: \'#0B101B\', blueprint: \'#071B38\' };\\n      ctx.fillStyle = bgMap[theme] || \'#F8F7F4\';\\n      ctx.fillRect(0, 0, cw, ch);\\n\\n      // Grid\\n      if (showGrid && entities.length > 0) {\\n        const rawStep = 85 / zoom;\\n        const mag = Math.pow(10, Math.floor(Math.log10(rawStep)));\\n        let step = mag;\\n        if (rawStep / mag > 5) step = mag * 10;\\n        else if (rawStep / mag > 2) step = mag * 5;\\n        else if (rawStep / mag > 1) step = mag * 2;\\n\\n        const c1 = screenToWorld(0, 0);\\n        const c2 = screenToWorld(cw, ch);\\n        const minX = Math.floor(Math.min(c1.x, c2.x) / step) * step;\\n        const maxX = Math.ceil(Math.max(c1.x, c2.x) / step) * step;\\n        const minY = Math.floor(Math.min(c1.y, c2.y) / step) * step;\\n        const maxY = Math.ceil(Math.max(c1.y, c2.y) / step) * step;\\n\\n        ctx.save();\\n        ctx.lineWidth = 1;\\n        ctx.strokeStyle =\\n          theme === \'white\'\\n            ? \'rgba(148, 163, 184, 0.25)\'\\n            : \'rgba(51, 65, 85, 0.35)\';\\n        ctx.beginPath();\\n        for (let x = minX; x <= maxX; x += step) {\\n          const pA = worldToScreen(x, minY);\\n          const pB = worldToScreen(x, maxY);\\n          ctx.moveTo(pA.x, pA.y);\\n          ctx.lineTo(pB.x, pB.y);\\n        }\\n        for (let y = minY; y <= maxY; y += step) {\\n          const pA = worldToScreen(minX, y);\\n          const pB = worldToScreen(maxX, y);\\n          ctx.moveTo(pA.x, pA.y);\\n          ctx.lineTo(pB.x, pB.y);\\n        }\\n        ctx.stroke();\\n\\n        // Origin crosshair\\n        const orig = worldToScreen(0, 0);\\n        ctx.lineWidth = 1.5;\\n        ctx.strokeStyle = \'#C8102E\';\\n        ctx.beginPath();\\n        ctx.moveTo(orig.x, orig.y);\\n        ctx.lineTo(orig.x + 28, orig.y);\\n        ctx.stroke();\\n        ctx.strokeStyle = \'#15803d\';\\n        ctx.beginPath();\\n        ctx.moveTo(orig.x, orig.y);\\n        ctx.lineTo(orig.x, orig.y - 28);\\n        ctx.stroke();\\n        ctx.restore();\\n      }\\n\\n      // Raster Preview\\n      for (let i = 0; i < rasterEntities.length; i++) {\\n        const ent = rasterEntities[i];\\n        const tl = worldToScreen(ent.minX, ent.maxY);\\n        const br = worldToScreen(ent.maxX, ent.minY);\\n        ctx.drawImage(ent.img, tl.x, tl.y, br.x - tl.x, br.y - tl.y);\\n      }\\n\\n      // Render Batches\\n      const halfW = cw / 2;\\n      const halfH = ch / 2;\\n      const rad = (rotation * Math.PI) / 180;\\n      const cosA = Math.cos(rad);\\n      const sinA = Math.sin(rad);\\n      const noRot = rotation === 0;\\n\\n      ctx.lineWidth = 1.15;\\n      for (let bIdx = 0; bIdx < renderBatches.length; bIdx++) {\\n        const batch = renderBatches[bIdx];\\n        const lyr = layers[batch.layer];\\n        if (lyr && !lyr.visible) continue;\\n\\n        ctx.strokeStyle = batch.color;\\n        if (batch.dashType === \'C\') {\\n          ctx.setLineDash([10, 4, 3, 4]);\\n        } else if (batch.dashType === \'D\') {\\n          ctx.setLineDash([6, 4]);\\n        } else {\\n          ctx.setLineDash([]);\\n        }\\n\\n        ctx.beginPath();\\n        const coords = batch.lineCoords;\\n        if (noRot) {\\n          for (let i = 0; i < coords.length; i += 4) {\\n            const sx1 = halfW + (coords[i] - camX) * zoom;\\n            const sy1 = halfH - (coords[i + 1] - camY) * zoom;\\n            const sx2 = halfW + (coords[i + 2] - camX) * zoom;\\n            const sy2 = halfH - (coords[i + 3] - camY) * zoom;\\n            if (\\n              (sx1 < 0 && sx2 < 0) ||\\n              (sx1 > cw && sx2 > cw) ||\\n              (sy1 < 0 && sy2 < 0) ||\\n              (sy1 > ch && sy2 > ch)\\n            )\\n              continue;\\n            ctx.moveTo(sx1, sy1);\\n            ctx.lineTo(sx2, sy2);\\n          }\\n        } else {\\n          for (let i = 0; i < coords.length; i += 4) {\\n            const dx1 = coords[i] - camX;\\n            const dy1 = coords[i + 1] - camY;\\n            const sx1 = halfW + (dx1 * cosA - dy1 * sinA) * zoom;\\n            const sy1 = halfH - (dx1 * sinA + dy1 * cosA) * zoom;\\n            const dx2 = coords[i + 2] - camX;\\n            const dy2 = coords[i + 3] - camY;\\n            const sx2 = halfW + (dx2 * cosA - dy2 * sinA) * zoom;\\n            const sy2 = halfH - (dx2 * sinA + dy2 * cosA) * zoom;\\n            ctx.moveTo(sx1, sy1);\\n            ctx.lineTo(sx2, sy2);\\n          }\\n        }\\n\\n        // Polylines\\n        const polys = batch.polylines;\\n        for (let pIdx = 0; pIdx < polys.length; pIdx++) {\\n          const verts = polys[pIdx].vertices;\\n          if (verts.length < 2) continue;\\n          const v0 = verts[0];\\n          const s0 = worldToScreen(v0.x, v0.y);\\n          ctx.moveTo(s0.x, s0.y);\\n          for (let k = 1; k < verts.length; k++) {\\n            const sk = worldToScreen(verts[k].x, verts[k].y);\\n            ctx.lineTo(sk.x, sk.y);\\n          }\\n          if (polys[pIdx].closed) ctx.closePath();\\n        }\\n\\n        // Circles\\n        const circles = batch.circles;\\n        for (let cIdx = 0; cIdx < circles.length; cIdx++) {\\n          const c = circles[cIdx];\\n          const r = c.radius * zoom;\\n          if (r < 0.6) continue;\\n          const sc = worldToScreen(c.center.x, c.center.y);\\n          if (sc.x + r < 0 || sc.x - r > cw || sc.y + r < 0 || sc.y - r > ch)\\n            continue;\\n          ctx.moveTo(sc.x + r, sc.y);\\n          ctx.arc(sc.x, sc.y, r, 0, Math.PI * 2);\\n        }\\n\\n        // Arcs\\n        const arcs = batch.arcs;\\n        for (let aIdx = 0; aIdx < arcs.length; aIdx++) {\\n          const a = arcs[aIdx];\\n          const r = a.radius * zoom;\\n          if (r < 0.6) continue;\\n          const sc = worldToScreen(a.center.x, a.center.y);\\n          if (sc.x + r < 0 || sc.x - r > cw || sc.y + r < 0 || sc.y - r > ch)\\n            continue;\\n          const sRad = (-(a.startAngle + rotation) * Math.PI) / 180;\\n          const eRad = (-(a.endAngle + rotation) * Math.PI) / 180;\\n          ctx.moveTo(sc.x + Math.cos(sRad) * r, sc.y + Math.sin(sRad) * r);\\n          ctx.arc(sc.x, sc.y, r, sRad, eRad, true);\\n        }\\n\\n        // Ellipses\\n        const ellipses = batch.ellipses;\\n        for (let eIdx = 0; eIdx < ellipses.length; eIdx++) {\\n          const el = ellipses[eIdx];\\n          const sc = worldToScreen(el.center.x, el.center.y);\\n          const majLen = Math.hypot(el.majorAxis.x, el.majorAxis.y) * zoom;\\n          const minLen = majLen * el.axisRatio;\\n          if (majLen < 1) continue;\\n          const rotA =\\n            (Math.atan2(el.majorAxis.y, el.majorAxis.x) - (rotation * Math.PI) / 180);\\n          ctx.ellipse(sc.x, sc.y, majLen, minLen, rotA, 0, Math.PI * 2);\\n        }\\n\\n        ctx.stroke();\\n      }\\n      ctx.setLineDash([]);\\n\\n      // Texts\\n      for (let tIdx = 0; tIdx < textEntities.length; tIdx++) {\\n        const ent = textEntities[tIdx];\\n        const lyr = layers[ent.layer || \'0\'];\\n        if (lyr && !lyr.visible) continue;\\n        const rawPx = (ent.height || 10) * zoom * textScale;\\n        if (rawPx < 3.5) continue;\\n        const p = worldToScreen(ent.position.x, ent.position.y);\\n        if (p.x < -120 || p.x > cw + 120 || p.y < -60 || p.y > ch + 60) continue;\\n\\n        const fontPx = Math.min(56, rawPx);\\n        ctx.save();\\n        ctx.fillStyle =\\n          ent.aci !== null && ent.aci !== undefined\\n            ? resolveCadColorValue(ent.aci, theme)\\n            : lyr\\n              ? resolveCadColorValue(lyr.aci, theme)\\n              : theme === \'white\'\\n                ? \'#0f172a\'\\n                : \'#f8fafc\';\\n        ctx.translate(p.x, p.y);\\n        const rotRad =\\n          (-((ent.rotation || 0) + rotation) * Math.PI) / 180;\\n        if (rotRad !== 0) ctx.rotate(rotRad);\\n        ctx.font = `500 ${fontPx.toFixed(1)}px \\\"Inter\\\", \\\"Noto Sans KR\\\", sans-serif`;\\n        ctx.textAlign = ent.align || \'left\';\\n        ctx.textBaseline = \'alphabetic\';\\n        const lines = String(ent.text).split(\'\\\\n\');\\n        for (let l = 0; l < lines.length; l++) {\\n          ctx.fillText(lines[l], 0, l * fontPx * 1.2);\\n        }\\n        ctx.restore();\\n      }\\n\\n      // Selected Entity Highlight\\n      if (selectedEntity) {\\n        ctx.save();\\n        ctx.strokeStyle = \'#C8102E\';\\n        ctx.lineWidth = 3.0;\\n        if (selectedEntity.type === \'LINE\' && selectedEntity.start && selectedEntity.end) {\\n          const p1 = worldToScreen(selectedEntity.start.x, selectedEntity.start.y);\\n          const p2 = worldToScreen(selectedEntity.end.x, selectedEntity.end.y);\\n          ctx.beginPath();\\n          ctx.moveTo(p1.x, p1.y);\\n          ctx.lineTo(p2.x, p2.y);\\n          ctx.stroke();\\n        } else if (\\n          selectedEntity.type === \'LWPOLYLINE\' &&\\n          selectedEntity.vertices\\n        ) {\\n          ctx.beginPath();\\n          const p0 = worldToScreen(\\n            selectedEntity.vertices[0].x,\\n            selectedEntity.vertices[0].y\\n          );\\n          ctx.moveTo(p0.x, p0.y);\\n          for (let k = 1; k < selectedEntity.vertices.length; k++) {\\n            const pk = worldToScreen(\\n              selectedEntity.vertices[k].x,\\n              selectedEntity.vertices[k].y\\n            );\\n            ctx.lineTo(pk.x, pk.y);\\n          }\\n          if (selectedEntity.closed) ctx.closePath();\\n          ctx.stroke();\\n        } else if (\\n          (selectedEntity.type === \'CIRCLE\' || selectedEntity.type === \'ARC\') &&\\n          selectedEntity.center\\n        ) {\\n          const c = worldToScreen(\\n            selectedEntity.center.x,\\n            selectedEntity.center.y\\n          );\\n          ctx.beginPath();\\n          ctx.arc(c.x, c.y, Math.max(2, selectedEntity.radius * zoom), 0, Math.PI * 2);\\n          ctx.stroke();\\n        }\\n        ctx.restore();\\n      }\\n\\n      // Measurements\\n      measurements.forEach((m) => {\\n        const s1 = worldToScreen(m.p1.x, m.p1.y);\\n        const s2 = worldToScreen(m.p2.x, m.p2.y);\\n        ctx.save();\\n        ctx.strokeStyle = \'#C8102E\';\\n        ctx.fillStyle = \'#C8102E\';\\n        ctx.lineWidth = 2;\\n        ctx.setLineDash([5, 4]);\\n        ctx.beginPath();\\n        ctx.moveTo(s1.x, s1.y);\\n        ctx.lineTo(s2.x, s2.y);\\n        ctx.stroke();\\n        ctx.setLineDash([]);\\n        [s1, s2].forEach((p) => {\\n          ctx.beginPath();\\n          ctx.arc(p.x, p.y, 4, 0, Math.PI * 2);\\n          ctx.fill();\\n        });\\n\\n        // Measurement pill\\n        const mx = (s1.x + s2.x) / 2;\\n        const my = (s1.y + s2.y) / 2 - 12;\\n        ctx.font = \'bold 11px \\\"Inter\\\", \\\"Noto Sans KR\\\", sans-serif\';\\n        const tw = ctx.measureText(m.label).width + 14;\\n        ctx.fillStyle = \'#1E3A8A\';\\n        ctx.beginPath();\\n        ctx.roundRect(mx - tw / 2, my - 11, tw, 22, 6);\\n        ctx.fill();\\n        ctx.fillStyle = \'#FFFFFF\';\\n        ctx.textAlign = \'center\';\\n        ctx.textBaseline = \'middle\';\\n        ctx.fillText(m.label, mx, my);\\n        ctx.restore();\\n      });\\n\\n      // Active Measurement Points\\n      if (measurePoints.length > 0) {\\n        const p0 = worldToScreen(measurePoints[0].x, measurePoints[0].y);\\n        ctx.save();\\n        ctx.fillStyle = \'#C8102E\';\\n        ctx.beginPath();\\n        ctx.arc(p0.x, p0.y, 5.5, 0, Math.PI * 2);\\n        ctx.fill();\\n        ctx.restore();\\n      }\\n\\n      // OSNAP Marker\\n      if (enableOsnap && snapPointRef.current) {\\n        const sp = worldToScreen(\\n          snapPointRef.current.x,\\n          snapPointRef.current.y\\n        );\\n        ctx.save();\\n        ctx.strokeStyle = \'#10B981\';\\n        ctx.lineWidth = 2;\\n        ctx.strokeRect(sp.x - 6, sp.y - 6, 12, 12);\\n        ctx.restore();\\n      }\\n    };\\n\\n    render();\\n  }, [\\n    theme,\\n    showGrid,\\n    entities,\\n    renderBatches,\\n    textEntities,\\n    rasterEntities,\\n    layers,\\n    selectedEntity,\\n    measurements,\\n    measurePoints,\\n    camX,\\n    camY,\\n    zoom,\\n    rotation,\\n    textScale,\\n    enableOsnap,\\n    screenToWorld,\\n    worldToScreen,\\n  ]);\\n\\n  // Window resize handler\\n  useEffect(() => {\\n    const handleResize = () => {\\n      const container = containerRef.current;\\n      const canvas = canvasRef.current;\\n      if (!container || !canvas) return;\\n      const rect = container.getBoundingClientRect();\\n      canvas.width = Math.max(280, Math.floor(rect.width));\\n      canvas.height = Math.max(200, Math.floor(rect.height));\\n    };\\n\\n    handleResize();\\n    window.addEventListener(\'resize\', handleResize);\\n    window.addEventListener(\'orientationchange\', () =>\\n      setTimeout(handleResize, 150)\\n    );\\n    return () => {\\n      window.removeEventListener(\'resize\', handleResize);\\n    };\\n  }, []);\\n\\n  // Mouse & Touch Interaction Listeners\\n  useEffect(() => {\\n    const canvas = canvasRef.current;\\n    if (!canvas) return;\\n\\n    const onMouseDown = (e: MouseEvent) => {\\n      const rect = canvas.getBoundingClientRect();\\n      const sx = e.clientX - rect.left;\\n      const sy = e.clientY - rect.top;\\n      isDraggingRef.current = true;\\n      dragStartScreenRef.current = { x: sx, y: sy };\\n      dragStartCamRef.current = { x: camX, y: camY };\\n      tapStartPosRef.current = { x: sx, y: sy };\\n    };\\n\\n    const onMouseMove = (e: MouseEvent) => {\\n      const rect = canvas.getBoundingClientRect();\\n      const sx = e.clientX - rect.left;\\n      const sy = e.clientY - rect.top;\\n      const wPt = screenToWorld(sx, sy);\\n      onUpdateMouseWorld(wPt);\\n\\n      if (isDraggingRef.current && mode === \'pan\') {\\n        const dx = sx - dragStartScreenRef.current.x;\\n        const dy = sy - dragStartScreenRef.current.y;\\n        const rad = (-rotation * Math.PI) / 180;\\n        const wx = -(dx / zoom);\\n        const wy = dy / zoom;\\n        const nx = dragStartCamRef.current.x + (wx * Math.cos(rad) - wy * Math.sin(rad));\\n        const ny = dragStartCamRef.current.y + (wx * Math.sin(rad) + wy * Math.cos(rad));\\n        onUpdateCamera(nx, ny, zoom);\\n      } else if (mode === \'measure\' || mode === \'calibrate\') {\\n        snapPointRef.current = findSnapPoint(sx, sy);\\n      }\\n    };\\n\\n    const onMouseUp = (e: MouseEvent) => {\\n      if (!isDraggingRef.current) return;\\n      isDraggingRef.current = false;\\n      const rect = canvas.getBoundingClientRect();\\n      const sx = e.clientX - rect.left;\\n      const sy = e.clientY - rect.top;\\n      if (\\n        Math.hypot(\\n          sx - tapStartPosRef.current.x,\\n          sy - tapStartPosRef.current.y\\n        ) < 6 &&\\n        mode !== \'pan\'\\n      ) {\\n        handlePointTap(sx, sy);\\n      }\\n    };\\n\\n    const onWheel = (e: WheelEvent) => {\\n      e.preventDefault();\\n      const rect = canvas.getBoundingClientRect();\\n      const sx = e.clientX - rect.left;\\n      const sy = e.clientY - rect.top;\\n      const before = screenToWorld(sx, sy);\\n      const factor = e.deltaY < 0 ? 1.18 : 1 / 1.18;\\n      const newZoom = Math.max(0.0002, Math.min(2000, zoom * factor));\\n      const after = {\\n        x: camX + (before.x - camX) * (zoom / newZoom),\\n        y: camY + (before.y - camY) * (zoom / newZoom),\\n      };\\n      onUpdateCamera(after.x, after.y, newZoom);\\n    };\\n\\n    const onTouchStart = (e: TouchEvent) => {\\n      const rect = canvas.getBoundingClientRect();\\n      if (e.touches.length === 1) {\\n        const sx = e.touches[0].clientX - rect.left;\\n        const sy = e.touches[0].clientY - rect.top;\\n        isDraggingRef.current = true;\\n        dragStartScreenRef.current = { x: sx, y: sy };\\n        dragStartCamRef.current = { x: camX, y: camY };\\n        tapStartPosRef.current = { x: sx, y: sy };\\n        if (mode === \'measure\' || mode === \'calibrate\') {\\n          snapPointRef.current = findSnapPoint(sx, sy);\\n          updateTouchLoupe(sx, sy);\\n        }\\n      } else if (e.touches.length === 2) {\\n        isDraggingRef.current = false;\\n        loupeWrapperRef.current?.classList.add(\'hidden\');\\n        pinchDistStartRef.current = Math.hypot(\\n          e.touches[1].clientX - e.touches[0].clientX,\\n          e.touches[1].clientY - e.touches[0].clientY\\n        );\\n      }\\n    };\\n\\n    const onTouchMove = (e: TouchEvent) => {\\n      e.preventDefault();\\n      const rect = canvas.getBoundingClientRect();\\n      if (e.touches.length === 1 && isDraggingRef.current) {\\n        const sx = e.touches[0].clientX - rect.left;\\n        const sy = e.touches[0].clientY - rect.top;\\n        if (mode === \'measure\' || mode === \'calibrate\') {\\n          snapPointRef.current = findSnapPoint(sx, sy);\\n          updateTouchLoupe(sx, sy);\\n          return;\\n        }\\n        const dx = sx - dragStartScreenRef.current.x;\\n        const dy = sy - dragStartScreenRef.current.y;\\n        const rad = (-rotation * Math.PI) / 180;\\n        const wx = -(dx / zoom);\\n        const wy = dy / zoom;\\n        const nx = dragStartCamRef.current.x + (wx * Math.cos(rad) - wy * Math.sin(rad));\\n        const ny = dragStartCamRef.current.y + (wx * Math.sin(rad) + wy * Math.cos(rad));\\n        onUpdateCamera(nx, ny, zoom);\\n      } else if (e.touches.length === 2 && pinchDistStartRef.current > 10) {\\n        const dist = Math.hypot(\\n          e.touches[1].clientX - e.touches[0].clientX,\\n          e.touches[1].clientY - e.touches[0].clientY\\n        );\\n        const midX =\\n          (e.touches[0].clientX + e.touches[1].clientX) / 2 - rect.left;\\n        const midY =\\n          (e.touches[0].clientY + e.touches[1].clientY) / 2 - rect.top;\\n        const before = screenToWorld(midX, midY);\\n        const newZoom = Math.max(\\n          0.0002,\\n          Math.min(2000, zoom * (dist / pinchDistStartRef.current))\\n        );\\n        const after = screenToWorld(midX, midY);\\n        onUpdateCamera(\\n          camX + (before.x - after.x),\\n          camY + (before.y - after.y),\\n          newZoom\\n        );\\n        pinchDistStartRef.current = dist;\\n      }\\n    };\\n\\n    const onTouchEnd = (e: TouchEvent) => {\\n      loupeWrapperRef.current?.classList.add(\'hidden\');\\n      if (isDraggingRef.current && e.changedTouches.length === 1) {\\n        const rect = canvas.getBoundingClientRect();\\n        const sx = e.changedTouches[0].clientX - rect.left;\\n        const sy = e.changedTouches[0].clientY - rect.top;\\n        if (\\n          Math.hypot(\\n            sx - tapStartPosRef.current.x,\\n            sy - tapStartPosRef.current.y\\n          ) < 12 &&\\n          mode !== \'pan\'\\n        ) {\\n          handlePointTap(sx, sy);\\n        }\\n      }\\n      isDraggingRef.current = false;\\n      pinchDistStartRef.current = 0;\\n    };\\n\\n    canvas.addEventListener(\'mousedown\', onMouseDown);\\n    window.addEventListener(\'mousemove\', onMouseMove);\\n    window.addEventListener(\'mouseup\', onMouseUp);\\n    canvas.addEventListener(\'wheel\', onWheel, { passive: false });\\n\\n    canvas.addEventListener(\'touchstart\', onTouchStart, { passive: false });\\n    canvas.addEventListener(\'touchmove\', onTouchMove, { passive: false });\\n    canvas.addEventListener(\'touchend\', onTouchEnd);\\n\\n    return () => {\\n      canvas.removeEventListener(\'mousedown\', onMouseDown);\\n      window.removeEventListener(\'mousemove\', onMouseMove);\\n      window.removeEventListener(\'mouseup\', onMouseUp);\\n      canvas.removeEventListener(\'wheel\', onWheel);\\n\\n      canvas.removeEventListener(\'touchstart\', onTouchStart);\\n      canvas.removeEventListener(\'touchmove\', onTouchMove);\\n      canvas.removeEventListener(\'touchend\', onTouchEnd);\\n    };\\n  }, [\\n    camX,\\n    camY,\\n    zoom,\\n    rotation,\\n    mode,\\n    findSnapPoint,\\n    screenToWorld,\\n    onUpdateCamera,\\n    onUpdateMouseWorld,\\n  ]);\\n\\n  return (\\n    <main\\n      ref={containerRef}\\n      className=\\\"relative flex-1 w-full bg-[#F8F7F4] dark:bg-[#0B101B] overflow-hidden\\\"\\n    >\\n      <canvas\\n        ref={canvasRef}\\n        className=\\\"block w-full h-full cursor-grab active:cursor-grabbing\\\"\\n      />\\n\\n      {/* Empty State Welcome Screen */}\\n      {entities.length === 0 && !isLoading && (\\n        <div className=\\\"absolute inset-0 z-10 flex flex-col items-center justify-center p-6 text-center bg-[#F8F7F4]/95 dark:bg-[#0B101B]/95\\\">\\n          <div className=\\\"w-16 h-16 rounded-2xl bg-[#1E3A8A] text-white flex items-center justify-center mb-4 shadow-lg\\\">\\n            <Compass className=\\\"w-8 h-8\\\" />\\n          </div>\\n          <div className=\\\"inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-[#1E3A8A]/10 text-[#1E3A8A] dark:text-blue-300 border border-[#1E3A8A]/25 text-[11px] font-bold mb-2\\\">\\n            <span>AI-VAULT MOBILE CAD CONSOLE</span>\\n          </div>\\n          <h2 className=\\\"text-base sm:text-lg font-bold text-slate-900 dark:text-white mb-1.5\\\">\\n            \353\252\250\353\260\224\354\235\274 DWG \302\267 DXF \354\240\225\353\260\200 \353\217\204\353\251\264 \353\267\260\354\226\264\\n          </h2>\\n          <p className=\\\"text-xs text-slate-500 dark:text-slate-400 max-w-sm leading-relaxed mb-6\\\">\\n            \354\212\244\353\247\210\355\212\270\355\217\260\354\235\264\353\202\230 \355\203\234\353\270\224\353\246\277\354\227\220 \354\240\200\354\236\245\353\220\234 <strong>.dwg</strong> \353\260\217 <strong>.dxf</strong> \354\233\220\353\263\270 \353\217\204\353\251\264\354\235\204 \354\204\234\353\262\204 \354\240\204\354\206\241 \354\227\206\354\235\264 100% \353\270\214\353\235\274\354\232\260\354\240\200 \353\202\264\353\266\200\354\227\220\354\204\234 \354\246\211\354\213\234 \355\225\264\353\217\205\355\225\230\354\227\254 \355\231\225\353\214\200\302\267\354\266\225\354\206\214\302\267\353\240\210\354\235\264\354\226\264 \354\240\234\354\226\264\302\267\354\271\230\354\210\230 \354\270\241\354\240\225\354\235\204 \354\210\230\355\226\211\355\225\251\353\213\210\353\213\244.\\n          </p>\\n          <div className=\\\"flex flex-col sm:flex-row items-center gap-2.5 w-full max-w-xs\\\">\\n            <button\\n              onClick={onOpenFileClick}\\n              className=\\\"bg-[#C8102E] hover:bg-[#a50d26] text-white w-full py-3 px-4 rounded-xl text-xs font-bold flex items-center justify-center gap-2 active:scale-95 transition shadow-sm\\\"\\n            >\\n              <FolderOpen className=\\\"w-4 h-4\\\" />\\n              <span>\353\202\264 \352\270\260\352\270\260\354\227\220\354\204\234 \353\217\204\353\251\264 \354\227\264\352\270\260 (.DWG / .DXF)</span>\\n            </button>\\n          </div>\\n          <div className=\\\"mt-4 flex flex-wrap items-center justify-center gap-2\\\">\\n            <button\\n              onClick={onLoadArchSample}\\n              className=\\\"px-3 py-1.5 rounded-lg bg-slate-200 hover:bg-slate-300 dark:bg-slate-800 dark:hover:bg-slate-700 text-[11px] font-semibold text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-700 transition\\\"\\n            >\\n              \360\237\223\220 \352\261\264\354\266\225 \355\217\211\353\251\264\353\217\204 \354\203\230\355\224\214 \354\227\264\352\270\260\\n            </button>\\n            <button\\n              onClick={onLoadMechSample}\\n              className=\\\"px-3 py-1.5 rounded-lg bg-slate-200 hover:bg-slate-300 dark:bg-slate-800 dark:hover:bg-slate-700 text-[11px] font-semibold text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-700 transition\\\"\\n            >\\n              \342\232\231\357\270\217 \352\270\260\352\263\204 \354\241\260\353\246\275\353\217\204 \354\203\230\355\224\214 \354\227\264\352\270\260\\n            </button>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Active Mode Banner */}\\n      {(mode === \'measure\' || mode === \'calibrate\') && (\\n        <div className=\\\"absolute top-3 left-1/2 -translate-x-1/2 z-20 bg-[#1E3A8A] text-white px-3.5 py-1.5 rounded-full text-xs font-bold shadow-xl flex items-center gap-2 whitespace-nowrap border border-white/20\\\">\\n          <span>\\n            {mode === \'measure\'\\n              ? \'\360\237\223\217 \353\221\220 \354\247\200\354\240\220\354\235\204 \354\260\250\353\241\200\353\241\234 \355\204\260\354\271\230\355\225\230\354\204\270\354\232\224 (\353\201\235\354\240\220\302\267\354\244\221\354\213\254\354\240\220 \354\236\220\353\217\231 \354\212\244\353\203\205)\'\\n              : \'\360\237\223\220 2\354\240\220 \354\266\225\354\262\231\352\265\220\354\240\225: \354\213\244\354\240\234 \354\271\230\354\210\230\353\245\274 \354\225\204\353\212\224 \353\221\220 \354\240\220\354\235\204 \355\204\260\354\271\230\355\225\230\354\204\270\354\232\224\'}\\n          </span>\\n          <button\\n            onClick={onCancelMode}\\n            className=\\\"w-5 h-5 rounded-full bg-white/20 hover:bg-white/30 flex items-center justify-center text-[11px]\\\"\\n          >\\n            \342\234\225\\n          </button>\\n        </div>\\n      )}\\n\\n      {/* Floating Vertical Tool Pill (Zoom In, Zoom Out, Fit, Rotate, Clear) */}\\n      <div className=\\\"absolute right-3 top-1/2 -translate-y-1/2 z-20 flex flex-col gap-1.5 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border border-slate-300 dark:border-slate-700 p-1.5 rounded-2xl shadow-xl\\\">\\n        <button\\n          onClick={() => onUpdateCamera(camX, camY, Math.min(2000, zoom * 1.25))}\\n          className=\\\"w-9 h-9 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-100 flex items-center justify-center text-lg font-bold transition active:scale-95\\\"\\n          title=\\\"\353\217\204\353\251\264 \355\231\225\353\214\200\\\"\\n        >\\n          +\\n        </button>\\n        <button\\n          onClick={() => onUpdateCamera(camX, camY, Math.max(0.0002, zoom / 1.25))}\\n          className=\\\"w-9 h-9 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-100 flex items-center justify-center text-lg font-bold transition active:scale-95\\\"\\n          title=\\\"\353\217\204\353\251\264 \354\266\225\354\206\214\\\"\\n        >\\n          \342\210\222\\n        </button>\\n        <button\\n          onClick={handleFitExtents}\\n          className=\\\"w-9 h-9 rounded-xl bg-[#1E3A8A] hover:bg-[#172e6e] text-white flex items-center justify-center transition active:scale-95 shadow-xs\\\"\\n          title=\\\"\353\217\204\353\251\264 \354\240\204\354\262\264 \355\231\224\353\251\264 \353\247\236\354\266\244\\\"\\n        >\\n          <Maximize2 className=\\\"w-4 h-4\\\" />\\n        </button>\\n        <button\\n          onClick={onRotate90}\\n          className=\\\"w-9 h-9 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 flex items-center justify-center transition active:scale-95\\\"\\n          title=\\\"\353\217\204\353\251\264 90\353\217\204 \355\232\214\354\240\204\\\"\\n        >\\n          <RotateCw className=\\\"w-4 h-4\\\" />\\n        </button>\\n        {measurements.length > 0 && (\\n          <button\\n            onClick={onClearMeasurements}\\n            className=\\\"w-9 h-9 rounded-xl bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/40 text-[#C8102E] flex items-center justify-center transition active:scale-95\\\"\\n            title=\\\"\354\270\241\354\240\225\354\204\240 \353\252\250\353\221\220 \354\247\200\354\232\260\352\270\260\\\"\\n          >\\n            <Eraser className=\\\"w-4 h-4\\\" />\\n          </button>\\n        )}\\n      </div>\\n\\n      {/* Mobile Touch Loupe (Magnifying Glass) */}\\n      <div\\n        ref={loupeWrapperRef}\\n        className=\\\"hidden pointer-events-none absolute z-30 w-28 h-28 rounded-full border-2 border-[#1E3A8A] shadow-2xl overflow-hidden bg-slate-950\\\"\\n      >\\n        <canvas\\n          ref={loupeCanvasRef}\\n          width=\\\"112\\\"\\n          height=\\\"112\\\"\\n          className=\\\"block w-full h-full\\\"\\n        />\\n      </div>\\n\\n      {/* Loading Overlay */}\\n      {isLoading && (\\n        <div className=\\\"absolute inset-0 z-40 bg-slate-950/80 backdrop-blur-xs flex flex-col items-center justify-center text-center p-6 text-white\\\">\\n          <div className=\\\"w-12 h-12 rounded-full border-4 border-[#1E3A8A]/30 border-t-[#C8102E] animate-spin mb-3\\\"></div>\\n          <h3 className=\\\"text-sm font-bold mb-1\\\">\\n            DWG/DXF \353\217\204\353\251\264 \354\240\225\353\260\200 \355\225\264\353\217\205 \354\244\221...\\n          </h3>\\n          <p className=\\\"text-xs text-slate-300 max-w-xs\\\">{loadingMessage}</p>\\n        </div>\\n      )}\\n    </main>\\n  );\\n};\\n\", \"Description\":\"Create CADCanvas viewport component with touch loupe and hardware renderer\", \"Overwrite\":true, \"TargetFile\":\"/src/components/CADCanvas.tsx\", \"toolAction\":\"Writing CADCanvas.tsx\", \"toolSummary\":\"Create CADCanvas component\"}"
      thinking_signature: "\022\356\b\n\353\b\001i\024}\023\337\032\227_\003\374\271\376\024vU[\313\357#\325\335l\217\'\006%\264\346\205\326\212\f\266}=>\033\335\361\026\302\343\312R+\367i?y\334\371M\"r\261\306<\b\004:\232\275h\273\275DX\2076\365Ti\003G\271+\272j\242\375k\350\213<\231\360\276\273\b\276\245\244m\241z\240\235\377\206>\367[\242\231\207\362\370V\240\235\342j\261x\215\301d\233s\362FH,\305\264z\020P\253Z\026?\244\212\273J\207$U\353O\3466\245>i\303\276\022\337\000\332\364\345.\324T\326\230H\256)l\300u\227X\221d1[4\370\232\360\264\373r;3\243r$\266\266\343.\362\251\303\247*\376ax\035\226\340\347\216\271\341@j\253~\261\230\025\272\222~\202\233i)0<\344\333\201\255DD*\\\306\277\222\300\\\312\354\350\307U|\246\364Apdf2j\203[\b\\lpF\2744\201.\204\2613\256<\343\362.l{=\237\017i\254\3308L\002y\312\370\330\001\225\301\a@\204\"\0340\365\372\353\320\372V\222\211K\265\345R\337c`\002\374?\2415\265is\234\322\034a\341\031\351\374\n\351)O.\201\206\270j\371\264\272~>\357\332q\024\245y\2733\266\002\330\022+lB\353\203;\363\330\201\325\375\345\360\2463\"\2737\226\027\301\314\360nL\334t\214\271LD(\305t \b\356$\237\355a\321?\026=i\260\2476}\326\224\372\250i\354\246*\217\024\025\242\240\027k,\000\263\021j\330\265\362\357\341\321D\233\020\231\324\267k\'\r\342\342H\262tP\210\177\372\222\333a\300\206\247\257M\303\'\327\232\270\266\200n\327/h\333b;|5\316Z\237\336p\217\361G\224\236rJ\031\302@\341\344]\232}\340^\bM\235\235\275\361\221V\365_\vo{&\366B;\357]\222\'\016\021\353%)[\022\226y\337\254\316\316w\252\033\\#P\202\nL\b\254\237\t?\002\211:x\033y\304\337+\245G\226\334\320N7\235\2149p\005Y\376\330R\nq\365\272\243\335r\271\203T\226n\314\177\262CK$\023\235\031\027\316X\027\325\345\364\b\320q\001M\324SqT1\027\r\005\200\261\332\364\342\357\230\360\300\035__\276\rL\213\364NG\204k\201\037\332p\265\257\340\332\320wF\376\343\270\353B\025.,\347S\350\255d!\273\315\tDbp;?\177\346\207\355\370<\325\250]\311 \273\236u7F\3761\276r\023\221\324@!\341\2253K\3730\nr\326\342\242&\321L$k\270\263\264_\v\34