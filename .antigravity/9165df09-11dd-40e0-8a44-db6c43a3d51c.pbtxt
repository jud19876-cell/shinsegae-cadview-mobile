  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React from \'react\';\nimport { X } from \'lucide-react\';\nimport { CadEntity } from \'../types/cad\';\n\ninterface EntityInspectorProps {\n  entity: CadEntity | null;\n  unitScaleFactor: number;\n  onClose: () => void;\n}\n\nexport const EntityInspector: React.FC<EntityInspectorProps> = ({\n  entity,\n  unitScaleFactor,\n  onClose,\n}) => {\n  if (!entity) return null;\n\n  const sf = unitScaleFactor || 1;\n  const items: string[] = [];\n\n  if (entity.type === \'LINE\' && entity.start && entity.end) {\n    const len = Math.hypot(entity.end.x - entity.start.x, entity.end.y - entity.start.y) * sf;\n    items.push(`\352\270\270\354\235\264: ${len.toFixed(1)} mm`);\n    items.push(`\316\224X: ${((entity.end.x - entity.start.x) * sf).toFixed(1)}`);\n    items.push(`\316\224Y: ${((entity.end.y - entity.start.y) * sf).toFixed(1)}`);\n  } else if (entity.type === \'CIRCLE\' && entity.center) {\n    items.push(`\353\260\230\354\247\200\353\246\204 R: ${(entity.radius * sf).toFixed(1)} mm`);\n    items.push(`\354\247\200\353\246\204 \303\230: ${(entity.radius * 2 * sf).toFixed(1)} mm`);\n  } else if (entity.type === \'ARC\' && entity.center) {\n    items.push(`\353\260\230\354\247\200\353\246\204 R: ${(entity.radius * sf).toFixed(1)} mm`);\n    items.push(`\352\260\201\353\217\204: ${Math.round(entity.startAngle)}\302\260 ~ ${Math.round(entity.endAngle)}\302\260`);\n  } else if (entity.type === \'LWPOLYLINE\' && entity.vertices) {\n    let len = 0;\n    for (let i = 0; i < entity.vertices.length - 1; i++) {\n      len += Math.hypot(\n        entity.vertices[i + 1].x - entity.vertices[i].x,\n        entity.vertices[i + 1].y - entity.vertices[i].y\n      );\n    }\n    items.push(`\352\274\255\354\247\223\354\240\220: ${entity.vertices.length}\352\260\234`);\n    items.push(`\354\264\235 \352\270\270\354\235\264: ${(len * sf).toFixed(1)} mm`);\n    if (entity.closed) items.push(\'\355\230\225\355\203\234: \353\213\253\355\236\214 \355\217\264\353\246\254\353\235\274\354\235\270 (Closed)\');\n  } else if (entity.type === \'TEXT\') {\n    items.push(`\353\202\264\354\232\251: ${entity.text}`);\n    items.push(`\353\206\222\354\235\264: ${Math.round(entity.height * sf)}`);\n  }\n\n  return (\n    <div className=\"fixed inset-x-0 bottom-16 z-30 p-3 pointer-events-none\">\n      <div className=\"pointer-events-auto max-w-md mx-auto bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border border-slate-300 dark:border-slate-700 rounded-2xl p-3.5 shadow-2xl\">\n        <div className=\"flex items-center justify-between mb-2 pb-1.5 border-b border-slate-200 dark:border-slate-700/60\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"px-2 py-0.5 rounded bg-[#1E3A8A] text-white font-mono text-[11px] font-bold\">\n              {entity.type}\n            </span>\n            <span className=\"text-xs font-bold text-slate-800 dark:text-slate-200\">\n              \353\240\210\354\235\264\354\226\264: {entity.layer || \'0\'}\n            </span>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 text-xs p-1\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n        <div className=\"grid grid-cols-2 gap-1.5 text-xs text-slate-700 dark:text-slate-300 font-mono\">\n          {items.map((t, idx) => (\n            <div\n              key={idx}\n              className=\"bg-slate-100 dark:bg-slate-950/80 px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 truncate\"\n            >\n              {t}\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
