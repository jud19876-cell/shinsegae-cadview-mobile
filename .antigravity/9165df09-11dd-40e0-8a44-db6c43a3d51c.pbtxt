            }
            lines {
              text: "          for (let k = 0; k < e.vertices.length; k++) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            check(e.vertices[k].x, e.vertices[k].y, \'END\');"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        } else if ((e.type === \'CIRCLE\' || e.type === \'ARC\') && e.center) {"
