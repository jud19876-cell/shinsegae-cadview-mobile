    content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport {\n  CadBlock,\n  CadEntity,\n  DrawingModel,\n  LayerInfo,\n  Point2D,\n  Vertex2D,\n} from \'../types/cad\';\nimport { cleanCadText } from \'./textSanitizer\';\nimport { sanitizeCadEntity, sanitizeDrawingModel } from \'./cadSanitizer\';\n\nexport interface OcsTransform {\n  isIdentity: boolean;\n  flipX: number;\n  pt: (x: number, y: number, z?: number) => Point2D;\n}\n\nexport function buildOcsTransform(extObj: unknown): OcsTransform {\n  if (!extObj) {\n    return { isIdentity: true, flipX: 1, pt: (x, y) => ({ x, y }) };\n  }\n  let nx = 0,\n    ny = 0,\n    nz = 1;\n\n  if (Array.isArray(extObj) && extObj.length >= 3) {\n    nx = Number(extObj[0] || 0);\n    ny = Number(extObj[1] || 0);\n    nz = Number(extObj[2] !== undefined ? extObj[2] : 1);\n  } else if (typeof extObj === \'object\') {\n    const o = extObj as { x?: number; y?: number; z?: number };\n    nx = Number(o.x || 0);\n    ny = Number(o.y || 0);\n    nz = Number(o.z !== undefined ? o.z : 1);\n  }\n\n  if (!isFinite(nx) || !isFinite(ny) || !isFinite(nz)) {\n    return { isIdentity: true, flipX: 1, pt: (x, y) => ({ x, y }) };\n  }\n\n  const len = Math.hypot(nx, ny, nz);\n  if (len < 1e-9) {\n    return { isIdentity: true, flipX: 1, pt: (x, y) => ({ x, y }) };\n  }\n  nx /= len;\n  ny /= len;\n  nz /= len;\n\n  // Standard normal (0, 0, +1)\n  if (Math.abs(nx) < 1e-5 && Math.abs(ny) < 1e-5 && nz > 0) {\n    return { isIdentity: true, flipX: 1, pt: (x, y) => ({ x, y }) };\n  }\n  // Mirrored normal (0, 0, -1) -> WCS_X = -OCS_X, WCS_Y = OCS_Y\n  if (Math.abs(nx) < 1e-5 && Math.abs(ny) < 1e-5 && nz < 0) {\n    return { isIdentity: false, flipX: -1, pt: (x, y) => ({ x: -x, y }) };\n  }\n\n  // Arbitrary Axis Algorithm (AutoCAD DXF spec)\n  let axX: number, axY: number, axZ: number;\n  if (Math.abs(nx) < 1 / 64 && Math.abs(ny) < 1 / 64) {\n    const alen = Math.hypot(nz, -nx) || 1;\n    axX = nz / alen;\n    axY = 0;\n    axZ = -nx / alen;\n  } else {\n    const alen = Math.hypot(-ny, nx) || 1;\n    axX = -ny / alen;\n    axY = nx / alen;\n    axZ = 0;\n  }\n  const ayX = ny * axZ - nz * axY;\n  const ayY = nz * axX - nx * axZ;\n\n  return {\n    isIdentity: false,\n    flipX: nz < 0 ? -1 : 1,\n    pt: (x, y, z = 0) => ({\n      x: x * axX + y * ayX + z * nx,\n      y: x * axY + y * ayY + z * ny,\n    }),\n  };\n}\n\nexport function expandVerticesWithBulge(\n  rawVerts: Vertex2D[],\n  isClosed?: boolean\n): Vertex2D[] {\n  if (!rawVerts || rawVerts.length < 2) return rawVerts || [];\n  const out: Vertex2D[] = [];\n  const segCount = isClosed ? rawVerts.length : rawVerts.length - 1;\n\n  for (let i = 0; i < rawVerts.length; i++) {\n    const p1 = rawVerts[i];\n    out.push({ x: p1.x, y: p1.y });\n\n    if (i < segCount && p1.bulge && Math.abs(p1.bulge) > 1e-4) {\n      const p2 = rawVerts[(i + 1) % rawVerts.length];\n      const chordDx = p2.x - p1.x;\n      const chordDy = p2.y - p1.y;\n      const chordLen = Math.hypot(chordDx, chordDy);\n\n      if (chordLen > 1e-6) {\n        const b = p1.bulge;\n        const theta = 4 * Math.atan(b);\n        const radius = Math.abs(chordLen / (2 * Math.sin(Math.abs(theta) / 2)));\n        const midX = (p1.x + p2.x) / 2;\n        const midY = (p1.y + p2.y) / 2;\n        const cotQuarter = (1 - b * b) / (2 * b);\n        const cx = midX - (chordDy / 2) * cotQuarter;\n        const cy = midY + (chordDx / 2) * cotQuarter;\n        const startA = Math.atan2(p1.y - cy, p1.x - cx);\n        const steps = Math.max(\n          4,\n          Math.min(16, Math.ceil(Math.abs(theta) / (Math.PI / 12)))\n        );"
