      original_chunk {
        target_content: "  const rawEnts = db && Array.isArray(db.entities) ? db.entities : [];\n  rawEnts.forEach((r: any) => {\n    const m = mapRawEntity(r, false);\n    if (m) entities.push(m);\n  });\n\n  if (entities.length === 0 && modelSpaceFallback.length > 0) {\n    modelSpaceFallback.forEach((e) => entities.push(e));\n  } else if (entities.length === 0 && paperSpaceFallback.length > 0) {\n    paperSpaceFallback.forEach((e) => entities.push(e));\n  }"
        replacement_content: "  const seenIds = new Set<string>();\n\n  // 1. Primary Model Space entities (*MODEL_SPACE block in DWG BLOCK_RECORD)\n  if (modelSpaceFallback.length > 0) {\n    modelSpaceFallback.forEach((e) => {\n      if (!seenIds.has(e.id)) {\n        seenIds.add(e.id);\n        entities.push(e);\n      }\n    });\n  }\n\n  // 2. Incorporate non-duplicate drawing entities from db.entities (active model space)\n  const rawEnts = db && Array.isArray(db.entities) ? db.entities : [];\n  rawEnts.forEach((r: any) => {\n    const m = mapRawEntity(r, false);\n    if (m && !seenIds.has(m.id)) {\n      seenIds.add(m.id);\n      entities.push(m);\n    }\n  });\n\n  // 3. Fallback to paper space only if no model space objects were found anywhere\n  if (entities.length === 0 && paperSpaceFallback.length > 0) {\n    paperSpaceFallback.forEach((e) => entities.push(e));\n  }"
        start_line: 729
        end_line: 740
      }
      num_matches: 1
    }
    description: "Merge *MODEL_SPACE entities and db.entities with deduplication in libreDwgLoader.ts"
