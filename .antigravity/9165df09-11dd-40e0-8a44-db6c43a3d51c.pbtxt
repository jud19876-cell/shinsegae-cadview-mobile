        instruction: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React from \'react\';\nimport { AppThemePreference, CadTheme, Point2D } from \'../types/cad\';\nimport { SunMoon } from \'lucide-react\';\n\ninterface UniversalModeBarProps {\n  zoom: number;\n  mouseWorld: Point2D;\n  unitScaleFactor: number;\n  theme: CadTheme;\n  themePreference: AppThemePreference;\n  textScale: number;\n  onSetThemePreference: (theme: AppThemePreference) => void;\n  onTextScaleDown: () => void;\n  onTextScaleUp: () => void;\n}\n\nexport const UniversalModeBar: React.FC<UniversalModeBarProps> = ({\n  zoom,\n  mouseWorld,\n  unitScaleFactor,\n  theme,\n  themePreference,\n  textScale,\n  onSetThemePreference,\n  onTextScaleDown,\n  onTextScaleUp,\n}) => {\n  const isCalibrated = Math.abs(unitScaleFactor - 1.0) > 0.001;\n\n  return (\n    <div className=\"h-9 bg-slate-100 dark:bg-slate-900 border-b border-slate-300 dark:border-slate-800 px-3 flex items-center justify-between gap-2 shrink-0 z-20 overflow-x-auto no-scrollbar\">\n      {/* HUD Info */}\n      <div className=\"flex items-center gap-1.5 text-[11px] font-mono shrink-0\">\n        <span className=\"w-2 h-2 rounded-full bg-emerald-500 shrink-0\"></span>\n        <span className=\"font-bold text-slate-800 dark:text-slate-100\">\n          {Math.round(zoom * 100)}%\n        </span>\n        <span className=\"opacity-40\">|</span>\n        <span className=\"text-[#1E3A8A] dark:text-cyan-300 font-semibold truncate max-w-[140px] sm:max-w-none\">\n          X: {mouseWorld.x.toFixed(0)}, Y: {mouseWorld.y.toFixed(0)}\n        </span>\n        {isCalibrated && (\n          <span className=\"hidden sm:inline text-[10px] font-mono px-1 py-0.2 rounded bg-amber-500/15 text-amber-600 dark:text-amber-400 font-bold\">\n            \353\260\260\354\234\250 \303\227{unitScaleFactor.toFixed(3)}\n          </span>\n        )}\n      </div>\n\n      {/* Theme & Text Scaling Controls */}\n      <div className=\"flex items-center gap-1 shrink-0 text-[11px]\">\n        {/* System Auto Theme (Automatically follows OS dark mode) */}\n        <button\n          onClick={() => onSetThemePreference(\'system\')}\n          className={`px-2 py-0.5 rounded-lg text-xs font-semibold flex items-center gap-1 transition ${\n            themePreference === \'system\'\n              ? \'bg-[#1E3A8A] text-white shadow-xs\'\n              : \'text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800\'\n          }`}\n          title=\"\354\212\244\353\247\210\355\212\270\355\217\260/\354\213\234\354\212\244\355\205\234 \354\204\244\354\240\225\354\227\220 \353\247\236\354\266\260 \353\213\244\355\201\254\302\267\353\235\274\354\235\264\355\212\270 \353\252\250\353\223\234 \354\236\220\353\217\231 \354\240\204\355\231\230\"\n        >\n          <SunMoon className=\"w-3 h-3\" />\n          <span>\354\213\234\354\212\244\355\205\234</span>\n        </button>\n\n        {/* Ivory White Theme */}\n        <button\n          onClick={() => onSetThemePreference(\'white\')}\n          className={`px-2 py-0.5 rounded-lg text-xs font-semibold transition ${\n            themePreference === \'white\'\n              ? \'bg-[#1E3A8A] text-white shadow-xs\'\n              : \'text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800\'\n          }`}\n          title=\"\354\206\214\355\224\204\355\212\270 \354\225\204\354\235\264\353\263\264\353\246\254 \353\260\235\354\235\200 \353\217\204\353\251\264 \355\205\214\353\247\210\"\n        >\n          \353\260\261\354\247\200\n        </button>\n\n        {/* CAD Dark Theme */}\n        <button\n          onClick={() => onSetThemePreference(\'dark\')}\n          className={`px-2 py-0.5 rounded-lg text-xs font-semibold transition ${\n            themePreference === \'dark\'\n              ? \'bg-[#1E3A8A] text-white shadow-xs\'\n              : \'text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800\'\n          }`}\n          title=\"AutoCAD \355\201\264\353\236\230\354\213\235 \353\213\244\355\201\254 \355\205\214\353\247\210\"\n        >\n          \353\213\244\355\201\254\n        </button>\n\n        {/* Engineering Blueprint Theme */}\n        <button\n          onClick={() => onSetThemePreference(\'blueprint\')}\n          className={`px-2 py-0.5 rounded-lg text-xs font-semibold transition ${\n            themePreference === \'blueprint\'\n              ? \'bg-[#1E3A8A] text-white shadow-xs\'\n              : \'text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800\'\n          }`}\n          title=\"\354\227\224\354\247\200\353\213\210\354\226\264\353\247\201 \354\262\255\354\202\254\354\247\204 \353\270\224\353\243\250 \355\205\214\353\247\210\"\n        >\n          \354\262\255\354\202\254\354\247\204\n        </button>\n\n        <div className=\"w-px h-3.5 bg-slate-300 dark:bg-slate-700 mx-0.5\"></div>\n\n        {/* Text Scaling */}\n        <button\n          onClick={onTextScaleDown}\n          className=\"px-1.5 py-0.5 rounded hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 font-mono font-bold\"\n          title={`\353\217\204\353\251\264 \353\254\270\354\236\220 \355\201\254\352\270\260 \354\266\225\354\206\214 (\355\230\204\354\236\254: ${textScale}x)`}\n        >\n          A-\n        </button>\n        <button\n          onClick={onTextScaleUp}\n          className=\"px-1.5 py-0.5 rounded hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 font-mono font-bold\"\n          title={`\353\217\204\353\251\264 \353\254\270\354\236\220 \355\201\254\352\270\260 \355\231\225\353\214\200 (\355\230\204\354\236\254: ${textScale}x)`}\n        >\n          A+\n        </button>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/UniversalModeBar.tsx"
        }
        overwrite: true
      }
    }
