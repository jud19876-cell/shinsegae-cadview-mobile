    content: "      idx++;\n      continue;\n    }\n\n    if (section === \'TABLES\') {\n      if (\n        p.code === 0 &&\n        p.value === \'TABLE\' &&\n        idx + 1 < pairs.length &&\n        pairs[idx + 1].value === \'LAYER\'\n      ) {\n        inLayerTable = true;\n        idx += 2;\n        continue;\n      }\n      if (p.code === 0 && p.value === \'ENDTAB\') {\n        inLayerTable = false;\n        currentLayer = null;\n        idx++;\n        continue;\n      }\n      if (inLayerTable) {\n        if (p.code === 0 && p.value === \'LAYER\') {\n          currentLayer = {\n            name: \'0\',\n            aci: 7,\n            color: \'#0f172a\',\n            visible: true,\n            count: 0,\n          };\n        } else if (currentLayer) {\n          if (p.code === 2) {\n            currentLayer.name = cleanCadText(p.value) || \'0\';\n            layers[currentLayer.name] = currentLayer;\n          } else if (p.code === 62) {\n            const col = parseInt(p.value, 10);\n            currentLayer.aci = Math.abs(col);\n            if (col < 0) currentLayer.visible = false;\n          } else if (p.code === 420) {\n            currentLayer.aci = parseInt(p.value, 10);\n          }\n        }\n      }\n      idx++;\n    } else if (section === \'BLOCKS\') {\n      if (p.code === 0 && p.value === \'BLOCK\') {\n        currentBlock = {\n          name: \'\',\n          basePoint: { x: 0, y: 0 },\n          entities: [],\n        };\n        idx++;\n        while (idx < pairs.length && pairs[idx].code !== 0) {\n          if (pairs[idx].code === 2) {\n            currentBlock.name = cleanCadText(pairs[idx].value);\n            blocks[currentBlock.name] = currentBlock;\n          } else if (pairs[idx].code === 10) {\n            currentBlock.basePoint.x = parseFloat(pairs[idx].value);\n          } else if (pairs[idx].code === 20) {\n            currentBlock.basePoint.y = parseFloat(pairs[idx].value);\n          }\n          idx++;\n        }\n        if (currentBlock.name.toUpperCase().startsWith(\'*D\')) {\n          currentBlock.basePoint = { x: 0, y: 0 };\n        }\n        continue;\n      } else if (p.code === 0 && p.value === \'ENDBLK\') {\n        currentBlock = null;\n        idx++;\n        continue;\n      } else if (p.code === 0 && currentBlock) {\n        const res = parseEntityGroup(idx);\n        if (res.entity) currentBlock.entities.push(res.entity);\n        idx = res.nextIndex;\n        continue;\n      }\n      idx++;\n    } else if (section === \'ENTITIES\') {\n      if (p.code === 0) {\n        const res = parseEntityGroup(idx);\n        if (res.entity) entities.push(res.entity);\n        idx = res.nextIndex;\n        continue;\n      }\n      idx++;\n    } else {\n      idx++;\n    }\n  }\n\n  return sanitizeDrawingModel({\n    fileName,\n    formatVersion: \'DXF\',\n    layers,\n    blocks,\n    entities,\n  });\n}\n"
