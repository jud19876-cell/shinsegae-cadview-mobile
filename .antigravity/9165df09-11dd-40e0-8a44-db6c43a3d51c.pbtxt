    content: "\n  const spanW = Math.max(100, maxX - minX);\n  const spanH = Math.max(100, maxY - minY);\n  const maxDiag = Math.hypot(spanW, spanH);\n\n  function isArtifactStreakSegment(p1: Point2D, p2: Point2D): boolean {\n    const dx = Math.abs(p2.x - p1.x);\n    const dy = Math.abs(p2.y - p1.y);\n    const len = Math.hypot(dx, dy);\n    if (len > maxDiag * 1.5) return true;\n    const isDiagonal = dx > len * 0.22 && dy > len * 0.22;\n    if (isDiagonal && len > maxDiag * 0.22) {\n      return true;\n    }\n    return false;\n  }\n\n  const finalEntities: CadEntity[] = [];\n  for (let i = 0; i < expanded.length; i++) {\n    const e = expanded[i];\n    if (e.type === \'LINE\' && e.start && e.end) {\n      if (isArtifactStreakSegment(e.start, e.end)) continue;\n      finalEntities.push(e);\n    } else if (e.type === \'LWPOLYLINE\' && e.vertices && e.vertices.length >= 2) {\n      if (e.closed && e.vertices.length >= 3) {\n        const v0 = e.vertices[0];\n        const vn = e.vertices[e.vertices.length - 1];\n        if (isArtifactStreakSegment(vn, v0)) {\n          e.closed = false;\n        }\n      }\n      let currentSubVerts = [e.vertices[0]];\n      for (let k = 1; k < e.vertices.length; k++) {\n        const prev = e.vertices[k - 1];\n        const cur = e.vertices[k];\n        if (isArtifactStreakSegment(prev, cur)) {\n          if (currentSubVerts.length >= 2) {\n            finalEntities.push({\n              id: `${e.id}_sub${k}`,\n              type: \'LWPOLYLINE\',\n              layer: e.layer,\n              aci: e.aci,\n              linetype: e.linetype,\n              lineweight: e.lineweight,\n              closed: false,\n              vertices: currentSubVerts,\n            });\n          }\n          currentSubVerts = [cur];\n        } else {\n          currentSubVerts.push(cur);\n        }\n      }\n      if (currentSubVerts.length >= 2) {\n        e.vertices = currentSubVerts;\n        finalEntities.push(e);\n      }\n    } else {\n      finalEntities.push(e);\n    }\n  }\n\n  // Count entities per layer\n  finalEntities.forEach((e) => {\n    const lname = e.layer || \'0\';\n    if (!layers[lname]) {\n      const fallbackAci =\n        e.aci && e.aci !== 256 && e.aci !== 0 ? e.aci : 7;\n      layers[lname] = {\n        name: lname,\n        aci: fallbackAci,"
    num_lines: 521
