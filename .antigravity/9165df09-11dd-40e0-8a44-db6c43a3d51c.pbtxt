      thinking_signature: "\022\357\027\n\354\027\001i\024}\023_`?_O\342\227\342\253\017\315\332\203\325w\372\021\337\030-B\327-]\307\275\371\321o\204b5\362\365U\235\304\034\346\316\036\264\325p<\250K\376\177\217\347\273TX\034D\244\237\r\021\354.\317~\203\373Z\021a*\334\224\000\v\324n~\250\323\a\336\f\345\313g\211\276\005\305\313\f\317e\212i\332q\021\\m\000W\237d\375\2213e/;\257\311\342\242%\307\342\357:4\274E\326u\340\212\252\266D\345^\203D\255\333\251\255XD\022=\001\005\024\255\372xCH6\271\037\353\373\315q&\036\212\367\227\300q\346\3228;\232\250\003\"\355\203\003\231\223\006\276\'\343\316\311\021\307\236\367&\2507\003\001cD\270\302g\v\0041\203\253\370\257\217\006\355\030\\\3002\341z\367v/O\227\216\330Y\340\330\204\336[\372\360<\277V\275\237\255\247\v\255Z\317\027\0228\333\370\031\017e\312\367D\377\240\312\017\037\314\237\257Y7\365My\361J\276\002\336\272\030\316\262#7v\025\nT\023\353/\323S\344\2576\225\204\244\027\373\306\242.\234\004\021\340\266\3138\354\243i=\363cU\333^\205&?l\250\353g\213\277AQ\350\362Zn\307{R\372d^\314\036\035W\312\204=\202$\203.\262_\213N\031s\257\260\306\362?\272c\256\"\342\017\374\262\341i\003\355O&\364#\326xr\263C\254\200\3056.[]\261\274\214\310 \223\373\223F@\213\307\225\317\353~\304\322u)\351\366\214\231\253\216G\243\266\207U\205\326z\343\0255f\347C\367\a\n\r3+?\270{\376\\!B \v\211\370\b/\376\000\004\331\267#\002\032*&\252\361\334\333%\200u,\377\306\276\365\307EA\346\226\254\000\363\231\351\216\241\254\025g\336\263a,\024\374?\')\316\336\264\234\b<\314\270\367\252\275\305\3061%_\016\354\321\272t\346\311\214K(3R\\G\302\351\247\\\376\'\222\250\274\335#\250j\366\2103\301\361H{\227\371\263G$\347eu\307\325\3524jN\205\276\276l\226\035\347\232\032\336ai\357\037\024\265[\023\231\204\276\30556\201\022\246\214\341\vi\342\221\034v\326L\360\231\352M\225\317-p\314nK\254\342_C\003\2677\265\375\356\v\246;\364D?\330z\232z)\035\016$\307\230\344\005!\225\260\224,u\253$M\275&W\342@\330\371\336\301s\246\270x\177|\322\1771\300\324o\263)d\030\362n\002D\321\275\