      original_chunk {
        target_content: "        {/* Body */}\n        <div className=\"p-4 space-y-4 overflow-y-auto custom-scrollbar text-xs text-slate-700 dark:text-slate-300 leading-relaxed\">\n          {/* Option 1: Direct Standalone HTML */}\n          <div className=\"p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 space-y-2\">\n            <div className=\"font-bold text-[#1E3A8A] dark:text-emerald-400 flex items-center justify-between\">\n              <span>\353\260\251\353\262\225 1. \353\213\250\354\235\274 \355\214\214\354\235\274(.html)\353\241\234 \353\260\233\354\225\204 \353\202\264 \355\217\260\354\227\220\354\204\234 \353\260\224\353\241\234 \354\223\260\352\270\260</span>"
        replacement_content: "        {/* Body */}\n        <div className=\"p-4 space-y-4 overflow-y-auto custom-scrollbar text-xs text-slate-700 dark:text-slate-300 leading-relaxed\">\n          {/* Direct Share Link & QR Code (No App Store required) */}\n          <div className=\"p-4 rounded-xl bg-gradient-to-br from-blue-50/80 to-indigo-50/80 dark:from-slate-900 dark:to-slate-950 border-2 border-[#1E3A8A]/30 dark:border-blue-500/30 space-y-3\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse\" />\n                <span className=\"font-bold text-sm text-[#1E3A8A] dark:text-blue-400\">\n                  \353\202\230\353\247\214\354\235\230 \354\240\204\354\232\251 \354\233\271 \354\225\261 \354\243\274\354\206\214 (\354\212\244\355\206\240\354\226\264 \353\223\261\353\241\235 \353\266\210\355\225\204\354\232\224)\n                </span>\n              </div>\n              <span className=\"text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 font-bold\">\n                \353\271\204\352\263\265\352\260\234 \353\213\244\354\235\264\353\240\211\355\212\270 \353\247\201\355\201\254\n              </span>\n            </div>\n\n            <p className=\"text-[11px] text-slate-600 dark:text-slate-400\">\n              \352\265\254\352\270\200 \355\224\214\353\240\210\354\235\264 \354\212\244\355\206\240\354\226\264\354\227\220 \354\230\254\353\246\264 \355\225\204\354\232\224 \354\227\206\354\235\264, <strong>\353\202\230 \353\230\220\353\212\224 \353\247\201\355\201\254\353\245\274 \353\260\233\354\235\200 \354\202\254\353\236\214</strong>\353\247\214 \354\240\221\354\206\215\355\225\230\354\227\254 \354\212\244\353\247\210\355\212\270\355\217\260\354\227\220 \354\225\261\354\234\274\353\241\234 \354\204\244\354\271\230\355\225\264 \354\202\254\354\232\251\355\225\240 \354\210\230 \354\236\210\354\212\265\353\213\210\353\213\244.\n            </p>\n\n            <div className=\"flex flex-col sm:flex-row items-center gap-3 bg-white dark:bg-slate-900/80 p-3 rounded-xl border border-slate-200 dark:border-slate-800\">\n              {/* QR Code */}\n              <div className=\"bg-white p-1.5 rounded-lg border border-slate-200 shadow-xs shrink-0 flex flex-col items-center\">\n                <img\n                  src={`https://api.qrserver.com/v1/create-qr-code/?size=130x130&data=${encodeURIComponent(sharedUrl)}`}\n                  alt=\"\354\212\244\353\247\210\355\212\270\355\217\260 \354\227\260\352\262\260 QR\354\275\224\353\223\234\"\n                  className=\"w-24 h-24 sm:w-28 sm:h-28 object-contain\"\n                  loading=\"lazy\"\n                />\n                <span className=\"text-[9px] text-slate-500 font-medium mt-1\">\354\212\244\353\247\210\355\212\270\355\217\260 \354\271\264\353\251\224\353\235\274\353\241\234 \354\212\244\354\272\224</span>\n              </div>\n\n              {/* URL & Action buttons */}\n              <div className=\"flex-1 w-full space-y-2\">\n                <div className=\"text-[11px] font-mono bg-slate-100 dark:bg-slate-950 px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-800 break-all select-all text-slate-800 dark:text-slate-200\">\n                  {sharedUrl}\n                </div>\n                <div className=\"flex flex-wrap gap-2\">\n                  <button\n                    onClick={() => handleCopyUrl(sharedUrl)}\n                    className=\"flex-1 bg-[#1E3A8A] hover:bg-[#172e6e] text-white py-2 px-3 rounded-lg font-bold flex items-center justify-center gap-1.5 text-xs shadow-xs transition active:scale-95\"\n                  >\n                    {copiedAppUrl ? <Check className=\"w-3.5 h-3.5 text-emerald-300\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                    <span>{copiedAppUrl ? \'\353\247\201\355\201\254 \353\263\265\354\202\254\353\220\250!\' : \'\354\271\264\355\206\241/\353\254\270\354\236\220 \354\240\204\354\206\241\354\232\251 \353\247\201\355\201\254 \353\263\265\354\202\254\'}</span>\n                  </button>\n                  <a\n                    href={sharedUrl}\n                    target=\"_blank\"\n                    rel=\"noopener noreferrer\"\n                    className=\"bg-slate-200 hover:bg-slate-300 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 py-2 px-3 rounded-lg font-semibold flex items-center justify-center gap-1 text-xs transition\"\n                  >\n                    <span>\354\203\210 \354\260\275 \354\227\264\352\270\260</span>\n                    <ExternalLink className=\"w-3 h-3\" />\n                  </a>\n                </div>\n                <div className=\"text-[10px] text-slate-500 dark:text-slate-400 leading-tight\">\n                  \360\237\222\241 <strong>\354\212\244\353\247\210\355\212\270\355\217\260 \354\225\261 \354\266\224\352\260\200 \355\214\201</strong>: \355\217\260 \353\270\214\353\235\274\354\232\260\354\240\200\354\227\220\354\204\234 \353\247\201\355\201\254 \354\240\221\354\206\215 \355\233\204 \353\251\224\353\211\264(\342\213\256) \342\236\224 <strong>[\354\225\261 \354\204\244\354\271\230]</strong> \353\230\220\353\212\224 <strong>[\355\231\210 \355\231\224\353\251\264\354\227\220 \354\266\224\352\260\200]</strong>\353\245\274 \353\210\204\353\245\264\353\251\264 \355\217\260 \353\260\224\355\203\225\355\231\224\353\251\264\354\227\220 \353\213\250\353\217\205 CAD \353\267\260\354\226\264 \354\225\204\354\235\264\354\275\230\354\235\264 \354\203\235\352\271\201\353\213\210\353\213\244.\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Option 1: Direct Standalone HTML */}\n          <div className=\"p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 space-y-2\">\n            <div className=\"font-bold text-[#1E3A8A] dark:text-emerald-400 flex items-center justify-between\">\n              <span>\353\260\251\353\262\225 1. \353\213\250\354\235\274 \355\214\214\354\235\274(.html)\353\241\234 \353\260\233\354\225\204 \353\202\264 \355\217\260\354\227\220\354\204\234 \353\260\224\353\241\234 \354\223\260\352\270\260</span>"
        start_line: 200
        end_line: 210
      }
