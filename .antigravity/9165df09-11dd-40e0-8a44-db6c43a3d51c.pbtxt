        replacement_content: "        ent.closed = false;\n        const validPts = pts\n          .map((p: any) => ({ x: Number(p.x), y: Number(p.y) }))\n          .filter((p: any) => isValidCoord(p.x) && isValidCoord(p.y));\n        if (validPts.length < 2) return null;\n\n        // Strip anomalous tangent vectors or stray origin (0, 0) leaps at ends of spline\n        let filteredPts = validPts;\n        if (filteredPts.length >= 3) {\n          const first = filteredPts[0];\n          const second = filteredPts[1];\n          const last = filteredPts[filteredPts.length - 1];\n          const prevLast = filteredPts[filteredPts.length - 2];\n          const midDist = Math.max(1, Math.hypot(second.x - first.x, second.y - first.y));\n          const endDist = Math.hypot(last.x - prevLast.x, last.y - prevLast.y);\n\n          if (endDist > 800 && (Math.hypot(last.x, last.y) < 1.0 || endDist > Math.max(500, midDist * 12))) {\n            filteredPts = filteredPts.slice(0, -1);\n          }\n          if (filteredPts.length >= 3) {\n            const startDist = Math.hypot(filteredPts[1].x - filteredPts[0].x, filteredPts[1].y - filteredPts[0].y);\n            if (startDist > 800 && (Math.hypot(filteredPts[0].x, filteredPts[0].y) < 1.0 || startDist > Math.max(500, midDist * 12))) {\n              filteredPts = filteredPts.slice(1);\n            }\n          }\n        }\n        ent.vertices = filteredPts;\n        if (ent.vertices.length < 2) return null;"
        start_line: 615
        end_line: 620
      }
